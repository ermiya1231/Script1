-- ========== زوم نرم (جایگزین زوم پیش‌فرض در حالت NoClip) ==========
local function applyZoom(dt)
	local cam = workspace.CurrentCamera
	if not cam then return end

	-- اینترپولیشن مستقل از فریم‌ریت => بدون پرش و گلیچ
	local alpha = 1 - math.exp(-ZOOM_SMOOTH * dt)
	currentZoom = currentZoom + (targetZoom - currentZoom) * alpha

	local focusPos = cam.Focus.Position
	local rotation = cam.CFrame - cam.CFrame.Position
	cam.CFrame = CFrame.new(focusPos) * rotation * CFrame.new(0, 0, currentZoom)
end

UserInputService.InputChanged:Connect(function(input)
	if not enabled then return end
	if input.UserInputType == Enum.UserInputType.MouseWheel then
		if input.Position.Z > 0 then
			targetZoom = math.clamp(targetZoom / ZOOM_STEP, MIN_ZOOM, MAX_ZOOM)
		else
			targetZoom = math.clamp(targetZoom * ZOOM_STEP, MIN_ZOOM, MAX_ZOOM)
		end
	end
end)

UserInputService.TouchPinch:Connect(function(_, scale, velocity, state)
	if not enabled then return end
	targetZoom = math.clamp(targetZoom - velocity * 0.15, MIN_ZOOM, MAX_ZOOM)
end)

-- ========== منطق NoClip دوربین ==========
local function setNoClip(state)
	enabled = state
	local cam = workspace.CurrentCamera

	if state then
		-- فاصلهٔ فعلی دوربین رو بگیر و زوم پیش‌فرض رو قفل کن تا با زوم ما تداخل نکنه
		currentZoom = (cam.CFrame.Position - cam.Focus.Position).Magnitude
		targetZoom = math.clamp(currentZoom, MIN_ZOOM, MAX_ZOOM)
		currentZoom = targetZoom

		player.DevCameraOcclusionMode = Enum.DevCameraOcclusionMode.Invisicam
		player.CameraMaxZoomDistance = targetZoom
		player.CameraMinZoomDistance = targetZoom

		RunService:BindToRenderStep("NoClipCameraZoom", Enum.RenderPriority.Camera.Value + 1, applyZoom)
	else
		RunService:UnbindFromRenderStep("NoClipCameraZoom")

		player.DevCameraOcclusionMode = ORIGINAL_OCCLUSION
		player.CameraMinZoomDistance = ORIGINAL_MIN_ZOOM
		player.CameraMaxZoomDistance = math.max(ORIGINAL_MAX_ZOOM, currentZoom)
	end

	toggle.Text = state and "ON" or "OFF"
	TweenService:Create(toggle, TweenInfo.new(0.2), {
		BackgroundColor3 = state and Color3.fromRGB(50, 170, 90) or Color3.fromRGB(190, 55, 55),
	}):Play()
end

toggle.MouseButton1Click:Connect(function()
	setNoClip(not enabled)
end)
