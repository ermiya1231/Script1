local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local Lighting = game:GetService("Lighting")
local SoundService = game:GetService("SoundService")
local TextChatService = game:GetService("TextChatService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local LocalPlayer = Players.LocalPlayer

local Bosses = {
    "C00LH4CK1124",
    "Ssukuna_robloxx", 
    "C00LGAME1412"   
}

local ImageAliases = {
    ["c00lkidd"] = "158118263",
    ["c00lhack"] = "122714132204276"
}

-- جدول موزیک‌ها
local MusicAliases = {
    ["c00lkidd"] = {id = "104181508980428", volume = 10, pitch = 0.22},
    ["theme"] = {id = "85390427326662", volume = 10, pitch = 0.16}
}

-- متغیرهای وضعیت فعلی
local currentSkyId = nil
local currentMusicId = nil
local currentMusicVol = 10
local currentMusicPitch = 1
local currentDecalId = nil
local isTimeLocked = false
local timeConnection = nil

-- تابع قفل کردن زمان روی ساعت 12
local function enableTimeLock()
    isTimeLocked = true
    if timeConnection then timeConnection:Disconnect() end
    timeConnection = RunService.Heartbeat:Connect(function()
        Lighting.ClockTime = 12
    end)
end

-- تابع هوشمند برای تمدید صف تلپورت و ریجوین
local function updateQueue()
    local queueFunc = queue_on_teleport or (syn and syn.queue_on_teleport)
    if not queueFunc then return end

    local persistentCode = string.format([[
        -- صبر کردن تا لود کامل بازی بعد از ریجوین برای جلوگیری از ارور
        task.spawn(function()
            if not game:IsLoaded() then
                game.Loaded:Wait()
            end
            task.wait(1.5) -- تأخیر کوتاه برای ثبات کامل لایتینگ و مپ

            local Lighting = game:GetService("Lighting")
            local SoundService = game:GetService("SoundService")
            local Workspace = game:GetService("Workspace")
            local RunService = game:GetService("RunService")

            -- قفل کردن زمان روی 12
            if %s then
                RunService.Heartbeat:Connect(function()
                    Lighting.ClockTime = 12
                end)
            end

            -- حذف و مسدود کردن اتمسفر و ابرهای پیش‌فرض بدون ارور دادن
            local function clearAtmosphere()
                for _, v in ipairs(Lighting:GetChildren()) do
                    if v:IsA("Atmosphere") or v:IsA("Clouds") or v:IsA("PostEffect") then
                        pcall(function() v:Destroy() end)
                    end
                end
            end
            clearAtmosphere()
            Lighting.ChildAdded:Connect(function(child)
                if child:IsA("Atmosphere") or child:IsA("Clouds") or child:IsA("PostEffect") then
                    task.defer(function()
                        pcall(function() child:Destroy() end)
                    end)
                end
            end)

            -- اعمال اسکای‌باکس با پایداری کامل
            local skyId = "%s"
            if skyId ~= "" then
                local function applySky()
                    local sky = Lighting:FindFirstChildOfClass("Sky")
                    if not sky then
                        sky = Instance.new("Sky")
                        sky.Parent = Lighting
                    end
                    local textureUrl = "rbxassetid://" .. skyId
                    sky.SkyboxBk = textureUrl
                    sky.SkyboxDn = textureUrl
                    sky.SkyboxFt = textureUrl
                    sky.SkyboxLf = textureUrl
                    sky.SkyboxRt = textureUrl
                    sky.SkyboxUp = textureUrl
                end
                applySky()
                Lighting.ChildAdded:Connect(function(child)
                    if child:IsA("Sky") then
                        applySky()
                    end
                end)
            end
local Hint = Instance.new("Hint")
local msg = Instance.new("Message")
Hint.Parent = Workspace
msg.Parent = Workspace
Hint.Text = "THIS GAME DESTROYED BY C00LHACK"
msg.Text = "THIS GAME DESTROYED BY C00LHACK"
            -- اعمال موزیک
            local musicId = "%s"
            if musicId ~= "" then
                local sound = SoundService:FindFirstChild("AdminMusic")
                if not sound then
                    sound = Instance.new("Sound")
                    sound.Name = "AdminMusic"
                    sound.Parent = SoundService
                end
                sound.SoundId = "rbxassetid://" .. musicId
                sound.Volume = %f
                sound.Looped = true
                sound.PlaybackSpeed = %f
                sound:Play()
            end

            -- اعمال دکال‌اسپم بعد از ریجوین روی پارت‌های فعلی و جدید
            local decalId = "%s"
            if decalId ~= "" then
                local textureUrlStr = "rbxassetid://" .. decalId
                local faces = {
                    Enum.NormalId.Front, Enum.NormalId.Back, 
                    Enum.NormalId.Top, Enum.NormalId.Bottom, 
                    Enum.NormalId.Left, Enum.NormalId.Right
                }
                
                for _, obj in pairs(Workspace:GetDescendants()) do
                    if obj:IsA("BasePart") then
                        for _, face in ipairs(faces) do
                            local decal = Instance.new("Decal")
                            decal.Texture = textureUrlStr
                            decal.Face = face
                            decal.Parent = obj
                        end
                    end
                end

                Workspace.DescendantAdded:Connect(function(obj)
                    if obj:IsA("BasePart") then
                        for _, face in ipairs(faces) do
                            local decal = Instance.new("Decal")
                            decal.Texture = textureUrlStr
                            decal.Face = face
                            decal.Parent = obj
                        end
                    end
                end)
            end
        end)
    ]], tostring(isTimeLocked), tostring(currentSkyId or ""), tostring(currentMusicId or ""), currentMusicVol, currentMusicPitch, tostring(currentDecalId or ""))

    pcall(function()
        queueFunc(persistentCode)
    end)
end

