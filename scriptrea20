                else
                    idSequence = idSequence .. ("&id=" .. hexPatterns[math.random(#hexPatterns)] .. " | ")
                end
                idSequence = idSequence .. generateNoise()
            end
            if idSequence:sub(-3) == " | " then
                idSequence = idSequence:sub(1, -4)
            end
            return idSequence
