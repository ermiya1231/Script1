    local function GetSoundSource()
        local now = tick()

        -- اسکن حداکثر ۳۰ بار در ثانیه انجام می‌شود.
        if lastScan and now - lastScan < 1 / 30 then
            return audioMeter
        end

        local deltaTime = lastScan and math.max(0, now - lastScan) or (1 / 30)
