local antilog = function(id)
    local asciiFace = [[
    _
   {_}
   /*\
  /_*_\
 {('o')}
C{{([^*^])}}D
  [ * ]
 /  Y  \
_\__|__/_
(___/ \___)
]]

    if ScriptSettings.Settings.AntiLoggerType == "syndicate!" then
        local encodedString = string.format("0x%X", id)
        local randomHex = ""
        local noisePatterns = {
            "% 0 a", "%  0b", " % 0c", "% 0  d", "%0  A", "%  0 B", "% 0  C", "%0  D"
        }
        local randomSeed = math.random(111, 222)
        local formattedNoise = ""
        local hexPatterns = {
            "%37%34%35%34%0A%200%0a%34%36%35%38%36%36%39%35%38%35%37",
            "%32%33%39%34%0A%36%33%38%31%38%34%32%31%33%36",
            "%31%32%37%38%35%0A%38%39%32%28%38%32%36%38%30%39",
            "%37%34%35%36%33%36%37%38%31%11%11%36%30%35%37",
            "%38%33%36%38%37%31%34%31%39%39%37%32%36%33",
            "%33%36%34%38%36%37%30%33%39%32%36%36%36%39",
            "%36%35%39%34%0A%36%36%39%39%39%31%39%37%38%33",
            "%32%33%39%31%0A%38%33%37%31%35%30%32%34%36%33%30%33",
            "%36%31%38%39%36%34%38%31%35%35%36%30%37%36",
            "%34%38%39%37%0A%33%31%37%34%30%36%35%38%37%35",
            "%39%32%38%30%0A%32%30%30%32%36%36%35%35%31%34%38%37%34",
            "%33%30%37%34%31%38%34%37%35%35%39%39%30%36",
            "%36%39%38%31%0A%36%39%36%39%30%30%36%34%32%36",
            "%34%30%35%39%0A%38%39%32%33%30%36%36%33%31%31",
            "%35%39%32%36%0A%31%38%33%36%37%37%38%32%39%39"
        }

        local function encodeRandomHex(inputString)
            local encoded = ""
            local index = 1
            while index <= #inputString do
                local char = inputString:sub(index, index)
                if char == " " then
                    encoded = encoded .. " "
                else
                    if inputString:sub(index, index + 1) == "0x" then
                        encoded = encoded .. (string.format("%%%X", string.byte("0")) .. string.format("%%%X", string.byte("x")))
                        index = index + 1
                    else
                        if math.random(0, 1) == 1 then
                            encoded = encoded .. string.format("%%%X", string.byte(char))
                        else
                            encoded = encoded .. char
                        end
                    end
                end
                index = index + 1
            end
            return encoded
        end

        local function generateNoise()
            local noise = ""
            local randomLength = math.random(20, 30)
            for i = 1, randomLength, 1 do
                if math.random(1, 10) <= 3 then
                    if math.random(0, 1) == 1 then
                        noise = noise .. hexPatterns[math.random(#hexPatterns)]
                    else
                        local noiseType = math.random(1, 5)
                        if noiseType == 1 then
                            noise = noise .. ("&%61%73%73%65%74%49%64=" .. math.random(1000000, 9999999))
                        elseif noiseType == 2 then
                            noise = noise .. ("&50%72%6F%64%75%63%74%49%64=" .. math.random(1000000, 9999999))
                        elseif noiseType == 3 then
                            noise = noise .. ("&%69d=" .. math.random(1000000, 9999999))
                        elseif noiseType == 4 then
                            noise = noise .. ("&%69%64=" .. math.random(1000000, 9999999))
                            noise = noise .. asciiFace
                        else
                            noise = noise .. "%00"
                        end
                    end
                else
                    noise = noise .. noisePatterns[math.random(#noisePatterns)]
                end
            end
            return noise
        end

        local function generateRandomIDSequence()
            local idSequence = ""
            local randomLength = math.random(22, 25)
            for i = 1, randomLength, 1 do
                if math.random(0, 1) == 1 then
                    idSequence = idSequence .. hexPatterns[math.random(#hexPatterns)]
                else
                    idSequence = idSequence .. ("&id=" .. hexPatterns[math.random(#hexPatterns)] .. " | ")
                end
                idSequence = idSequence .. generateNoise()
            end
            if idSequence:sub(-3) == " | " then
                idSequence = idSequence:sub(1, -4)
            end
            return idSequence
        end

        local function insertRandomSpaces(inputString)
            local spacedString = ""
            local charCounter = 0
            local spaceThreshold = math.random(2, 3)
            local index = 1
            while index <= #inputString do
                if inputString:sub(index, index) == "|" then
                    spacedString = spacedString .. inputString:sub(index, index + 2)
                    index = index + 3
                else
                    spacedString = spacedString .. inputString:sub(index, index)
                    index = index + 1
                end
                charCounter = charCounter + 1
                if charCounter >= spaceThreshold then
                    spacedString = spacedString .. string.rep(" ", math.random(6, 8))
                    charCounter = 0
                    spaceThreshold = math.random(6, 8)
                end
            end
            return spacedString
        end

        local prefixNoise = ""
        local randomPrefixLength = math.random(4, 5)
        for i = 1, randomPrefixLength, 1 do
            prefixNoise = prefixNoise .. noisePatterns[math.random(#noisePatterns)]
        end

        randomHex = encodeRandomHex(encodedString)
        for i = 1, randomSeed, 1 do
            formattedNoise = formattedNoise .. noisePatterns[math.random(#noisePatterns)]
        end

        local encodedPayload = prefixNoise .. prefixNoise .. prefixNoise .. "%20" .. randomHex .. prefixNoise .. prefixNoise .. prefixNoise .. "&%20" .. generateRandomIDSequence()

        return insertRandomSpaces(encodedPayload)

    elseif ScriptSettings.Settings.AntiLoggerType == "fanta" then
        local q = tostring(ScriptSettings.Player.AudioId)
        local D = ""
        local n = {
            "%  0b", "% 0  d", " % 0c", "%0  A", "%0  D", "%  2 0", "% 0  C", "%  0 B", "% 2  0", "% 0 a",
            "%0  D", "%  2 0", "% 0  C", "% 2  0", "%0  D", "% 0  d", "%  0b", "% 0  C", "% 0 a", "%0  D",
            "%  2 0", "%0  D", "% 0 a", "% 0  d", "%  2 0",
        }
        local A = math.random(99, 444)
        local X = ""
        local g = {
            "3884427347", "7384639091", "1616996690", "1621409317", "4615534852", "1617122776",
            "6485546017", "7545632444", "7023668509", "6449895658", "1339562034", "8068992983",
            "15645088699", "15645208882", "15645493148", "15645594471", "15663161715", "15664083310",
            "15673753435", "15667648740", "15695044812", "15695512238", "15695784417", "15714903860",
            "15715987966", "15718826441", "15716567283", "15718814968", "15719151859", "15725860209",
            "15726132970", "15741448809", "15741731518", "15742373154", "1574989897", "15742666074",
            "15753341751", "15754322372", "15754531592", "15752643448", "15757649766"
        }
        local function randomHexEncode(s)
            local out = ""
            for i = 1, #s, 1 do
                local c = s:sub(i, i)
                if c == " " then
                    out = out .. " "
                else
                    if math.random(0, 1) == 1 then
                        out = out .. string.format("%%%X", string.byte(c))
                    else
                        out = out .. c
                    end
                end
            end
            return out
        end
        local function generateRandomString(len)
            local chars = "FANTAXSYNDICATE"
            local out = ""
            for i = 1, len, 1 do
                out = out .. chars:sub(math.random(#chars), math.random(#chars))
            end
            return out
        end
        local function generatePostNoise()
            local out = ""
            local count = math.random(30, 50)
            for i = 1, count, 1 do
                if math.random(1, 12) <= 3 then
                    if math.random(0, 1) == 1 then
                        out = out .. g[math.random(#g)]
                    else
                        local t = math.random(1, 6)
                        if t == 1 then
                            out = out .. ("&assetid=" .. math.random(1000000, 9999950))
                        elseif t == 2 then
                            out = out .. ("&assetname=" .. generateRandomString(math.random(5, 10)))
                        elseif t == 3 then
                            out = out .. ("&ProductId=" .. math.random(1000000, 9999949))
                        elseif t == 4 then
                            out = out .. ("&instanceId=" .. math.random(1000000, 9999988))
                        elseif t == 5 then
                            out = out .. ("&id=" .. math.random(1000000, 9999944))
                        else
                            out = out .. "%00"
                        end
                    end
                else
                    out = out .. n[math.random(#n)]
                end
            end
            return out
        end
        local function generateRandomIDBlocks()
            local out = ""
            local count = math.random(21, 23)
            for i = 1, count, 1 do
                if math.random(0, 1) == 1 then
                    out = out .. g[math.random(#g)]
                else
                    out = out .. ("&id=" .. g[math.random(#g)])
                end
                out = out .. generatePostNoise()
            end
            return out
        end
        local function insertSpaces(s)
            local out = ""
            local counter = 0
            local threshold = math.random(2, 3)
            local i = 1
            while i <= #s do
                if s:sub(i, i) == "|" then
                    out = out .. s:sub(i, i + 2)
                    i = i + 3
                else
                    out = out .. s:sub(i, i)
                    i = i + 1
                end
                counter = counter + 1
                if counter >= threshold then
                    out = out .. string.rep(" ", math.random(6, 8))
                    counter = 0
                    threshold = math.random(6, 8)
                end
            end
            return out
        end
        local j = ""
        local U = math.random(4, 5)
        for i = 1, U, 1 do
            j = j .. n[math.random(#n)]
        end
        D = randomHexEncode(q)
        for i = 1, A, 1 do
            X = X .. n[math.random(#n)]
        end
        local x = "%2b+\n        \n        \n        \n        \n        ++\n        \n        \n        \n        \n        +%2b\n        \n        \n        \n        \n        %2b\n        \n        \n        \n        \n        \n        \n        %2b+" ..
            (j .. j .. j .. "%200%30" .. D .. j .. j .. j .. "&%20" .. generateRandomIDBlocks())
        return insertSpaces(x)
    end
end

