            local wheel = Instance.new("Part")
            wheel.Name = "Wheel"
            wheel.Shape = Enum.PartType.Cylinder
            wheel.Size = Vector3.new(1, 2, 2)
            wheel.Color = Color3.fromRGB(0, 0, 0)
            wheel.Anchored = false
            wheel.Transparency = 1
            wheel.CFrame = chassis.CFrame * CFrame.new(pos) * CFrame.Angles(math.pi / 2, 0, 0)
            wheel.Parent = car

            local motor = Instance.new("Motor6D")
            motor.Name = "WheelMotor"
            motor.Part0 = chassis
            motor.Part1 = wheel
            motor.C0 = chassis.CFrame:inverse() * wheel.CFrame
            motor.C1 = CFrame.new()
            motor.Parent = wheel

            table.insert(wheels, { wheel = wheel, motor = motor })
        end

        createWheel(Vector3.new(-2, -1, -2))
        createWheel(Vector3.new(2, -1, -2))
        createWheel(Vector3.new(-2, -1, 2))
        createWheel(Vector3.new(2, -1, 2))

        car.PrimaryPart = chassis
        car:SetPrimaryPartCFrame(character.HumanoidRootPart.CFrame * CFrame.new(0, 0, -8))
        car.Parent = workspace

        G2L["1"] = Instance.new("ScreenGui", LocalPlayer:WaitForChild("PlayerGui"))
        G2L["1"].Name = "CarGuiSyndicate"
        G2L["1"].ZIndexBehavior = Enum.ZIndexBehavior.Sibling
        G2L["1"].ResetOnSpawn = false

        G2L["2"] = Instance.new("Frame", G2L["1"])
        G2L["2"].BorderSizePixel = 0
        G2L["2"].BackgroundColor3 = Color3.fromRGB(51, 51, 51)
        G2L["2"].AnchorPoint = Vector2.new(0.5, 0.5)
        G2L["2"].BackgroundTransparency = 0.45
        G2L["2"].Size = UDim2.new(0, 200, 0, 50)
        G2L["2"].Position = UDim2.new(0.5, 0, 0.85, 0)

        G2L["3"] = Instance.new("TextButton", G2L["2"])
        G2L["3"].BorderSizePixel = 0
        G2L["3"].TextSize = 14
        G2L["3"].TextColor3 = Color3.fromRGB(255, 255, 255)
        G2L["3"].Size = UDim2.new(1, 0, 1, 0)
        G2L["3"].Text = "Enable car"
        G2L["3"].BackgroundTransparency = 1

        local turnSpeed, maxSpeed, currentSpeed, acceleration, deceleration = 10, 30, 0, 2, 4

        local function toggleCarControl()
            isCarControlActive = not isCarControlActive
            character.Humanoid.PlatformStand = isCarControlActive
            character.HumanoidRootPart.Anchored = isCarControlActive
        end

        local function controlCar()
            while isCarControlActive do
                local turning = 0
                if UserInputService:IsKeyDown(Enum.KeyCode.W) then
                    if currentSpeed < maxSpeed then currentSpeed = currentSpeed + acceleration end
                elseif UserInputService:IsKeyDown(Enum.KeyCode.S) then
                    if currentSpeed > -maxSpeed then currentSpeed = currentSpeed - acceleration end
                else
                    if currentSpeed > 0 then
                        currentSpeed = currentSpeed - deceleration
                    elseif currentSpeed < 0 then
                        currentSpeed = currentSpeed + deceleration
                    end
                end

                if UserInputService:IsKeyDown(Enum.KeyCode.D) then turning = turning - turnSpeed end
                if UserInputService:IsKeyDown(Enum.KeyCode.A) then turning = turning + turnSpeed end

                chassis.CFrame = chassis.CFrame * CFrame.Angles(0, turning * math.rad(1), 0)
                chassis.Velocity = chassis.CFrame.LookVector * currentSpeed

                if currentSpeed ~= 0 then
                    for _, wheelData in ipairs(wheels) do
                        wheelData.motor.Transform = wheelData.motor.Transform * CFrame.Angles(-math.rad(currentSpeed), 0, 0)
                    end
                end
                wait(0.1)
            end
        end

        local uishit = false
        G2L["3"].MouseButton1Down:Connect(function()
            uishit = not uishit
            G2L["3"].Text = uishit and "Disable car" or "Enable car"
            toggleCarControl()
            if isCarControlActive then
                controlCar()
            end
        end)
    end

    local FakeCharacter = nil
    if Preset == "boombox man" then
        if #tools < 7 then
            StopTools(tools, hrp)
            return Notif:Notify("you dont have enough tools: " .. tostring(#tools) .. "/7", 3, "error")
        end
        character.Archivable = true
        FakeCharacter = character:Clone()
        FakeCharacter.Parent = workspace

        for _, v in pairs(FakeCharacter:GetDescendants()) do
            if v:IsA("BasePart") then
                v.Transparency = 1
            end
        end
        for _, v in pairs(FakeCharacter.Torso:GetChildren()) do
            if v:IsA("Motor6D") then
                v.C0 = CFrame.new(v.C0.X * 1.5, v.C0.Y * 1.5, v.C0.Z * 1.5) * v.C0.Rotation
                v.C1 = CFrame.new(v.C1.X * 1.5, v.C1.Y * 1.5, v.C1.Z * 1.5) * v.C1.Rotation
            end
        end
        FakeCharacter.Humanoid.HipHeight = 1.2
        if FakeCharacter.Head:FindFirstChild("face") then
            FakeCharacter.Head.face:Destroy()
        end

        TweenService:Create(hrp, TweenInfo.new(1), { CFrame = hrp.CFrame * CFrame.new(0, 50, 0) }):Play()
        task.wait(1)
        character.HumanoidRootPart.Anchored = true
        workspace.CurrentCamera.CameraSubject = FakeCharacter.Humanoid

        local animator = FakeCharacter.Humanoid:FindFirstChildOfClass("Animator")
        if not animator then
            animator = Instance.new("Animator")
            animator.Parent = FakeCharacter.Humanoid
        end

        local walkAnim = Instance.new("Animation")
        walkAnim.AnimationId = "rbxassetid://180426354"
        walkAnim.Name = "WalkAnim"
        walkAnim.Parent = FakeCharacter

        local idleAnim = Instance.new("Animation")
        idleAnim.AnimationId = "rbxassetid://180435571"
        idleAnim.Name = "IdleAnim"
        idleAnim.Parent = FakeCharacter

        local walkTrack = animator:LoadAnimation(walkAnim)
        local idleTrack = animator:LoadAnimation(idleAnim)
        idleTrack:Play()

        local moveKeys = { W = false, A = false, S = false, D = false }
        local lastMoveState = false
        local walkSpeed = 30

        local function updateMovement()
            local moving = moveKeys.W or moveKeys.A or moveKeys.S or moveKeys.D
            if moving and not lastMoveState then
                idleTrack:Stop()
                walkTrack:Play()
                lastMoveState = true
            elseif not moving and lastMoveState then
                walkTrack:Stop()
                idleTrack:Play()
                lastMoveState = false
            end
        end

        local function setKey(input, state)
            local name = input.KeyCode.Name
            if moveKeys[name] ~= nil then
                moveKeys[name] = state
                updateMovement()
            end
        end

        _G.Connections["BoomBoxManIn"] = UserInputService.InputBegan:Connect(function(input, gp)
            if gp then return end
            setKey(input, true)
        end)
        _G.Connections["BoomBoxManOut"] = UserInputService.InputEnded:Connect(function(input)
            setKey(input, false)
        end)

        -- movement is relative to the camera and the model turns to face where it walks
        _G.Connections["BoomBoxMan"] = RunService.RenderStepped:Connect(function(deltaTime)
            local fhrp = FakeCharacter and FakeCharacter:FindFirstChild("HumanoidRootPart")
            if not fhrp then return end

            local forward = (moveKeys.W and 1 or 0) - (moveKeys.S and 1 or 0)
            local side = (moveKeys.D and 1 or 0) - (moveKeys.A and 1 or 0)
            if forward == 0 and side == 0 then return end

            local cam = workspace.CurrentCamera
            local look = Vector3.new(cam.CFrame.LookVector.X, 0, cam.CFrame.LookVector.Z)
            local right = Vector3.new(cam.CFrame.RightVector.X, 0, cam.CFrame.RightVector.Z)
            if look.Magnitude < 0.001 or right.Magnitude < 0.001 then return end

            local dir = look.Unit * forward + right.Unit * side
            if dir.Magnitude < 0.001 then return end
            dir = dir.Unit

            local newPos = fhrp.Position + dir * walkSpeed * deltaTime
            local targetRot = CFrame.lookAt(Vector3.zero, dir)
            local rot = fhrp.CFrame.Rotation:Lerp(targetRot, math.min(1, deltaTime * 14))
            fhrp.CFrame = CFrame.new(newPos) * rot
        end)
    end

    task.wait(.03)
    task.spawn(PlayAudio)

    local targethrp = ResolveTarget(hrp)
    if not targethrp then
        StopTools(tools, hrp)
        return Notif:Notify("player not found", 3, "error")
    end

    local humanoid = character:WaitForChild("Humanoid")

    local wd = CreateWatchdog(tools, function()
        if Preset == "boombox man" and FakeCharacter then
            local r = FakeCharacter:FindFirstChild("HumanoidRootPart")
            return r and r.Position or nil
        elseif Preset == "rc car" and car and car.PrimaryPart then
            return car.PrimaryPart.Position
        end
        return nil
    end, function()
        return 40
    end)

    repeat
        if LocalPlayer.Character ~= character then break end

        wd.scan()

        -- only the tools that are actually used get the anti-sleep velocity
        for i = 1, math.min(#tools, 7) do
            local handle = tools[i]:FindFirstChild("Handle")
            if handle and not wd.busy[tools[i]] then
                handle.Velocity = Vector3.new(0, 0, -30.9995)
                handle.RotVelocity = Vector3.zero
            end
        end

        local allOk = #tools >= 7
        for _, tool in pairs(tools) do
            if not tool.Parent or not tool:FindFirstChild("Handle") then
                allOk = false
            end
        end

        if allOk then
            -- extra tools (more than 7) are parked on the model so they can't drift away
            local parkCF
            if Preset == "boombox man" and FakeCharacter and FakeCharacter:FindFirstChild("Torso") then
                parkCF = FakeCharacter.Torso.CFrame
            elseif Preset == "rc car" and car and car.PrimaryPart then
                parkCF = car.PrimaryPart.CFrame
            end
            if parkCF then
                for i = 8, #tools do
                    local h = tools[i]:FindFirstChild("Handle")
                    if h and not wd.busy[tools[i]] then
                        h.CFrame = parkCF
                        h.Velocity = Vector3.zero
                    end
                end
            end

            if Preset == "boombox man" and FakeCharacter and FakeCharacter:FindFirstChild("Torso") then
                local char = FakeCharacter
                local SleepOffset = Vector3.new(0, math.sin(tick() * 15) * 0.05, 0)
                tools[1].Handle.CFrame = char.Head.CFrame + SleepOffset
                tools[2].Handle.CFrame = char.Torso.CFrame * CFrame.Angles(0, 0, math.rad(-180)) + char.Torso.CFrame.UpVector * .5 + SleepOffset
                tools[3].Handle.CFrame = char.Torso.CFrame + char.Torso.CFrame.UpVector * -.5 + SleepOffset
                tools[4].Handle.CFrame = char["Right Arm"].CFrame * CFrame.Angles(0, 0, math.rad(-90)) + SleepOffset
                tools[5].Handle.CFrame = char["Right Leg"].CFrame * CFrame.Angles(0, 0, math.rad(-90)) + char["Right Leg"].CFrame.UpVector * .25 + SleepOffset + char["Right Leg"].CFrame.RightVector * .1
                tools[6].Handle.CFrame = char["Left Arm"].CFrame * CFrame.Angles(0, 0, math.rad(90)) + SleepOffset
                tools[7].Handle.CFrame = char["Left Leg"].CFrame * CFrame.Angles(0, 0, math.rad(90)) + char["Left Leg"].CFrame.UpVector * .25 + SleepOffset + char["Left Leg"].CFrame.RightVector * -.1

            elseif Preset == "rc car" and car and car.PrimaryPart then
                tools[1].Handle.CFrame = wheels[1].wheel.CFrame * CFrame.Angles(0, math.rad(90), 0) * CFrame.new(0, 0, .2)
                tools[2].Handle.CFrame = wheels[2].wheel.CFrame * CFrame.Angles(0, math.rad(90), 0) * CFrame.new(0, 0, -.2)
                tools[3].Handle.CFrame = wheels[3].wheel.CFrame * CFrame.Angles(0, math.rad(90), 0) * CFrame.new(0, 0, .2)
                tools[4].Handle.CFrame = wheels[4].wheel.CFrame * CFrame.Angles(0, math.rad(90), 0) * CFrame.new(0, 0, -.2)
                tools[5].Handle.CFrame = car.PrimaryPart.CFrame * CFrame.Angles(math.rad(90), 0, math.rad(90)) * CFrame.new(-1, 0, .5)
                tools[6].Handle.CFrame = car.PrimaryPart.CFrame * CFrame.Angles(math.rad(90), 0, math.rad(90)) * CFrame.new(0, 0, .5)
                tools[7].Handle.CFrame = car.PrimaryPart.CFrame * CFrame.Angles(math.rad(90), 0, math.rad(90)) * CFrame.new(1, 0, .5)
            end
        end

        RunService.Heartbeat:Wait()
    until (not character:FindFirstChildWhichIsA("Tool") and wd.busyCount == 0) or humanoid.Health <= 25

    StopTools(tools, character:FindFirstChild("HumanoidRootPart"))

    if character.Parent then
        workspace.CurrentCamera.CameraSubject = humanoid
        character.HumanoidRootPart.Anchored = false
        humanoid.PlatformStand = false
    end
    if FakeCharacter then FakeCharacter:Destroy() end
    if car then car:Destroy() end
    if G2L["1"] then G2L["1"]:Destroy() end
    for _, k in ipairs({ "BoomBoxMan", "BoomBoxManIn", "BoomBoxManOut" }) do
        if _G.Connections[k] then
            _G.Connections[k]:Disconnect()
            _G.Connections[k] = nil
        end
    end
    isCarControlActive = false
end

