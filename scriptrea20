local function getSounds(tool)
    local list = {}
    for _, d in ipairs(tool:GetDescendants()) do
        if d:IsA("Sound") then table.insert(list, d) end
    end
    return list
end

-- Only the boombox's own remote: direct RemoteEvent first, then any RemoteEvent that isn't obviously something else
local function getRemotes(tool)
    local direct = tool:FindFirstChildOfClass("RemoteEvent")
    if direct then return { direct } end
    for _, d in ipairs(tool:GetDescendants()) do
        if d:IsA("RemoteEvent") then
            local n = d.Name:lower()
            if not (n:find("slap") or n:find("hit") or n:find("damage") or n:find("attack")) then
                return { d }
            end
        end
    end
    return {}
end

local function isAudioTool(tool)
    return tool:IsA("Tool") and tool:FindFirstChild("Handle") ~= nil and isBoombox(tool)
end

local function EquipAudioTools()
    local character, backpack = GetLPlrImportant()
    if not character then return end
    for _, t in ipairs(backpack:GetChildren()) do
        if isAudioTool(t) then
            t.Parent = character
        end
    end
end

local function sendTo(tool, kind, id, pitch)
    local isSpecial = game.PlaceId == 138900085453390
    local payload
    if kind == "obfuscated" then
        if isSpecial then
            payload = "+" .. string.rep("0", math.random(1500, 2500)) .. tostring(id)
        else
            payload = antilog(id)
        end
    else
        payload = tostring(id)
    end

    if isSpecial then
        local pa = tool:FindFirstChild("PlayAudio")
        if pa and pa:IsA("RemoteFunction") then
            task.spawn(function()
                pcall(function() pa:InvokeServer("PlayAudio", payload, pitch, "0", "0") end)
            end)
        end
        return
    end

    for _, remote in ipairs(getRemotes(tool)) do
        task.spawn(function()
            pcall(function()
                remote:FireServer("PlaySong", payload, pitch)
            end)
        end)
    end
end

local function confirmed(tool, id)
    for _, snd in ipairs(getSounds(tool)) do
        if tostring(snd.SoundId):find(tostring(id), 1, true) then
            return true
        end
    end
    return false
end

-- Returns true if every audio tool confirmed the new song
local PlayAudio = function()
    local character = GetLPlrImportant()
    if not character then
        Notif:Notify("character not loaded", 3, "error")
        return false
    end

    local id = ScriptSettings.Player.AudioId
    if not id then
        Notif:Notify("invalid audio id", 3, "error")
        return false
    end
    local pitch = ScriptSettings.Player.Pitch or 1

    local pending = {}
    for _, t in ipairs(character:GetChildren()) do
        if isAudioTool(t) then table.insert(pending, t) end
    end
    if #pending == 0 then
        Notif:Notify("no boombox equipped", 3, "error")
        return false
    end
    local total = #pending

    local mode = ScriptSettings.Player.Mode or "Auto"
    local kinds = (mode == "Auto") and { "obfuscated", "plain" } or { string.lower(mode) }

    for _, kind in ipairs(kinds) do
        for _, tool in ipairs(pending) do
            sendTo(tool, kind, id, pitch)
        end
        task.wait(0.8)
        local failed = {}
        for _, tool in ipairs(pending) do
            if not confirmed(tool, id) then
                table.insert(failed, tool)
            end
        end
        pending = failed
        if #pending == 0 then break end
    end

    if #pending > 0 then
        Notif:Notify((total - #pending) .. "/" .. total .. " boomboxes confirmed the song", 4, "error")
        return false
    end
    Notif:Notify("playing " .. tostring(id) .. " on " .. total .. " boombox(es)", 3, "success")
    return true
end

-- Restarts every equipped audio tool at the same instant
local SyncAudio = function()
    local character = GetLPlrImportant()
    if not character then return end
    local sounds = {}
    for _, t in ipairs(character:GetChildren()) do
        if t:IsA("Tool") and isAudioTool(t) then
            for _, snd in ipairs(getSounds(t)) do
                table.insert(sounds, snd)
            end
        end
    end
    if #sounds == 0 then
        return Notif:Notify("no sounds to sync", 3, "error")
    end
    RunService.Heartbeat:Wait()
    for _, snd in ipairs(sounds) do
        snd.TimePosition = 0
    end
    for _, snd in ipairs(sounds) do
        if not snd.IsPlaying and snd.SoundId ~= "" then
            snd:Play()
        end
    end
    Notif:Notify("synced " .. #sounds .. " sound(s)", 3, "success")
end

