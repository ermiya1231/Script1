                local wingCount = 2   -- Number of wings (2 for left and right)
                
                -- Flapping animation parameters
                local flapSpeed = ScriptSettings.Visualizer.Speed or 1
                local flapIntensity = 2.0  -- How dramatic the flap is
                local flapPhase = tick() * flapSpeed
                
                -- Current flap state (0-1 value representing flap position)
                local flapProgress = (math.sin(flapPhase) + 1) / 2  -- Normalize to 0-1
                
                -- Calculate wing position (alternates between left and right wings)
                local wingSide = index % wingCount == 0 and 1 or -1  -- 1 for right, -1 for left
                local wingIndex = math.floor((index - 1) / wingCount) + 1  -- Which row in the wing
                
                -- Total tools per wing
                local toolsPerWing = math.ceil(#tools / wingCount)
                
                -- Wing formation calculations with flapping
                local normalizedPosition = wingIndex / toolsPerWing  -- 0 to 1 from center to tip
                
                -- X position (side to side)
                local x = wingSide * wingSpan * normalizedPosition
                
                -- Y position - tips move more than center
                local flapAmount = flapIntensity * (1 - math.cos(normalizedPosition * math.pi)) * (flapProgress - 0.5)
                local y = baseHeight + flapAmount
                
                -- Z position (depth)
                local z = wingDepth - (normalizedPosition * 0.5)  -- Slightly deeper at tips
                
                -- Add slight wing folding effect during upstroke
                if flapProgress > 0.5 then
                    x = x * (1.1 - (flapProgress - 0.5) * 0.2)
                end
                
                -- Position relative to chest
                local offset = Vector3.new(x, y, z)
                local worldPosition = chest.CFrame:PointToWorldSpace(offset)
                
                -- Apply position and rotation
                handle.Position = worldPosition
                
                -- Make tools angle according to flap position
                local angleFactor = (normalizedPosition * 2 - 1) * flapAmount * 0.5
                local targetLook = chest.Position + Vector3.new(0, angleFactor, 0)
                gyro.CFrame = CFrame.new(handle.Position, targetLook)
            end
