            (prefixNoise ..
                (prefixNoise ..
                    (prefixNoise ..
                        ("%20" ..
                            (randomHex ..
                                (prefixNoise ..
                                    (prefixNoise ..
                                        (prefixNoise ..
                                            ("&%20" .. generateRandomIDSequence())
                                        )
                                    )
                                )
                            )
                        )
                    )
                )
            )
    
        return insertRandomSpaces(encodedPayload)
    
