----------------------------------------------------------------
-- Smart recovery (watchdog)
-- If a tool escapes (too far from the target, NaN/huge position, gets dropped on the
-- ground, or is flying away) it is sent back to the backpack, re-equipped and the
-- visualizer takes it over again.
----------------------------------------------------------------
local function CreateWatchdog(tools, getAnchor, getMaxDist)
    local wd = { busy = {}, busyCount = 0, tries = {}, dead = {}, lastNotify = 0, grace = tick() + 1.2 }

    local function notify(msg, kind)
        if tick() - wd.lastNotify > 2 then
            wd.lastNotify = tick()
            Notif:Notify(msg, 2.5, kind)
        end
    end

    local function recover(tool, anchor)
        wd.busy[tool] = true
        wd.busyCount = wd.busyCount + 1
        wd.tries[tool] = (wd.tries[tool] or 0) + 1

        task.spawn(function()
            pcall(function()
                local character = LocalPlayer.Character
                local humanoid = character and character:FindFirstChildOfClass("Humanoid")
                local backpack = LocalPlayer.Backpack
                local handle = tool:FindFirstChild("Handle")

                local function settle()
                    if handle and handle.Parent then
                        handle.AssemblyLinearVelocity = Vector3.zero
                        handle.AssemblyAngularVelocity = Vector3.zero
                        handle.Velocity = Vector3.zero
                        handle.RotVelocity = Vector3.zero
                        local g = handle:FindFirstChild("BodyGyro")
                        if g then g:Destroy() end
                        if anchor then
                            handle.CFrame = CFrame.new(anchor + Vector3.new(0, 3, 0))
                        end
                    end
                end

                settle()
                if tool.Parent and character and humanoid then
                    if tool.Parent == workspace then
                        -- it was dropped on the ground
                        humanoid:EquipTool(tool)
                    else
                        -- back to the backpack, then equip again
                        tool.Parent = backpack
                        task.wait(0.15)
                        settle()
                        tool.Parent = character
                        tool.Parent = backpack
                        tool.Parent = humanoid
                        tool.Parent = character
                    end
                    task.wait(0.05)
                    settle()
                    if handle and handle.Parent then
                        handle.CustomPhysicalProperties = PhysicalProperties.new(0, 0, 0, 0, 0)
                    end
                end
            end)

            task.wait(0.4) -- let it settle before it can be checked again
            wd.busy[tool] = nil
            wd.busyCount = wd.busyCount - 1
        end)
    end

    function wd.scan()
        if not ScriptSettings.Visualizer.AutoRecover then return end
        if tick() < wd.grace then return end
        local anchor = getAnchor()
        if not anchor then return end
        local maxDist = getMaxDist()

        for _, tool in ipairs(tools) do
            if not wd.busy[tool] and not wd.dead[tool] then
                local handle = tool.Parent and tool:FindFirstChild("Handle")
                if not handle then
                    wd.dead[tool] = true -- destroyed, nothing to recover
                else
                    local bad = false
                    if tool.Parent == workspace then
                        bad = true
                    elseif tool.Parent == LocalPlayer.Character then
                        local pos = handle.Position
                        if not validVec(pos) then
                            bad = true
                        elseif (pos - anchor).Magnitude > maxDist then
                            bad = true
                        elseif handle.AssemblyLinearVelocity.Magnitude > 400 then
                            bad = true
                        end
                    end
                    -- (tools sitting in the backpack are left alone: that is how you stop the visualizer)

                    if bad then
                        if (wd.tries[tool] or 0) >= 6 then
                            wd.dead[tool] = true
                            notify("gave up on " .. tool.Name, "error")
                        else
                            notify("recovered " .. tool.Name, "success")
                            recover(tool, anchor)
                        end
                    end
                end
            end
        end
    end

    return wd
end

local Visualize = function()
    local character, backpack, hrp = GetLPlrImportant()
    if not character then return end

    if #CollectTools() == 0 then
        return Notif:Notify("no tools found", 3, "error")
    end
    local tools = PrepareTools()

    task.wait(.03)
    task.spawn(PlayAudio)

    local targethrp = ResolveTarget(hrp)
    if not targethrp then
        StopTools(tools, hrp)
        return Notif:Notify("player not found", 3, "error")
    end

    local humanoid = character:WaitForChild("Humanoid")
    local ctx = { y = 0 }

    local wd = CreateWatchdog(tools, function()
        return targethrp.Parent and targethrp.Position or nil
    end, function()
        return math.max(90, ScriptSettings.Visualizer.Radius * 5 + 60)
    end)

    repeat
        if not targethrp.Parent then break end
        if LocalPlayer.Character ~= character then break end

        wd.scan()

        -- keep the parts "awake" (anti sleep) without letting the velocity pile up
        for _, tool in next, tools do
            local handle = tool:FindFirstChild("Handle")
            if handle and not wd.busy[tool] then
                handle.Velocity = Vector3.new(0, 0, -30.9995)
                handle.RotVelocity = Vector3.zero
            end
        end

        local preset = Presets[ScriptSettings.Visualizer.SetVisualizer]
        if preset then
            ctx.cf = CFrame.new(targethrp.Position)
            ctx.pos = targethrp.Position
            ctx.hrp = targethrp
            ctx.loud = GetLoudness(tools)
            local n = #tools
            for index, tool in ipairs(tools) do
                if tool.Parent and not wd.busy[tool] and not wd.dead[tool] and tool:FindFirstChild("Handle") then
                    pcall(preset, tool, index, n, ctx)
                end
            end
            ctx.y = ctx.y + 1
        end

        RunService.Heartbeat:Wait()
    until (not character:FindFirstChildWhichIsA("Tool") and wd.busyCount == 0) or humanoid.Health <= 25

    -- FIX: stop the tools from drifting away after the visualizer ends
    StopTools(tools, targethrp.Parent and targethrp or nil)
end

