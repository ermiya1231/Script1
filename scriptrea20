-- ctx = { cf = CFrame at target, pos = Vector3, loud = loudness, y = counter }
local J = 1 -- radius is now in real studs

local function placeOnCurve(tool, ctx, x, y, z)
    local A = tool:FindFirstChild("Handle")
    if not A then return end
    local p = (ctx.cf * CFrame.new(x * J, y * J, z * J)).Position
    if not validVec(p) then return end
    A.Position = p
    if (p - ctx.pos).Magnitude > 0.01 then
        Gyro(A).CFrame = CFrame.new(p, ctx.pos)
    end
end

local function curvePreset(fn, speedMul)
    return function(tool, index, n, ctx)
        local u = math.rad(tick() * ScriptSettings.Visualizer.Speed * (speedMul or 20) + index * (360 / n))
        local x, y, z = fn(u, ScriptSettings.Visualizer.Radius, index)
        placeOnCurve(tool, ctx, x, y, z)
    end
end

local Presets = {}

local function reactiveCircle(radiusMode)
    return function(tool, index, n, ctx)
        local A = tool:FindFirstChild("Handle")
        if not A then return end
        local j = radiusMode and (ScriptSettings.Visualizer.Radius / 5) or (ctx.loud / 150)
        local d = tick() * ScriptSettings.Visualizer.Speed * 20
        local u = math.rad(d + index * (360 / n))
        local p = (ctx.cf * CFrame.new(
            (math.cos(u) * 5) * j,
            math.sin(math.deg(tick() / 7 + ((index * n) / math.max(0.1, 5)) / 360)) * 2,
            (math.sin(u) * 5) * j
        )).Position
        if not validVec(p) then return end
        A.Position = p
        if (p - ctx.pos).Magnitude > 0.01 then
            Gyro(A).CFrame = CFrame.new(p, ctx.pos)
        end
    end
end

Presets["circle (reactive)"] = reactiveCircle(false)
Presets["sine wave"] = reactiveCircle(true)

Presets["halo (visualizer)"] = function(tool, index, n, ctx)
    local A = tool:FindFirstChild("Handle")
    if not A then return end
    local b = ctx.loud
    local w = b / 150
    local targetYOffset = math.clamp(b / 1000, 0, 1) * 4 - 2
    local currentYOffset = A.CFrame.Position.Y - ctx.pos.Y
    if currentYOffset ~= currentYOffset or math.abs(currentYOffset) > 50 then currentYOffset = 0 end
    local smoothed = currentYOffset + (targetYOffset - currentYOffset) * 0.1
    local p = ((ctx.cf * CFrame.Angles(0, math.rad(ctx.y + index * (360 / n)), 0)) * CFrame.new(0, smoothed, ScriptSettings.Visualizer.Radius + w / 3)).Position
    if not validVec(p) then return end
    A.CFrame = CFrame.new(p, ctx.pos + Vector3.new(0, smoothed, 0))
end

Presets["wings (reactive)"] = function(tool, index, n, ctx)
    local handle = tool:FindFirstChild("Handle")
    if not handle then return end
    local gyro = Gyro(handle)
    local b = ctx.loud
    local pc = math.clamp(0.5 * (b / 400), 0.1, 1)
    local hs = 2 / (pc + 1)
    local xOffset, yOffset
    if index == 1 then
        xOffset = ((n + 1) - (n / 2)) * hs
        yOffset = pc * ((n + 1) - (n / 2)) ^ 2
    else
        xOffset = (index - (n / 2)) * hs
        yOffset = pc * (index - (n / 2)) ^ 2
    end
    local cf = ctx.hrp.CFrame * CFrame.new(xOffset, yOffset, 1)
    if not validVec(cf.Position) then return end
    handle.CFrame = cf
    gyro.CFrame = CFrame.new(handle.Position, ctx.pos)
end

Presets["wave wings"] = function(tool, index, n, ctx)
    local handle = tool:FindFirstChild("Handle")
    if not handle then return end
    local gyro = Gyro(handle)
    local distanceBehind, verticalSpacing, horizontalSpacing, outwardSpacing = -0.5, 1.5, 2, -1
    local line = (index % 2 == 0) and 1 or -1
    local row = math.floor((index + 1) / 2)
    local xOffset = line * horizontalSpacing - (line * outwardSpacing * row)
    local yOffset = row * verticalSpacing
    local zOffset = -distanceBehind - row * outwardSpacing
    handle.CFrame = ctx.hrp.CFrame * CFrame.new(xOffset, yOffset, zOffset)
    local rot = math.rad(30 * math.sin(tick() * 4 + index * (360 / n)))
    handle.CFrame = handle.CFrame * CFrame.Angles(0, rot, 0)
    gyro.CFrame = CFrame.new(handle.Position, ctx.pos)
end

Presets["backpack"] = function(tool, index, n, ctx)
    local handle = tool:FindFirstChild("Handle")
    if not handle then return end
    local gyro = Gyro(handle)
    handle.CFrame = (ctx.hrp.CFrame * CFrame.new(0, 0, 0.8)) * CFrame.Angles(0, math.rad(180), 0)
    local rot = math.rad(30 * math.sin(tick() * 4 + (360 / n)))
    handle.CFrame = handle.CFrame * CFrame.Angles(0, 0, rot)
    gyro.CFrame = CFrame.new(handle.Position, ctx.pos)
end

Presets["REVAMPED WINGS - Emo Caine"] = function(tool, index, n, ctx)
    local handle = tool:FindFirstChild("Handle")
    if not handle then return end
    local gyro = handle:FindFirstChild("BodyGyro") or Instance.new("BodyGyro")
    gyro.P = 10000
    gyro.D = 1000
    gyro.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
    gyro.Parent = handle

    local wingSpan = ScriptSettings.Visualizer.Radius or 5
    local baseHeight, wingDepth, wingCount = 0.6, 2, 2
    local flapSpeed = ScriptSettings.Visualizer.Speed or 1
    local flapIntensity = 2.0
    local flapProgress = (math.sin(tick() * flapSpeed) + 1) / 2

    local wingSide = index % wingCount == 0 and 1 or -1
    local wingIndex = math.floor((index - 1) / wingCount) + 1
    local toolsPerWing = math.ceil(n / wingCount)
    local np = wingIndex / toolsPerWing

    local x = wingSide * wingSpan * np
    local flapAmount = flapIntensity * (1 - math.cos(np * math.pi)) * (flapProgress - 0.5)
    local y = baseHeight + flapAmount
    local z = wingDepth - (np * 0.5)
    if flapProgress > 0.5 then
        x = x * (1.1 - (flapProgress - 0.5) * 0.2)
    end

    local worldPosition = ctx.hrp.CFrame:PointToWorldSpace(Vector3.new(x, y, z))
    if not validVec(worldPosition) then return end
    handle.Position = worldPosition
    local angleFactor = (np * 2 - 1) * flapAmount * 0.5
    gyro.CFrame = CFrame.new(handle.Position, ctx.pos + Vector3.new(0, angleFactor, 0))
end

Presets["lemniscate"] = curvePreset(function(u, R)
    return R * math.sin(u), 2 * math.sin(2 * u), R * math.cos(u)
end)
Presets["figure-8"] = curvePreset(function(u, R)
    return R * math.sin(u), 3 * math.cos(u), R * math.sin(2 * u)
