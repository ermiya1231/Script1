    if game.PlaceId == 138900085453390 then
        local audiostring = tostring(ScriptSettings.Player.AudioId)
        local a= string.rep("0", math.random(1500, 2500))
        local b = "+" .. (a .. audiostring)


        for index, tool in next, character:GetChildren() do
            if tool:IsA("Tool") and tool:FindFirstChild("PlayAudio") then
                tool.PlayAudio:InvokeServer("PlayAudio", b, pitch, "0", "0")
            end
        end

    else
        audio = antilog(ScriptSettings.Player.AudioId)
        for index, tool in next, character:GetChildren() do
