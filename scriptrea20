local GetLPlrImportant = function()
    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
        return LocalPlayer.Character, LocalPlayer.Backpack, LocalPlayer.Character.HumanoidRootPart
    end
end

local function isBoombox(tool)
    return tool.Name:lower():find("boom") ~= nil
end

-- Collects ALL tools that have a Handle (boomboxes first, so tools[1] is always a boombox if you have one)
local function CollectTools()
    local character, backpack = GetLPlrImportant()
    local list = {}
    for _, container in ipairs({ backpack, character }) do
        for _, t in ipairs(container:GetChildren()) do
            if t:IsA("Tool") and t:FindFirstChild("Handle") then
                if ScriptSettings.Visualizer.ToolMode ~= "Only Boombox" or isBoombox(t) then
                    table.insert(list, t)
                end
            end
        end
    end
    table.sort(list, function(a, b)
        local ba, bb = isBoombox(a), isBoombox(b)
        if ba ~= bb then return ba end
        return a.Name < b.Name
    end)
    return list
end

local function GetLoudness(tools)
    for _, t in ipairs(tools) do
        if isBoombox(t) then
            local h = t:FindFirstChild("Handle")
            local s = h and h:FindFirstChildWhichIsA("Sound")
            if s then return s.PlaybackLoudness end
        end
    end
    return 0
end

local EquipAll = function()
    local character, backpack = GetLPlrImportant()
    for _, tool in next, backpack:GetChildren() do
        if tool:IsA("Tool") then
            tool.Parent = character
        end
    end
end

local GetPlayer = function(String)
    if not String or String == "" or String == " " then
        return nil
    end
    for _, v in pairs(Players:GetPlayers()) do
        if v.Name:lower():sub(1, #String) == String:lower() then
            return v
        end
    end
end

local function validVec(v)
    return v.X == v.X and v.Y == v.Y and v.Z == v.Z and math.abs(v.X) < 1e6 and math.abs(v.Y) < 1e6 and math.abs(v.Z) < 1e6
end

local function Gyro(handle)
    local g = handle:FindFirstChild("BodyGyro") or Instance.new("BodyGyro", handle)
    g.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
    g.P = 10000
    return g
end

local function ResolveTarget(hrp)
    if string.lower(ScriptSettings.Visualizer.Target) ~= "me" then
        local p = GetPlayer(ScriptSettings.Visualizer.Target)
        if p and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
            return p.Character.HumanoidRootPart
        end
        return nil
    end
    return hrp
end

-- Stops the drifting bug: zero velocities, destroy gyros and snap tools back next to the target
local function StopTools(tools, anchorHrp)
    for _, tool in ipairs(tools) do
        local h = tool and tool:FindFirstChild("Handle")
        if h then
            local g = h:FindFirstChild("BodyGyro")
            if g then g:Destroy() end
            h.AssemblyLinearVelocity = Vector3.zero
            h.AssemblyAngularVelocity = Vector3.zero
            h.Velocity = Vector3.zero
            h.RotVelocity = Vector3.zero
            if anchorHrp and anchorHrp.Parent then
                h.CFrame = anchorHrp.CFrame
            end
        end
    end
end

-- Equips ALL tools and prepares them (same trick as the original, now for every tool)
local function PrepareTools()
    local character, backpack = GetLPlrImportant()
    workspace.FallenPartsDestroyHeight = 0 / 0
    character:WaitForChild("Humanoid"):UnequipTools()
    task.wait(.2)

    local tools = CollectTools()

    for _, tool in ipairs(tools) do
        tool.Parent = character
        tool.Parent = backpack
    end

    task.spawn(function()
        task.wait(.15)
        for _, value in pairs(character:WaitForChild("Humanoid"):GetPlayingAnimationTracks()) do
            if value.Name == "ToolNoneAnim" then
                value:Stop()
            end
        end
    end)

    for _, tool in ipairs(tools) do
        tool.Parent = character
        tool.Parent = backpack
        tool.Parent = character:WaitForChild("Humanoid")
        tool.Parent = character
        local h = tool:FindFirstChild("Handle")
        if h then
            h.CustomPhysicalProperties = PhysicalProperties.new(0, 0, 0, 0, 0)
        end
    end
    return tools
end

