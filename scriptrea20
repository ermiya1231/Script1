local DupeBoomboxes = function()
    local character, backpack, hrp = GetLPlrImportant()

    if not ScriptSettings.Duper.Vip then
        local ogpos = character.HumanoidRootPart.Position

        for i = 1, ScriptSettings.Duper.Ammount do
            if ScriptSettings.Duper.PanicStop then continue end
            character:WaitForChild("HumanoidRootPart")
            for _, v in pairs(LocalPlayer.Backpack:GetChildren()) do
                if v:IsA("Tool") then v.Parent = character end
            end
            for _, v in pairs(character:GetChildren()) do
                if v:IsA("Tool") then v.Parent = character end
            end
            character.HumanoidRootPart.CFrame = CFrame.new(0, 9999999999, 500)
            repeat wait() until not LocalPlayer.Backpack:FindFirstChildOfClass("Tool")
            wait(0.75)
            for _, v in pairs(character:GetChildren()) do
                if v:IsA("BasePart") then
                    v.CanCollide = false
                    v.Anchored = true
                end
            end
            for _, v in pairs(character:GetChildren()) do
                if v:IsA("Tool") then v.Parent = workspace end
            end
            character:BreakJoints()
            LocalPlayer.CharacterAdded:Wait()
            character = LocalPlayer.Character
        end

        character:WaitForChild("HumanoidRootPart")
        wait(0.15)
        character.HumanoidRootPart.CFrame = CFrame.new(ogpos)
        for _, v in pairs(workspace:GetChildren()) do
            if v:IsA("Tool") then
                character.Humanoid:EquipTool(v)
            end
        end
    else
        local og_pos = character.HumanoidRootPart.Position
        local basepos = Vector3.new(1000000, 5000000005, 0)
        hrp.CFrame = CFrame.new(basepos)
        TweenService:Create(hrp, TweenInfo.new(1), { CFrame = hrp.CFrame * CFrame.new(0, 20, 0) }):Play()
        task.wait(1)
        character.HumanoidRootPart.Anchored = true

        local reCount = 0
        local cooldownTime = 3

        for i = 1, ScriptSettings.Duper.Ammount do
            if reCount >= 7 then
                Notif:Notify("Dupe limit reached, waiting for cooldown...", 3, "error")
                wait(cooldownTime)
                reCount = 0
            end
            if ScriptSettings.Duper.PanicStop then continue end
            character:WaitForChild("HumanoidRootPart")
            character.HumanoidRootPart.CFrame = character.HumanoidRootPart.CFrame * CFrame.new(0, 20, 0)
            character.HumanoidRootPart.Anchored = true

            repeat wait() until LocalPlayer.Backpack:FindFirstChildOfClass("Tool")

            for _, v in pairs(LocalPlayer.Backpack:GetChildren()) do
                if v:IsA("Tool") then v.Parent = character end
            end
            wait(0.75)

            for _, v in pairs(character:GetChildren()) do
                if v:IsA("Tool") then v.Parent = workspace end
            end

            game:GetService("Players"):Chat(";re")
            reCount = reCount + 1

            LocalPlayer.CharacterAdded:Wait()
            character = LocalPlayer.Character
        end

        character:WaitForChild("HumanoidRootPart")
        wait(0.15)
        for _, v in pairs(workspace:GetChildren()) do
            if v:IsA("Tool") then
                character.Humanoid:EquipTool(v)
            end
        end

        character.HumanoidRootPart.Anchored = false
        character.HumanoidRootPart.CFrame = CFrame.new(og_pos)
    end

    ScriptSettings.Duper.PanicStop = false
end

