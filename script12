-- 2. توابع امنیتی (بدون سپر محافظ)
------------------------------------------
local function SetupProtections(char)
    if not Enabled then return end
    
    local root = char:WaitForChild("HumanoidRootPart", 5)
    local hum = char:WaitForChild("Humanoid", 5)
    if not root or not hum then return end
    
    hum:GetPropertyChangedSignal("PlatformStand"):Connect(function()
        if Enabled and hum.PlatformStand then hum.PlatformStand = false end
    end)
    hum:GetPropertyChangedSignal("Sit"):Connect(function()
        if Enabled and hum.Sit then hum.Sit = false end
    end)
    
    if MoverConnection then MoverConnection:Disconnect() end
    MoverConnection = char.DescendantAdded:Connect(function(obj)
        if not Enabled then return end
        if obj:IsA("BodyMover") or obj:IsA("LinearVelocity") or obj:IsA("AngularVelocity") or obj:IsA("AlignPosition") or obj:IsA("VectorForce") or obj:IsA("Torque") then
            pcall(function() obj:Destroy() end)
        end
    end)
end

------------------------------------------
-- 3. گارد حرکتی
------------------------------------------
local function StartSmartGuard()
    if RenderConnection then RenderConnection:Disconnect() end
    
    RenderConnection = RunService.RenderStepped:Connect(function()
        if not Enabled then return end
        
        local char = LocalPlayer.Character
        if not char then return end
        
        local root = char:FindFirstChild("HumanoidRootPart")
        local hum = char:FindFirstChildOfClass("Humanoid")
        
        -- غیرفعال کردن برخورد با سایر پلیرها
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= LocalPlayer and player.Character then
                for _, part in ipairs(player.Character:GetDescendants()) do
                    if part:IsA("BasePart") then
                        part.CanCollide = false
                    end
                end
            end
        end
        
        if hum and root then
            -- جلوگیری از استیت‌های خطرناک
            hum:SetStateEnabled(Enum.HumanoidStateType.Physics, false)
            hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
            hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
            hum:SetStateEnabled(Enum.HumanoidStateType.PlatformStanding, false)
            hum:SetStateEnabled(Enum.HumanoidStateType.Seated, false)
            
            local currentVel = root.AssemblyLinearVelocity
            local horizontalVel = Vector3.new(currentVel.X, 0, currentVel.Z)
            local maxWalkSpeed = hum.WalkSpeed + 5
            
            -- فیلتر سرعت افقی (پرتاب شدن به اطراف)
            if horizontalVel.Magnitude > maxWalkSpeed then
                root.AssemblyLinearVelocity = Vector3.new(0, currentVel.Y, 0)
            end
            
            -- فیلتر پرتاب شدن به بالا
            if currentVel.Y > 70 then
                root.AssemblyLinearVelocity = Vector3.new(currentVel.X, 0, currentVel.Z)
            end
            
            -- فیلتر چرخش‌های غیرطبیعی
            if root.AssemblyAngularVelocity.Magnitude > 25 then
                root.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
            end
        end
    end)
end

