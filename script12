-- تابع تبدیل کردن کاراکتر به تانک
local function setupTankMode(char)
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then return end

    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") then
            if part.Name == "HumanoidRootPart" then
                part.CustomPhysicalProperties = PhysicalProperties.new(0.7, 0, 0, 1, 1)
            else
                part.Massless = true
                part.CustomPhysicalProperties = PhysicalProperties.new(0.01, 0, 0, 1, 1)
            end
        end
    end

    hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
    hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
    hum:SetStateEnabled(Enum.HumanoidStateType.Physics, false)

    local attachment = hrp:FindFirstChild("AntiFlingAttachment") or Instance.new("Attachment", hrp)
    attachment.Name = "AntiFlingAttachment"

    local mover = hrp:FindFirstChild("AntiFlingVelocity") or Instance.new("LinearVelocity", hrp)
    mover.Name = "AntiFlingVelocity"
    mover.Attachment0 = attachment
    mover.RelativeTo = Enum.ActuatorRelativeTo.World
    
    mover.ForceLimitMode = Enum.ForceLimitMode.PerAxis
    mover.MaxAxesForce = Vector3.new(99999999, 0, 99999999) 
    mover.Enabled = true
end

-- تابع بازگرداندن به حالت عادی
local function disableTankMode(char)
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    
    if hum then
        hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, true)
        hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, true)
        hum:SetStateEnabled(Enum.HumanoidStateType.Physics, true)
    end
    
    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BasePart") then
            part.CustomPhysicalProperties = nil
            if part.Name ~= "HumanoidRootPart" then
                part.Massless = false
            end
        end
    end

    if hrp then
        local mover = hrp:FindFirstChild("AntiFlingVelocity")
        if mover then mover:Destroy() end
        local att = hrp:FindFirstChild("AntiFlingAttachment")
        if att then att:Destroy() end
    end
end

-- حلقه‌ی دفاعی
local function onUpdate()
    if not AntiFling then return end
    local char = LocalPlayer.Character
    if not char then return end
    
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    local mover = hrp and hrp:FindFirstChild("AntiFlingVelocity")

    if hum and hrp then
        if hum.PlatformStand then hum.PlatformStand = false end
        if hum.Sit then hum.Sit = false end
        
        for _, obj in ipairs(hrp:GetChildren()) do
            if obj:IsA("BodyVelocity") or obj:IsA("BodyThrust") or obj:IsA("BodyForce") 
            or obj:IsA("BodyAngularVelocity") or obj:IsA("AngularVelocity") or obj:IsA("Torque") 
            or (obj:IsA("LinearVelocity") and obj.Name ~= "AntiFlingVelocity") then
                obj:Destroy()
            end
        end

        local moveDir = hum.MoveDirection
        local isNearWall = false
        
        -- آپدیت جدید: رادار تشخیص دیوار (جلوگیری از بالا رفتن از دیوار و چسبیدن به آن)
        if moveDir.Magnitude > 0 then
            local rayOrigin = hrp.Position
            local params = RaycastParams.new()
            params.FilterDescendantsInstances = {char}
            params.FilterType = Enum.RaycastFilterType.Exclude
            
            -- ارسال یک پرتو به اندازه 2.2 استاد جلوتر از کاراکتر
            local result = workspace:Raycast(rayOrigin, moveDir * 2.2, params)
            
            -- اگر به یک جسم سخت (مثل دیوار یا پله) برخورد کرد
            if result and result.Instance and result.Instance.CanCollide then
                isNearWall = true
            end
        end

        -- اگر در حال بالا رفتن از نردبان هستید یا به دیوار نزدیک شده‌اید، نیروی هل‌دهنده را خاموش کن
        if hum:GetState() == Enum.HumanoidStateType.Climbing or isNearWall then
            if mover then mover.Enabled = false end
        else
            if mover then
                mover.Enabled = true
                mover.VectorVelocity = moveDir * hum.WalkSpeed
            end
        end

        -- محدود کننده‌های سرعت (خفه‌کننده پرتاب)
        local vel = hrp.AssemblyLinearVelocity
        local newX, newY, newZ = vel.X, vel.Y, vel.Z

        if vel.Y > 65 or vel.Y < -150 then newY = 0 end
        
        if moveDir.Magnitude == 0 then
            if math.abs(vel.X) > 1 then newX = 0 end
            if math.abs(vel.Z) > 1 then newZ = 0 end
        end

        if newX ~= vel.X or newY ~= vel.Y or newZ ~= vel.Z then
            hrp.AssemblyLinearVelocity = Vector3.new(newX, newY, newZ)
        end
        
        local angVel = hrp.AssemblyAngularVelocity
        hrp.AssemblyAngularVelocity = Vector3.new(0, math.clamp(angVel.Y, -15, 15), 0)
    end
end

local function refresh()
    if AntiFling then
        toggle.Text = "Anti Slap: ON"
        setupTankMode(LocalPlayer.Character)
        if not Connection then
            Connection = RunService.Stepped:Connect(onUpdate)
        end
    else
        toggle.Text = "Anti Slap: OFF"
        disableTankMode(LocalPlayer.Character)
        if Connection then
            Connection:Disconnect()
            Connection = nil
        end
    end
end

toggle.MouseButton1Click:Connect(function()
    AntiFling = not AntiFling
    refresh()
end)

LocalPlayer.CharacterAdded:Connect(function(char)
    task.wait(0.5)
    if AntiFling then
        setupTankMode(char)
    end
end)

refresh()
