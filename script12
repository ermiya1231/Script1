        FrameStroke.Color = Color3.fromRGB(0, 220, 110)
        
        if LocalPlayer.Character then
            SetupProtections(LocalPlayer.Character)
        end
        StartSmartGuard()
    else
        ToggleBtn.Text = "OFF"
        ToggleBtn.BackgroundColor3 = Color3.fromRGB(35, 35, 40)
        ToggleBtn.TextColor3 = Color3.fromRGB(180, 180, 180)
        BtnStroke.Color = Color3.fromRGB(60, 60, 65)
        FrameStroke.Color = Color3.fromRGB(255, 60, 60)
        
        if RenderConnection then RenderConnection:Disconnect() end
        if MoverConnection then MoverConnection:Disconnect() end
    end
end)

