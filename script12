-- 2. پاک‌کننده فورس‌های سرور
------------------------------------------
local function KillForeignMovers(char)
    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BodyMover") or part:IsA("BodyVelocity") or part:IsA("BodyForce") 
        or part:IsA("BodyPosition") or part:IsA("BodyThrust") or part:IsA("VectorForce") 
        or part:IsA("AlignPosition") or part:IsA("LinearVelocity") or part:IsA("AngularVelocity") then
            -- پاک کردن همه فورس‌ها به جز موتور خودمون
            if part.Name ~= MoverName then
                pcall(function() part:Destroy() end)
            end
        end
    end
end

------------------------------------------
-- 3. نصب موتور فیزیک شخصی (Infinite Force)
------------------------------------------
local function SetupGodMode(char)
    local root = char:WaitForChild("HumanoidRootPart", 5)
    if not root then return end
    
    -- پاکسازی موتورهای قبلی در صورت وجود
    if root:FindFirstChild(MoverName) then root[MoverName]:Destroy() end
    if root:FindFirstChild("AntiSlapAttachment") then root.AntiSlapAttachment:Destroy() end

    -- ساخت اتچمنت
    local attach = Instance.new("Attachment", root)
    attach.Name = "AntiSlapAttachment"

    -- ساخت موتور با نیروی بینهایت
    local lv = Instance.new("LinearVelocity", root)
    lv.Name = MoverName
    lv.Attachment0 = attach
    lv.ForceLimitMode = Enum.ForceLimitMode.PerAxis
    -- قفل کردن کامل محور X و Z (هیچکس نمیتونه پرتت کنه چپ/راست/جلو/عقب)
    lv.MaxAxesForce = Vector3.new(math.huge, 0, math.huge) 
    lv.RelativeTo = Enum.ActuatorRelativeTo.World
    lv.VectorVelocity = Vector3.zero
end

------------------------------------------
-- 4. لوپ اصلی (حفاظت در هر میلی‌ثانیه)
------------------------------------------
local function StartGodGuard()
    if Connection then Connection:Disconnect() end
    
    Connection = RunService.Heartbeat:Connect(function()
        if not Enabled then return end
        
        local char = LocalPlayer.Character
        if not char then return end
        
        local root = char:FindFirstChild("HumanoidRootPart")
        local hum = char:FindFirstChildOfClass("Humanoid")
        
        if hum and root then
            -- 1. کشتن هر نیرویی که سرور روت میندازه
            KillForeignMovers(char)
            
            -- 2. غیرفعال کردن استیت‌های سقوط و پرت شدن
            hum:SetStateEnabled(Enum.HumanoidStateType.Physics, false)
            hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
            hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
            
            local isMoving = hum.MoveDirection.Magnitude > 0
            local isOnGround = hum.FloorMaterial ~= Enum.Material.Air
            local isJumping = hum.Jump
            
            -- 3. سیستم لنگر خودکار (Auto-Anchor)
            -- اگر دستت به WASD نیست و روی زمینی، کاملا لنگر میشی (هیچکس تو بازی نمیتونه تکونت بده)
            if not isMoving and isOnGround and not isJumping then
                root.Anchored = true
                root.AssemblyLinearVelocity = Vector3.zero
            else
                root.Anchored = false
            end
            
            -- 4. کنترل جهت با موتور شخصی (مقاومت بی‌نهایت)
            local lv = root:FindFirstChild(MoverName)
            if lv then
                -- سرعت موتور رو برابر با دکمه‌های WASD قرار میدیم
                lv.VectorVelocity = hum.MoveDirection * hum.WalkSpeed
            end
            
            -- 5. ضد آپرکات (Anti-Uppercut)
            -- اگر سرور تورو با قدرت پرتاب کرد بالا، درجا سرعت یقه رو صفر میکنه
            if root.AssemblyLinearVelocity.Y > hum.JumpPower + 2 then
                root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
            end
            
            -- 6. ضد چرخیدن
            root.AssemblyAngularVelocity = Vector3.zero
        end
    end)
end

