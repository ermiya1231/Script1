-- 2. پاک‌کننده فورس‌های سرور
------------------------------------------
local function KillForeignMovers(char)
    for _, part in ipairs(char:GetDescendants()) do
        if part:IsA("BodyMover") or part:IsA("BodyVelocity") or part:IsA("BodyForce") 
        or part:IsA("BodyPosition") or part:IsA("BodyThrust") or part:IsA("VectorForce") 
        or part:IsA("AlignPosition") or part:IsA("LinearVelocity") or part:IsA("AngularVelocity") then
            if part.Name ~= MoverName then
                pcall(function() part:Destroy() end)
            end
        end
    end
end

------------------------------------------
-- 3. نصب موتور فیزیک شخصی
------------------------------------------
local function SetupGodMode(char)
    local root = char:WaitForChild("HumanoidRootPart", 5)
    if not root then return end
    
    if root:FindFirstChild(MoverName) then root[MoverName]:Destroy() end
    if root:FindFirstChild("AntiSlapAttachment") then root.AntiSlapAttachment:Destroy() end

    local attach = Instance.new("Attachment", root)
    attach.Name = "AntiSlapAttachment"

    local lv = Instance.new("LinearVelocity", root)
    lv.Name = MoverName
    lv.Attachment0 = attach
    lv.ForceLimitMode = Enum.ForceLimitMode.PerAxis
    lv.MaxAxesForce = Vector3.new(math.huge, 0, math.huge) 
    lv.RelativeTo = Enum.ActuatorRelativeTo.World
    lv.VectorVelocity = Vector3.zero
end

------------------------------------------
-- 4. لوپ اصلی (محافظت کامل در برابر فرو رفتن)
------------------------------------------
local function StartGodGuard()
    if Connection then Connection:Disconnect() end
    
    Connection = RunService.Heartbeat:Connect(function()
        if not Enabled then return end
        
        local char = LocalPlayer.Character
        if not char then return end
        
        local root = char:FindFirstChild("HumanoidRootPart")
        local hum = char:FindFirstChildOfClass("Humanoid")
        
        if hum and root then
            KillForeignMovers(char)
            
            -- ۱. جلوگیری از زمین‌گیر شدن و افتادن
            hum.PlatformStand = false
            hum.Sit = false
            
            -- ۲. غیرفعال کردن استیت‌های راگ‌دال و فیزیک
            hum:SetStateEnabled(Enum.HumanoidStateType.Physics, false)
            hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
            hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
            hum:SetStateEnabled(Enum.HumanoidStateType.PlatformStanding, false)
            
            -- اگر بازی سعی کرد استیت را راگ‌دال کند، بلافاصله ایستاده‌اش می‌کنیم
            local currentState = hum:GetState()
            if currentState == Enum.HumanoidStateType.Ragdoll or currentState == Enum.HumanoidStateType.Physics or currentState == Enum.HumanoidStateType.FallingDown then
                hum:ChangeState(Enum.HumanoidStateType.Running)
            end
            
            -- ۳. اجبار برخورد با زمین (جلوگیری ۱۰۰٪ از فرو رفتن در زمین)
            root.CanCollide = true
            if char:FindFirstChild("Torso") then char.Torso.CanCollide = true end
            if char:FindFirstChild("UpperTorso") then char.UpperTorso.CanCollide = true end
            if char:FindFirstChild("LowerTorso") then char.LowerTorso.CanCollide = true end
            
            local isMoving = hum.MoveDirection.Magnitude > 0
            
            -- تشخیص دقیق وضعیت پرش
            local isJumpingOrFalling = (currentState == Enum.HumanoidStateType.Jumping) 
                or (currentState == Enum.HumanoidStateType.Freefall) 
                or (hum.FloorMaterial == Enum.Material.Air)
                or (math.abs(root.AssemblyLinearVelocity.Y) > 1)
                or hum.Jump
            
            -- ۴. لنگر هوشمند (فقط موقع ایستادن روی زمین)
            if not isMoving and not isJumpingOrFalling then
                root.Anchored = true
                root.AssemblyLinearVelocity = Vector3.zero
            else
                root.Anchored = false
            end
            
            -- ۵. کنترل حرکت
            local lv = root:FindFirstChild(MoverName)
            if lv then
                lv.VectorVelocity = hum.MoveDirection * hum.WalkSpeed
            end
            
            -- ۶. ضد آپرکات شدید
            if root.AssemblyLinearVelocity.Y > 110 then
                root.AssemblyLinearVelocity = Vector3.new(root.AssemblyLinearVelocity.X, 0, root.AssemblyLinearVelocity.Z)
            end
            
            root.AssemblyAngularVelocity = Vector3.zero
        end
    end)
end

