-- تابع پیدا کردن ProximityPrompt بر اساس نام
local function findPromptByName(targetName)
	for _, obj in ipairs(Workspace:GetDescendants()) do
		if obj:IsA("ProximityPrompt") then
			if (obj.ActionText and obj.ActionText:find(targetName)) or (obj.ObjectText and obj.ObjectText:find(targetName)) or (obj.Parent and obj.Parent.Name:find(targetName)) then
				return obj
			end
		end
	end
	return nil
end

-- تابع روح، متریال ForceField و سرعت ملایم‌تر و کنترل‌شده
local function executePromptWithGhost(prompt)
	local character = player.Character
	if not character or not character:FindFirstChild("HumanoidRootPart") then return end
	local humanoidRootPart = character.HumanoidRootPart
	local camera = Workspace.CurrentCamera

	local originalCFrame = humanoidRootPart.CFrame
	local promptPart = prompt.Parent
	if not promptPart or not promptPart:IsA("BasePart") then return end

	-- ۱. ساخت کلون روح
	character.Archivable = true
	local ghost = character:Clone()
	ghost.Name = "SpiritGhost"

	local ghostRoot = ghost:FindFirstChild("HumanoidRootPart")
	if ghostRoot then
		ghost.PrimaryPart = ghostRoot
	end

	-- تنظیمات متریال ForceField و مخفی کردن روت‌پارت روح
	for _, obj in ipairs(ghost:GetDescendants()) do
		if obj:IsA("Script") or obj:IsA("LocalScript") or obj:IsA("ModuleScript") then
			obj:Destroy()
		elseif obj:IsA("BasePart") then
			obj.Anchored = true
			obj.CanCollide = false
			obj.Material = Enum.Material.ForceField

			if obj.Name == "HumanoidRootPart" then
				obj.Transparency = 1
			else
				obj.Transparency = 0.2
				obj.Color = Color3.fromRGB(0, 170, 255)
			end
		end
	end

	ghost.Parent = Workspace
	if ghost.PrimaryPart then
		ghost:SetPrimaryPartCFrame(originalCFrame)
	end

	-- ۲. تنظیم دوربین روی روح و مکث بیشتر برای دیدن روح
	local ghostHumanoid = ghost:FindFirstChildOfClass("Humanoid")
	if ghostHumanoid then
		camera.CameraSubject = ghostHumanoid
	elseif ghost.PrimaryPart then
		camera.CameraSubject = ghost.PrimaryPart
	end

	-- ۳. تلپورت کاراکتر اصلی به پرامپت با سرعت کمتر
	humanoidRootPart.CFrame = promptPart.CFrame + Vector3.new(0, 3, 0)
	task.wait(0.4) -- مکث قبل از فایر کردن پرامپت

	fireproximityprompt(prompt)

	task.wait(0.4) -- مکث بعد از فایر کردن پرامپت

	-- ۴. بازگرداندن کاراکتر به جای اول همراه با فریز موقت و صفر کردن شتاب (بدون زمین خوردن)
	humanoidRootPart.CFrame = originalCFrame
	humanoidRootPart.Anchored = true
	humanoidRootPart.AssemblyLinearVelocity = Vector3.zero
	humanoidRootPart.AssemblyAngularVelocity = Vector3.zero

	-- ۵. بازگشت دوربین و پاکسازی روح
	local realHumanoid = character:FindFirstChildOfClass("Humanoid")
	if realHumanoid then
		camera.CameraSubject = realHumanoid
	end
	ghost:Destroy()
	character.Archivable = false

	task.wait(0.15)
	humanoidRootPart.Anchored = false
end

-- متغیر کول‌دان دکمه‌ها
local isBusy = false

local function buyItem(itemData, buyBtn)
	if isBusy then
		errorLabel.Text = "لطفاً صبر کنید..."
		return
	end

	errorLabel.Text = ""

	local leaderstats = player:FindFirstChild("leaderstats")
	if not leaderstats then
		errorLabel.Text = "پوشه leaderstats پیدا نشد!"
		return
	end

	local money = leaderstats:FindFirstChild("Money")
	if not money then
		errorLabel.Text = "متغیر Money پیدا نشد!"
		return
	end

	if money.Value < itemData.price then
		errorLabel.Text = "پول کافی نداری! (نیاز به " .. itemData.price .. "$)"
		return
	end

	-- فعال شدن کول‌دان دکمه
	isBusy = true
	buyBtn.BackgroundColor3 = Color3.fromRGB(100, 100, 100)
	buyBtn.Text = "..."

	-- کسر پول
	money.Value = money.Value - itemData.price

	-- اجرای آیتم
	if itemData.type == "Path" and itemData.path and itemData.path:IsA("ProximityPrompt") then
		executePromptWithGhost(itemData.path)
	elseif itemData.type == "PromptByName" then
		local prompt = findPromptByName(itemData.searchKey)
		if prompt then
			executePromptWithGhost(prompt)
		else
			errorLabel.Text = "پرامپت مورد نظر پیدا نشد!"
		end
	elseif itemData.type == "TouchInterest" and itemData.path then
		local part = itemData.path
		local character = player.Character
		if character and character:FindFirstChild("HumanoidRootPart") and part:IsA("BasePart") then
			firetouchinterest(character.HumanoidRootPart, part, 0)
			task.wait(0.1)
			firetouchinterest(character.HumanoidRootPart, part, 1)
		end
	end

	-- کول‌دان دکمه (۲ ثانیه تأخیر قبل از فعال شدن مجدد)
	task.wait(2.0)
	buyBtn.BackgroundColor3 = Color3.fromRGB(0, 200, 100)
	buyBtn.Text = "Buy"
	isBusy = false
end

