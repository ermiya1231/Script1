-- Collapse / Expand and Close
---------------------------------------------------------------------
local collapsed = false
local collapseToken = 0

-- Everything in the panel body that gets hidden while collapsed
local bodyElements = { errorLabel, scrollingFrame, giveAllBtn, giveStatusLabel }

local function setBodyVisible(visible)
	for _, element in ipairs(bodyElements) do
		element.Visible = visible
	end
end

local function toggleCollapse()
	collapsed = not collapsed
	collapseToken += 1
	local myToken = collapseToken

	if collapsed then
		collapseBtn.Text = "+"
		setBodyVisible(false)
		TweenService:Create(mainFrame, TweenInfo.new(0.2, Enum.EasingStyle.Quad), {
			Size = UDim2.new(0, PANEL_WIDTH, 0, HEADER_HEIGHT),
		}):Play()
	else
		collapseBtn.Text = "-"
		local tween = TweenService:Create(mainFrame, TweenInfo.new(0.2, Enum.EasingStyle.Quad), {
			Size = UDim2.new(0, PANEL_WIDTH, 0, PANEL_HEIGHT),
		})
		tween:Play()
		tween.Completed:Connect(function()
			-- Only show the body if the user didn't collapse again in the meantime
			if myToken == collapseToken and not collapsed then
				setBodyVisible(true)
				updateSmartScroll()
			end
		end)
	end
end

local function closePanel()
	for _, conn in ipairs(connections) do
		conn:Disconnect()
	end
	table.clear(connections)
	screenGui:Destroy()
end

collapseBtn.MouseButton1Click:Connect(toggleCollapse)
closeBtn.MouseButton1Click:Connect(closePanel)

