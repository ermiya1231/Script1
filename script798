local GIVEALL = {
	Delay = 0, -- ثانیه فاصله بین هر InvokeServer
	DeepSearch = true, -- جستجوی تمام فرزندان List (نه فقط سطح اول)
	UseLabelName = true, -- اگر نام دکمه خالی/پیش‌فرض بود، از TextLabel داخلش بخوان
	SmartFilter = true, -- رد کردن دکمه‌های غیر آیتمی (Buy، قیمت، ...)
	MaxItems = 0, -- 0 یعنی بدون محدودیت
	OpenShopGui = true, -- اول ShopGui را روشن کن تا List پر شود
	WaitForList = 5, -- چند ثانیه برای ظاهر شدن List صبر کن
	Debug = true, -- پرینت نتیجه هر آیتم در Output
}

-- نام‌هایی که هیچ‌وقت آیتم حساب نمی‌شوند
local GIVEALL_SKIP = {
	Buy = true, Sell = true, Close = true, Exit = true, Equip = true,
	Unequip = true, Use = true, Next = true, Previous = true, Back = true,
	Tab1 = true, Tab2 = true, Tab3 = true, Frame = true, TextButton = true,
}

local GIVEALL_TEXT = "Give All Buyed Items From Shop"
local GIVEALL_COLOR = Color3.fromRGB(255, 170, 40)
local GIVEALL_HOVER = Color3.fromRGB(255, 195, 90)
local GIVEALL_BUSY = Color3.fromRGB(110, 110, 125)

local giveAllBtn
local giveStatusLabel
local giveAllRunning = false

-- ریموت EquipGear را پیدا می‌کند
local function getEquipGearRemote()
	local shopShared = ReplicatedStorage:FindFirstChild("ShopShared")
	local remotes = shopShared and shopShared:FindFirstChild("Remotes")
	return remotes and remotes:FindFirstChild("EquipGear")
end

-- مسیر ShopGui.Shop.Catalog.List (با جستجوی بازگشتی، اگر چیدمان فرق داشت)
local function findShopList()
	local shopGui = playerGui:FindFirstChild("ShopGui")
	if not shopGui then return nil, "ShopGui داخل PlayerGui نیست" end

	local shop = shopGui:FindFirstChild("Shop", true)
	if not shop then return nil, "فریم Shop پیدا نشد" end

	local catalog = shop:FindFirstChild("Catalog", true)
	if not catalog then return nil, "فریم Catalog پیدا نشد" end

	local list = catalog:FindFirstChild("List", true)
	if not list then return nil, "فریم List پیدا نشد" end

	return list
end

-- نام همه TextButton های لیست فروشگاه را جمع می‌کند
local function collectShopItemNames(list)
	local names = {}
	local seen = {}
	local nodes

	if GIVEALL.DeepSearch then
		nodes = list:GetDescendants()
	else
		nodes = list:GetChildren()
	end

	for _, obj in ipairs(nodes) do
		if obj:IsA("TextButton") then
			local raw = obj.Name

			-- نام خالی/پیش‌فرض → خواندن متن برچسب داخل دکمه
			if GIVEALL.UseLabelName and (#raw < 3 or raw == "TextButton") then
				local label = obj:FindFirstChildOfClass("TextLabel") or obj:FindFirstChildOfClass("TextButton", true)
				if label and label.Text and #label.Text > 0 then
					raw = label.Text
				end
			end

			local cleanName = raw:match("^[^\r\n]+") or raw
			cleanName = cleanName:gsub("^%s+", "")
			cleanName = cleanName:gsub("%s+$", "")

			local skip = #cleanName < 2 or seen[cleanName] == true

			if not skip and GIVEALL.SmartFilter then
				if GIVEALL_SKIP[cleanName] then
					skip = true
				elseif cleanName:find("%d") and (cleanName:find("%$") or cleanName:find("%%")) then
					skip = true -- رد شدن ردیف‌های قیمت مثل «۲۵$»
				elseif cleanName:find("^%d+$") then
					skip = true
				end
			end

			if not skip then
				seen[cleanName] = true
				table.insert(names, cleanName)
				if GIVEALL.MaxItems > 0 and #names >= GIVEALL.MaxItems then
					break
				end
			end
		end
	end

	return names
end

local function setGiveAllState(busy, text)
	giveAllRunning = busy
	if not giveAllBtn then return end
	giveAllBtn.Text = text or GIVEALL_TEXT
	giveAllBtn.BackgroundColor3 = busy and GIVEALL_BUSY or GIVEALL_COLOR
end

-- تابع اصلی: اسکن لیست + Equip تک‌تک آیتم‌ها با ریموت
local function giveAllBuyedItems()
	if isBusy then
		errorLabel.Text = "یک خرید در جریان است؛ کمی بعد امتحان کن..."
		return
	end
	if giveAllRunning then return end

	setGiveAllState(true, "در حال آماده‌سازی...")

	task.defer(function()
		-- ۱) ریموت
		local equipGear = getEquipGearRemote()
		if not equipGear then
			errorLabel.Text = "ریموت EquipGear پیدا نشد!"
			setGiveAllState(false)
			return
		end

		-- ۲) باز کردن فروشگاه تا لیست ساخته شود
		if GIVEALL.OpenShopGui then
			local shopGui = playerGui:FindFirstChild("ShopGui")
			if shopGui and not shopGui.Enabled then
				shopGui.Enabled = true
			end
		end

		-- ۳) صبر برای پیدا شدن List (اگر WaitForList = 0 باشد فقط یک بار بررسی می‌کند)
		local list, lastError = findShopList()
		local waited = 0
		while not list and waited < GIVEALL.WaitForList do
			task.wait(0.2)
			waited += 0.2
			list, lastError = findShopList()
		end

		if not list then
			errorLabel.Text = lastError or "لیست فروشگاه پیدا نشد!"
			setGiveAllState(false)
			return
		end

		-- ۴) جمع کردن نام دکمه‌ها (یک بار تلاش مجدد اگر لیست هنوز خالی بود)
		local names = collectShopItemNames(list)
		if #names == 0 then
			setGiveAllState(true, "لیست خالی است؛ دوباره بررسی می‌شود...")
			task.wait(0.6)
			names = collectShopItemNames(list)
		end

		if #names == 0 then
			errorLabel.Text = "هیچ TextButton آیتمی داخل List پیدا نشد!"
			setGiveAllState(false)
			return
		end

		-- ۵) ارسال نام هر آیتم به ریموت
		local equipped, failed = 0, 0
		for index, itemName in ipairs(names) do
			setGiveAllState(true, ("Equipping %d / %d  ·  %s"):format(index, #names, itemName))

			local ok, err = pcall(function()
				return equipGear:InvokeServer(itemName, true)
			end)

			if ok then
				equipped += 1
			else
				failed += 1
			end

			if GIVEALL.Debug then
				print("[ShopPanel][GiveAll] " .. itemName .. " → " .. (ok and "OK" or ("ERROR: " .. tostring(err))))
			end

			task.wait(GIVEALL.Delay)
		end

		errorLabel.Text = ""
		giveStatusLabel.Text = ("%d آیتم Equip شد · %d خطا"):format(equipped, failed)
		giveStatusLabel.TextColor3 = Color3.fromRGB(120, 255, 190)
		setGiveAllState(false, GIVEALL_TEXT)

		if GIVEALL.Debug then
			print(("[ShopPanel][GiveAll] DONE ✅ %d ok / %d fail"):format(equipped, failed))
		end
	end)
end

