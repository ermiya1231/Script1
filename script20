local function refreshPlayerDropdown()
	for _, child in ipairs(DropdownScroll:GetChildren()) do
		if child:IsA("TextButton") then
			child:Destroy()
		end
	end
	
	local order = 1
	
	-- دکمه All
	local allBtn = Instance.new("TextButton")
	allBtn.Parent = DropdownScroll
	allBtn.BackgroundColor3 = Color3.fromRGB(245, 245, 245)
	allBtn.BorderColor3 = Color3.fromRGB(0, 0, 0)
	allBtn.BorderSizePixel = 1
	allBtn.Size = UDim2.new(1, 0, 0, 24)
	allBtn.Font = Enum.Font.Code
	allBtn.Text = "All (Everyone)"
	allBtn.TextColor3 = Color3.fromRGB(0, 0, 0)
	allBtn.TextSize = 12
	allBtn.TextXAlignment = Enum.TextXAlignment.Left
	allBtn.LayoutOrder = order
	allBtn.ZIndex = 6
	order = order + 1
	
	local p1 = Instance.new("UIPadding")
	p1.Parent = allBtn
	p1.PaddingLeft = UDim.new(0, 6)
	
	allBtn.MouseButton1Click:Connect(function()
		selectedTargetMode = "All"
		ExecuteAsBtn.Text = "Execute As: All"
		DropdownFrame.Visible = false
	end)
	
	-- دکمه Others
	local othersBtn = Instance.new("TextButton")
	othersBtn.Parent = DropdownScroll
	othersBtn.BackgroundColor3 = Color3.fromRGB(245, 245, 245)
	othersBtn.BorderColor3 = Color3.fromRGB(0, 0, 0)
	othersBtn.BorderSizePixel = 1
	othersBtn.Size = UDim2.new(1, 0, 0, 24)
	othersBtn.Font = Enum.Font.Code
	othersBtn.Text = "Others (Excluding Self)"
	othersBtn.TextColor3 = Color3.fromRGB(0, 0, 0)
	othersBtn.TextSize = 12
	othersBtn.TextXAlignment = Enum.TextXAlignment.Left
	othersBtn.LayoutOrder = order
	othersBtn.ZIndex = 6
	order = order + 1
	
	local p2 = Instance.new("UIPadding")
	p2.Parent = othersBtn
	p2.PaddingLeft = UDim.new(0, 6)
	
	othersBtn.MouseButton1Click:Connect(function()
		selectedTargetMode = "Others"
		ExecuteAsBtn.Text = "Execute As: Others"
		DropdownFrame.Visible = false
	end)
	
-- لیست تک‌تک پلیرها
	for _, plr in ipairs(Players:GetPlayers()) do
		local pBtn = Instance.new("TextButton")
		pBtn.Parent = DropdownScroll
		pBtn.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
		pBtn.BorderColor3 = Color3.fromRGB(0, 0, 0)
		pBtn.BorderSizePixel = 1
		pBtn.Size = UDim2.new(1, 0, 0, 24)
		pBtn.Font = Enum.Font.Code
		
		local isMe = (plr == LocalPlayer)
		pBtn.Text = plr.Name .. (isMe and " (You)" or "")
		pBtn.TextColor3 = Color3.fromRGB(0, 0, 0)
		pBtn.TextSize = 12
		pBtn.TextXAlignment = Enum.TextXAlignment.Left
		pBtn.LayoutOrder = order
		pBtn.ZIndex = 6
		order = order + 1
		
		local p3 = Instance.new("UIPadding")
		p3.Parent = pBtn
		p3.PaddingLeft = UDim.new(0, 6)
		
		local pName = plr.Name
		pBtn.MouseButton1Click:Connect(function()
			selectedTargetMode = pName
			if isMe then
				ExecuteAsBtn.Text = "Execute As: Me"
			else
				ExecuteAsBtn.Text = "Execute As: " .. pName
			end
			DropdownFrame.Visible = false
		end)
	end
    end

ExecuteAsBtn.MouseButton1Click:Connect(function()
	refreshPlayerDropdown()
	DropdownFrame.Visible = not DropdownFrame.Visible
end)

