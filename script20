	btn.BackgroundColor3 = Color3.fromRGB(245, 245, 245)
	btn.BorderColor3 = Color3.fromRGB(0, 0, 0)
	btn.BorderSizePixel = 1
	btn.Size = UDim2.new(1, 0, 0, 24)
