-- تابع پردازش متن فارسی (برعکس‌ساز)
local function processText(text)
	local hasPersian = false
	for _, code in utf8.codes(text) do
		if (code >= 0x0600 and code <= 0x06FF) or (code >= 0x0750 and code <= 0x077F) then
			hasPersian = true
			break
		end
	end
	
	if hasPersian then
		local chars = {}
		for _, code in utf8.codes(text) do
			table.insert(chars, utf8.char(code))
		end
		local reversed = {}
		for i = #chars, 1, -1 do
			table.insert(reversed, chars[i])
		end
		return table.concat(reversed)
	else
		return text
	end
end

