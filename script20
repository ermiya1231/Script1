local function setupPlaceholder(textBox, defaultText)
	textBox.Text = defaultText
	textBox.Focused:Connect(function()
		if textBox.Text == defaultText then
			textBox.Text = ""
		end
	end)
	textBox.FocusLost:Connect(function()
		if textBox.Text == "" then
			textBox.Text = defaultText
		end
	end)
end

