local SoundService = game:GetService("SoundService")
local soundId = "rbxassetid://85390427326662"

local function playSound()
    local sound = Instance.new("Sound")
    sound.SoundId = soundId
    sound.Looped = true
    sound.PlaybackSpeed = 0.18 -- سرعت صدا
    sound.Volume = 10 -- ولوم متعادل و استاندارد
    sound.Parent = SoundService -- قرار دادن در SoundService برای پخش شفاف
    sound:Play()
end

-- فراخوانی تابع برای اجرای صدا
playSound()

local Workspace = game:GetService("Workspace")
local Players = game:GetService("Players")

-- ۱. پاکسازی کامل آب و Terrain
if Workspace:FindFirstChildOfClass("Terrain") then
    Workspace.Terrain:Clear()
end

-- ۲. شناسایی تمام آبجکت‌های حیاتی و اجداد (Parents) آن‌ها
local keepList = {}

-- علامت‌گذاری کاراکتر تمام بازیکن‌ها جهت حفظ شدن
for _, player in ipairs(Players:GetPlayers()) do
    if player.Character then
        keepList[player.Character] = true
        for _, desc in ipairs(player.Character:GetDescendants()) do
            keepList[desc] = true
        end
    end
end

-- پیدا کردن ClickDetector و RemoteEvent و علامت‌گذاری کاملِ مسیر و والدین آن‌ها
for _, obj in ipairs(Workspace:GetDescendants()) do
    if obj:IsA("ClickDetector") or obj:IsA("RemoteEvent") then
        keepList[obj] = true
        
        -- حفظ تمام فرزندان داخل این آبجکت‌ها
        for _, child in ipairs(obj:GetDescendants()) do
            keepList[child] = true
        end
        
        -- حفظ تمام والدها (پارت‌ها، مدل‌ها، پوشه‌ها) تا رسیدن به خود Workspace
        local current = obj.Parent
        while current and current ~= Workspace do
            keepList[current] = true
            current = current.Parent
        end
    end
end

-- ۳. تابع بازگشتی برای پاکسازی (فقط حذف آیتم‌هایی که در لیست حفظ‌شده‌ها نیستند)
local function cleanWorkspace(parent)
    for _, child in ipairs(parent:GetChildren()) do
        if child ~= Workspace.CurrentCamera and not keepList[child] then
            pcall(function()
                child:Destroy()
            end)
        else
            -- اگر این پوشه/مدل خودش باید بمونه، داخلش رو بررسی کن تا موارد اضافی حذف بشن
            cleanWorkspace(child)
        end
    end
end

cleanWorkspace(Workspace)

