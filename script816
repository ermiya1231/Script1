local SORT_MODES = {"Lowest Players", "Highest Players", "Best Ping"}
local sortMode = 1
local loading = false
local servers = {}

local function sortServers()
    local mode = SORT_MODES[sortMode]
    table.sort(servers, function(a, b)
        if mode == "Highest Players" then
            return (a.playing or 0) > (b.playing or 0)
        elseif mode == "Lowest Players" then
            return (a.playing or 0) < (b.playing or 0)
        else
            local pa, pb = a.ping or math.huge, b.ping or math.huge
            if pa ~= pb then return pa < pb end
            return (a.playing or 0) < (b.playing or 0)
        end
    end)
end

local function joinServer(id)
    Info.Text = "Joining " .. id:sub(1, 8) .. "..."
    local ok, err = pcall(function()
        TeleportService:TeleportToPlaceInstance(PlaceId, id, LocalPlayer)
    end)
    if not ok then Info.Text = "Teleport failed: " .. tostring(err) end
end

