local function pingColor(ping)
    if not ping then return MUTED end
    if ping < 80 then return Color3.fromRGB(80, 230, 110) end
    if ping < 150 then return Color3.fromRGB(245, 205, 60) end
    return Color3.fromRGB(245, 80, 80)
end

