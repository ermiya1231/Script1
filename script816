local function rainbow()
    return ColorSequence.new({
        ColorSequenceKeypoint.new(0.00, Color3.fromRGB(255, 0, 80)),
        ColorSequenceKeypoint.new(0.17, Color3.fromRGB(255, 200, 0)),
        ColorSequenceKeypoint.new(0.33, Color3.fromRGB(0, 255, 120)),
        ColorSequenceKeypoint.new(0.50, Color3.fromRGB(0, 200, 255)),
        ColorSequenceKeypoint.new(0.67, Color3.fromRGB(120, 80, 255)),
        ColorSequenceKeypoint.new(0.83, Color3.fromRGB(255, 0, 200)),
        ColorSequenceKeypoint.new(1.00, Color3.fromRGB(255, 0, 80)),
    })
end

local function tween(obj, t, props)
    TweenService:Create(obj, TweenInfo.new(t, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), props):Play()
end

local function corner(obj, r)
    local c = Instance.new("UICorner")
    c.CornerRadius = r == "full" and UDim.new(1, 0) or UDim.new(0, r)
    c.Parent = obj
    return c
end

local function stroke(obj, color, thickness)
    local s = Instance.new("UIStroke")
    s.Color = color or EDGE
    s.Thickness = thickness or 1
    s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    s.Parent = obj
    return s
end

local function hoverable(btn, base)
    local function getBase()
        return typeof(base) == "function" and base() or base
    end
    btn.MouseEnter:Connect(function()
        tween(btn, 0.12, {BackgroundColor3 = getBase():Lerp(Color3.new(1, 1, 1), 0.2)})
    end)
    btn.MouseLeave:Connect(function()
        tween(btn, 0.12, {BackgroundColor3 = getBase()})
    end)
end

