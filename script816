local function render()
    if not ScreenGui.Parent then return end
    local savedY = List.CanvasPosition.Y
    clearList()
    local q = Search.Text:lower()
    local shown, total = 0, 0
    for _, s in ipairs(servers) do
        local isFull = (s.playing or 0) >= math.max(s.maxPlayers or 1, 1)
        if not (excludeFull and isFull) then
            total += 1
            if q == "" or s.id:lower():find(q, 1, true) then
                shown += 1
                buildRow(s, shown)
            end
        end
    end
    Info.Text = string.format("%d / %d servers shown  |  Place %d", shown, total, PlaceId)
    task.defer(function()
        if List.Parent then List.CanvasPosition = Vector2.new(0, savedY) end
    end)
end

local function refresh()
    if loading then return end
    loading = true
    Footer.Text = "Refreshing..."
    RefreshBtn.Text = "🔄 Loading..."
    RefreshBtn.Interactable = false
    
    local ok, err = pcall(function()
        Info.Text = "Loading servers..."

        local newServers = {}
        local cursor, pages = nil, 0
        repeat
            local data = fetchServers(cursor)
            if not ScreenGui.Parent then return end
            if not data or not data.data then break end
            for _, s in ipairs(data.data) do
                table.insert(newServers, s)
            end
            cursor = data.nextPageCursor
            pages += 1
            Info.Text = string.format("Loading servers... (%d found)", #newServers)
        until not cursor or pages >= 3

        if #newServers > 0 then
            servers = newServers
            sortServers()
        else
            Info.Text = "Failed to load servers"
        end
        if not ScreenGui.Parent then return end
        if #newServers > 0 then render() end
    end)
    loading = false
    
    if not ok and ScreenGui.Parent then
        Info.Text = "Error: " .. tostring(err)
    end
    
    RefreshBtn.Text = "🔄 Refresh"
    RefreshBtn.Interactable = true
    Footer.Text = "Ready"
end

