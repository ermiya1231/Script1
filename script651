-- Client 60 FPS Cap Loop
task.spawn(function()
	local targetFPS = 60
	local frameInterval = 1 / targetFPS
	while true do
		local startTime = os.clock()
		RunService.Heartbeat:Wait()
		local elapsed = os.clock() - startTime
		if elapsed < frameInterval then
			task.wait(frameInterval - elapsed)
		end
	end
end)

