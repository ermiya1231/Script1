-- === منطق اسکن و Fire ===
local isScanning = false

local function fireAdminGiver(part)
    if firetouchinterest and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
        local hrp = LocalPlayer.Character.HumanoidRootPart
        firetouchinterest(hrp, part, 0)
        task.wait()
        firetouchinterest(hrp, part, 1)
    end
end

local function scanWorkspace()
    while isScanning do
        for _, obj in pairs(workspace:GetDescendants()) do
            if obj:IsA("BasePart") and obj.Name == "adminGiver" and obj:FindFirstChildWhichIsA("TouchTransmitter") then
                fireAdminGiver(obj)
            end
        end
        task.wait(1)
    end
end

ToggleBtn.MouseButton1Click:Connect(function()
    isScanning = not isScanning
    local targetColor = isScanning and Color3.fromRGB(50, 200, 100) or Color3.fromRGB(200, 50, 50)
    local targetText = isScanning and "ON" or "OFF"
    
    local tweenInfo = TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    TweenService:Create(ToggleBtn, tweenInfo, {BackgroundColor3 = targetColor}):Play()
    ToggleBtn.Text = targetText
    
    if isScanning then task.spawn(scanWorkspace) end
end)

-- === منطق واقعی Server Hop ===
local function performServerHop()
    ServerHopBtn.Text = "Hopping..."
    
    -- 1. اول به اگزکیوتور میگیم که اسکریپت گیت‌هاب رو بعد از تلپورت اجرا کنه
    local scriptToExecute = [[loadstring(game:HttpGet("https://raw.githubusercontent.com/ermiya1231/Script1/refs/heads/main/obby"))()]]
    local queue = queue_on_teleport or (syn and syn.queue_on_teleport) or (fluxus and fluxus.queue_on_teleport)
    if queue then
        queue(scriptToExecute)
    else
        warn("اگزکیوتور شما از قابلیت queue_on_teleport پشتیبانی نمی‌کند!")
    end

    -- 2. دریافت لیست سرورهای بازی
    local placeId = game.PlaceId
    local req = request or http_request or (http and http.request) or syn.request
    
    if req then
        local success, response = pcall(function()
            return req({
                Url = "https://games.roblox.com/v1/games/" .. placeId .. "/servers/Public?sortOrder=Desc&limit=100",
                Method = "GET"
            })
        end)

        if success and response and response.Body then
            local data = HttpService:JSONDecode(response.Body)
            local servers = {}
            
            -- فیلتر کردن سرورهایی که جا دارند و سرور فعلی ما نیستند
            if data and data.data then
                for _, v in pairs(data.data) do
                    if type(v) == "table" and v.playing < v.maxPlayers and v.id ~= game.JobId then
                        table.insert(servers, v.id)
                    end
                end
            end
            
            -- 3. انتقال بازیکن به یک سرور تصادفی از لیست
            if #servers > 0 then
                local randomServerId = servers[math.random(1, #servers)]
                TeleportService:TeleportToPlaceInstance(placeId, randomServerId, LocalPlayer)
                return
            end
        end
    end
    
    -- اگر پیدا نکرد یا ریکوئست مشکل داشت، به یک سرور معمولی تلپورت می‌کنه
    TeleportService:Teleport(placeId, LocalPlayer)
end

ServerHopBtn.MouseButton1Click:Connect(function()
