--------------------------------------------------------------------
-- Serializer
--------------------------------------------------------------------
local function escStr(s)
	s = s:gsub("[%c\"\\\128-\255]", function(c)
		return string.format("\\x%02X", c:byte())
	end)
	return '"' .. s .. '"'
end

local function hexOf(s)
	return (s:gsub(".", function(c) return string.format("%02X ", c:byte()) end))
end

local function isIdent(s)
	return type(s) == "string" and s:match("^[%a_][%w_]*$") ~= nil
end

local function instPath(inst)
	local parts, cur = {}, inst
	while cur and cur ~= game do
		table.insert(parts, 1, cur)
		cur = cur.Parent
	end
	if cur ~= game then
		return "nil --[[nil instance: " .. inst.Name .. " (" .. inst.ClassName .. ")]]"
	end
	local out = "game"
	for i, o in ipairs(parts) do
		if i == 1 then
			out = out .. ":GetService(" .. escStr(o.ClassName) .. ")"
			-- اگر سرویس نبود، با نام می‌گیریم
			local ok = pcall(function() return game:GetService(o.ClassName) end)
			if not ok or game:GetService(o.ClassName) ~= o then
				out = "game[" .. escStr(o.Name) .. "]"
			end
		else
			out = out .. (isIdent(o.Name) and ("." .. o.Name) or ("[" .. escStr(o.Name) .. "]"))
		end
	end
	return out
end

local function num(n)
	if n ~= n then return "0/0" end
	if n == math.huge then return "math.huge" end
	if n == -math.huge then return "-math.huge" end
	if n == math.floor(n) and math.abs(n) < 1e15 then return string.format("%d", n) end
	return string.format("%.17g", n)
end

local ser
function ser(v, depth)
	depth = depth or 0
	local t = typeof(v)
	if t == "nil" then return "nil"
	elseif t == "boolean" then return tostring(v)
	elseif t == "number" then return num(v)
	elseif t == "string" then return escStr(v)
	elseif t == "buffer" then
		return string.format("buffer.fromstring(%s)", escStr(buffer.tostring(v)))
	elseif t == "Instance" then return instPath(v)
	elseif t == "Vector3" then return string.format("Vector3.new(%s, %s, %s)", num(v.X), num(v.Y), num(v.Z))
	elseif t == "Vector2" then return string.format("Vector2.new(%s, %s)", num(v.X), num(v.Y))
	elseif t == "CFrame" then
		local c = {v:GetComponents()}
		for i = 1, #c do c[i] = num(c[i]) end
		return "CFrame.new(" .. table.concat(c, ", ") .. ")"
	elseif t == "Color3" then return string.format("Color3.new(%s, %s, %s)", num(v.R), num(v.G), num(v.B))
	elseif t == "UDim2" then
		return string.format("UDim2.new(%s, %s, %s, %s)", num(v.X.Scale), num(v.X.Offset), num(v.Y.Scale), num(v.Y.Offset))
	elseif t == "UDim" then return string.format("UDim.new(%s, %s)", num(v.Scale), num(v.Offset))
	elseif t == "EnumItem" then return tostring(v)
	elseif t == "BrickColor" then return string.format("BrickColor.new(%s)", escStr(v.Name))
	elseif t == "Ray" then return string.format("Ray.new(%s, %s)", ser(v.Origin), ser(v.Direction))
	elseif t == "table" then
		if depth > 8 then return "{} --[[max depth]]" end
		local parts, n = {}, 0
		for _ in pairs(v) do n = n + 1 end
		local isArray = (n == #v)
		if n == 0 then return "{}" end
		if isArray then
			for i = 1, #v do parts[#parts + 1] = ser(v[i], depth + 1) end
		else
			for k, val in pairs(v) do
				local key = isIdent(k) and k or ("[" .. ser(k, depth + 1) .. "]")
				parts[#parts + 1] = key .. " = " .. ser(val, depth + 1)
			end
		end
		return "{" .. table.concat(parts, ", ") .. "}"
	end
	return "nil --[[" .. t .. ": " .. tostring(v) .. "]]"
end

-- کپی عمیق (بافر در لحظه‌ی ارسال snapshot می‌شود چون ممکنه بعداً تغییر کنه)
local function snap(v, depth)
	depth = depth or 0
	local t = typeof(v)
	if t == "buffer" then
		return buffer.fromstring(buffer.tostring(v))
	elseif t == "table" and depth < 8 then
		local c = {}
		for k, val in pairs(v) do c[k] = snap(val, depth + 1) end
		return c
	end
	return v
end

local function collectBuffers(v, out, depth)
	depth = depth or 0
	if typeof(v) == "buffer" then
		out[#out + 1] = v
	elseif type(v) == "table" and depth < 8 then
		for _, val in pairs(v) do collectBuffers(val, out, depth + 1) end
	end
end

