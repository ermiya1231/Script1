fireBtn.MouseButton1Click:Connect(function()
	if not selected then return end
	local e = selected
	task.spawn(function()
		local ok, err = pcall(function()
			-- از نسخه‌ی snapshot شده (بافر واقعی) استفاده می‌کند
			if e.method == "InvokeServer" then
				e.remote:InvokeServer(unpack(e.args, 1, e.n))
			else
				e.remote:FireServer(unpack(e.args, 1, e.n))
			end
		end)
		fireBtn.Text = ok and "Fired!" or "Error"
		if not ok then warn("[OutgoingLogger]", err) end
		task.delay(1, function() fireBtn.Text = "Fire Again" end)
	end)
end)

