-- Dynamic Custom Spawn Point Management
getgenv().HumanBulletConnection = player.CharacterAdded:Connect(function(newChar)
	if lastLaunchCFrame then
		task.spawn(function()
			local hrp = newChar:WaitForChild("HumanoidRootPart", 5)
			if hrp then
				task.wait(0.05)
				hrp.CFrame = lastLaunchCFrame + Vector3.new(0, 3, 0)
			end
		end)
	end
end)

-- Launch Logic
button.MouseButton1Click:Connect(function()
	local character = player.Character
	if not character then return end

	local humanoidRootPart = character:FindFirstChild("HumanoidRootPart")
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local head = character:FindFirstChild("Head")

	if head then
		local sound = Instance.new("Sound")
		sound.Parent = head
		sound.SoundId = "rbxassetid://133773862421542"
		sound.Volume = 0.5
		sound:Play()
		Debris:AddItem(sound, 2)
	end

	if humanoidRootPart and humanoid then
		lastLaunchCFrame = humanoidRootPart.CFrame

		local lookVector = humanoidRootPart.CFrame.LookVector
		local launchDirection = (lookVector * forwardVal) + Vector3.new(0, upwardVal, 0)
		humanoidRootPart.AssemblyLinearVelocity = launchDirection

		task.delay(deathDelayVal, function()
			if humanoid and humanoid.Health > 0 then
				humanoid.Health = 0
			end
		end)
	end
end)
