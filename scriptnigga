-- Position of one hat for the current mode
-- i = hat number, n = hat count, a = orbit angle, t = time
local function getOffset(mode, i, n, a, t)
	local frac = i / n
	if mode == "Ring" then
		local ang = a + frac * math.pi * 2
		return Vector3.new(math.cos(ang) * ORBIT_RADIUS, math.sin(t * 1.5 + i) * BOB_AMOUNT, math.sin(ang) * ORBIT_RADIUS)

	elseif mode == "Vertical Ring" then
		local ang = a + frac * math.pi * 2
		local p = Vector3.new(math.cos(ang) * ORBIT_RADIUS, math.sin(ang) * ORBIT_RADIUS, 0)
		return CFrame.Angles(0, t * 0.6, 0):VectorToWorldSpace(p)

	elseif mode == "Sphere" then
		local y = 1 - 2 * (i - 0.5) / n
		local r = math.sqrt(math.max(0, 1 - y * y))
		local phi = i * 2.399963
		local p = Vector3.new(math.cos(phi) * r, y, math.sin(phi) * r) * ORBIT_RADIUS
		return (CFrame.Angles(0, a, 0) * CFrame.Angles(a * 0.5, 0, 0)):VectorToWorldSpace(p)

	elseif mode == "Tornado" then
		local ang = a * 1.5 + i * 1.1
		local height = frac * 9 - 3
		local radius = ORBIT_RADIUS * (0.35 + 0.65 * frac)
		return Vector3.new(math.cos(ang) * radius, height, math.sin(ang) * radius)

	else -- Infinity
		local s = a + frac * math.pi * 2
		local d = 1 + math.sin(s) ^ 2
		return Vector3.new(
			ORBIT_RADIUS * 1.4 * math.cos(s) / d,
			math.sin(t * 1.5 + i) * BOB_AMOUNT,
			ORBIT_RADIUS * 2.2 * math.sin(s) * math.cos(s) / d
		)
	end
end

-- Cut the weld of an accessory so its Handle becomes a free part we can move
local function grabAccessory(accessory)
	local handle = accessory:FindFirstChild("Handle") or accessory:WaitForChild("Handle", 2)
	if not (handle and handle:IsA("BasePart")) then return end
	for _, child in ipairs(handle:GetChildren()) do
		if child:IsA("Weld") or child:IsA("WeldConstraint") or child:IsA("Motor6D") or child:IsA("ManualWeld") then
			child:Destroy()
		end
	end
	handle.Massless = false
	handle.CanCollide = false
	if not table.find(orbitHandles, handle) then
		table.insert(orbitHandles, handle)
	end
end

-- Place every hat on its orbit spot around the body
local function placeAll()
	if not orbitActive then return end

	local hrp = orbitChar and orbitChar:FindFirstChild("HumanoidRootPart")
	if hrp then
		lastCenter = hrp.Position
	end
	if not lastCenter then return end

	local ramp = math.clamp((os.clock() - orbitStartClock) / RAMP_TIME, 0, 1)
	local center = lastCenter + Vector3.new(0, ORBIT_HEIGHT, 0)
	local mode = orbitModes[orbitModeIndex]
	local n = #orbitHandles

	for i, handle in ipairs(orbitHandles) do
		if handle:IsDescendantOf(Workspace) then
			local offset = getOffset(mode, i, n, orbitAngle, orbitTime) * ramp
			handle.CFrame = CFrame.new(center + offset) * CFrame.Angles(0, orbitTime * SPIN_SPEED + i, 0)
		end
	end
end

-- Keep network ownership of the hats so OTHER PLAYERS see them orbit
local function keepOwnership()
	pcall(function() sethiddenproperty(player, "SimulationRadius", 1e9) end)
	pcall(function() sethiddenproperty(player, "MaximumSimulationRadius", 1e9) end)
end

-- NETLESS: small velocity every frame so you keep ownership of the hats
local function applyNetless()
	if not orbitActive then return end
	netlessSign = -netlessSign
	local vel = Vector3.new(0, NETLESS_SPEED * netlessSign, 0)
	for _, handle in ipairs(orbitHandles) do
		if handle:IsDescendantOf(Workspace) then
			handle.AssemblyLinearVelocity = vel
			handle.AssemblyAngularVelocity = Vector3.zero
		end
	end
end

-- Kill the character in a way the SERVER sees too:
-- ChangeState(Dead) is replicated from the owner, and the server then breaks the joints
-- (that is what really frees the hats for everyone).
local function killCharacter(hum)
	pcall(function() hum:ChangeState(Enum.HumanoidStateType.Dead) end)
	hum.Health = 0
	task.delay(0.3, function()
		if hum and hum.Parent then
			pcall(function() hum:ChangeState(Enum.HumanoidStateType.Dead) end)
			hum.Health = 0
		end
	end)
end

local function stopOrbit()
	for _, conn in ipairs(orbitConns) do
		conn:Disconnect()
	end
	orbitConns = {}
	orbitActive = false
	orbitHandles = {}
	orbitChar = nil
	lastCenter = nil

	orbitButton.Text = "HAT ORBIT"
	orbitButton.BackgroundColor3 = Color3.fromRGB(40, 100, 180)
end

local function startOrbit()
	if orbitActive then return end

	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if not (hum and hrp) or hum.Health <= 0 then return end

	-- You respawn where you died
	lastLaunchCFrame = hrp.CFrame

	orbitActive = true
	orbitStartClock = os.clock()
	orbitAngle = 0
	orbitTime = 0
	orbitChar = char
	orbitHandles = {}
	lastCenter = hrp.Position

	-- Network ownership (client side way) + keep replicating around the world
	pcall(function() player.ReplicationFocus = Workspace end)
	pcall(function() settings().Physics.AllowSleep = false end)
	keepOwnership()

	-- Free every hat from the head
	for _, accessory in ipairs(hum:GetAccessories()) do
		task.spawn(grabAccessory, accessory)
	end

	-- Before physics, after physics (+ netless) and every rendered frame
	table.insert(orbitConns, RunService.Stepped:Connect(function()
		placeAll()
	end))
	table.insert(orbitConns, RunService.Heartbeat:Connect(function()
		placeAll()
		applyNetless()
		keepOwnership()
	end))
	table.insert(orbitConns, RunService.RenderStepped:Connect(function(dt)
		orbitAngle = orbitAngle + orbitSpeed * dt
		orbitTime = orbitTime + dt
		placeAll()

		-- The orbit ends when you respawn (the old body is removed) or after the safety limit
		if not (orbitChar and orbitChar:IsDescendantOf(Workspace)) or orbitTime > MAX_ORBIT_TIME then
			stopOrbit()
		end
	end))

	orbitButton.Text = "ORBITING..."
	orbitButton.BackgroundColor3 = Color3.fromRGB(50, 180, 90)

	killCharacter(hum)
end

orbitButton.MouseButton1Click:Connect(startOrbit)

-- So the close button / re-running the script can stop everything cleanly
getgenv().HumanBulletCleanup = function()
	stopOrbit()
end

