-- Logic
--------------------------------------------------------------------
local function matches(e)
	return filterText == "" or e.remoteName:lower():find(filterText:lower(), 1, true) ~= nil
end

local function refreshStatus()
	status.Text = #logs .. " logs" .. (paused and " (paused)" or "")
end

local function selectLog(e)
	selected = e
	codeBox.Text = e.code
	for _, l in ipairs(logs) do
		if l.btn then
			l.btn.BackgroundColor3 = (l == e) and Color3.fromRGB(70, 70, 110) or Color3.fromRGB(34, 34, 44)
		end
	end
end

local function addButton(e)
	local b = Instance.new("TextButton")
	b.Size = UDim2.new(1, -6, 0, 38)
	b.BackgroundColor3 = Color3.fromRGB(34, 34, 44)
	b.BorderSizePixel = 0
	b.Text = string.format("[%s] #%d %s\n%s  |  %s", e.time, e.id, e.method, e.remoteName, e.summary)
	b.TextColor3 = Color3.fromRGB(230, 230, 235)
	b.Font = Enum.Font.Code
	b.TextSize = 11
	b.TextXAlignment = Enum.TextXAlignment.Left
	b.TextTruncate = Enum.TextTruncate.AtEnd
	b.LayoutOrder = -e.id
	b.Visible = matches(e)
	b.Parent = list
	b.MouseButton1Click:Connect(function() selectLog(e) end)
	e.btn = b
end

local function build(e)
	local bufs = {}
	collectBuffers(e.args, bufs)
	local argStrs = {}
	for i = 1, e.n do argStrs[i] = ser(e.args[i]) end

	local summary = {}
	for i, b in ipairs(bufs) do summary[#summary + 1] = "buf" .. i .. ":" .. buffer.len(b) .. "B" end
	e.summary = #summary > 0 and table.concat(summary, ",") or (e.n .. " args")

	local head = {
		"-- Time: " .. e.fullTime,
		"-- Remote: " .. e.remotePath,
		"-- Method: " .. e.method .. " | Args: " .. e.n,
	}
	e.hexes = {}
	for i, b in ipairs(bufs) do
		local h = hexOf(buffer.tostring(b))
		e.hexes[i] = h
		head[#head + 1] = string.format("-- Buffer %d (%d bytes): %s", i, buffer.len(b), h)
	end

	local call = (e.method == "InvokeServer") and "local result = remote:InvokeServer(" or "remote:FireServer("
	e.code = table.concat(head, "\n") .. "\n\nlocal remote = " .. e.remotePath .. "\n"
		.. call .. table.concat(argStrs, ", ") .. ")"
end

local counter = 0
local function record(remote, method, args, n)
	counter += 1
	local e = {
		id = counter,
		remote = remote,
		remoteName = remote.Name,
		method = method,
		args = args,
		n = n,
		time = os.date("%H:%M:%S"),
		fullTime = os.date("%Y-%m-%d %H:%M:%S"),
	}
	local ok, err = pcall(function()
		e.remotePath = instPath(remote)
		build(e)
	end)
	if not ok then
		e.summary = "serialize error"
		e.code = "-- serialize error: " .. tostring(err)
		e.hexes = {}
	end
	table.insert(logs, e)
	addButton(e)
	if #logs > MAX_LOGS then
		local old = table.remove(logs, 1)
		if old.btn then old.btn:Destroy() end
	end
	refreshStatus()
end

-- Hook
local inHook = false
local oldNc
oldNc = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
	local method = getnamecallmethod()
	if not paused and (method == "FireServer" or method == "InvokeServer")
		and not checkcaller() and typeof(self) == "Instance"
		and (self.ClassName == "RemoteEvent" or self.ClassName == "RemoteFunction"
			or self.ClassName == "UnreliableRemoteEvent") then
		local n = select("#", ...)
		local args = {}
		local raw = {...}
		for i = 1, n do args[i] = snap(raw[i]) end -- snapshot همزمان
		task.defer(record, self, method, args, n)
	end
	if setnamecallmethod then setnamecallmethod(method) end
	if method == "FireServer" then
		inHook = true
		local r = table.pack(oldNc(self, ...))
		inHook = false
		return table.unpack(r, 1, r.n)
	end
	return oldNc(self, ...)
end))

-- Fallback: وقتی بازی FireServer را به‌صورت تابع کش کرده (بدون namecall)
pcall(function()
	if not hookfunction then return end
	local function wrap(method, orig)
		return newcclosure(function(self, ...)
			if not inHook and not paused and not checkcaller() and typeof(self) == "Instance" then
				local n = select("#", ...)
				local raw = {...}
				local args = {}
				for i = 1, n do args[i] = snap(raw[i]) end
				task.defer(record, self, method, args, n)
			end
			return orig(self, ...)
		end)
	end
	local re = Instance.new("RemoteEvent")
	local oldFire
	oldFire = hookfunction(re.FireServer, wrap("FireServer", function(...) return oldFire(...) end))
	local rf = Instance.new("RemoteFunction")
	local oldInvoke
	oldInvoke = hookfunction(rf.InvokeServer, wrap("InvokeServer", function(...) return oldInvoke(...) end))
end)

