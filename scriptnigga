-- =====================================================================
-- HAT ORBIT (left side panel)
-- One click: your character dies (server-visible death) and your hats
-- orbit around the body until you respawn. You respawn where you died.
-- Other players see the hats orbit, because we keep network ownership.
-- =====================================================================

-- Orbit settings (edit freely)
local ORBIT_RADIUS = 5        -- distance of the hats from the body (studs)
local ORBIT_HEIGHT = 0.5      -- height of the orbit center above the body
local BOB_AMOUNT = 1          -- up/down bobbing of the hats
local SPIN_SPEED = 3          -- how fast each hat spins on itself
local RAMP_TIME = 1.5         -- seconds to smoothly open the orbit after the click
local MAX_ORBIT_TIME = 30     -- safety limit (the orbit also ends when you respawn)
local NETLESS_SPEED = 25.05   -- netless velocity (keeps hats owned by you)

