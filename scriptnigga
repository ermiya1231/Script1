local orbitActive = false
local orbitSpeed = 2
local orbitModes = { "Ring", "Vertical Ring", "Sphere", "Tornado", "Infinity" }
local orbitModeIndex = 1
local orbitAngle = 0
local orbitTime = 0
local orbitStartClock = 0
local orbitConns = {}
local orbitChar = nil
local orbitHandles = {}
local lastCenter = nil
local netlessSign = 1

