-- [ Core Reach Logic ] --
local plr = game.Players.LocalPlayer
local hitCooldowns = {}
setmetatable(hitCooldowns, {__mode = "k"})

local function onHit(hit, handle)
    local char = hit.Parent
    local victim = char:FindFirstChildOfClass("Humanoid")
    
    if victim and char.Name ~= plr.Name then
        if hitCooldowns[char] and (tick() - hitCooldowns[char]) < 0.1 then
            return 
        end
        hitCooldowns[char] = tick()

        if dmgEnabled then
            for _,v in pairs(char:GetChildren()) do
                if v:IsA("Part") or v:IsA("MeshPart") then
                    firetouchinterest(v, handle, 0)
                    firetouchinterest(v, handle, 1)
                end
            end
        else
            firetouchinterest(hit, handle, 0)
            firetouchinterest(hit, handle, 1)
        end
    end
end

local function getWhiteList()
    local wl = {}
    for _,v in pairs(game.Players:GetPlayers()) do
        if v ~= plr and v.Character then
            for _,q in pairs(v.Character:GetChildren()) do
                if q:IsA("Part") then table.insert(wl, q) end
            end
        end
    end
    return wl
end

game:GetService("RunService").RenderStepped:Connect(function()
    if not active or not trueActive then return end
    local s = plr.Character and plr.Character:FindFirstChildOfClass("Tool")
    
    if not s then 
        visualizer.Parent = nil
        restoreAll()
        lastAppliedReach = -1
        lastTool = nil
        return
    end

    local handle = s:FindFirstChild("Handle") or s:FindFirstChildOfClass("Part")
    if handle then
        local reach = tonumber(TextBox.Text)
        if not reach then return end

        if currentMode == "Enlarge Tool" then
            visualizer.Parent = nil 

            -- فقط زمانی تغییرات اعمال می‌شود که اسلایدر جابجا شده باشد (جلوگیری از گلیچ فریم)
            if reach ~= lastAppliedReach or lastAppliedMode ~= "Enlarge Tool" or lastTool ~= s then
                lastAppliedReach = reach
                lastAppliedMode = "Enlarge Tool"
                lastTool = s

                -- محاسبه ضریب سایز
                if not originalProperties[handle] then
                    local mesh = handle:FindFirstChildOfClass("SpecialMesh")
                    originalProperties[handle] = {
                        Size = handle.Size,
                        Transparency = handle.Transparency,
                        Massless = handle.Massless,
                        CanCollide = handle.CanCollide,
                        MeshScale = mesh and mesh.Scale or nil
                    }
                end
                
                local origSize = originalProperties[handle].Size
                local maxDim = math.max(origSize.X, origSize.Y, origSize.Z)
                if maxDim == 0 then maxDim = 1 end
                local scaleFactor = reach / maxDim

                -- بزرگ‌نمایی تمام قطعات داخلی ابزار
                for _, part in pairs(s:GetDescendants()) do
                    if part:IsA("BasePart") then
                        if not originalProperties[part] then
                            local mesh = part:FindFirstChildOfClass("SpecialMesh")
                            originalProperties[part] = {
                                Size = part.Size,
                                Transparency = part.Transparency,
                                Massless = part.Massless,
                                CanCollide = part.CanCollide,
                                MeshScale = mesh and mesh.Scale or nil
                            }
                        end
                        
                        part.Size = originalProperties[part].Size * scaleFactor
                        part.Transparency = 0.7
                        part.Massless = true
                        part.CanCollide = false

                        local mesh = part:FindFirstChildOfClass("SpecialMesh")
                        if mesh and originalProperties[part].MeshScale then
                            mesh.Scale = originalProperties[part].MeshScale * scaleFactor
                        end
                        
                    elseif part:IsA("Weld") or part:IsA("Motor6D") or part:IsA("ManualWeld") then
                        -- حل مشکل Character: فقط اتصالاتی که هر دو سر آن‌ها داخل خود شمشیر است تغییر می‌کنند!
                        if part.Part0 and part.Part1 and part.Part0:IsDescendantOf(s) and part.Part1:IsDescendantOf(s) then
                            if not originalProperties[part] then
                                originalProperties[part] = { C0 = part.C0, C1 = part.C1 }
                            end
                            local origC0 = originalProperties[part].C0
                            local origC1 = originalProperties[part].C1
                            
                            -- فاصله قطعات شمشیر از هم به نسبت سایز بزرگ می‌شود
                            part.C0 = CFrame.new(origC0.Position * scaleFactor) * origC0.Rotation
                            part.C1 = CFrame.new(origC1.Position * scaleFactor) * origC1.Rotation
                        end
                    end
                end
            end

        else
            -- حالت Fake Signal
            if lastAppliedMode == "Enlarge Tool" then
                restoreAll()
                lastAppliedReach = -1
                lastAppliedMode = "Fake Signal"
            end

            visualizer.Parent = visualizerEnabled and workspace or nil

            if reachType == "Sphere" then
                visualizer.Shape = Enum.PartType.Ball
                visualizer.Size = Vector3.new(reach, reach, reach)
                visualizer.CFrame = handle.CFrame
                for _,v in pairs(game.Players:GetPlayers()) do
                    local hrp = v.Character and v.Character:FindFirstChild("HumanoidRootPart")
                    if hrp and handle and (hrp.Position - handle.Position).Magnitude <= reach then
                        onHit(hrp, handle)
                    end
                end
                
            elseif reachType == "Line" then
                local origin = (handle.CFrame * CFrame.new(0, 0, -2)).p
                local ray = Ray.new(origin, handle.CFrame.lookVector * -reach)
                local p, pos = workspace:FindPartOnRayWithWhitelist(ray, getWhiteList())
                visualizer.Shape = Enum.PartType.Block
                visualizer.Size = Vector3.new(1, 0.8, reach)
                visualizer.CFrame = handle.CFrame * CFrame.new(0, 0, (reach/2) + 2)
                if p then
                    onHit(p, handle)
                else
                    for _,v in pairs(handle:GetTouchingParts()) do
                        onHit(v, handle)
                    end
                end
                
            elseif reachType == "Cube" then
                visualizer.Shape = Enum.PartType.Block
                visualizer.Size = Vector3.new(reach, reach, reach)
                visualizer.CFrame = handle.CFrame
                
                for _,v in pairs(game.Players:GetPlayers()) do
                    local hrp = v.Character and v.Character:FindFirstChild("HumanoidRootPart")
                    if hrp and handle then
                        local localPos = handle.CFrame:PointToObjectSpace(hrp.Position)
                        if math.abs(localPos.X) <= reach/2 and math.abs(localPos.Y) <= reach/2 and math.abs(localPos.Z) <= reach/2 then
                            onHit(hrp, handle)
                        end
                    end
                end
            end
        end
    end
end)
