-- [ Dragging Logic ] --
local dragging, dragInput, dragStart, startPos
MainFrame.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = MainFrame.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)
MainFrame.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        dragInput = input
    end
end)
game:GetService("UserInputService").InputChanged:Connect(function(input)
    if input == dragInput and dragging then
        local delta = input.Position - dragStart
        MainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)

-- [ Slider Logic ] --
local mouse = game.Players.LocalPlayer:GetMouse()
local uis = game:GetService("UserInputService")
local sliderActive = false
local minReach, maxReach = 1, 100

local function updateSlider()
    local percent = math.clamp((mouse.X - SliderTrack.AbsolutePosition.X) / SliderTrack.AbsoluteSize.X, 0, 1)
    SliderFill.Size = UDim2.new(percent, 0, 1, 0)
    SliderKnob.Position = UDim2.new(percent, 0, 0.5, 0) 
    local value = math.floor((minReach + ((maxReach - minReach) * percent)) * 10) / 10
    TextBox.Text = tostring(value)
end

local initPercent = (3.5 - minReach) / (maxReach - minReach)
SliderFill.Size = UDim2.new(initPercent, 0, 1, 0)
SliderKnob.Position = UDim2.new(initPercent, 0, 0.5, 0)

SliderBtn.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        sliderActive = true
        updateSlider()
    end
end)
uis.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        sliderActive = false
    end
end)
uis.InputChanged:Connect(function(input)
    if sliderActive and input.UserInputType == Enum.UserInputType.MouseMovement then
        updateSlider()
    end
end)
TextBox.FocusLost:Connect(function()
    local val = tonumber(TextBox.Text)
    if val then
        val = math.clamp(val, minReach, maxReach)
        TextBox.Text = tostring(val)
        local p = (val - minReach) / (maxReach - minReach)
        SliderFill.Size = UDim2.new(p, 0, 1, 0)
        SliderKnob.Position = UDim2.new(p, 0, 0.5, 0)
    end
end)

-- [ Buttons Logic ] --
local ts = game:GetService("TweenService")

local fakeSignalShapes = {"Sphere", "Line", "Cube"}
local enlargeShapes = {"Tool Mesh", "Sphere", "Line", "Cube", "All Map"}

-- حالت پیش فرض: Enlarge Tool
local currentShapes = enlargeShapes
local currentShapeIdx = 1
local reachType = currentShapes[currentShapeIdx]
ShapeBtn.Text = reachType

local originalProperties = {}
local lastAppliedReach = -1
local lastAppliedMode = ""
local lastAppliedShape = ""
local lastTool = nil

local function restoreObject(obj)
    if obj and originalProperties[obj] then
        local props = originalProperties[obj]
        if obj:IsA("BasePart") then
            obj.Size = props.Size
            obj.Transparency = props.Transparency
            obj.Massless = props.Massless
            obj.CanCollide = props.CanCollide
            
            local tempMesh = obj:FindFirstChild("C00LREACH_TempMesh")
            if tempMesh then tempMesh:Destroy() end
            
            if props.ExistingMesh then
                props.ExistingMesh.Parent = obj
                props.ExistingMesh.Scale = props.MeshScale
            end
        elseif obj:IsA("Tool") then
            obj.Grip = props.Grip
        elseif obj:IsA("Weld") or obj:IsA("Motor6D") or obj:IsA("ManualWeld") then
            obj.C0 = props.C0
            obj.C1 = props.C1
        end
        originalProperties[obj] = nil
    end
end

local function restoreAll()
    for obj, _ in pairs(originalProperties) do
        restoreObject(obj)
    end
end

