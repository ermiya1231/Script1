-- [ Core Reach Logic ] --
local plr = game.Players.LocalPlayer
local hitCooldowns = {}
setmetatable(hitCooldowns, {__mode = "k"})

local function onHit(hitPart, handle)
    if not hitPart or not hitPart.Parent then return end
    local char = hitPart.Parent
    local victim = char:FindFirstChildOfClass("Humanoid")
    
    if victim and victim.Health > 0 and char.Name ~= plr.Name then
        local currentTime = tick()
        if hitCooldowns[char] and (currentTime - hitCooldowns[char]) < 0.1 then
            return 
        end
        hitCooldowns[char] = currentTime

        firetouchinterest(hitPart, handle, 0)
        firetouchinterest(hitPart, handle, 1)
    end
end

game:GetService("RunService").RenderStepped:Connect(function()
    if not active or not trueActive then return end
    local s = plr.Character and plr.Character:FindFirstChildOfClass("Tool")
    
    if not s then 
        visualizer.Parent = nil
        restoreAll()
        lastAppliedReach = -1
        lastAppliedShape = ""
        lastTool = nil
        return
    end

    local handle = s:FindFirstChild("Handle") or s:FindFirstChildOfClass("Part")
    if handle then
        local reach = tonumber(TextBox.Text)
        if not reach then return end

        if currentMode == "Enlarge Tool" then
            visualizer.Parent = nil 

            if reach ~= lastAppliedReach or lastAppliedMode ~= "Enlarge Tool" or lastTool ~= s or lastAppliedShape ~= reachType then
                if lastAppliedShape ~= reachType then
                    restoreAll()
                end

                lastAppliedReach = reach
                lastAppliedMode = "Enlarge Tool"
                lastAppliedShape = reachType
                lastTool = s

                if not originalProperties[handle] then
                    local existingMesh = handle:FindFirstChildOfClass("SpecialMesh")
                    originalProperties[handle] = {
                        Size = handle.Size,
                        Transparency = handle.Transparency,
                        Massless = handle.Massless,
                        CanCollide = handle.CanCollide,
                        ExistingMesh = existingMesh,
                        MeshScale = existingMesh and existingMesh.Scale or nil
                    }
                end
                
                local origSize = originalProperties[handle].Size
                local maxDim = math.max(origSize.X, origSize.Y, origSize.Z)
                if maxDim == 0 then maxDim = 1 end
                local scaleFactor = reach / maxDim
                
                local tempMesh = handle:FindFirstChild("C00LREACH_TempMesh")

                if reachType == "Tool Mesh" then
                    if tempMesh then tempMesh:Destroy() end
                    handle.Size = origSize * scaleFactor
                    handle.Transparency = 0.7
                    handle.Massless = true
                    handle.CanCollide = false
                    
                    if originalProperties[handle].ExistingMesh then
                        originalProperties[handle].ExistingMesh.Parent = handle
                        originalProperties[handle].ExistingMesh.Scale = originalProperties[handle].MeshScale * scaleFactor
                    end
                else
                    if originalProperties[handle].ExistingMesh then
                        originalProperties[handle].ExistingMesh.Parent = nil
                    end
                    
                    if not tempMesh then
                        tempMesh = Instance.new("SpecialMesh")
                        tempMesh.Name = "C00LREACH_TempMesh"
                        tempMesh.Parent = handle
                    end

                    handle.Massless = true
                    handle.CanCollide = false
                    
                    if reachType == "Sphere" then
                        handle.Size = Vector3.new(reach, reach, reach)
                        handle.Transparency = 0.7
                        tempMesh.MeshType = Enum.MeshType.Sphere
                        tempMesh.Scale = Vector3.new(1, 1, 1)
                    elseif reachType == "Cube" then
                        handle.Size = Vector3.new(reach, reach, reach)
                        handle.Transparency = 0.7
                        tempMesh.MeshType = Enum.MeshType.Brick
                        tempMesh.Scale = Vector3.new(1, 1, 1)
                    elseif reachType == "Line" then
                        handle.Size = Vector3.new(0.5, 0.5, reach)
                        handle.Transparency = 0.7
                        tempMesh.MeshType = Enum.MeshType.Brick
                        tempMesh.Scale = Vector3.new(1, 1, 1)
                    elseif reachType == "All Map" then
                        handle.Size = Vector3.new(2048, 2048, 2048)
                        handle.Transparency = 1
                        tempMesh.MeshType = Enum.MeshType.Brick
                        tempMesh.Scale = Vector3.new(1, 1, 1)
                    end
                end
            end

        else
            -- حالت Fake Signal
            if lastAppliedMode == "Enlarge Tool" then
                restoreAll()
                lastAppliedReach = -1
                lastAppliedShape = ""
                lastAppliedMode = "Fake Signal"
            end

            visualizer.Parent = visualizerEnabled and workspace or nil

            if reachType == "Sphere" then
                visualizer.Shape = Enum.PartType.Ball
                visualizer.Size = Vector3.new(reach, reach, reach)
                visualizer.CFrame = handle.CFrame
                
                for _,v in pairs(game.Players:GetPlayers()) do
                    local hrp = v.Character and v.Character:FindFirstChild("HumanoidRootPart")
                    if hrp and handle and (hrp.Position - handle.Position).Magnitude <= (reach / 2) then
                        onHit(hrp, handle)
                    end
                end
                
            elseif reachType == "Line" then
                -- اصلاح منطق لاین (هم تراز کردن با CFrame هندل به سمت جلو)
                visualizer.Shape = Enum.PartType.Block
                visualizer.Size = Vector3.new(0.5, 0.5, reach)
                
                -- مختصات کشیده شده به سمت جلوی شمشیر/هندل
                local lineCFrame = handle.CFrame * CFrame.new(0, 0, reach/2)
                visualizer.CFrame = lineCFrame
                
                for _,v in pairs(game.Players:GetPlayers()) do
                    local hrp = v.Character and v.Character:FindFirstChild("HumanoidRootPart")
                    if hrp and handle then
                        -- محاسبه موقعیت بازیکن نسبت به این خط
                        local localPos = lineCFrame:PointToObjectSpace(hrp.Position)
                        
                        -- بررسی اینکه آیا بازیکن داخل باکس مستطیلی خط قرار دارد یا خیر
                        if math.abs(localPos.X) <= 1.5 and math.abs(localPos.Y) <= 1.5 and math.abs(localPos.Z) <= reach/2 then
                            onHit(hrp, handle)
                        end
                    end
                end
                
            elseif reachType == "Cube" then
                visualizer.Shape = Enum.PartType.Block
                visualizer.Size = Vector3.new(reach, reach, reach)
                visualizer.CFrame = handle.CFrame
                
                for _,v in pairs(game.Players:GetPlayers()) do
                    local hrp = v.Character and v.Character:FindFirstChild("HumanoidRootPart")
                    if hrp and handle then
                        local localPos = handle.CFrame:PointToObjectSpace(hrp.Position)
                        if math.abs(localPos.X) <= reach/2 and math.abs(localPos.Y) <= reach/2 and math.abs(localPos.Z) <= reach/2 then
                            onHit(hrp, handle)
                        end
                    end
                end
            end
        end
    end
end)
