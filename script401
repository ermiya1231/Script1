local order = 0
local liveRows = {}   -- ردیف‌هایی که مدام آپدیت می‌شن

local function fmt(k, v)
    if v == nil or v == "" then v = "N/A" end
    return string.format('<font color="#00b82e">%s</font> : %s', esc(k), esc(v))
end

local function newLabel(text)
    order = order + 1
    local l = Instance.new("TextLabel")
    l.Size = UDim2.new(1, 0, 0, 0)
    l.AutomaticSize = Enum.AutomaticSize.Y
    l.BackgroundTransparency = 1
    l.RichText = true
    l.Text = text
    l.TextColor3 = GREEN
    l.Font = Enum.Font.Code
    l.TextSize = 17
    l.TextWrapped = true
    l.TextXAlignment = Enum.TextXAlignment.Left
    l.TextYAlignment = Enum.TextYAlignment.Top
    l.LayoutOrder = order
    l.Parent = scroll
    return l
end

local function section(name)
    newLabel(string.format('<font color="#00ff46"><b>══ %s ══</b></font>', esc(name)))
end

-- ردیف ثابت
local function add(k, v)
    newLabel(fmt(k, v))
end

-- ردیف زنده: fn هر بار صدا زده می‌شه و فقط اگه مقدار عوض شده باشه متن تغییر می‌کنه
local function updateRow(r)
    local ok, val = pcall(r.fn)
    if not ok then val = nil end
    local text = fmt(r.key, val)
    if text ~= r.last then
        r.last = text
        r.label.Text = text
    end
end

local function addLive(k, fn)
    local r = {key = k, fn = fn, last = "", label = newLabel("")}
    table.insert(liveRows, r)
    updateRow(r)
end

local function updateLive()
    for _, r in ipairs(liveRows) do
        updateRow(r)
    end
end

