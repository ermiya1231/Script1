task.spawn(function()
    local ok, err = pcall(extract)
    loadingLabel:Destroy()
    if not ok then
        newLabel("> error: " .. esc(err))
        generalLabel.Text = "> error"
        return
    end

    -- آپدیت فوری موقع ورود و خروج پلیرها
    table.insert(connections, Players.PlayerAdded:Connect(function()
        task.defer(updateLive)
    end))
    table.insert(connections, Players.PlayerRemoving:Connect(function()
        task.defer(updateLive)
    end))

    -- حلقه آپدیت سرور (هر LIVE_INTERVAL ثانیه)
    task.spawn(function()
        local blink = false
        while gui.Parent do
            task.wait(LIVE_INTERVAL)
            if not gui.Parent then break end
            sampleFps()
            updateLive()
            blink = not blink
            liveDot.TextTransparency = blink and 0.6 or 0
        end
    end)

    -- حلقه آپدیت آمار سایت (هر API_INTERVAL ثانیه، توی ترد جدا تا لگ نیاد)
    task.spawn(function()
        while gui.Parent do
            task.wait(API_INTERVAL)
            if not gui.Parent then break end
            task.spawn(fetchApi)
        end
    end)
end)
