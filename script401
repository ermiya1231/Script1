local apiState = {g = nil, v = nil}

local function fetchApi()
    local universeId = game.GameId
    local gameData = getJSON("https://games.roblox.com/v1/games?universeIds=" .. universeId)
    local g = gameData and gameData.data and gameData.data[1] or nil
    if g then apiState.g = g end

    local votesData = getJSON("https://games.roblox.com/v1/games/votes?universeIds=" .. universeId)
    local v = votesData and votesData.data and votesData.data[1] or nil
    if v then apiState.v = v end
end

-- FPS کلاینت
local frames, fps, lastT = 0, 0, os.clock()
local hbConn = RunService.Heartbeat:Connect(function()
    frames = frames + 1
end)

local function sampleFps()
    local now = os.clock()
    local dt = now - lastT
    if dt > 0 then
        fps = frames / dt
    end
    frames = 0
    lastT = now
end

