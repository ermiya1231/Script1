-- توابع کمکی
------------------------------------------------------------
local function esc(s)
    return (tostring(s):gsub("&", "&amp;"):gsub("<", "&lt;"):gsub(">", "&gt;"))
end

local function commas(n)
    local r = tostring(n):reverse():gsub("(%d%d%d)", "%1,"):reverse():gsub("^,", "")
    return r
end

-- تاریخ به شکل: 2024/5/1 (2 Years Ago)
local function formatDate(iso)
    if type(iso) ~= "string" then return "N/A" end
    local y, m, d = iso:match("^(%d+)%-(%d+)%-(%d+)")
    if not y then return iso end
    y, m, d = tonumber(y), tonumber(m), tonumber(d)

    local ago = ""
    local ok, then_ = pcall(os.time, {year = y, month = m, day = d, hour = 12})
    if ok and then_ then
        local days = math.floor((os.time() - then_) / 86400)
        if days < 1 then
            ago = "Today"
        elseif days < 30 then
            ago = days .. (days == 1 and " Day Ago" or " Days Ago")
        elseif days < 365 then
            local months = math.floor(days / 30)
            ago = months .. (months == 1 and " Month Ago" or " Months Ago")
        else
            local years = math.floor(days / 365.25)
            if years < 1 then years = 1 end
            ago = years .. (years == 1 and " Year Ago" or " Years Ago")
        end
    end

    local base = string.format("%d/%d/%d", y, m, d)
    if ago ~= "" then return base .. " (" .. ago .. ")" end
    return base
end

local function formatDuration(sec)
    sec = math.floor(sec)
    return string.format("%02d:%02d:%02d", math.floor(sec / 3600), math.floor(sec / 60) % 60, sec % 60)
end

local httpRequest = request or http_request or (syn and syn.request)

local function httpGet(url)
    if not httpRequest then return nil end
    local ok, res = pcall(httpRequest, {Url = url, Method = "GET"})
    if ok and res and res.StatusCode == 200 then return res.Body end
    return nil
end

local function getJSON(url)
    local body = httpGet(url)
    if not body then return nil end
    local ok, data = pcall(function() return HttpService:JSONDecode(body) end)
    if ok then return data end
    return nil
end

local function loadImageFromUrl(url, fileName)
    local getAsset = getcustomasset or getsynasset
    if not (url and writefile and getAsset) then return false end
    local body = httpGet(url)
    if not body then return false end
    local ok, asset = pcall(function()
        writefile(fileName, body)
        return getAsset(fileName)
    end)
    if ok and asset then return asset end
    return false
end

local function trim(s, n)
    s = tostring(s or "")
    if #s > n then return s:sub(1, n) .. "..." end
    return s
end

