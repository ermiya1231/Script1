local function extract()
    local universeId = game.GameId

    -- 1) MarketplaceService
    local okInfo, info = pcall(function()
        return game:GetService("MarketplaceService"):GetProductInfo(game.PlaceId)
    end)
    info = (okInfo and type(info) == "table") and info or {}

    -- 2) Games API + Votes
    fetchApi()
    local g = apiState.g

    -- 3) Icon
    local iconData = getJSON("https://thumbnails.roblox.com/v1/games/icons?universeIds=" .. universeId .. "&size=256x256&format=Png&isCircular=false")
    local iconUrl = iconData and iconData.data and iconData.data[1] and iconData.data[1].imageUrl or nil

    if info.IconImageAssetId and info.IconImageAssetId ~= 0 then
        iconImg.Image = "rbxassetid://" .. info.IconImageAssetId
    else
        local a = loadImageFromUrl(iconUrl, "gi_icon.png")
        if a then iconImg.Image = a end
    end

    local creator = info.Creator or {}

    -- GENERAL (بالا، سمت چپ آیکون)
    local generalLines = {
        fmt("Name", (g and g.name) or info.Name or game.Name),
        fmt("Genre", g and g.genre),
        fmt("Created", formatDate((g and g.created) or info.Created)),
        fmt("Updated", formatDate((g and g.updated) or info.Updated)),
        fmt("Price", g and g.price or "Free"),
    }
    generalLabel.Text = table.concat(generalLines, "\n")

    -- CREATOR
    section("CREATOR")
    local gc = g and g.creator or {}
    add("Creator", gc.name or creator.Name)
    add("Creator Type", gc.type or creator.CreatorType)
    add("Creator ID", gc.id or creator.CreatorTargetId or creator.Id)
    add("Verified Badge", gc.hasVerifiedBadge ~= nil and gc.hasVerifiedBadge or creator.HasVerifiedBadge)

    -- IDS
    section("IDS")
    add("PlaceId", game.PlaceId)
    add("Root PlaceId", g and g.rootPlaceId)
    add("UniverseId (GameId)", universeId)
    add("Place Version", game.PlaceVersion)
    add("JobId", game.JobId ~= "" and game.JobId or "N/A (Studio)")
    if info.IconImageAssetId then add("Icon AssetId", info.IconImageAssetId) end

    -- STATS (زنده، از API هر ۳۰ ثانیه)
    section("STATS")
    addLive("Playing Now", function()
        return apiState.g and commas(apiState.g.playing or 0) or "N/A"
    end)
    addLive("Total Visits", function()
        return apiState.g and commas(apiState.g.visits or 0) or "N/A"
    end)
    addLive("Favorites", function()
        return apiState.g and commas(apiState.g.favoritedCount or 0) or "N/A"
    end)
    addLive("Likes", function()
        return apiState.v and commas(apiState.v.upVotes or 0) or "N/A"
    end)
    addLive("Dislikes", function()
        return apiState.v and commas(apiState.v.downVotes or 0) or "N/A"
    end)
    addLive("Like Ratio", function()
        local v = apiState.v
        if not v then return "N/A" end
        local up, down = v.upVotes or 0, v.downVotes or 0
        local total = up + down
        if total <= 0 then return "N/A" end
        return string.format("%.1f%%", up / total * 100)
    end)

    -- SETTINGS
    section("SETTINGS")
    if g then
        add("Copying Allowed", g.copyingAllowed)
        add("VIP Servers", g.createVipServersAllowed)
        add("Avatar Type", g.universeAvatarType)
        add("Studio API Access", g.studioAccessToApisAllowed)
        add("All Genre", g.isAllGenre)
    end

    -- SERVER (زنده، هر ثانیه)
    section("SERVER")
    addLive("Players", function()
        return #Players:GetPlayers() .. "/" .. Players.MaxPlayers
    end)
    addLive("Server Uptime", function()
        return formatDuration(workspace.DistributedGameTime)
    end)
    addLive("Ping", function()
        return string.format("%.0f ms", Stats.Network.ServerStatsItem["Data Ping"]:GetValue())
    end)
    addLive("Client FPS", function()
        return string.format("%.0f", fps)
    end)
    addLive("Physics FPS", function()
        return string.format("%.0f", workspace:GetRealPhysicsFPS())
    end)
    addLive("Memory", function()
        return string.format("%.0f MB", Stats:GetTotalMemoryUsageMb())
    end)
    addLive("Instances", function()
        return commas(Stats.InstanceCount)
    end)
    addLive("Teams", function()
        return #game:GetService("Teams"):GetTeams()
    end)
    addLive("Gravity", function()
        return workspace.Gravity
    end)
    add("Private Server", game.PrivateServerId ~= "")
    pcall(function() add("Roblox Version", version()) end)
    add("Streaming Enabled", workspace.StreamingEnabled)
    add("Lighting Tech", tostring(Lighting.Technology):gsub("Enum.Technology.", ""))
    add("Locale", LocalPlayer.LocaleId)

    -- DESCRIPTION
    section("DESCRIPTION")
    add("Description", trim((g and g.description) or info.Description, 700))
    if g and g.sourceName then add("Source Name", g.sourceName) end

    -- LINKS
    section("LINKS")
    add("Game URL", "https://www.roblox.com/games/" .. game.PlaceId)
    add("Icon URL", iconUrl)
end

