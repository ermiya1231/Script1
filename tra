local function buildMirror(char, arm, cf)
	if building or mirrorReady then return end
	building = true

	local p = sync("CreatePart", "Normal", cf, char)
	if not p then
		building = false
		return
	end

	sync("SyncResize", {{Part = p, CFrame = cf, Size = Handle.Size}})
	sync("SyncCollision", {{Part = p, CanCollide = false}})
	sync("SyncAnchor", {{Part = p, Anchored = true}})
	sync("SyncMaterial", {{Part = p, Reflectance = 0.4, Transparency = 1}})
	sync("CreateMeshes", {{Part = p}})
	sync("SyncMesh", {{
		Part = p,
		MeshType = Enum.MeshType.FileMesh,
		MeshId = Mesh.MeshId,
		TextureId = Mesh.TextureId,
		Scale = Mesh.Scale,
	}})
	sync("CreateWelds", {p}, arm)
	sync("SyncAnchor", {{Part = p, Anchored = false}})

	mirror = p
	mirrorReady = true
	building = false
end

local function setMirrorVisible(v)
	if not mirrorReady then return end
	fire("SyncMaterial", {{Part = mirror, Transparency = v and 0 or 1}})
end

local function waitStill(root, duration, timeout)
	local stillFor = 0
	local waited = 0
	while stillFor < duration and waited < timeout do
		task.wait(0.05)
		waited += 0.05
		if root and root.AssemblyLinearVelocity.Magnitude < 0.5 then
			stillFor += 0.05
		else
			stillFor = 0
		end
	end
end

local function calibrate()
	local char = LocalPlayer.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local arm = char and (char:FindFirstChild("Right Arm") or char:FindFirstChild("RightHand"))
	local root = char and char:FindFirstChild("HumanoidRootPart")
	if not hum or not arm then return end

	waitStill(root, 0.3, 3)

	calibrating = true
	hum:EquipTool(Tool)

	local grip
	local waited = 0
	repeat
		task.wait()
		waited += 1 / 60
		grip = arm:FindFirstChild("RightGrip")
	until (grip and grip.Part1 == Handle) or waited > 2

	if not grip or grip.Part1 ~= Handle then
		hum:UnequipTools()
		task.wait(0.2)
		calibrating = false
		return
	end

	local rel = grip.C0 * grip.C1:Inverse()

	hum:UnequipTools()
	task.wait(0.7)
	waitStill(root, 0.3, 3)
	calibrating = false

	local cf = arm.CFrame * rel * HoldOffset
	buildMirror(char, arm, cf)
end

task.spawn(calibrate)

local function swingAnimation()
	local anim = Instance.new("StringValue")
	anim.Name = "toolanim"
	anim.Value = "Slash"
	anim.Parent = Tool
	Debris:AddItem(anim, 2)
end

Handle.Touched:Connect(function(hit)
	if not Swinging or not Equipped then return end
	local targetChar = hit.Parent
	if not targetChar or targetChar == Character then return end

	local hum = targetChar:FindFirstChildOfClass("Humanoid")
	if not hum or hum.Health <= 0 or HitThisSwing[hum] then return end

	HitThisSwing[hum] = true
	HitSound:Play()

	if UseAdminDamage then
		local target = Players:GetPlayerFromCharacter(targetChar)
		if target then
			runCmd(";explode " .. target.Name)
			return
		end
	end
	hum:TakeDamage(Damage)
end)

Tool.Activated:Connect(function()
	if not Equipped or Swinging then return end
	if os.clock() - LastSwing < SwingCooldown then return end

	LastSwing = os.clock()
	Swinging = true
	HitThisSwing = {}
	swingAnimation()

	task.delay(SwingDuration, function()
		Swinging = false
	end)
end)

Tool.Equipped:Connect(function()
	if calibrating then return end

	Character = Tool.Parent
	Humanoid = Character:FindFirstChildOfClass("Humanoid")
	Equipped = true

	task.spawn(function()
		if not mirrorReady and not building then
			local arm = Character:FindFirstChild("Right Arm") or Character:FindFirstChild("RightHand")
			if arm then
				task.wait()
				buildMirror(Character, arm, Handle.CFrame * HoldOffset)
			end
		end

		local waited = 0
		while not mirrorReady and waited < 8 do
			task.wait(0.05)
			waited += 0.05
		end

		if Equipped then
			setMirrorVisible(true)
		end
	end)
end)

Tool.Unequipped:Connect(function()
	if calibrating then return end

	Equipped = false
	Swinging = false
	HitSound:Stop()
	setMirrorVisible(false)
end)

local function cleanup()
	if not alive then return end
	alive = false
	if mirrorReady then
		fire("Remove", {mirror})
	end
end

Tool.AncestryChanged:Connect(function()
	task.defer(function()
		if Tool.Parent == workspace then
			Tool:Destroy()
		end
		if not Tool:IsDescendantOf(game) then
			cleanup()
		end
	end)
end)

local function watchDeath(char)
	local hum = char:WaitForChild("Humanoid", 5)
	if hum then
		hum.Died:Connect(cleanup)
	end
end
if LocalPlayer.Character then task.spawn(watchDeath, LocalPlayer.Character) end

Tool.Parent = Backpack
