	local itemsToDelete = {}

	for _, v in ipairs(workspace:GetDescendants()) do
		if not v:IsDescendantOf(char) then
			if v:IsA("Smoke") or v:IsA("Fire") or v:IsA("Sparkles") or v:IsA("Light") then
