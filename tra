			end
		end
	end

	local chunkSize = 400
	for i = 1, #itemsToDelete, chunkSize do
		local batch = {}
		for j = i, math.min(i + chunkSize - 1, #itemsToDelete) do
			table.insert(batch, itemsToDelete[j])
		end
		
