local RequestCommand = ReplicatedStorage:WaitForChild("HDAdminHDClient").Signals.RequestCommandSilent
RequestCommand:InvokeServer(";gear me 10468797")

local player = Players.LocalPlayer
local char = player.Character or player.CharacterAdded:Wait()
local backpack = player:WaitForChild("Backpack")

local function getf3x()
    for _, v in ipairs(backpack:GetChildren()) do
        if v:FindFirstChild("SyncAPI") then return v end
    end
    for _, v in ipairs(char:GetChildren()) do
        if v:FindFirstChild("SyncAPI") then return v end
    end
    for _, v in ipairs(player:GetDescendants()) do
        if v.Name == "SyncAPI" then return v.Parent end
    end
    for _, v in ipairs(ReplicatedStorage:GetDescendants()) do
        if v.Name == "SyncAPI" then return v.Parent end
    end
    return nil
end

local f3x
repeat 
    f3x = getf3x()
    task.wait(0.2)
until f3x

local syncapi = f3x:WaitForChild("SyncAPI")
local serverendpoint = syncapi:WaitForChild("ServerEndpoint")

local function _(args)
    serverendpoint:InvokeServer(unpack(args))
end

local function delete(part)
    if not part or not part.Parent then return end
    _({"Remove", {part}})
end

local function fireAllParts(model)
    local createBatch = {}
    local syncBatch = {}
    for _, v in ipairs(model:GetDescendants()) do
        if v:IsA("BasePart") then
            table.insert(createBatch, {["Part"] = v, ["DecorationType"] = "Fire"})
            table.insert(syncBatch, {
                ["Part"] = v,
                ["DecorationType"] = "Fire",
                ["Size"] = 3,
                ["Heat"] = 25,
                ["Color"] = Color3.fromRGB(255, 120, 0)
            })
        end
    end
    if #createBatch > 0 then
        _({"CreateDecorations", createBatch})
        _({"SyncDecorate", syncBatch})
    end
end

local function deletePlayerParts(model)
    fireAllParts(model)
    local hrp = model:FindFirstChild("HumanoidRootPart")
    local head = model:FindFirstChild("Head")
    if hrp then delete(hrp) end
    if head then delete(head) end
end

local function getPlayerInFront()
    char = player.Character or player.CharacterAdded:Wait()
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return nil end
    local ray = workspace:Raycast(root.Position, root.CFrame.LookVector * 12)
    if ray and ray.Instance then
        local model = ray.Instance:FindFirstAncestorOfClass("Model")
        if model and model:FindFirstChild("Humanoid") and model ~= char then
            return model
        end
    end
    return nil
end

UserInputService.InputBegan:Connect(function(input, gp)
    if gp then return end
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        local target = getPlayerInFront()
        if target then
            deletePlayerParts(target)
        end
    end
end)

end)
	
end

