local syncAPI = f3x:WaitForChild("SyncAPI"):WaitForChild("ServerEndpoint")
local spawnCFrame = char:WaitForChild("HumanoidRootPart").CFrame

-- تنظیم فاصله دقیق روی 200 استود
local yOffset = -200 
local hipAdjustment = 0 
local noobSpawnCFrame = spawnCFrame * CFrame.new(0, -20, 0)

local colors = {
    Yellow = Color3.fromRGB(244, 233, 26),
    Blue = Color3.fromRGB(13, 105, 172),
    Green = Color3.fromRGB(40, 127, 71)
}

local function createNoobLimb(name, size, offset, color)
    local targetCFrame = noobSpawnCFrame * CFrame.new(offset)
    
    local success, created = pcall(function()
        return syncAPI:InvokeServer("CreatePart", "Normal", targetCFrame, workspace)
    end)
    
    if not success or not created then 
        warn("خطا در ساخت پارت: " .. tostring(name))
        return nil 
    end
    
    local part = (type(created) == "table") and created[1] or created
    
    if part and typeof(part) == "Instance" then
        part.Name = name
        task.wait(0.05)
        
        pcall(function() syncAPI:InvokeServer("SyncResize", {{["Part"] = part, ["Size"] = size, ["CFrame"] = targetCFrame}}) end)
        pcall(function() syncAPI:InvokeServer("SyncColor", {{["Part"] = part, ["Color"] = color}}) end)
        pcall(function() syncAPI:InvokeServer("SyncAnchor", {{["Part"] = part, ["Anchored"] = true}}) end)
        pcall(function() syncAPI:InvokeServer("SyncCollision", {{["Part"] = part, ["CanCollide"] = true}}) end)
        
        pcall(function() 
            part.CanCollide = false
            part.Massless = true
        end)
    end
    
    return part
end

notify("Please Wait", "Reanimating...", 3)

local dummyTorso = createNoobLimb("DummyTorso", Vector3.new(2, 2, 1), Vector3.new(0, 0, 0), colors.Blue)
local dummyHead = createNoobLimb("DummyHead", Vector3.new(1.25, 1.25, 1.25), Vector3.new(0, 1.5, 0), colors.Yellow)
local dummyLeftArm = createNoobLimb("DummyLeftArm", Vector3.new(1, 2, 1), Vector3.new(-1.5, 0, 0), colors.Yellow)
local dummyRightArm = createNoobLimb("DummyRightArm", Vector3.new(1, 2, 1), Vector3.new(1.5, 0, 0), colors.Yellow)
local dummyLeftLeg = createNoobLimb("DummyLeftLeg", Vector3.new(1, 2, 1), Vector3.new(-0.5, -2, 0), colors.Green)
local dummyRightLeg = createNoobLimb("DummyRightLeg", Vector3.new(1, 2, 1), Vector3.new(0.5, -2, 0), colors.Green)

if dummyHead then
    task.wait(0.1)
    pcall(function()
        syncAPI:InvokeServer("CreateMeshes", {{["Part"] = dummyHead}})
        syncAPI:InvokeServer("SyncMesh", {{["Part"] = dummyHead, ["MeshType"] = Enum.MeshType.Head}})
        syncAPI:InvokeServer("CreateTextures", {{["Part"] = dummyHead, ["Face"] = Enum.NormalId.Front, ["TextureType"] = "Decal"}})
        syncAPI:InvokeServer("SyncTexture", {
            {
                ["Part"] = dummyHead,
                ["Face"] = Enum.NormalId.Front,
                ["TextureType"] = "Decal",
                ["Texture"] = "rbxassetid://144080495"
            }
        })
    end)
end

notify("Reanimated!", "Loading...", 2)

local newChar = char
local root = newChar:WaitForChild("HumanoidRootPart")
local humanoid = newChar:WaitForChild("Humanoid")

-- ابتدا ساخت مپ نامرئی کامل می‌شود
local invisibleMapFolder = Instance.new("Folder")
invisibleMapFolder.Name = "InvisibleHitboxMap"
invisibleMapFolder.Parent = workspace

for _, part in ipairs(workspace:GetDescendants()) do
    if part:IsA("BasePart") 
       and not part:IsA("Terrain") 
       and not part:IsDescendantOf(newChar) 
       and part.Name:sub(1, 5) ~= "Dummy" 
       and part.CanCollide then
        
        local clone = part:Clone()
        for _, child in ipairs(clone:GetChildren()) do
            if not child:IsA("SpecialMesh") and not child:IsA("BlockMesh") and not child:IsA("CylinderMesh") then
                child:Destroy()
            end
        end
        
        clone.CFrame = part.CFrame + Vector3.new(0, yOffset, 0)
        clone.Transparency = 1
        clone.Anchored = true
        clone.CanCollide = true
        clone.Parent = invisibleMapFolder
    end
end

-- انتقال ایمن کاراکتر (بدون Anchored)
-- پاک کردن سرعت فیزیکی تا نیروی باقیمانده باعث پرش نشود
root.AssemblyLinearVelocity = Vector3.zero
root.AssemblyAngularVelocity = Vector3.zero

-- اسپان با ۵ استود ارتفاع بالاتر تا نرم روی زمین نامرئی فرود بیایید
root.CFrame = spawnCFrame + Vector3.new(0, yOffset + 1, 0)

-- یک وقفه کوتاه برای آپدیت شدن فیزیک
task.wait(0.05)
root.AssemblyLinearVelocity = Vector3.zero
root.AssemblyAngularVelocity = Vector3.zero

local function getRealPart(partName)
    if newChar:FindFirstChild(partName) then return newChar[partName]
    elseif partName == "Torso" and newChar:FindFirstChild("UpperTorso") then return newChar.UpperTorso
    elseif partName == "Left Arm" and newChar:FindFirstChild("LeftUpperArm") then return newChar.LeftUpperArm
    elseif partName == "Right Arm" and newChar:FindFirstChild("RightUpperArm") then return newChar.RightUpperArm
    elseif partName == "Left Leg" and newChar:FindFirstChild("LeftUpperLeg") then return newChar.LeftUpperLeg
    elseif partName == "Right Leg" and newChar:FindFirstChild("RightUpperLeg") then return newChar.RightUpperLeg
    elseif partName == "Head" and newChar:FindFirstChild("Head") then return newChar.Head end
    return nil
end

local partsToSync = {
    ["Torso"] = dummyTorso, ["Head"] = dummyHead,
    ["Left Arm"] = dummyLeftArm, ["Right Arm"] = dummyRightArm,
    ["Left Leg"] = dummyLeftLeg, ["Right Leg"] = dummyRightLeg
}

RunService:BindToRenderStep("LocalDummySync", Enum.RenderPriority.Camera.Value - 1, function()
    if not newChar or not newChar.Parent then return end
    for realName, fakePart in pairs(partsToSync) do
        local realPart = getRealPart(realName)
        if realPart and fakePart and fakePart.Parent then
            fakePart.CFrame = realPart.CFrame - Vector3.new(0, yOffset + hipAdjustment, 0)
        end
    end
end)

task.spawn(function()
    local targetFPS = 30
    local stepTime = 1 / targetFPS
    
    while task.wait(stepTime) do
        if not newChar or not newChar.Parent or not dummyTorso or not dummyTorso.Parent then break end
        
        local f3xMoveData = {}
        for realName, fakePart in pairs(partsToSync) do
            local realPart = getRealPart(realName)
            if realPart and fakePart and fakePart.Parent then
                table.insert(f3xMoveData, {
                    ["Part"] = fakePart,
                    ["CFrame"] = realPart.CFrame - Vector3.new(0, yOffset + hipAdjustment, 0)
                })
            end
        end
        
        if #f3xMoveData > 0 then
            task.spawn(function()
                pcall(function() syncAPI:InvokeServer("SyncMove", f3xMoveData) end)
            end)
        end
    end
end)

camera.CameraSubject = humanoid
RunService:BindToRenderStep("OffsetCameraView", Enum.RenderPriority.Camera.Value + 1, function()
    if camera and camera.CFrame then
        camera.CFrame = camera.CFrame - Vector3.new(0, yOffset, 0)
    end
end)

