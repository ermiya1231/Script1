local function updateToolList()
    for _, child in pairs(ToolsScroll:GetChildren()) do
        if child:IsA("TextButton") then child:Destroy() end
    end

    local character = LocalPlayer.Character
    local tools = {}

    if character then
        for _, v in pairs(character:GetChildren()) do
            if v:IsA("Tool") then table.insert(tools, v) end
        end
    end
    for _, v in pairs(LocalPlayer.Backpack:GetChildren()) do
        if v:IsA("Tool") then table.insert(tools, v) end
    end

    for _, tool in pairs(tools) do
        local btn = Instance.new("TextButton", ToolsScroll)
        btn.Size = UDim2.new(1, 0, 0, 35)
        btn.BackgroundColor3 = Color3.fromRGB(65, 65, 70)
        btn.TextColor3 = Color3.fromRGB(255, 255, 255)
        btn.Text = tool.Name
        btn.Font = Enum.Font.GothamMedium
        btn.TextSize = 16 
        Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 4)
        addTextOutline(btn)

        btn.MouseButton1Click:Connect(function()
            SelectedTool = tool
            SelectedToolLabel.Text = "Selected Tool: " .. tool.Name
        end)
    end
    ToolsScroll.CanvasSize = UDim2.new(0, 0, 0, #tools * 40)
end

