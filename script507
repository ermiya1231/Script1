local function getTargetPlayer(targetName)
    if targetName == "" then return nil end
    local searchLower = string.lower(targetName)
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            if string.find(string.lower(p.Name), searchLower) or string.find(string.lower(p.DisplayName), searchLower) then
                return p.Character
            end
        end
    end
    return nil
end

local function getRemoteFromTool(tool)
    if not tool then return nil end
    for _, child in pairs(tool:GetChildren()) do
        if child:IsA("RemoteEvent") then return child end
    end
    return nil
end

local function executeSlap()
    if not SelectedTool then return false end
    local targetChar = getTargetPlayer(TargetInput.Text)
    local remote = getRemoteFromTool(SelectedTool)
    if targetChar and remote then
        remote:FireServer("slash", targetChar, Vector3.new(4.979505, -0.000000, 0.452252))
        return true
    end
    return false
end

FireBtn.MouseButton1Click:Connect(function()
    if not SelectedTool then 
        TargetInput.PlaceholderText = "Select tool first!"
        task.wait(1)
        TargetInput.PlaceholderText = "Target (Username/Display)"
        return 
    end
    executeSlap()
end)

