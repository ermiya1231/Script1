-- سیستم کره شفاف (Sphere Visual)
local auraVisual = nil

local function removeAuraVisual()
    if auraVisual then
        auraVisual:Destroy()
        auraVisual = nil
    end
end

local function createAuraVisual(char, range)
    removeAuraVisual()
    if not char or not char:FindFirstChild("HumanoidRootPart") then return end

    auraVisual = Instance.new("Part")
    auraVisual.Name = "SlapAuraVisual"
    auraVisual.Shape = Enum.PartType.Ball -- تغییر به کُره برای انطباق با محدوده ۳ بعدی
    auraVisual.Material = Enum.Material.Neon
    auraVisual.Color = Color3.fromRGB(255, 30, 30) 
    auraVisual.Transparency = 0.8 -- افزایش شفافیت
    auraVisual.Size = Vector3.new(range * 2, range * 2, range * 2)
    auraVisual.CanCollide = false
    auraVisual.Anchored = false
    auraVisual.Massless = true
    auraVisual.CastShadow = false

    auraVisual.CFrame = char.HumanoidRootPart.CFrame

    local weld = Instance.new("WeldConstraint")
    weld.Part0 = char.HumanoidRootPart
    weld.Part1 = auraVisual
    weld.Parent = auraVisual

    auraVisual.Parent = char
end

local isAuraActive = false

local function fireAtTarget(targetChar, remote)
    if not targetChar or not remote then return end
    remote:FireServer("slash", targetChar, Vector3.new(4.979505, -0.000000, 0.452252))
end

AuraBtn.MouseButton1Click:Connect(function()
    if not SelectedTool then 
        TargetInput.PlaceholderText = "Select tool for Aura!"
        task.wait(1.5)
        TargetInput.PlaceholderText = "Target (Username/Display)"
        return 
    end

    isAuraActive = not isAuraActive
    if isAuraActive then
        AuraBtn.Text = "🌀 Slap Aura: ON"
        AuraBtn.BackgroundColor3 = Color3.fromRGB(150, 50, 255)
        
        task.spawn(function()
            while isAuraActive do
                local remote = getRemoteFromTool(SelectedTool)
                local myChar = LocalPlayer.Character
                local currentRange = tonumber(AuraRangeInput.Text) or 20
                local currentDelay = tonumber(AuraSpeedInput.Text) or 0.08
                
                if myChar and myChar:FindFirstChild("HumanoidRootPart") and remote then
                    local myRoot = myChar.HumanoidRootPart
                    
                    if not auraVisual or not auraVisual.Parent or auraVisual.Parent ~= myChar then
                        createAuraVisual(myChar, currentRange)
                    else
                        auraVisual.Size = Vector3.new(currentRange * 2, currentRange * 2, currentRange * 2)
                    end
                    
                    for _, p in pairs(Players:GetPlayers()) do
                        if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") and p.Character:FindFirstChild("Humanoid") and p.Character.Humanoid.Health > 0 then
                            local targetRoot = p.Character.HumanoidRootPart
                            local distance = (myRoot.Position - targetRoot.Position).Magnitude
                            
                            if distance <= currentRange then
                                fireAtTarget(p.Character, remote)
                            end
                        end
                    end
                else
                    removeAuraVisual()
                end
                
                task.wait(currentDelay)
            end
        end)
    else
        AuraBtn.Text = "🌀 Slap Aura: OFF"
        AuraBtn.BackgroundColor3 = Color3.fromRGB(120, 50, 200)
        removeAuraVisual()
    end
end)
