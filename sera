-- متغیرها و وضعیت‌ها
local isRunning = false
local isFloating = false
local originalHipHeight = humanoid.HipHeight
local originalSpeed = humanoid.WalkSpeed

-- آیدی انیمیشن‌ها و موزیک‌ها
local INTRO_ANIM_1 = "rbxassetid://287325678"
