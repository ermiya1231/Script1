local isRunning = false
local isFloating = false
local currentState = nil -- "idle" | "walk"
local freezeToken = 0
local floatTimer = 0
local originalHipHeight = humanoid.HipHeight
local originalSpeed = humanoid.WalkSpeed

-- آیدی انیمیشن‌ها و موزیک‌ها
local INTRO_ANIM_1 = "rbxassetid://287325678"
local INTRO_ANIM_2 = "rbxassetid://70439247"
local IDLE_ID = "rbxassetid://214744412"
local WALK_ID = "rbxassetid://218504594"

local SOUND_ID_1 = "rbxassetid://137463716"
local SOUND_ID_2 = "rbxassetid://743521450"

local animator = humanoid:WaitForChild("Animator")

local introAnim1Obj = Instance.new("Animation"); introAnim1Obj.AnimationId = INTRO_ANIM_1
local introAnim2Obj = Instance.new("Animation"); introAnim2Obj.AnimationId = INTRO_ANIM_2
local idleAnim = Instance.new("Animation");      idleAnim.AnimationId = IDLE_ID
local walkAnim = Instance.new("Animation");      walkAnim.AnimationId = WALK_ID

local introTrack1, introTrack2, idleTrack, walkTrack

local function loadTracks()
    introTrack1 = animator:LoadAnimation(introAnim1Obj)
    introTrack2 = animator:LoadAnimation(introAnim2Obj)
    idleTrack   = animator:LoadAnimation(idleAnim)
    walkTrack   = animator:LoadAnimation(walkAnim)

    for _, t in ipairs({introTrack1, introTrack2, idleTrack, walkTrack}) do
        t.Priority = Enum.AnimationPriority.Action4
    end
    idleTrack.Looped = true
    walkTrack.Looped = true
end
loadTracks()

-- توقف ترک‌های پیش‌فرض (Animate) که با ترک‌های ما تداخل دارن
local function stopDefaultTracks()
    for _, t in ipairs(animator:GetPlayingAnimationTracks()) do
        if t ~= introTrack1 and t ~= introTrack2 and t ~= idleTrack and t ~= walkTrack then
            t:Stop(0)
        end
    end
end

-- فریز قابل replicate: پلی با سرعت عادی، رسیدن به زمان هدف، بعد سرعت صفر
local function playFrozenAt(track, targetTime)
    freezeToken += 1
    local myToken = freezeToken
    track:Play(0, 1, 1) -- fade صفر، weight یک، speed یک
    task.spawn(function()
        local startClock = os.clock()
        -- تایم‌اوت: اگه انیمیشن کوتاه‌تر از زمان هدف بود و لوپ شد، گیر نکنه
        while myToken == freezeToken and track.IsPlaying and track.TimePosition < targetTime
            and (os.clock() - startClock) < 2 do
            task.wait()
        end
        if myToken == freezeToken and track.IsPlaying then
            track:AdjustSpeed(0)
        end
    end)
end

-- موزیک‌ها
local sound1, sound2

local function createSounds()
    if sound1 then sound1:Destroy() end
    if sound2 then sound2:Destroy() end

    sound1 = Instance.new("Sound")
    sound1.SoundId = SOUND_ID_1
    sound1.Pitch = 0.3
    sound1.Volume = 8
    sound1.Parent = Workspace

    sound2 = Instance.new("Sound")
    sound2.SoundId = SOUND_ID_2
    sound2.Pitch = 1.0
    sound2.Volume = 8
    sound2.Parent = Workspace
end
createSounds()

----------------------------------------------------------------
-- ریست کامل
----------------------------------------------------------------
local function resetEverything()
    isRunning = false
    isFloating = false
    freezeToken += 1
    currentState = nil

    if sound1 and sound1.IsPlaying then sound1:Stop() end
    if sound2 and sound2.IsPlaying then sound2:Stop() end

    introTrack1:Stop(0)
    introTrack2:Stop(0)
    idleTrack:Stop(0)
    walkTrack:Stop(0)

    if rootPart then
        rootPart.Anchored = false
    end

    humanoid.HipHeight = originalHipHeight
    humanoid.WalkSpeed = originalSpeed

    local animateScript = character:FindFirstChild("Animate")
    if animateScript then animateScript.Disabled = false end
end

-- ریسپاون
player.CharacterAdded:Connect(function(newChar)
    freezeToken += 1
    currentState = nil
    isRunning = false
    isFloating = false

    character = newChar
    humanoid = character:WaitForChild("Humanoid")

    if humanoid.RigType ~= Enum.HumanoidRigType.R6 then
        return
    end

    rootPart = character:WaitForChild("HumanoidRootPart")
    animator = humanoid:WaitForChild("Animator")
    originalHipHeight = humanoid.HipHeight
    originalSpeed = humanoid.WalkSpeed

    loadTracks()
    createSounds()
end)

----------------------------------------------------------------
-- دکمه Run
----------------------------------------------------------------
G2L[8].MouseButton1Click:Connect(function()
    if isRunning then return end
    isRunning = true
    isFloating = false
    currentState = nil

    originalHipHeight = humanoid.HipHeight
    originalSpeed = humanoid.WalkSpeed
    humanoid.WalkSpeed = 30

    local animateScript = character:FindFirstChild("Animate")
    if animateScript then animateScript.Disabled = true end
    stopDefaultTracks()

    -- ۱. انکر کردن کاراکتر
    rootPart.Anchored = true

    -- ۲. انیمیشن‌های اینترو و آهنگ اول
    introTrack1:Play(0, 1, 1)
    introTrack2:Play(0, 1, 1)
    sound1:Play()

    -- ۳. ۳ ثانیه بعد: آهنگ دوم و بالا رفتن نرم
    task.delay(3, function()
        if not isRunning then return end

        sound2:Play()

        task.spawn(function()
            while isRunning and humanoid.HipHeight < BASE_HIP_HEIGHT do
                humanoid.HipHeight = math.min(humanoid.HipHeight + 0.05, BASE_HIP_HEIGHT)
                task.wait(0.02)
            end

            -- ۴. رسیدن به ارتفاع: آنانکر و فعال شدن انیمیشن‌های اصلی
            if isRunning then
                rootPart.Anchored = false
                introTrack1:Stop(0)
                introTrack2:Stop(0)
                stopDefaultTracks()
                currentState = nil
                isFloating = true
            end
        end)
    end)
end)

-- دکمه Stop
G2L[11].MouseButton1Click:Connect(function()
    resetEverything()
end)

----------------------------------------------------------------
-- حلقه شناوری و انیمیشن‌های اصلی
----------------------------------------------------------------
RunService.Heartbeat:Connect(function(dt)
    if not isRunning or not isFloating or not character or not character:FindFirstChild("HumanoidRootPart") then
        currentState = nil
        return
    end

    -- افکت بالا و پایین رفتن نرم
    floatTimer += dt * 2
    humanoid.HipHeight = BASE_HIP_HEIGHT + math.sin(floatTimer) * 1.5

    -- فقط هنگام تغییر وضعیت انیمیشن عوض میشه
    local newState = humanoid.MoveDirection.Magnitude > 0 and "walk" or "idle"
    if newState ~= currentState then
        currentState = newState
        stopDefaultTracks()
        if newState == "walk" then
            idleTrack:Stop(0)
            playFrozenAt(walkTrack, WALK_FREEZE_TIME)
        else
            walkTrack:Stop(0)
            playFrozenAt(idleTrack, IDLE_FREEZE_TIME)
        end
    end
end)
