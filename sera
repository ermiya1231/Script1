player.CharacterAdded:Connect(function(newChar)
    character = newChar
    humanoid = character:WaitForChild("Humanoid")
    
    if humanoid.RigType ~= Enum.HumanoidRigType.R6 then
        return
    end
    
    rootPart = character:WaitForChild("HumanoidRootPart")
    animator = humanoid:WaitForChild("Animator")
    
    introTrack1 = animator:LoadAnimation(introAnim1Obj)
    introTrack2 = animator:LoadAnimation(introAnim2Obj)
    idleTrack = animator:LoadAnimation(idleAnim)
    walkTrack = animator:LoadAnimation(walkAnim)
    
    if sound1 then sound1:Destroy() end
    if sound2 then sound2:Destroy() end
    
    sound1 = Instance.new("Sound")
    sound1.SoundId = SOUND_ID_1
    sound1.Pitch = 0.3
    sound1.Volume = 8
    sound1.Parent = Workspace
    
    sound2 = Instance.new("Sound")
    sound2.SoundId = SOUND_ID_2
    sound2.Pitch = 1.0
    sound2.Volume = 8
    sound2.Parent = Workspace
    
    isRunning = false
    isFloating = false
end)

-- تابع ریست کامل
local function resetEverything()
    isRunning = false
    isFloating = false
    
    if sound1 and sound1.IsPlaying then sound1:Stop() end
    if sound2 and sound2.IsPlaying then sound2:Stop() end
    
    introTrack1:Stop()
    introTrack2:Stop()
    idleTrack:Stop()
    walkTrack:Stop()
    
    if rootPart then
        rootPart.Anchored = false
    end
    
    humanoid.HipHeight = originalHipHeight
    humanoid.WalkSpeed = originalSpeed
    
    local animateScript = character:FindFirstChild("Animate")
    if animateScript then animateScript.Disabled = false end
end

-- کلیک روی دکمه Run
G2L[8].MouseButton1Click:Connect(function()
    if isRunning then return end
    isRunning = true
    isFloating = false
    
    originalHipHeight = humanoid.HipHeight
    originalSpeed = humanoid.WalkSpeed
    humanoid.WalkSpeed = 30
    
    local animateScript = character:FindFirstChild("Animate")
    if animateScript then animateScript.Disabled = true end
    
    -- ۱. انکر کردن کاراکتر در ابتدای کار
    rootPart.Anchored = true
    
    -- ۲. پلی کردن انیمیشن‌های اینترو و آهنگ اول
    introTrack1:Play()
    introTrack2:Play()
    sound1:Play()
    
    -- ۳. دقیقاً ۳ ثانیه بعد از شروع آهنگ اول: پخش آهنگ دوم و شروع بالا رفتن نرم و روان
    task.delay(3, function()
        if not isRunning then return end
        
        sound2:Play()
        
        task.spawn(function()
            while isRunning and humanoid.HipHeight < BASE_HIP_HEIGHT do
                humanoid.HipHeight = math.min(humanoid.HipHeight + 0.05, BASE_HIP_HEIGHT)
                task.wait(0.02)
            end
            
            -- ۴. به محض رسیدن کامل به HipHeight 6.5، کاراکتر Unanchor شده و انیمیشن‌های اصلی فعال می‌شوند
            if isRunning then
                rootPart.Anchored = false
                introTrack1:Stop()
                introTrack2:Stop()
                isFloating = true
            end
        end)
    end)
end)

-- کلیک روی دکمه Reset / Stop
G2L[11].MouseButton1Click:Connect(function()
    resetEverything()
end)

-- حلقه شناوری و انیمیشن‌های اصلی پس از اتمام بالا آمدن
local floatTimer = 0
RunService.RenderStepped:Connect(function(dt)
    if not isRunning or not isFloating or not character or not character:FindFirstChild("HumanoidRootPart") then return end
    
    -- افکت بالا و پایین رفتن نرم شناوری
    floatTimer = floatTimer + (dt * 2)
    local hoverOffset = math.sin(floatTimer) * 1.5
    humanoid.HipHeight = BASE_HIP_HEIGHT + hoverOffset
    
    -- مدیریت انیمیشن‌های اصلی (Idle و Walk)
    if humanoid.MoveDirection.Magnitude > 0 then
        if not walkTrack.IsPlaying then
            idleTrack:Stop()
            walkTrack:Play()
            walkTrack.TimePosition = 0.90
            walkTrack.Speed = 0
        end
    else
        if not idleTrack.IsPlaying then
            walkTrack:Stop()
            idleTrack:Play()
            idleTrack.TimePosition = 0.90
            idleTrack.Speed = 0
        end
    end
end)
