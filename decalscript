local Players = game:GetService("Players")
local Player = Players.LocalPlayer
local workspace = game:GetService("Workspace")

local tool = nil
local remote = nil

-- 1. پیدا کردن ابزار SyncAPI
for _, v in ipairs(Player:GetDescendants()) do
    if v.Name == "SyncAPI" then tool = v.Parent break end
end
if not tool then
    for _, v in ipairs(game:GetService("ReplicatedStorage"):GetDescendants()) do
        if v.Name == "SyncAPI" then tool = v.Parent break end
    end
end

if not tool or not tool:FindFirstChild("SyncAPI") then
    warn("SyncAPI پیدا نشد! مطمئن شوید که Btools را در اختیار دارید.")
    return
end

remote = tool.SyncAPI.ServerEndpoint
local id = "122714132204276"

---------------------------------------------------------
-- تابع اسپم ۶ وجهی پارت‌ها (با سرعت بالا)
---------------------------------------------------------
local function spam_all_faces(imageId)
    local faces = {
        Enum.NormalId.Front, Enum.NormalId.Back,
        Enum.NormalId.Right, Enum.NormalId.Left,
        Enum.NormalId.Bottom, Enum.NormalId.Top
    }
    
    local allParts = {}
    for _, v in ipairs(workspace:GetDescendants()) do
        -- برای اینکه خود اسکای باکس اسپم نشه، اسمش رو فیلتر میکنیم
        if v:IsA("BasePart") and v.Name ~= "Skybox" then
            table.insert(allParts, v)
        end
    end

    local chunkSize = 100
    for i = 1, #allParts, chunkSize do
        local chunk = {}
        for j = i, math.min(i + chunkSize - 1, #allParts) do
            table.insert(chunk, allParts[j])
        end

        remote:InvokeServer("SetLocked", chunk, false)

        for _, face in ipairs(faces) do
            local decalsToCreate = {}
            local decalsToSync = {}

            for _, part in ipairs(chunk) do
                table.insert(decalsToCreate, {Part = part, Face = face, TextureType = "Decal"})
                table.insert(decalsToSync, {Part = part, Face = face, TextureType = "Decal", Texture = "rbxassetid://" .. imageId})
            end

            remote:InvokeServer("CreateTextures", decalsToCreate)
            remote:InvokeServer("SyncTexture", decalsToSync)
        end
        task.wait() -- جلوگیری از کرش کلاینت
    end
    print("اسپم تمام ۶ وجه با موفقیت به پایان رسید!")
end

---------------------------------------------------------
-- اولویت اول: ساخت اسکای‌باکس با جستجوی هوشمند
---------------------------------------------------------
local char = Player.Character
if char and char:FindFirstChild("HumanoidRootPart") then
    local hrpPos = char.HumanoidRootPart.Position
    -- تعیین موقعیت دقیق بالای سر
    local targetPos = Vector3.new(hrpPos.X, hrpPos.Y + 6, hrpPos.Z)
    local targetCF = CFrame.new(targetPos)

    -- درخواست ساخت پارت به سرور
    remote:InvokeServer("CreatePart", "Normal", targetCF, workspace)
    
    print("در حال ساخت اسکای باکس...")
    local skyboxPart = nil
    
    -- تلاش برای پیدا کردن پارت ساخته شده (حداکثر 2 ثانیه منتظر میماند)
    for i = 1, 20 do
        task.wait(0.1)
        for _, v in ipairs(workspace:GetDescendants()) do
            if v:IsA("BasePart") and v.Name == "Part" then
                -- اگر فاصله پارت تا موقعیت بالای سر کمتر از 3 اِستاد (Stud) بود یعنی همون پارت ماست!
                if (v.Position - targetPos).Magnitude < 3 then
                    skyboxPart = v
                    break
                end
            end
        end
        if skyboxPart then break end -- اگه پیدا شد از حلقه جستجو خارج شو
    end

    -- اگر پارت با موفقیت پیدا شد، آن را به اسکای باکس تبدیل کن
    if skyboxPart then
        task.spawn(function()
            remote:InvokeServer("SetName", {skyboxPart}, "Skybox")
            remote:InvokeServer("CreateMeshes", {{Part = skyboxPart}})
            remote:InvokeServer("SyncMesh", {{Part = skyboxPart, MeshId = "rbxassetid://111891702759441"}})
            remote:InvokeServer("SyncMesh", {{Part = skyboxPart, TextureId = "rbxassetid://" .. id}})
            remote:InvokeServer("SyncMesh", {{Part = skyboxPart, Scale = Vector3.new(7200, 7200, 7200)}})
            remote:InvokeServer("SyncCollision", {{Part = skyboxPart, CanCollide = false}})
            remote:InvokeServer("SyncAnchor", {{Part = skyboxPart, Anchored = true}})
            remote:InvokeServer("SetLocked", {skyboxPart}, true)
            print("اسکای‌باکس با موفقیت ساخته شد و اعمال گردید!")
            
            -- حالا که اسکای باکس ساخته شد، اسپم مپ را شروع کن!
            print("در حال شروع اسپم مپ...")
            spam_all_faces(id)
        end)
    else
        warn("خطا: پارت اسکای‌باکس توسط سرور ساخته نشد یا با تاخیر زیاد مواجه شد.")
    end
end
