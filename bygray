-- Keyword Disabler Panel v3 (Toggle + Live Monitor)
-- Disable  : disables every LocalScript/Script/ModuleScript whose name contains a keyword
--            and keeps watching so nothing gets re-enabled or created again.
-- Disabled!: click again to stop monitoring and restore everything.

local Players = game:GetService("Players")
local StarterPlayer = game:GetService("StarterPlayer")
local ReplicatedFirst = game:GetService("ReplicatedFirst")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local LocalPlayer = Players.LocalPlayer

-- ===== Settings =====
local KEYWORDS = { "anti", "cheat", "ac", "collision", "noclip", "hack", "exploit", "monitor" }

-- PlayerModule contains "play" and disabling it breaks movement, so it stays protected
local PROTECTED_NAMES = {
	["PlayerModule"] = true,
	["RbxCharacterSounds"] = true,
	["Animate"] = true,
}

local SWEEP_INTERVAL = 0.5 -- seconds between full re-scans (backup for the live events)

-- ===== State =====
local active = false
local runId = 0
local connections = {}
local hooked = {}          -- [container] = true
local watched = {}         -- [script] = true
local toRestoreLocals = {} -- [BaseScript] = true (was enabled before we touched it)
local parkedLocals = {}    -- [BaseScript] = oldParent (fallback if Disabled didn't stick)
local parkedModules = {}   -- [ModuleScript] = oldParent
local disabledCount = 0

-- ===== Logic =====
local function matches(name)
	if PROTECTED_NAMES[name] then return false end
	local lowered = string.lower(name)
	for _, kw in ipairs(KEYWORDS) do
		if string.find(lowered, kw, 1, true) then
			return true
		end
	end
	return false
end

-- StarterX folders are only templates; the scripts that really run live in
-- PlayerScripts and in the current Character, so those are scanned too.
local function getContainers()
	return {
		ReplicatedFirst,
		ReplicatedStorage,
		StarterPlayer:FindFirstChild("StarterCharacterScripts"),
		StarterPlayer:FindFirstChild("StarterPlayerScripts"),
		LocalPlayer:FindFirstChild("PlayerScripts"),
		LocalPlayer.Character,
	}
end

local process

local function hookWatch(obj)
	if watched[obj] then return end
	watched[obj] = true

	if obj:IsA("BaseScript") then
		-- if the game turns a target script back on, turn it off again
		table.insert(connections, obj:GetPropertyChangedSignal("Disabled"):Connect(function()
			if active and not obj.Disabled and matches(obj.Name) then
				task.defer(function()
					if active then
						pcall(function() obj.Disabled = true end)
					end
				end)
			end
		end))
	end

	-- if a script gets renamed to a target name, catch it
	table.insert(connections, obj:GetPropertyChangedSignal("Name"):Connect(function()
		if active then
			task.defer(process, obj)
		end
	end))
end

process = function(obj)
	if not active then return end
	if not (obj:IsA("BaseScript") or obj:IsA("ModuleScript")) then return end

	hookWatch(obj)
	if not matches(obj.Name) then return end

	if obj:IsA("BaseScript") then -- LocalScript / Script
		if not obj.Disabled then
			if toRestoreLocals[obj] == nil then
				toRestoreLocals[obj] = true
			end
			pcall(function() obj.Disabled = true end)
			if not obj.Disabled then
				-- fallback: Disabled didn't stick, remove the script instead
				pcall(function()
					parkedLocals[obj] = obj.Parent
					obj.Parent = nil
				end)
			end
			disabledCount += 1
		end
	else -- ModuleScript (has no Disabled property)
		if obj.Parent then
			parkedModules[obj] = obj.Parent
			pcall(function() obj.Parent = nil end)
			disabledCount += 1
		end
	end
end

local function hookContainer(container)
	if not container or hooked[container] then return end
	hooked[container] = true

	table.insert(connections, container.DescendantAdded:Connect(function(d)
		task.defer(process, d)
	end))

	for _, d in ipairs(container:GetDescendants()) do
		process(d)
	end
end

local function startMonitor()
	active = true
	runId += 1
	local myId = runId
	disabledCount = 0

	for _, c in ipairs(getContainers()) do
		hookContainer(c)
	end

	-- new character = new copies of StarterCharacterScripts
	table.insert(connections, LocalPlayer.CharacterAdded:Connect(function(char)
		if active then hookContainer(char) end
	end))

	-- backup sweep: hooks containers that appeared late and re-checks everything
	task.spawn(function()
		while active and runId == myId do
			for _, c in ipairs(getContainers()) do
				if c then
					if hooked[c] then
						for _, d in ipairs(c:GetDescendants()) do
							process(d)
						end
					else
						hookContainer(c)
					end
				end
			end
			task.wait(SWEEP_INTERVAL)
		end
	end)

	return disabledCount
end

local function stopMonitor()
	active = false
	runId += 1

	for _, c in ipairs(connections) do
		pcall(function() c:Disconnect() end)
	end
	connections = {}
	hooked = {}
	watched = {}

	local n = 0
	for s in pairs(toRestoreLocals) do
		pcall(function()
			s.Disabled = false
			n += 1
		end)
	end
	for s, p in pairs(parkedLocals) do
		pcall(function() s.Parent = p end)
	end
	for m, p in pairs(parkedModules) do
		pcall(function()
			m.Parent = p
			n += 1
		end)
	end

	toRestoreLocals = {}
	parkedLocals = {}
	parkedModules = {}
	return n
end

