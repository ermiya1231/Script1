local function serializeType(val)
    if typeof(val) == "UDim2" then 
        return string.format("UDim2.new(%s, %s, %s, %s)", val.X.Scale, val.X.Offset, val.Y.Scale, val.Y.Offset)
    elseif typeof(val) == "UDim" then
        return string.format("UDim.new(%s, %s)", val.Scale, val.Offset)
    elseif typeof(val) == "Color3" then 
        return string.format("Color3.fromRGB(%d, %d, %d)", math.round(val.R * 255), math.round(val.G * 255), math.round(val.B * 255))
    elseif typeof(val) == "string" then 
        return string.format("%q", val)
    elseif typeof(val) == "boolean" then 
        return tostring(val)
    elseif typeof(val) == "number" then 
        return tostring(val)
    elseif typeof(val) == "EnumItem" then 
        local str = tostring(val)
        if str:find("Unknown") then return nil end
        return str
    elseif typeof(val) == "Vector2" then 
        return string.format("Vector2.new(%s, %s)", val.X, val.Y)
    elseif typeof(val) == "Rect" then
        return string.format("Rect.new(%s, %s, %s, %s)", val.Min.X, val.Min.Y, val.Max.X, val.Max.Y)
    elseif typeof(val) == "Font" then
        local success, str = pcall(function()
            return string.format("Font.new(%q, Enum.FontWeight.%s, Enum.FontStyle.%s)", val.Family, val.Weight.Name, val.Style.Name)
        end)
        if success then return str end
    end
    return nil
end

local function generateLuaCode(guiElement)
    local code = [==[
--[[
 d888b  db    db d888888b      .d888b.      db      db    db  .d8b.  
88' Y8b 88    88   `88'        VP  `8D      88      88    88 d8' `8b 
88      88    88    88            odD'      88      88    88 88ooo88 
88  ooo 88    88    88          .88'        88      88    88 88~~~88 
88. ~8~ 88b  d88   .88.        j88.         88booo. 88b  d88 88   88
 Y888P  ~Y8888P' Y888888P      888888D      Y88888P ~Y8888P' YP   YP
]]

]==]
    local parentStr = coreGuiToggle and "game:GetService('CoreGui')" or "game.Players.LocalPlayer.PlayerGui"
    code = code .. "local ScreenGui = Instance.new('ScreenGui')\nScreenGui.Parent = " .. parentStr .. "\nScreenGui.Name = " .. string.format("%q", guiElement.Name) .. "\n\n"
    
    code = code .. "local G2L = {}\n\n"
    local counter = 1
    
    local function recurse(obj, parentName)
        if obj.Name == "G2L_Highlight_Stroke" then return end
        
        local objVar = "G2L[" .. counter .. "]"
        counter = counter + 1
        
        if obj:IsA("LocalScript") or obj:IsA("ModuleScript") then
            code = code .. "-- " .. obj.ClassName .. ": " .. obj.Name .. "\n"
            if decompile then
                local success, src = pcall(decompile, obj)
                if success and src then
                    code = code .. "task.spawn(function()\n" .. src .. "\nend)\n\n"
                else
                    code = code .. "-- [Decompile Failed or Protected]\n\n"
                end
            else
                code = code .. "-- [Decompile function not supported]\n\n"
            end
            return
        end
        
        code = code .. string.format("%s = Instance.new('%s')\n", objVar, obj.ClassName)
        code = code .. string.format("%s.Parent = %s\n", objVar, parentName)
        
        local propertiesToDump = {
            "Name", "Size", "Position", "AnchorPoint", "BackgroundColor3", "BackgroundTransparency", 
            "Visible", "ZIndex", "LayoutOrder", "ClipsDescendants", "BorderSizePixel", "BorderColor3", "BorderMode", "Rotation",
            "Text", "TextColor3", "TextTransparency", "TextSize", "Font", "FontFace", "TextScaled", "TextWrapped", 
            "TextXAlignment", "TextYAlignment", "RichText", "TextStrokeColor3", "TextStrokeTransparency", 
            "LineHeight", "MaxVisibleGraphemes", "TextTruncate", "TextDirection",
            "PlaceholderText", "PlaceholderColor3", "ClearTextOnFocus", "MultiLine", "TextEditable",
            "Image", "ImageColor3", "ImageTransparency", "ImageRectOffset", "ImageRectSize", 
            "ScaleType", "SliceCenter", "SliceScale", "TileSize", "ResampleMode", "HoverImage", "PressedImage",
            "AutoButtonColor", "Selected",
            "CanvasSize", "CanvasPosition", "ScrollBarImageColor3", "ScrollBarImageTransparency", 
            "ScrollBarThickness", "ScrollingDirection", "ElasticBehavior", "AutomaticCanvasSize", 
            "VerticalScrollBarInset", "VerticalScrollBarPosition",
            "CornerRadius", "Thickness", "Color", "Transparency", "ApplyStrokeMode", "LineJoinMode",
            "PaddingTop", "PaddingBottom", "PaddingLeft", "PaddingRight",
            "Padding", "FillDirection", "HorizontalAlignment", "VerticalAlignment", "SortOrder", "ItemLineAlignment",
            "CellPadding", "CellSize", "FillDirectionMaxCells", "StartCorner",
            "AspectRatio", "AspectType", "DominantAxis", "Scale", "MaxTextSize", "MinTextSize", "Value"
        }
        
        for _, prop in pairs(propertiesToDump) do
            local skipProperty = false
            if prop == "Transparency" and obj:IsA("GuiObject") then
                skipProperty = true
            end
            
            if not skipProperty then
                local success, val = pcall(function() return obj[prop] end)
                
                if prop == "Text" and (val == "" or val == nil) and obj:IsA("TextLabel") then
                    pcall(function()
                        if obj.ContentText and obj.ContentText ~= "" then
                            val = obj.ContentText
                            success = true
                        end
                    end)
                end

                if success and val ~= nil then
                    local serialized = serializeType(val)
                    if serialized then
                        code = code .. string.format("%s.%s = %s\n", objVar, prop, serialized)
                    end
                end
            end
        end
        code = code .. "\n"
        
        for _, child in pairs(obj:GetChildren()) do
            pcall(function()
                recurse(child, objVar)
            end)
        end
    end
    
    for _, child in pairs(guiElement:GetChildren()) do
        pcall(function()
            recurse(child, "ScreenGui")
        end)
    end
    
    if centerPanelToggle then
        code = code .. [[
-- Injected Centering Script
for _, child in pairs(ScreenGui:GetChildren()) do
    if child:IsA("Frame") or child:IsA("ScrollingFrame") or child:IsA("ImageLabel") then
        child.AnchorPoint = Vector2.new(0.5, 0.5)
        child.Position = UDim2.new(0.5, 0, 0.5, 0)
        break
    end
end
]]
    end

    if dragSystemToggle then
        code = code .. [[
-- Injected Custom Tween Drag System
local function FOSWQR_fake_script(targetFrame)
    local script = Instance.new('LocalScript', targetFrame)
    local UIS = game:GetService("UserInputService")
    
    local function dragify(Frame)
        local dragToggle = nil
        local dragSpeed = 0.15
        local dragInput = nil
        local dragStart = nil
        local startPos = nil
        
        local function updateInput(input)
            local Delta = input.Position - dragStart
            local Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + Delta.X, startPos.Y.Scale, startPos.Y.Offset + Delta.Y)
            game:GetService("TweenService"):Create(Frame, TweenInfo.new(dragSpeed), {Position = Position}):Play()
        end
        
        Frame.InputBegan:Connect(function(input)
            if (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) and UIS:GetFocusedTextBox() == nil then
                dragToggle = true
                dragStart = input.Position
                startPos = Frame.Position
                input.Changed:Connect(function()
                    if input.UserInputState == Enum.UserInputState.End then
                        dragToggle = false
                    end
                end)
            end
        end)
        
        Frame.InputChanged:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
                dragInput = input
            end
        end)
        
        UIS.InputChanged:Connect(function(input)
            if input == dragInput and dragToggle then
                updateInput(input)
            end
        end)
    end
    
    dragify(script.Parent)
end

for _, child in pairs(ScreenGui:GetChildren()) do
    if child:IsA("Frame") or child:IsA("ImageLabel") then
        FOSWQR_fake_script(child)
        break
    end
end
]]
    end

    return code
end

