-- سیستم هایلایت آبی روشن برای عناصر انتخاب‌شده
local currentHighlights = {}

local function clearHighlights()
    for _, stroke in ipairs(currentHighlights) do
        if stroke and stroke.Parent then
            stroke:Destroy()
        end
    end
    table.clear(currentHighlights)
end

local function highlightGui(guiElement)
    clearHighlights()
    if not guiElement then return end
    
    for _, obj in ipairs(guiElement:GetDescendants()) do
        if obj:IsA("Frame") or obj:IsA("TextButton") or obj:IsA("ImageButton") or obj:IsA("ScrollingFrame") then
            local stroke = Instance.new("UIStroke")
            stroke.Name = "__SelectionHighlightStroke"
            stroke.Color = Color3.fromRGB(0, 200, 255) -- آبی روشن (Cyan/Light Blue)
            stroke.Thickness = 2.5
            stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
            stroke.Parent = obj
            table.insert(currentHighlights, stroke)
        end
    end
end

