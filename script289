-- سیستم مدیریت هایلایت آبی روشن برای انتخاب
local currentHighlights = {}
local selectedGui = nil
local selectedButton = nil

local function clearHighlights()
    for _, stroke in ipairs(currentHighlights) do
        if stroke and stroke.Parent then stroke:Destroy() end
    end
    table.clear(currentHighlights)
end

local function highlightGui(targetGui)
    clearHighlights()
    if not targetGui then return end
    
    local function createStroke(parent)
        local stroke = Instance.new("UIStroke")
        stroke.Name = "G2L_Highlight_Stroke"
        stroke.Color = Color3.fromRGB(0, 200, 255)
        stroke.Thickness = 2.5
        stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
        stroke.Parent = parent
        table.insert(currentHighlights, stroke)
    end
    
    for _, child in ipairs(targetGui:GetChildren()) do
        if child:IsA("GuiObject") then createStroke(child) end
    end
end

