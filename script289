local function serializeType(val)
    if typeof(val) == "UDim2" then return string.format("UDim2.new(%s, %s, %s, %s)", val.X.Scale, val.X.Offset, val.Y.Scale, val.Y.Offset)
    elseif typeof(val) == "Color3" then return string.format("Color3.new(%s, %s, %s)", val.R, val.G, val.B)
    elseif typeof(val) == "string" then return string.format("%q", val)
    elseif typeof(val) == "boolean" then return tostring(val)
    elseif typeof(val) == "number" then return tostring(val)
    elseif typeof(val) == "EnumItem" then return tostring(val)
    elseif typeof(val) == "Vector2" then return string.format("Vector2.new(%s, %s)", val.X, val.Y)
    end
    return nil
end

local function generateLuaCode(guiElement)
    local code = [==[
--[[
 d888b  db    db d888888b      .d888b.      db      db    db  .d8b.  
88' Y8b 88    88   `88'        VP  `8D      88      88    88 d8' `8b 
88      88    88    88            odD'      88      88    88 88ooo88 
88  ooo 88    88    88          .88'        88      88    88 88~~~88 
88. ~8~ 88b  d88   .88.        j88.         88booo. 88b  d88 88   88
 Y888P  ~Y8888P' Y888888P      888888D      Y88888P ~Y8888P' YP   YP
]]

]==]
    local parentStr = coreGuiToggle and "game:GetService('CoreGui')" or "game.Players.LocalPlayer.PlayerGui"
    code = code .. "local ScreenGui = Instance.new('ScreenGui')\nScreenGui.Parent = " .. parentStr .. "\nScreenGui.Name = " .. string.format("%q", guiElement.Name) .. "\n\n"
    
    local objects = {}
    local counter = 1
    
    local function recurse(obj, parentName)
        -- نادیده گرفتن استروک‌های موقت هایلایت در خروجی
        if obj.Name == "__SelectionHighlightStroke" then return end
        if not obj:IsA("GuiObject") and not obj:IsA("UIComponent") and not obj:IsA("LocalScript") and not obj:IsA("Folder") then return end
        
        local objVar = "Obj_" .. counter
        counter = counter + 1
        objects[obj] = objVar
        
        if obj:IsA("LocalScript") then
            code = code .. "-- LocalScript: " .. obj.Name .. "\n"
            if decompile then
                local success, src = pcall(decompile, obj)
                if success and src then
                    code = code .. "task.spawn(function()\n" .. src .. "\nend)\n\n"
                else
                    code = code .. "-- [Decompile Failed or Protected]\n\n"
                end
            else
                code = code .. "-- [Decompile function not supported]\n\n"
            end
            return
        end
        
        code = code .. string.format("local %s = Instance.new('%s')\n", objVar, obj.ClassName)
        code = code .. string.format("%s.Parent = %s\n", objVar, parentName)
        
        local propertiesToDump = {
            "Name", "Size", "Position", "AnchorPoint", "BackgroundColor3", "BackgroundTransparency", 
            "Text", "TextColor3", "TextSize", "Font", "TextScaled", "TextWrapped", "TextXAlignment", "TextYAlignment",
            "Visible", "ZIndex", "ClipsDescendants", "BorderSizePixel", "BorderColor3",
            "CornerRadius", "Thickness", "Color", "Transparency", "ApplyStrokeMode", "LineJoinMode",
            "Color", "Rotation", "Offset", "PaddingTop", "PaddingBottom", "PaddingLeft", "PaddingRight",
            "Image", "ImageColor3", "ImageTransparency", "ScaleType", "SliceCenter"
        }
        
        for _, prop in pairs(propertiesToDump) do
            local success, val = pcall(function() return obj[prop] end)
            if success and val ~= nil then
                local serialized = serializeType(val)
                if serialized then
                    code = code .. string.format("%s.%s = %s\n", objVar, prop, serialized)
                end
            end
        end
        code = code .. "\n"
        
        for _, child in pairs(obj:GetChildren()) do
            recurse(child, objVar)
        end
    end
    
    for _, child in pairs(guiElement:GetChildren()) do
        recurse(child, "ScreenGui")
    end
    
    if centerPanelToggle then
        code = code .. [[
-- Injected Centering Script
for _, child in pairs(ScreenGui:GetChildren()) do
    if child:IsA("Frame") or child:IsA("ScrollingFrame") or child:IsA("ImageLabel") then
        child.AnchorPoint = Vector2.new(0.5, 0.5)
        child.Position = UDim2.new(0.5, 0, 0.5, 0)
        break
    end
end
]]
    end

    code = code .. [[
-- Injected Universal Drag System
local UserInputService = game:GetService("UserInputService")
local function makeDraggable(gui)
    local dragging, dragInput, dragStart, startPos
    gui.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = gui.Position
        end
    end)
    gui.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            local delta = input.Position - dragStart
            gui.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
end

for _, child in pairs(ScreenGui:GetChildren()) do
    if child:IsA("Frame") or child:IsA("ImageLabel") then
        makeDraggable(child)
        break
    end
end
]]
    return code
end

