local function addGuiItem(guiObject)
    if string.find(guiObject.Name, "GuiToLuaDumper") then return end
    
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, -10, 0, 30)
    btn.Font = Enum.Font.Gotham
    btn.TextSize = 14
    btn.Text = guiObject.Name
    btn.Parent = ScrollFrame
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 4)
    
    if guiObject == selectedGui then
        selectedButton = btn
        btn.BackgroundColor3 = Color3.fromRGB(0, 200, 128)
        btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    else
        btn.BackgroundColor3 = Color3.fromRGB(35, 35, 40)
        btn.TextColor3 = Color3.fromRGB(200, 200, 200)
    end
    
    btn.MouseButton1Click:Connect(function()
        if selectedGui == guiObject then
            TweenService:Create(btn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(35, 35, 40), TextColor3 = Color3.fromRGB(200, 200, 200)}):Play()
            selectedGui = nil
            selectedButton = nil
            clearHighlights()
        else
            if selectedButton and selectedButton ~= btn then
                TweenService:Create(selectedButton, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(35, 35, 40), TextColor3 = Color3.fromRGB(200, 200, 200)}):Play()
            end
            selectedButton = btn
            selectedGui = guiObject
            TweenService:Create(btn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(0, 200, 128), TextColor3 = Color3.fromRGB(255, 255, 255)}):Play()
            highlightGui(selectedGui)
        end
    end)
end

local function RefreshList()
    if selectedGui and not selectedGui.Parent then
        selectedGui = nil
        selectedButton = nil
        clearHighlights()
    end
    
    for _, v in pairs(ScrollFrame:GetChildren()) do
        if not v:IsA("UIListLayout") then v:Destroy() end
    end
    
    addHeader("PlayerGui:")
    local playerGui = LocalPlayer:WaitForChild("PlayerGui")
    for _, gui in pairs(playerGui:GetChildren()) do
        if gui:IsA("ScreenGui") then addGuiItem(gui) end
    end
    
    addHeader("CoreGui:")
    for _, gui in pairs(CoreGui:GetChildren()) do
        if gui:IsA("ScreenGui") then addGuiItem(gui) end
    end
    
    ScrollFrame.CanvasSize = UDim2.new(0, 0, 0, UIListLayout.AbsoluteContentSize.Y + 10)
end

RefreshList()

