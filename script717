local function buildCharacterSet()
    local set = {}
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr.Character then set[plr.Character] = true end
    end
    return set
end

local charSet = buildCharacterSet()
Players.PlayerAdded:Connect(function(p)
    p.CharacterAdded:Connect(function(c) charSet[c] = true end)
end)
for _, p in ipairs(Players:GetPlayers()) do
    p.CharacterAdded:Connect(function(c) charSet[c] = true end)
end

local function isProtected(obj)
    return obj == workspace.CurrentCamera
        or obj == workspace.Terrain
        or obj == spawnedBaseplate
        or charSet[obj] ~= nil
        or obj:IsA("Camera")
end

local function hideObject(child)
    if child and child.Parent and not isProtected(child) then
        pcall(function() child.Parent = hiddenStorage end)
    end
end

local function restoreObject(child)
    if child and child.Parent == hiddenStorage then
        pcall(function() child.Parent = workspace end)
    end
end

local function toggleExternalGuis(disable)
    if disable then
        local pGui = LocalPlayer:FindFirstChildOfClass("PlayerGui")
        if pGui then
            for _, gui in ipairs(pGui:GetDescendants()) do
                if (gui:IsA("BillboardGui") or gui:IsA("SurfaceGui")) and gui.Enabled then
                    table.insert(disabledGuis, gui)
                    gui.Enabled = false
                end
            end
        end
    else
        for _, gui in ipairs(disabledGuis) do
            if gui and gui.Parent then gui.Enabled = true end
        end
        table.clear(disabledGuis)
    end
end

