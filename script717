-- 11) روشن کردن (ON) — بدون لگ
----------------------------------------------------------------
local function enableVoid()
    local children = workspace:GetChildren()

    -- صف‌کردن آبجکت‌های جدید به‌جای انتقال آنی (ضد لگ)
    childAddedConn = workspace.ChildAdded:Connect(function(child)
        if isToggled then
            table.insert(pendingQueue, child)
        end
    end)

    toggleExternalGuis(true)

    -- Baseplate تیره قبل از پاک‌سازی ساخته می‌شود تا بازیکن سقوط نکند
    local char = LocalPlayer.Character
    local hrp  = char and char:FindFirstChild("HumanoidRootPart")
    if hrp then
        local spawnPos = hrp.Position - Vector3.new(0, CONFIG.DROP_OFFSET, 0)

        spawnedBaseplate = Instance.new("Part")
        spawnedBaseplate.Name = "UG_Baseplate"
        spawnedBaseplate.Size = CONFIG.BASEPLATE_SIZE
        spawnedBaseplate.CFrame = CFrame.new(spawnPos)
        spawnedBaseplate.Anchored = true
        spawnedBaseplate.CanCollide = true
        spawnedBaseplate.Material = Enum.Material.Plastic
        spawnedBaseplate.TopSurface = Enum.SurfaceType.Studs
        spawnedBaseplate.BottomSurface = Enum.SurfaceType.Studs
        spawnedBaseplate.FrontSurface = Enum.SurfaceType.Studs
        spawnedBaseplate.BackSurface = Enum.SurfaceType.Studs
        spawnedBaseplate.LeftSurface = Enum.SurfaceType.Studs
        spawnedBaseplate.RightSurface = Enum.SurfaceType.Studs
        spawnedBaseplate.Color = CONFIG.BASEPLATE_COLOR   -- تیره‌تر
        spawnedBaseplate.Parent = workspace

        -- شبکه نئونی روی زمین (ظاهر سایبرپانک)

        hrp.CFrame = CFrame.new(spawnPos + Vector3.new(0, 5, 0))
    end

    processBatched(children, hideObject, "CLEARING")

    -- پاک‌سازی صف باقی‌مانده، آرام و بدون لگ
    task.spawn(function()
        while isToggled do
            if #pendingQueue > 0 then
                local batch = pendingQueue
                pendingQueue = {}
                processBatched(batch, hideObject, "SYNCING")
            end
            RunService.Heartbeat:Wait()
        end
    end)
end

----------------------------------------------------------------
-- 12) خاموش کردن (OFF) — بازگردانی بدون لگ
----------------------------------------------------------------
local function disableVoid()
    if childAddedConn then
        childAddedConn:Disconnect()
        childAddedConn = nil
    end
    pendingQueue = {}

    if spawnedBaseplate and spawnedBaseplate.Parent then
        spawnedBaseplate:Destroy()
    end
    spawnedBaseplate = nil

    local char = LocalPlayer.Character
    local hrp  = char and char:FindFirstChild("HumanoidRootPart")
    if hrp then
        hrp.CFrame = hrp.CFrame + Vector3.new(0, CONFIG.DROP_OFFSET + 3, 0)
        if char:FindFirstChildOfClass("Humanoid") then
            char:FindFirstChildOfClass("Humanoid").PlatformStand = false
        end
    end

    processBatched(hiddenStorage:GetChildren(), restoreObject, "RESTORING")
    toggleExternalGuis(false)
end

