local function setProgress(done, total, text)
    local a = total > 0 and (done / total) or 0
    BarFill.Size = UDim2.new(a, 0, 1, 0)
    InfoLabel.Text = string.format("STATUS: %s  |  %d / %d", text, done, total)
end

-- لیست را در چند فریم پردازش می‌کند تا بازی هرگز فریز نشود
local function processBatched(list, handler, label)
    local total, done = #list, 0
    local clock = os.clock()
    for i = 1, total do
        handler(list[i])
        done += 1
        if done % CONFIG.MIN_PER_FRAME == 0 then
            if os.clock() - clock >= CONFIG.FRAME_BUDGET then
                setProgress(done, total, label)
                RunService.Heartbeat:Wait()
                clock = os.clock()
            end
        end
    end
    setProgress(total, total, "DONE")
end

