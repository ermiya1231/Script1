local function paintToggle(on)
    local accent = on and Color3.fromRGB(0, 255, 190) or Color3.fromRGB(255, 45, 95)
    local soft   = on and Color3.fromRGB(10, 32, 30)  or Color3.fromRGB(26, 14, 26)
    local trackC = on and Color3.fromRGB(12, 60, 52)  or Color3.fromRGB(48, 20, 34)

    ToggleLabel.Text = "Underground  :  " .. (on and "ON" or "OFF")
    TweenService:Create(ToggleButton, TweenInfo.new(0.2), {BackgroundColor3 = soft}):Play()
    TweenService:Create(tStroke,      TweenInfo.new(0.2), {Color = accent}):Play()
    TweenService:Create(ToggleLabel,  TweenInfo.new(0.2), {TextColor3 = accent}):Play()
    TweenService:Create(Track,        TweenInfo.new(0.2), {BackgroundColor3 = trackC}):Play()
    TweenService:Create(Knob, TweenInfo.new(0.22, Enum.EasingStyle.Back), {
        Position = on and UDim2.new(1, -19, 0.5, -8) or UDim2.new(0, 3, 0.5, -8),
        BackgroundColor3 = accent
    }):Play()
    TweenService:Create(StatusDot, TweenInfo.new(0.2), {BackgroundColor3 = accent}):Play()
end

