local isAnimLooping = false
local currentAnimTrack = nil
local animBtn = Instance.new("TextButton")
animBtn.Size = UDim2.new(0, 160, 0, 32)
animBtn.Position = UDim2.new(0, 20, 0, 250)
local defaultAnimText = "ToolNoneAnim Loop: OFF"
local defaultAnimColor = Color3.fromRGB(120, 40, 40)
animBtn.Text = defaultAnimText
animBtn.BackgroundColor3 = defaultAnimColor
animBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
animBtn.Font = Enum.Font.GothamBold
animBtn.TextSize = 11
animBtn.BorderSizePixel = 0
animBtn.Parent = frame

local function playToolNoneAnim()
    local char = player.Character
    if not char then return end
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    local animator = humanoid and (humanoid:FindFirstChildOfClass("Animator") or humanoid)
    if not animator then return end
    
    local animId = "rbxassetid://182393478"
    local animateScript = char:FindFirstChild("Animate")
    if animateScript and animateScript:FindFirstChild("toolnone") then
        local toolNoneObj = animateScript.toolnone:FindFirstChildOfClass("Animation") or animateScript.toolnone:FindFirstChild("ToolNoneAnim")
        if toolNoneObj and toolNoneObj.AnimationId ~= "" then animId = toolNoneObj.AnimationId end
    end
    
    local animObj = Instance.new("Animation")
    animObj.AnimationId = animId
    if currentAnimTrack then currentAnimTrack:Stop() end
    currentAnimTrack = animator:LoadAnimation(animObj)
    currentAnimTrack.Priority = Enum.AnimationPriority.Action4
    currentAnimTrack.Looped = true
    currentAnimTrack:Play()
end

animBtn.MouseButton1Click:Connect(function()
    isAnimLooping = not isAnimLooping
    if isAnimLooping then
        animBtn.Text = "ToolNoneAnim Loop: ON"
        TS:Create(animBtn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(0, 150, 50)}):Play()
        playToolNoneAnim()
        task.spawn(function()
            while isAnimLooping do
                if currentAnimTrack and not currentAnimTrack.IsPlaying then playToolNoneAnim() end
                task.wait(0.1)
            end
        end)
    else
        animBtn.Text = defaultAnimText
        TS:Create(animBtn, TweenInfo.new(0.2), {BackgroundColor3 = defaultAnimColor}):Play()
        if currentAnimTrack then currentAnimTrack:Stop() currentAnimTrack = nil end
    end
end)

