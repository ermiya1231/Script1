-- لیست اسکرول شاهکار با Hover/Touch Effects و انیمیشن رنگ
---------------------------------------------------------
local scrollFrame = Instance.new("ScrollingFrame")
scrollFrame.Size = UDim2.new(0, 210, 0, 250)
scrollFrame.Position = UDim2.new(0, 210, 0, 35)
scrollFrame.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
scrollFrame.BorderSizePixel = 0
scrollFrame.ScrollBarThickness = 6
scrollFrame.Parent = frame

local listLayout = Instance.new("UIListLayout")
listLayout.Parent = scrollFrame
listLayout.SortOrder = Enum.SortOrder.LayoutOrder
listLayout.Padding = UDim.new(0, 5)

local baseColor = Color3.fromRGB(45, 45, 45)
local hoverColor = Color3.fromRGB(65, 65, 75) -- رنگ هنگام قرار گرفتن ماوس/دست
local selectColor = Color3.fromRGB(0, 120, 80) -- رنگ هنگام انتخاب شدن

task.spawn(function()
    while task.wait(0.5) do
        local currentTools = {}
        
        if player:FindFirstChild("Backpack") then
            for _, item in ipairs(player.Backpack:GetChildren()) do
                if item:IsA("Tool") then currentTools[item] = true end
            end
        end
        if player.Character then
            for _, item in ipairs(player.Character:GetChildren()) do
                if item:IsA("Tool") then currentTools[item] = true end
            end
        end
        
        for tool, itemFrame in pairs(uiItems) do
            if not currentTools[tool] then
                itemFrame:Destroy()
                uiItems[tool] = nil
                if selectedTool == tool then
                    selectedTool = nil
                    for axis, _ in pairs(loopStates) do loopStates[axis] = false end 
                end
            end
        end
        
        for tool, _ in pairs(currentTools) do
            if not uiItems[tool] then
                local itemFrame = Instance.new("TextButton")
                itemFrame.Size = UDim2.new(1, -10, 0, 40)
                itemFrame.BackgroundColor3 = (selectedTool == tool) and selectColor or baseColor
                itemFrame.BorderSizePixel = 0
                itemFrame.Text = ""
                itemFrame.AutoButtonColor = false -- غیرفعال کردن رنگ پیش‌فرض کلیک روبلاکس
                
                local hasIcon = tool.TextureId and tool.TextureId ~= ""
                if hasIcon then
                    local icon = Instance.new("ImageLabel", itemFrame)
                    icon.Size = UDim2.new(0, 30, 0, 30)
                    icon.Position = UDim2.new(0, 5, 0, 5)
                    icon.Image = tool.TextureId
                    icon.BackgroundTransparency = 1
                    
                    local name = Instance.new("TextLabel", itemFrame)
                    name.Size = UDim2.new(1, -45, 1, 0)
                    name.Position = UDim2.new(0, 40, 0, 0)
                    name.Text = tool.Name
                    name.TextColor3 = Color3.fromRGB(255, 255, 255)
                    name.BackgroundTransparency = 1
                    name.Font = Enum.Font.Gotham
                    name.TextSize = 13
                    name.TextXAlignment = Enum.TextXAlignment.Left
                else
                    local name = Instance.new("TextLabel", itemFrame)
                    name.Size = UDim2.new(1, -10, 1, 0)
                    name.Position = UDim2.new(0, 5, 0, 0)
                    name.Text = tool.Name
                    name.TextColor3 = Color3.fromRGB(255, 255, 255)
                    name.BackgroundTransparency = 1
                    name.Font = Enum.Font.Gotham
                    name.TextSize = 14
                    name.TextXAlignment = Enum.TextXAlignment.Center
                end
                
                -----------------------------------
                -- سیستم Hover / Touch / Select
                -----------------------------------
                local function applyHover()
                    if selectedTool ~= tool then
                        TS:Create(itemFrame, TweenInfo.new(0.2), {BackgroundColor3 = hoverColor}):Play()
                    end
                end
                
                local function removeHover()
                    if selectedTool ~= tool then
                        TS:Create(itemFrame, TweenInfo.new(0.2), {BackgroundColor3 = baseColor}):Play()
                    end
                end
                
                -- پشتیبانی از PC
                itemFrame.MouseEnter:Connect(applyHover)
                itemFrame.MouseLeave:Connect(removeHover)
                
                -- پشتیبانی از موبایل (لمس)
                itemFrame.InputBegan:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.Touch then applyHover() end
                end)
                itemFrame.InputEnded:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.Touch then removeHover() end
                end)
                
                -- سیستم کلیک / انتخاب با Tween
                itemFrame.MouseButton1Click:Connect(function()
                    local char = player.Character
                    local humanoid = char and char:FindFirstChildOfClass("Humanoid")
                    
                    if selectedTool == tool then
                        -- Deselect
                        selectedTool = nil
                        TS:Create(itemFrame, TweenInfo.new(0.2), {BackgroundColor3 = hoverColor}):Play()
                        if humanoid then humanoid:UnequipTools() end
                    else
                        -- Select (و ریست کردن بقیه)
                        for otherTool, otherFrame in pairs(uiItems) do
                            if otherTool ~= tool then
                                TS:Create(otherFrame, TweenInfo.new(0.2), {BackgroundColor3 = baseColor}):Play()
                            end
                        end
                        selectedTool = tool
                        TS:Create(itemFrame, TweenInfo.new(0.2), {BackgroundColor3 = selectColor}):Play()
                        if humanoid then humanoid:EquipTool(tool) end
                    end
                end)
                
                itemFrame.Parent = scrollFrame
                uiItems[tool] = itemFrame
            end
        end
        scrollFrame.CanvasSize = UDim2.new(0, 0, 0, listLayout.AbsoluteContentSize.Y + 10)
    end
end)

