-- تابع نمایش ارور روی دکمه‌ها
local function flashError(btn, originalText, originalColor)
    if btn.Text == "Please Select A Tool!" then return end
    btn.Text = "Please Select A Tool!"
    TS:Create(btn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(180, 40, 40)}):Play()
    task.wait(1)
    btn.Text = originalText
    TS:Create(btn, TweenInfo.new(0.2), {BackgroundColor3 = originalColor}):Play()
end

-- ساخت دکمه‌های کلیکی
local function createButton(axisName, yPos, axis)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0, 160, 0, 28)
    btn.Position = UDim2.new(0, 20, 0, yPos)
    local defaultText = "Rotate " .. axisName .. " (Click)"
    local defaultColor = Color3.fromRGB(55, 55, 55)
    btn.Text = defaultText
    btn.BackgroundColor3 = defaultColor
    btn.TextColor3 = Color3.fromRGB(220, 220, 220)
    btn.Font = Enum.Font.Gotham
    btn.TextSize = 12
    btn.BorderSizePixel = 0
    btn.Parent = frame
    
    btn.MouseButton1Click:Connect(function()
        if not selectedTool or not selectedTool.Parent then
            task.spawn(flashError, btn, defaultText, defaultColor)
            return
        end
        local char = player.Character
        local humanoid = char and char:FindFirstChildOfClass("Humanoid")
        if humanoid then
            isInternalEquipping = true 
            local rx = axis == "X" and math.rad(rotationStep) or 0
            local ry = axis == "Y" and math.rad(rotationStep) or 0
            local rz = axis == "Z" and math.rad(rotationStep) or 0
            selectedTool.Grip = selectedTool.Grip * CFrame.Angles(rx, ry, rz)
            humanoid:UnequipTools()
            task.wait() 
            humanoid:EquipTool(selectedTool)
            isInternalEquipping = false 
        end
    end)
end

-- ساخت دکمه‌های لوپ
local loopStates = {X = false, Y = false, Z = false}
local function createToggleButton(axisName, yPos, axis)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0, 160, 0, 28)
    btn.Position = UDim2.new(0, 20, 0, yPos)
    local defaultText = "Auto Spin " .. axisName .. ": OFF"
    local defaultColor = Color3.fromRGB(45, 45, 45)
    btn.Text = defaultText
    btn.BackgroundColor3 = defaultColor
    btn.TextColor3 = Color3.fromRGB(220, 220, 220)
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 12
    btn.BorderSizePixel = 0
    btn.Parent = frame
    
    btn.MouseButton1Click:Connect(function()
        if not selectedTool or not selectedTool.Parent then
            task.spawn(flashError, btn, defaultText, defaultColor)
            return
        end
        loopStates[axis] = not loopStates[axis]
        if loopStates[axis] then
            btn.Text = "Auto Spin " .. axisName .. ": ON"
            TS:Create(btn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(0, 150, 50)}):Play()
            task.spawn(function()
                while loopStates[axis] do
                    if not selectedTool or not selectedTool.Parent then
                        loopStates[axis] = false
                        btn.Text = defaultText
                        TS:Create(btn, TweenInfo.new(0.2), {BackgroundColor3 = defaultColor}):Play()
                        break
                    end
                    local char = player.Character
                    local humanoid = char and char:FindFirstChildOfClass("Humanoid")
                    if humanoid then
                        isInternalEquipping = true
                        local rx = axis == "X" and math.rad(rotationStep) or 0
                        local ry = axis == "Y" and math.rad(rotationStep) or 0
                        local rz = axis == "Z" and math.rad(rotationStep) or 0
                        selectedTool.Grip = selectedTool.Grip * CFrame.Angles(rx, ry, rz)
                        humanoid:UnequipTools()
                        task.wait()
                        humanoid:EquipTool(selectedTool)
                        isInternalEquipping = false
                    end
                    task.wait()
                end
            end)
        else
            btn.Text = defaultText
            TS:Create(btn, TweenInfo.new(0.2), {BackgroundColor3 = defaultColor}):Play()
        end
    end)
end

