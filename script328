        local args = {...}
        if (self == LocalPlayer or self == Players) and (method:lower() == "kick") then
            logBlock(args[1])
            return nil 
        end
        return oldNamecall(self, ...)
    end)
end

if hookfunction and LocalPlayer and LocalPlayer.Kick then
    local oldKick
    oldKick = hookfunction(LocalPlayer.Kick, function(self, ...)
        local args = {...}
        logBlock(args[1])
