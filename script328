local function logBlock(reason)
    warn("[Anti-Kick] A LocalScript tried to kick you!")
    warn("[Anti-Kick] Reason given:", tostring(reason or "No reason specified"))
end

if hookmetamethod then
    local oldNamecall
    oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
