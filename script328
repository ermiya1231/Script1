-- ======================================================
-- 💥 بخش سوم: لایه دوم آنتی‌کیک (Script Nuker / نابودگر)
-- ======================================================
local suspiciousKeywords = {
    "anticheat", "anti-cheat", "ac", "anti", "cheat", 
    "detector", "kick", "ban", "exploit", "security", 
    "protect", "check", "validation", "guard", "bypass"
}

local function isAntiCheat(scriptObj)
    if not (scriptObj:IsA("LocalScript") or scriptObj:IsA("ModuleScript")) then
        return false
    end
    
    local scriptName = scriptObj.Name:lower()
    for _, word in ipairs(suspiciousKeywords) do
        if scriptName:find(word) then
            return true
        end
    end
    return false
end

local function neutralizeScript(scriptObj)
    pcall(function()
        if scriptObj:IsA("LocalScript") then
            scriptObj.Disabled = true
        end
        scriptObj:Destroy()
        warn("[Script Nuker] Successfully neutralized Anti-Cheat script:", scriptObj.Name)
    end)
end

local function scanContainer(container)
    if not container then return end
    for _, child in ipairs(container:GetDescendants()) do
        if isAntiCheat(child) then
            neutralizeScript(child)
        end
    end
end

local function monitorContainer(container)
    if not container then return end
    container.DescendantAdded:Connect(function(child)
        if isAntiCheat(child) then
            task.wait() 
            neutralizeScript(child)
        end
    end)
end

