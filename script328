local TweenService = game:GetService("TweenService")
local Players = game:GetService("Players")

local LocalPlayer = Players.LocalPlayer
local playerGui = LocalPlayer:WaitForChild("PlayerGui")

-- ======================================================
-- 🎨 بخش اول: تابع سازنده رابط کاربری (UI) هوشمند
-- ======================================================
local function showNotification(message, strokeColor)
    local screenGui = Instance.new("ScreenGui")
    screenGui.Name = "CoolModeGUI"
    screenGui.ResetOnSpawn = false
    screenGui.Parent = playerGui

    local frame = Instance.new("Frame")
    frame.Name = "NotifyFrame"
    frame.Size = UDim2.new(0.3, 0, 0.1, 0)
    frame.Position = UDim2.new(1.5, 0, 1, -20) 
    frame.AnchorPoint = Vector2.new(1, 1)
    frame.BackgroundColor3 = Color3.fromRGB(20, 20, 25)
    frame.BorderSizePixel = 0
    frame.Parent = screenGui

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 8)
    corner.Parent = frame

    local stroke = Instance.new("UIStroke")
    stroke.Color = strokeColor -- رنگ حاشیه بر اساس وضعیت تغییر می‌کند
    stroke.Thickness = 2
    stroke.Parent = frame

    local sizeConstraint = Instance.new("UISizeConstraint")
    sizeConstraint.MaxSize = Vector2.new(300, 65)
    sizeConstraint.MinSize = Vector2.new(200, 50)
    sizeConstraint.Parent = frame

    local textLabel = Instance.new("TextLabel")
    textLabel.Size = UDim2.new(1, 0, 1, 0)
    textLabel.BackgroundTransparency = 1
    textLabel.Text = message -- متن پیام بر اساس وضعیت تغییر می‌کند
    textLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    textLabel.Font = Enum.Font.GothamBold
    textLabel.TextScaled = true
    textLabel.Parent = frame

    local textConstraint = Instance.new("UITextSizeConstraint")
    textConstraint.MaxTextSize = 18
    textConstraint.MinTextSize = 12
    textConstraint.Parent = textLabel

    local slideInInfo = TweenInfo.new(0.6, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
    local slideIn = TweenService:Create(frame, slideInInfo, {Position = UDim2.new(1, -20, 1, -20)})

    local slideOutInfo = TweenInfo.new(0.5, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
    local slideOut = TweenService:Create(frame, slideOutInfo, {Position = UDim2.new(1.5, 0, 1, -20)})

    slideIn:Play()
    task.delay(4, function()
        slideOut:Play()
        slideOut.Completed:Wait()
        screenGui:Destroy()
    end)
end

