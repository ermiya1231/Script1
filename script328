-- چک می‌کند آیا توابع هوک در اگزکتور وجود دارند یا خیر
local hasHookSupport = (type(hookmetamethod) == "function" or type(hookfunction) == "function")

if hasHookSupport then
    showNotification("Full Anti-Kick Enabled", Color3.fromRGB(0, 255, 128)) -- سبز نئونی
else
    showNotification("No Hook! Using Nuker Only", Color3.fromRGB(255, 50, 50)) -- قرمز (ارور)
