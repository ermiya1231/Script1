-- ======================================================
-- 🛡️ بخش دوم: لایه اول (مسدود کردن مستقیم توابع)
-- ======================================================
local function logBlock(reason)
    warn("[Anti-Kick] A LocalScript tried to kick you!")
    warn("[Anti-Kick] Reason given:", tostring(reason or "No reason specified"))
end

-- کدهای این بخش فقط در صورتی اجرا می‌شوند که اگزکتور پشتیبانی کند
if hasHookSupport then
    if hookmetamethod then
        local oldNamecall
        oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
            local method = getnamecallmethod()
            local args = {...}
            if (self == LocalPlayer or self == Players) and (method:lower() == "kick") then
                logBlock(args[1])
                return nil 
            end
            return oldNamecall(self, ...)
        end)
    end

    if hookfunction and LocalPlayer and LocalPlayer.Kick then
        local oldKick
        oldKick = hookfunction(LocalPlayer.Kick, function(self, ...)
            local args = {...}
            logBlock(args[1])
            return nil 
        end)
    end
end

-- ======================================================
-- 💥 بخش سوم: لایه دوم (Script Nuker / نابودگر)
-- ======================================================
local suspiciousKeywords = {
    "anticheat", "anti-cheat", "ac", "anti", "cheat", 
    "detector", "kick", "ban", "exploit", "security", 
    "protect", "check", "validation", "guard", "bypass"
}

local function isAntiCheat(scriptObj)
    if not (scriptObj:IsA("LocalScript") or scriptObj:IsA("ModuleScript")) then
        return false
    end
    
    local scriptName = scriptObj.Name:lower()
    for _, word in ipairs(suspiciousKeywords) do
        if scriptName:find(word) then
            return true
        end
    end
    return false
end

local function neutralizeScript(scriptObj)
    pcall(function()
        if scriptObj:IsA("LocalScript") then
            scriptObj.Disabled = true
        end
        scriptObj:Destroy()
        warn("[Script Nuker] Successfully neutralized Anti-Cheat script:", scriptObj.Name)
    end)
end

local function scanContainer(container)
    if not container then return end
    for _, child in ipairs(container:GetDescendants()) do
        if isAntiCheat(child) then
            neutralizeScript(child)
        end
    end
end

local function monitorContainer(container)
    if not container then return end
    container.DescendantAdded:Connect(function(child)
        if isAntiCheat(child) then
            task.wait() 
            neutralizeScript(child)
        end
    end)
end

-- مسیرهای اصلی کلاینت
local playerScripts = LocalPlayer:WaitForChild("PlayerScripts", 5)
local backpack = LocalPlayer:WaitForChild("Backpack", 5)

scanContainer(playerScripts)
scanContainer(playerGui)
scanContainer(backpack)

monitorContainer(playerScripts)
monitorContainer(playerGui)
monitorContainer(backpack)

print("[System] Anti-Kick System Loaded!")
