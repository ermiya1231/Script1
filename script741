-- Slider Logic
local function UpdateSlider(inputPosition)
    local trackPos = SliderTrack.AbsolutePosition.X
    local trackSize = SliderTrack.AbsoluteSize.X
    local relativeX = math.clamp(inputPosition.X - trackPos, 0, trackSize)
    local percentage = relativeX / trackSize

    CurrentRange = math.floor(MinRange + (percentage * (MaxRange - MinRange)))
    if CurrentRange < MinRange then CurrentRange = MinRange end

    SliderFill.Size = UDim2.new(percentage, 0, 1, 0)
    SliderTitle.Text = "Range: " .. tostring(CurrentRange) .. " Studs"
    UpdateAuraSize()
end

