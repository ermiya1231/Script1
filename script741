--------------------------------------------------------------------------------
-- Anti-Robux Purchase Protection Hook
--------------------------------------------------------------------------------
if hookmetamethod then
    local oldNamecall
    oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
        local method = getnamecallmethod()
        if Enabled and self == MarketplaceService and (string.find(method, "Prompt") or string.find(method, "Purchase")) then
            return nil
        end
        return oldNamecall(self, ...)
    end)
end

local PurchaseKeywords = {
    "buy", "purchase", "robux", "r$", "pass", "gamepass", 
    "devproduct", "product", "donate", "store", "shop", "item", "push", "nuke", "spin"
}

local function IsPurchasePrompt(prompt)
    if not prompt then return false end
    
    local textToSearch = string.lower(
        (prompt.ActionText or "") .. " " .. 
        (prompt.ObjectText or "") .. " " .. 
        (prompt.Name or "") .. " " .. 
        (prompt.Parent and prompt.Parent.Name or "")
    )
    
    for _, kw in ipairs(PurchaseKeywords) do
        if string.find(textToSearch, kw, 1, true) then
            return true
        end
    end
    
    return false
end

--------------------------------------------------------------------------------
-- 1. Visual Aura Sphere Creation
--------------------------------------------------------------------------------
local function UpdateAuraSize()
    if AuraSphere and AuraSphere.Parent then
        local diameter = CurrentRange * 2
        AuraSphere.Size = Vector3.new(diameter, diameter, diameter)
    end
end

local function DestroyAura()
    if AuraSphere then
        AuraSphere:Destroy()
        AuraSphere = nil
    end
end

local function CreateAuraSphere(character)
    DestroyAura()
    if not character then return end
    local hrp = character:WaitForChild("HumanoidRootPart", 5)
    if not hrp then return end

    AuraSphere = Instance.new("Part")
    AuraSphere.Name = "ProxyAuraVisualSphere"
    AuraSphere.Shape = Enum.PartType.Ball
    AuraSphere.Color = Color3.fromRGB(255, 35, 35)
    AuraSphere.Material = Enum.Material.ForceField
    AuraSphere.Transparency = 0.35
    
    AuraSphere.CanCollide = false
    AuraSphere.CanTouch = false
    AuraSphere.CanQuery = false
    AuraSphere.Massless = true
    
    AuraSphere.CastShadow = false
    AuraSphere.CFrame = hrp.CFrame
    AuraSphere.Parent = character

    AuraWeld = Instance.new("WeldConstraint")
    AuraWeld.Part0 = hrp
    AuraWeld.Part1 = AuraSphere
    AuraWeld.Parent = AuraSphere

    UpdateAuraSize()
end

