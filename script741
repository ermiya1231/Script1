local function AddKeyword()
    local text = string.gsub(AddInput.Text, "^%s*(.-)%s*$", "%1"):lower()
    if text ~= "" then
        local exists = false
        for _, kw in ipairs(PurchaseKeywords) do
            if kw == text then exists = true; break end
        end
        if not exists then
            table.insert(PurchaseKeywords, text)
            RefreshKeywordList()
        end
        AddInput.Text = ""
    end
end

