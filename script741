-- Anti-Robux Purchase Protection Hook
--------------------------------------------------------------------------------
if hookmetamethod then
    local oldNamecall
    oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
        local method = getnamecallmethod()
        if Enabled and FilterEnabled and self == MarketplaceService and (string.find(method, "Prompt") or string.find(method, "Purchase")) then
            return nil
        end
        return oldNamecall(self, ...)
    end)
end

local PurchaseKeywords = {
    "buy", "purchase", "robux", "r$", "pass", "gamepass", 
    "devproduct", "product", "donate", "push", "nuke", "spin", "explode", "troll"
}

local function IsPurchasePrompt(prompt)
    if not prompt or not FilterEnabled then return false end
    
    local textToSearch = string.lower(
        (prompt.ActionText or "") .. " " .. 
        (prompt.ObjectText or "") .. " " .. 
        (prompt.Name or "") .. " " .. 
        (prompt.Parent and prompt.Parent.Name or "")
    )
    
    for _, kw in ipairs(PurchaseKeywords) do
        if string.find(textToSearch, kw, 1, true) then
            return true
        end
    end
    
    return false
end

