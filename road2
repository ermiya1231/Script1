							if v.Name == "Part" and v.Parent == workspace 
								and math.abs(v.CFrame.X - math.floor(xloc)) < 1 
								and math.abs(v.CFrame.Z - math.floor(zloc)) < 1 then
								SetName(v, "MiniToad")
								SetAnchor(false, v)
								AddMesh(v)
								SetMesh(v, "7234998844")
								SetTexture(v, "1009824086")
								SetCollision(v, false)
								v.Orientation = Vector3.new(0, 0, 0)
								local sound = Instance.new("Sound", v)
								sound.SoundId = "rbxassetid://153752123"
								sound.Volume = 10
								sound.PlayOnRemove = true
								sound:Destroy()
								break
							end
						end
					end)
				else
					wait(1)
				end
			end
		end
	
		coroutine.wrap(function()
			while true do
