        if workspaceChar and workspaceChar:FindFirstChild("GravitySlap") and workspaceChar.GravitySlap:FindFirstChild("Event") then
            local args2 = {
                [1] = "slash",
                [2] = workspaceChar
            }
            workspaceChar.GravitySlap.Event:FireServer(unpack(args2))
        end
        
        -- 5. صبر کردن به مدت 0.5 ثانیه
        task.wait(0.5)
        
