-- 6. سیستم Auto Farm
local autoFarmActive = false
BtnAutoFarm.MouseButton1Click:Connect(function()
    autoFarmActive = not autoFarmActive
    if autoFarmActive then
        BtnAutoFarm.Text = "Auto Farm: ON"
        BtnAutoFarm.TextColor3 = Color3.fromRGB(100, 255, 100)
        BtnAutoFarm.BackgroundColor3 = Color3.fromRGB(20, 80, 40)
        AutoFarmStroke.Color = Color3.fromRGB(0, 255, 100)

        task.spawn(function()
            local character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
            local hrp = character:FindFirstChild("HumanoidRootPart")

            if hrp then
                local originalCFrame = hrp.CFrame
                while autoFarmActive do
                    for _, prompt in pairs(Workspace:GetDescendants()) do
                        if not autoFarmActive then break end
                        if prompt:IsA("ProximityPrompt") then
                            local parentPart = prompt.Parent
                            if parentPart and parentPart:IsA("BasePart") then
                                local color = parentPart.Color
                                local isGreen = (color.G > 0.5 and color.R < 0.5)

                                if isGreen or prompt.ObjectText:lower():find("money") or prompt.ActionText:lower():find("get") then
                                    hrp.CFrame = parentPart.CFrame + Vector3.new(0, 3, 0)
                                    task.wait(0.2)
                                    fireproximityprompt(prompt)
                                    task.wait(prompt.HoldDuration + 0.2)
                                end
                            end
                        end
                    end
                    task.wait(1)
                end
                if hrp then hrp.CFrame = originalCFrame end
            end
        end)
    else
        BtnAutoFarm.Text = "Auto Farm: OFF"
        BtnAutoFarm.TextColor3 = Color3.fromRGB(255, 100, 100)
        BtnAutoFarm.BackgroundColor3 = Color3.fromRGB(30, 30, 35)
        AutoFarmStroke.Color = Color3.fromRGB(60, 60, 65)
    end
end)

