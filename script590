-- تابع ساخت دکمه‌ها
local function CreateButton(name, text, defaultColor, strokeColor, layoutOrder)
    local Btn = Instance.new("TextButton")
    Btn.Name = name
    Btn.Size = UDim2.new(0.9, 0, 0, 35)
    Btn.BackgroundColor3 = defaultColor or Color3.fromRGB(30, 30, 35)
    Btn.Text = text
    Btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    Btn.TextSize = 14
    Btn.Font = Enum.Font.GothamBold
    Btn.LayoutOrder = layoutOrder
    Btn.Parent = ButtonContainer

    local BtnCorner = Instance.new("UICorner")
    BtnCorner.CornerRadius = UDim.new(0, 8)
    BtnCorner.Parent = Btn

    local BtnStroke = Instance.new("UIStroke")
    BtnStroke.Color = strokeColor or Color3.fromRGB(60, 60, 65)
    BtnStroke.Thickness = 1
    BtnStroke.Parent = Btn
    
    return Btn, BtnStroke
end

