    end)
end

notify("Reanimated!", "Loading...", 2)

local newChar = char
local root = newChar:WaitForChild("HumanoidRootPart")
local humanoid = newChar:WaitForChild("Humanoid")

-- ساخت پوشه مپ نامرئی
local invisibleMapFolder = Instance.new("Folder")
invisibleMapFolder.Name = "InvisibleHitboxMap"
invisibleMapFolder.Parent = workspace

local trackedParts = {}
local addedConnection, removedConnection

local function isValidPart(part)
    if not (part and part.Parent) then return false end
    local isBasePart = false
    pcall(function() isBasePart = part:IsA("BasePart") end)
    if not isBasePart then return false end
    if part:IsA("Terrain") then return false end
    if part:IsDescendantOf(newChar) then return false end
    if part:IsDescendantOf(invisibleMapFolder) then return false end
    if part.Name:sub(1, 5) == "Dummy" then return false end
    
    -- بررسی CanCollide حذف شد تا هنگام درگ کردن با F3X پارت کپی شده نابود نشود
    return true
end

local function addPartToMap(part)
    if not isValidPart(part) or trackedParts[part] then return end
    
    pcall(function()
        local clone = part:Clone()
        if not clone then return end
        
        for _, child in ipairs(clone:GetChildren()) do
            if not child:IsA("SpecialMesh") and not child:IsA("BlockMesh") and not child:IsA("CylinderMesh") then
                pcall(function() child:Destroy() end)
            end
        end
        
        clone.CFrame = part.CFrame + Vector3.new(0, yOffset, 0)
        clone.Transparency = 1
        clone.Anchored = true
        clone.CanCollide = part.CanCollide
        clone.Parent = invisibleMapFolder
        
        trackedParts[part] = clone
    end)
end

local function removePartFromMap(part)
    if trackedParts[part] then
        pcall(function() trackedParts[part]:Destroy() end)
        trackedParts[part] = nil
    end
end

for _, part in ipairs(workspace:GetDescendants()) do
    addPartToMap(part)
end

addedConnection = workspace.DescendantAdded:Connect(function(part)
    task.defer(function() addPartToMap(part) end)
end)

removedConnection = workspace.DescendantRemoving:Connect(function(part)
    removePartFromMap(part)
end)

-- حلقه آپدیت موقعیت و سایز
task.spawn(function()
    while task.wait(0.1) do
        if not _G.ReanimateRunning then break end
        
        local toRemove = {}
        for realPart, clone in pairs(trackedParts) do
            if realPart and realPart.Parent and isValidPart(realPart) and clone and clone.Parent then
                pcall(function()
                    -- آپدیت سایز
                    if clone.Size ~= realPart.Size then
                        clone.Size = realPart.Size
                    end
                    -- آپدیت وضعیت کالیژن (سینک دقیق با پارت اصلی هنگام جابجایی)
                    if clone.CanCollide ~= realPart.CanCollide then
                        clone.CanCollide = realPart.CanCollide
                    end
                    -- آپدیت مکان بهینه (فقط در صورت تغییر مکان آپدیت می‌شود)
                    local targetCFrame = realPart.CFrame + Vector3.new(0, yOffset, 0)
                    if clone.CFrame ~= targetCFrame then
                        clone.CFrame = targetCFrame
                    end
                end)
            else
                table.insert(toRemove, realPart)
            end
        end
        
        for _, badPart in ipairs(toRemove) do
            removePartFromMap(badPart)
        end
    end
end)

-- انتقال ایمن کاراکتر
root.AssemblyLinearVelocity = Vector3.zero
root.AssemblyAngularVelocity = Vector3.zero
root.CFrame = spawnCFrame + Vector3.new(0, yOffset + 3, 0)

task.wait(0.05)
root.AssemblyLinearVelocity = Vector3.zero
root.AssemblyAngularVelocity = Vector3.zero

local function getRealPart(partName)
    if newChar:FindFirstChild(partName) then return newChar[partName]
    elseif partName == "Torso" and newChar:FindFirstChild("UpperTorso") then return newChar.UpperTorso
    elseif partName == "Left Arm" and newChar:FindFirstChild("LeftUpperArm") then return newChar.LeftUpperArm
    elseif partName == "Right Arm" and newChar:FindFirstChild("RightUpperArm") then return newChar.RightUpperArm
    elseif partName == "Left Leg" and newChar:FindFirstChild("LeftUpperLeg") then return newChar.LeftUpperLeg
    elseif partName == "Right Leg" and newChar:FindFirstChild("RightUpperLeg") then return newChar.RightUpperLeg
    elseif partName == "Head" and newChar:FindFirstChild("Head") then return newChar.Head end
    return nil
end

local partsToSync = {
    ["Torso"] = dummyTorso, ["Head"] = dummyHead,
    ["Left Arm"] = dummyLeftArm, ["Right Arm"] = dummyRightArm,
    ["Left Leg"] = dummyLeftLeg, ["Right Leg"] = dummyRightLeg
}

RunService:BindToRenderStep("LocalDummySync", Enum.RenderPriority.Camera.Value - 1, function()
    if not newChar or not newChar.Parent then return end
    for realName, fakePart in pairs(partsToSync) do
        local realPart = getRealPart(realName)
        if realPart and fakePart and fakePart.Parent then
            fakePart.CFrame = realPart.CFrame - Vector3.new(0, yOffset + hipAdjustment, 0)
        end
    end
end)

task.spawn(function()
    local targetFPS = 30
    local stepTime = 1 / targetFPS
    
    while task.wait(stepTime) do
        if not newChar or not newChar.Parent or not dummyTorso or not dummyTorso.Parent then break end
        
        local f3xMoveData = {}
        for realName, fakePart in pairs(partsToSync) do
            local realPart = getRealPart(realName)
            if realPart and fakePart and fakePart.Parent then
                table.insert(f3xMoveData, {
                    ["Part"] = fakePart,
                    ["CFrame"] = realPart.CFrame - Vector3.new(0, yOffset + hipAdjustment, 0)
                })
            end
        end
        
        if #f3xMoveData > 0 then
            task.spawn(function()
                pcall(function() syncAPI:InvokeServer("SyncMove", f3xMoveData) end)
            end)
        end
    end
end)

camera.CameraSubject = humanoid
RunService:BindToRenderStep("OffsetCameraView", Enum.RenderPriority.Camera.Value + 1, function()
    if camera and camera.CFrame then
        camera.CFrame = camera.CFrame - Vector3.new(0, yOffset, 0)
    end
end)

-- سیستم فیکس دوربین و ریست وضعیت هنگام مرگ
humanoid.Died:Connect(function()
    _G.ReanimateRunning = false
    pcall(function() RunService:UnbindFromRenderStep("LocalDummySync") end)
    pcall(function() RunService:UnbindFromRenderStep("OffsetCameraView") end)
    
    if addedConnection then addedConnection:Disconnect() end
    if removedConnection then removedConnection:Disconnect() end
    
    if invisibleMapFolder then
        pcall(function() invisibleMapFolder:Destroy() end)
    end
    
    task.delay(1, function()
        local latestChar = player.Character
        if latestChar then
            camera.CameraSubject = latestChar:FindFirstChild("Humanoid")
        end
    end)
end)

-- اجرای نامرئی‌سازی local
task.spawn(function()
    local function startInvisibilityLoop(character)
        local hum = character:WaitForChild("Humanoid")
        local connection

        connection = RunService.RenderStepped:Connect(function()
            if not hum or hum.Health <= 0 then
                if connection then
                    connection:Disconnect()
                    connection = nil
                end
                return
            end

            for _, object in ipairs(character:GetDescendants()) do
                if object:IsA("BasePart") or object:IsA("Decal") then
                    pcall(function()
                        if object.LocalTransparencyModifier ~= 1 then
                            object.LocalTransparencyModifier = 1
                        end
                    end)
                end
            end
        end)

        hum.Died:Connect(function()
            if connection then
                connection:Disconnect()
                connection = nil
            end
        end)
    end

    if player.Character then
        startInvisibilityLoop(player.Character)
    end
end)
