        StarterGui:SetCore("SendNotification", {
            Title = title,
            Text = text,
            Duration = duration or 4
        })
    end)
end

notify("Reanimate System", "در حال بررسی ابزار F3X...", 3)

local char = player.Character or player.CharacterAdded:Wait()
local f3x = player.Backpack:FindFirstChild("Building Tools") or char:FindFirstChild("Building Tools")

if not f3x then
    notify("خطا!", "ابزار F3X پیدا نشد! لطفا ابزار را در کیف (Backpack) داشته باشید.", 5)
