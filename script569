------------------------------------------------------------ API helpers
local function httpGet(url)
    local req = (syn and syn.request) or request or http_request or (http and http.request)
    if not req then return nil end
    local ok, res = pcall(req, { Url = url, Method = "GET" })
    if ok and res and res.StatusCode == 200 and res.Body then
        local ok2, data = pcall(function() return Http:JSONDecode(res.Body) end)
        if ok2 then return data end
    end
    return nil
end

local function productInfo(id, infoType)
    local ok, info = pcall(function() return Market:GetProductInfo(id, infoType) end)
    if ok and type(info) == "table" and (info.Name or info.name) then return info end
    return nil
end

local function normalize(info, kind)
    local c = info.Creator or info.creator or {}
    local typeId = info.AssetTypeId
    return {
        kind = kind,
        name = info.Name or info.name or "?",
        typeName = kind == "asset" and (ASSET_TYPES[typeId] or ("Type " .. tostring(typeId or "?")))
            or (kind == "bundle" and ("Bundle" .. (info.bundleType and (" / " .. tostring(info.bundleType)) or "")))
            or "GamePass",
        creatorName = c.Name or c.name or "?",
        creatorId = c.CreatorTargetId or c.Id or c.id,
        creatorType = c.CreatorType or c.type or "?",
        created = info.Created or info.created,
        updated = info.Updated or info.updated,
        description = info.Description or info.description,
    }
end

local function lookup(id, hint)
    local function asset()
        local i = productInfo(id, Enum.InfoType.Asset)
        if i then return normalize(i, "asset"), "MarketplaceService" end
        local d = httpGet("https://economy.roblox.com/v2/assets/" .. id .. "/details")
        if d then return normalize(d, "asset"), "economy API" end
    end
    local function bundle()
        local i = productInfo(id, Enum.InfoType.Bundle)
        if i then return normalize(i, "bundle"), "MarketplaceService" end
        local d = httpGet("https://catalog.roblox.com/v1/bundles/" .. id .. "/details")
        if d then return normalize(d, "bundle"), "catalog API" end
    end
    local function pass()
        local i = productInfo(id, Enum.InfoType.GamePass)
        if i then return normalize(i, "gamepass"), "MarketplaceService" end
    end

    local order = { asset, bundle, pass }
    if hint == "bundle" then order = { bundle, asset, pass }
    elseif hint == "gamepass" then order = { pass, asset, bundle } end

    for _, fn in ipairs(order) do
        local r, src = fn()
        if r then r.source = src return r end
    end
    return nil
end

local function creatorExtra(r)
    local rows = {}
    if not r.creatorId then return rows end
    local ctype = tostring(r.creatorType):lower()

    if ctype == "group" then
        local g = httpGet("https://groups.roblox.com/v1/groups/" .. r.creatorId)
        if g then
            if g.owner then
                table.insert(rows, { "Group Owner", tostring(g.owner.username) })
                table.insert(rows, { "Owner Display Name", tostring(g.owner.displayName) })
                table.insert(rows, { "Owner ID", tostring(g.owner.userId) })
                table.insert(rows, { "Owner Profile", "https://www.roblox.com/users/" .. g.owner.userId .. "/profile" })
            else
                table.insert(rows, { "Group Owner", "No owner (group is ownerless)" })
            end
            if g.memberCount then
                table.insert(rows, { "Members", tostring(g.memberCount) })
            end
        else
            table.insert(rows, { "Group Owner", "Could not fetch (request/API failed)" })
        end
        table.insert(rows, { "Group Link", "https://www.roblox.com/groups/" .. r.creatorId })
    else
        local u = httpGet("https://users.roblox.com/v1/users/" .. r.creatorId)
        if u then
            table.insert(rows, { "Display Name", tostring(u.displayName) })
            if u.created then
                table.insert(rows, { "Account Created", tostring(u.created):sub(1, 10) })
            end
        end
        table.insert(rows, { "Profile Link", "https://www.roblox.com/users/" .. r.creatorId .. "/profile" })
    end
    return rows
end

------------------------------------------------------------ input parsing
local function parseInput(text)
    text = tostring(text or "")
    local id = text:match("%d+")
    if not id then return nil end
    local low = text:lower()
    local hint = "asset"
    if low:find("bundles") then hint = "bundle"
    elseif low:find("game%-pass") or low:find("gamepass") then hint = "gamepass" end
    return tonumber(id), hint
end

