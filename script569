------------------------------------------------------------ main logic
local busy = false
local function run()
    if busy then return end
    local id, hint = parseInput(input.Text)
    if not id then
        status.Text = "No valid number found."
        status.TextColor3 = Color3.fromRGB(255, 120, 120)
        return
    end
    busy = true
    clearRows()
    status.TextColor3 = Color3.fromRGB(170, 170, 190)
    status.Text = "Searching..."

    task.spawn(function()
        local r = lookup(id, hint)
        if not r then
            status.Text = "Not found (private/deleted, or ID invalid)."
            status.TextColor3 = Color3.fromRGB(255, 120, 120)
            busy = false
            return
        end

        local isGroup = tostring(r.creatorType):lower() == "group"
        status.Text = "Found via " .. tostring(r.source) .. (isGroup and " | Creator is a Group" or "")
        status.TextColor3 = Color3.fromRGB(120, 230, 150)

        addRow("Creator", r.creatorName)
        addRow("Creator Type", r.creatorType)
        addRow("Creator ID", r.creatorId or "?")

        -- اگر Group بود، اینجا مالک گروه نشان داده می‌شود
        for _, e in ipairs(creatorExtra(r)) do addRow(e[1], e[2]) end

        addRow("Item Name", r.name)
        addRow("Item Type", r.typeName)
        addRow("Item ID", id)
        if r.created then addRow("Created", tostring(r.created):sub(1, 10)) end
        if r.updated then addRow("Updated", tostring(r.updated):sub(1, 10)) end
        if r.description and r.description ~= "" then addRow("Description", r.description) end

        busy = false
    end)
end

btn.MouseButton1Click:Connect(run)
input.FocusLost:Connect(function(enter) if enter then run() end end)

------------------------------------------------------------ dragging
local dragging, dragStart, startPos
title.InputBegan:Connect(function(i)
    if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
        dragging, dragStart, startPos = true, i.Position, main.Position
        i.Changed:Connect(function()
            if i.UserInputState == Enum.UserInputState.End then dragging = false end
        end)
    end
end)
UIS.InputChanged:Connect(function(i)
    if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
        local d = i.Position - dragStart
        main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
    end
end)
