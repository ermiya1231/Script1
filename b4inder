-- ====== پارس آرگومان ======
local function getArgs()
    local text = argBox.Text
    if text:match("^%s*$") then return table.pack() end
    local ls = loadstring or load
    if ls then
        local fn = ls("return " .. text)
        if fn then
            local ok, res = pcall(function() return table.pack(fn()) end)
            if ok then return res end
        end
    end
    return table.pack(text) -- اگه پارس نشد، به صورت رشته ساده
end

-- ====== اجرای ریموت ======
local function run(remote)
    local args = getArgs()
    if remote:IsA("RemoteEvent") then
        pcall(function() remote:FireServer(table.unpack(args, 1, args.n)) end)
    elseif remote:IsA("RemoteFunction") then
        task.spawn(function() -- InvokeServer yield می‌کنه
            pcall(function() remote:InvokeServer(table.unpack(args, 1, args.n)) end)
        end)
    end
end

-- ====== مدیریت ردیف‌ها ======
local rows = {} -- [remote] = {frame=, path=, pathLabel=, visible=}
local order = 0

local function isRemote(o)
    return o:IsA("RemoteEvent") or o:IsA("RemoteFunction")
end

local function removeRow(remote)
    local r = rows[remote]
    if r then
        r.frame:Destroy()
        rows[remote] = nil
    end
end

local function addRow(remote)
    if rows[remote] then return end
    order += 1
    local isEvent = remote:IsA("RemoteEvent")

    local row = make("Frame", {
        Size = UDim2.new(1, -6, 0, 44), BackgroundColor3 = C.row,
        BorderSizePixel = 1, BorderColor3 = C.dim,
        LayoutOrder = order, ClipsDescendants = true,
    }, list)

    local nameLabel = make("TextLabel", {
        Text = remote.Name .. (isEvent and "  [Event]" or "  [Function]"),
        Font = Enum.Font.Code, TextSize = 14, TextColor3 = C.green,
        BackgroundTransparency = 1, Size = UDim2.new(1, -130, 0, 20),
        Position = UDim2.new(0, 6, 0, 2), TextXAlignment = Enum.TextXAlignment.Left,
        TextTruncate = Enum.TextTruncate.AtEnd,
    }, row)

    local pathLabel = make("TextLabel", {
        Text = remote:GetFullName(), Font = Enum.Font.Code, TextSize = 11,
        TextColor3 = C.dim, BackgroundTransparency = 1,
        Size = UDim2.new(1, -130, 0, 18), Position = UDim2.new(0, 6, 0, 23),
        TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd,
    }, row)

    local actBtn = button(isEvent and "Fire" or "Invoke", isEvent and C.fire or C.invoke,
        UDim2.new(0, 56, 0, 30), UDim2.new(1, -122, 0, 7), row)
    local delBtn = button("Delete", C.red, UDim2.new(0, 56, 0, 30), UDim2.new(1, -62, 0, 7), row)

    actBtn.Activated:Connect(function() run(remote) end)
    delBtn.Activated:Connect(function()
        pcall(function() remote:Destroy() end)
        removeRow(remote)
    end)

    rows[remote] = { frame = row, pathLabel = pathLabel, nameLabel = nameLabel, path = pathLabel.Text, shown = true }
end

-- ====== ثبت ریموت‌ها با Event (بدون اسکن سنگین) ======
local roots = { RS, LP, workspace }

local function hook(root)
    for _, d in ipairs(root:GetDescendants()) do
        if isRemote(d) then addRow(d) end
    end
    root.DescendantAdded:Connect(function(d)
        if isRemote(d) then addRow(d) end
    end)
    root.DescendantRemoving:Connect(function(d)
        if rows[d] then
            task.defer(removeRow, d)
        end
    end)
end

for _, r in ipairs(roots) do hook(r) end

-- ====== آپدیت هر 0.1 ثانیه (فقط تغییرات) ======
task.spawn(function()
    while gui.Parent do
        local q = search.Text:lower()
        for remote, r in pairs(rows) do
            if not remote.Parent then
                removeRow(remote)
            else
                local p = remote:GetFullName()
                if p ~= r.path then
                    r.path = p
                    r.pathLabel.Text = p
                end
                local match = q == "" or remote.Name:lower():find(q, 1, true) ~= nil or p:lower():find(q, 1, true) ~= nil
                if match ~= r.shown then
                    r.shown = match
                    r.frame.Visible = match
                end
            end
        end
        task.wait(0.1)
    end
end)

-- ====== Fire All / Invoke All (فقط ریموت‌های قابل مشاهده در لیست) ======
fireAll.Activated:Connect(function()
    for remote, r in pairs(rows) do
        if r.shown and remote:IsA("RemoteEvent") then run(remote) end
    end
end)

invokeAll.Activated:Connect(function()
    for remote, r in pairs(rows) do
        if r.shown and remote:IsA("RemoteFunction") then run(remote) end
    end
end)

-- ====== سیستم درگ (همون سیستم خودت، با کمی اصلاح) ======
local function makeDraggable(handle, targetFrame)
    local dragging, dragInput, dragStart, startPos

    handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = targetFrame.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)

    handle.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)

    UIS.InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            local delta = input.Position - dragStart
            local newPos = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + delta.X,
                startPos.Y.Scale, startPos.Y.Offset + delta.Y
            )
            TweenService:Create(targetFrame, TweenInfo.new(0.15), { Position = newPos }):Play()
        end
    end)
end

makeDraggable(titleBar, frame)
