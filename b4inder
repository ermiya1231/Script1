-- ====== پارس آرگومان ======
local function getArgs()
    local text = argBox.Text
    if text:match("^%s*$") then return table.pack() end
    local ls = loadstring or load
    if ls then
        local fn = ls("return " .. text)
        if fn then
            local ok, res = pcall(function() return table.pack(fn()) end)
            if ok then return res end
        end
    end
    return table.pack(text)
end

-- ====== اجرای ریموت ======
local function run(remote)
    local args = getArgs()
    if remote:IsA("RemoteEvent") then
        pcall(function() remote:FireServer(table.unpack(args, 1, args.n)) end)
    elseif remote:IsA("RemoteFunction") then
        task.spawn(function()
            pcall(function() remote:InvokeServer(table.unpack(args, 1, args.n)) end)
        end)
    end
end

-- ====== کپی کردن مسیر ======
local function copyPath(remote)
    local path = remote:GetFullName()
    pcall(function()
        if setclipboard then
            setclipboard(path)
        elseif syn and syn.write_clipboard then
            syn.write_clipboard(path)
        elseif toclipboard then
            tostring(toclipboard(path))
        end
    end)
end

-- ====== تشخیص ریموت‌های بلک‌لیست ======
local function isBlacklistedRemote(remote)
    local p = remote:GetFullName():lower()
    if p:find("hdadminhdclient", 1, true) ~= nil then return true end
    if p:find("kohl", 1, true) ~= nil then return true end
    if p:find("replicatedstorage.zap", 1, true) ~= nil then return true end
    if p:find("replicatedstorage.defaultchatsystemchatevents", 1, true) ~= nil then return true end
    return false
end

-- ====== مدیریت ردیف‌ها ======
local rows = {}
local order = 0

local function isRemote(o)
    return o:IsA("RemoteEvent") or o:IsA("RemoteFunction")
end

local function removeRow(remote)
    local r = rows[remote]
    if r then
        r.frame:Destroy()
        rows[remote] = nil
    end
end

local function addRow(remote)
    if rows[remote] then return end
    order += 1
    local isEvent = remote:IsA("RemoteEvent")
    
    -- تنوع رنگ پس‌زمینه خود ریموت‌ها (Eventها سبزتر، Functionها آبی‌تر)
    local rowColor
    if isEvent then
        rowColor = (order % 2 == 1) and C.rowEvent1 or C.rowEvent2
    else
        rowColor = (order % 2 == 1) and C.rowFunc1 or C.rowFunc2
    end
    
    -- تنوع رنگ دکمه‌ها
    local actColor
    if isEvent then
        actColor = (order % 2 == 1) and C.fire or C.fireAlt
    else
        actColor = (order % 2 == 1) and C.invoke or C.invokeAlt
    end
    local copyColor = (order % 2 == 1) and C.copy or C.copyAlt

    local row = make("Frame", {
        Size = UDim2.new(1, -6, 0, 44), BackgroundColor3 = rowColor,
        BorderSizePixel = 1, BorderColor3 = C.dim,
        LayoutOrder = order, ClipsDescendants = true,
    }, list)

    local nameLabel = make("TextLabel", {
        Text = remote.Name .. (isEvent and "  [Event]" or "  [Function]"),
        Font = Enum.Font.Code, TextSize = 14, TextColor3 = C.green,
        BackgroundTransparency = 1, Size = UDim2.new(1, -178, 0, 20),
        Position = UDim2.new(0, 6, 0, 2), TextXAlignment = Enum.TextXAlignment.Left,
        TextTruncate = Enum.TextTruncate.AtEnd,
    }, row)

    local pathLabel = make("TextLabel", {
        Text = remote:GetFullName(), Font = Enum.Font.Code, TextSize = 11,
        TextColor3 = C.dim, BackgroundTransparency = 1,
        Size = UDim2.new(1, -178, 0, 18), Position = UDim2.new(0, 6, 0, 23),
        TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd,
    }, row)

    local actBtn = button(isEvent and "Fire" or "Invoke", actColor,
        UDim2.new(0, 52, 0, 30), UDim2.new(1, -172, 0, 7), row)
    local copyBtn = button("Copy Path", copyColor,
        UDim2.new(0, 56, 0, 30), UDim2.new(1, -116, 0, 7), row)
        copyBtn.TextSize = 11
    local delBtn = button("Delete", C.red,
        UDim2.new(0, 52, 0, 30), UDim2.new(1, -56, 0, 7), row)

    actBtn.Activated:Connect(function() run(remote) end)
    	
    copyBtn.Activated:Connect(function()
    	copyBtn.Text = "Copied!"
    	copyPath(remote)
        task.wait(1)
        copyBtn.Text = "Copy Path"
        end)

    delBtn.Activated:Connect(function()
        pcall(function() remote:Destroy() end)
        removeRow(remote)
    end)

    rows[remote] = { frame = row, pathLabel = pathLabel, nameLabel = nameLabel, path = pathLabel.Text, shown = true }
end

-- ====== ثبت ریموت‌ها ======
local roots = { RS, LP, workspace }

local function hook(root)
    for _, d in ipairs(root:GetDescendants()) do
        if isRemote(d) then addRow(d) end
    end
    root.DescendantAdded:Connect(function(d)
        if isRemote(d) then addRow(d) end
    end)
    root.DescendantRemoving:Connect(function(d)
        if rows[d] then
            task.defer(removeRow, d)
        end
    end)
end

for _, r in ipairs(roots) do hook(r) end

-- ====== آپدیت هر 0.1 ثانیه ======
task.spawn(function()
    while gui.Parent do
        local q = search.Text:lower()
        for remote, r in pairs(rows) do
            if not remote.Parent then
                removeRow(remote)
            else
                local p = remote:GetFullName()
                if p ~= r.path then
                    r.path = p
                    r.pathLabel.Text = p
                end
                
                local blacklisted = filterAdmin and isBlacklistedRemote(remote)
                local match = (not blacklisted) and (q == "" or remote.Name:lower():find(q, 1, true) ~= nil or p:lower():find(q, 1, true) ~= nil)
                
                if match ~= r.shown then
                    r.shown = match
                    r.frame.Visible = match
                end
            end
        end
        task.wait(0.1)
    end
end)

