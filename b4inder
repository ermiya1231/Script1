-- سیستم درگ نرم و سازگار با موبایل
local function makeDraggable(Frame, TopBar)
    TopBar = TopBar or Frame
    local dragToggle = false
    local dragSpeed = 0.15
    local dragInput = nil
    local dragStart = nil
    local startPos = nil

    local function updateInput(input)
        local Delta = input.Position - dragStart
        local Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + Delta.X, startPos.Y.Scale, startPos.Y.Offset + Delta.Y)
        TweenService:Create(Frame, TweenInfo.new(dragSpeed), {Position = Position}):Play()
    end

    TopBar.InputBegan:Connect(function(input)
        if (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) and UserInputService:GetFocusedTextBox() == nil then
            dragToggle = true
            dragStart = input.Position
            startPos = Frame.Position
            
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragToggle = false
                end
            end)
        end
    end)

    TopBar.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragToggle then
            updateInput(input)
        end
    end)
end

-- جدول ریموت‌ها برای جلوگیری از تکرار
local remotes = {}
local remoteSet = {}

local function addRemote(obj)
    if (obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction")) and not remoteSet[obj] then
        remoteSet[obj] = true
        table.insert(remotes, obj)
        return true
    end
    return false
end

-- لیست سرویس‌های ممنوعه کلاینت
local blacklistedServices = {
    ["ServerScriptService"] = true,
    ["ServerStorage"] = true,
    ["RobloxReplicatedStorage"] = true
}

-- استارت اسکن اولیه و سیستم شنود لحظه‌ای (Real-time Scanner)
local function startLiveScanning(onNewRemoteFound)
    -- اسکن همه‌جا در ابتدا
    for _, service in ipairs(game:GetChildren()) do
        if not blacklistedServices[service.Name] then
            pcall(function()
                for _, obj in ipairs(service:GetDescendants()) do
                    if addRemote(obj) and onNewRemoteFound then
                        onNewRemoteFound(obj)
                    end
                end
                
                -- شنود لحظه‌ای برای ریموت‌های جدید در این سرویس
                service.DescendantAdded:Connect(function(obj)
                    if addRemote(obj) and onNewRemoteFound then
                        onNewRemoteFound(obj)
                    end
                end)
            end)
        end
    end

    -- اسکن ویژه کوله‌پشتی و کاراکتر بازیکنان (پویا)
    local function listenToPlayer(player)
        player.CharacterAdded:Connect(function(char)
            pcall(function()
                for _, obj in ipairs(char:GetDescendants()) do
                    if addRemote(obj) and onNewRemoteFound then onNewRemoteFound(obj) end
                end
                char.DescendantAdded:Connect(function(obj)
                    if addRemote(obj) and onNewRemoteFound then onNewRemoteFound(obj) end
                end)
            end)
        end)

        player:GetPropertyChangedSignal("Backpack"):Connect(function()
            local bp = player:FindFirstChild("Backpack")
            if bp then
                pcall(function()
                    for _, obj in ipairs(bp:GetDescendants()) do
                        if addRemote(obj) and onNewRemoteFound then onNewRemoteFound(obj) end
                    end
                    bp.DescendantAdded:Connect(function(obj)
                        if addRemote(obj) and onNewRemoteFound then onNewRemoteFound(obj) end
                    end)
                end)
            end
        end)
        
        -- بررسی کوله‌پشتی فعلی در صورت وجود
        local bp = player:FindFirstChild("Backpack")
        if bp then
            pcall(function()
                for _, obj in ipairs(bp:GetDescendants()) do
                    if addRemote(obj) and onNewRemoteFound then onNewRemoteFound(obj) end
                end
                bp.DescendantAdded:Connect(function(obj)
                    if addRemote(obj) and onNewRemoteFound then onNewRemoteFound(obj) end
                end)
            end)
        end
    end

    Players.PlayerAdded:Connect(listenToPlayer)
    for _, p in ipairs(Players:GetPlayers()) do
        listenToPlayer(p)
    end
end

