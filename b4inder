end

removeRow = function(remote)
	local row = rows[remote]
	if row then
		row.frame:Destroy()
		rows[remote] = nil
		rowCount -= 1
	end
end

-- search filter (only toggles Visible, never rebuilds the list)
local function applyFilter()
	filterText = searchBox.Text:lower()
	for _, row in pairs(rows) do
		row.frame.Visible = matchesFilter(row.search)
	end
end
searchBox:GetPropertyChangedSignal("Text"):Connect(applyFilter)

---------------------------------------------------------------- discovery (event based + 0.1s flush)
local pending = {}
local pendingList = {}

local function queue(inst)
	if not pending[inst] and not rows[inst] then
		pending[inst] = true
		pendingList[#pendingList + 1] = inst
	end
end

for _, root in ipairs(Roots) do
	root.DescendantAdded:Connect(function(d)
		if isRemote(d) then
			queue(d)
		end
	end)
end

-- first scan in chunks so the game never freezes
task.spawn(function()
	for _, root in ipairs(Roots) do
		local n = 0
		for _, d in ipairs(root:GetDescendants()) do
			if isRemote(d) then
				queue(d)
			end
			n += 1
			if n % 1500 == 0 then
				task.wait()
			end
		end
	end
end)

-- main 0.1s update loop (only touches what changed)
task.spawn(function()
	while gui.Parent do
		-- 1) add new remotes (capped per tick to stay smooth)
		local added = 0
		while #pendingList > 0 and added < 40 do
			local inst = table.remove(pendingList)
			pending[inst] = nil
			if inst.Parent and inRoots(inst) then
				addRow(inst)
				added += 1
			end
		end

		-- 2) validate existing rows (removed / moved / renamed)
		local shown = 0
		for remote, row in pairs(rows) do
			if not inRoots(remote) then
				removeRow(remote)
			else
				local changed = false
				if remote.Parent ~= row.parent then
					row.parent = remote.Parent
					row.pathLbl.Text = remote:GetFullName()
					changed = true
				end
				if remote.Name ~= row.name then
					row.name = remote.Name
					row.nameLbl.Text = (isFunction(remote) and "[Function] " or "[Event] ") .. remote.Name
					row.pathLbl.Text = remote:GetFullName()
					changed = true
				end
				if changed then
					row.search = (remote.Name .. " " .. remote:GetFullName()):lower()
					row.frame.Visible = matchesFilter(row.search)
				end
				if row.frame.Visible then
					shown += 1
				end
			end
		end

		countLabel.Text = shown .. "/" .. rowCount .. " remotes"
		task.wait(0.1)
	end
end)

---------------------------------------------------------------- buttons
local function runAll(wantFunctions)
	local args = collectArgs()
	local snapshot = {}
	for remote in pairs(rows) do
		if isFunction(remote) == wantFunctions then
			snapshot[#snapshot + 1] = remote
		end
	end
	task.spawn(function()
		for i, remote in ipairs(snapshot) do
			fireRemote(remote, args)
			if i % 10 == 0 then
				task.wait()
			end
		end
	end)
end

