---------------------------------------------------------------- dragging (by header)
do
	local dragging, dragStart, startPos
	header.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			dragStart = input.Position
			startPos = main.Position
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if
			dragging
			and (
				input.UserInputType == Enum.UserInputType.MouseMovement
				or input.UserInputType == Enum.UserInputType.Touch
			)
		then
			local d = input.Position - dragStart
			main.Position = UDim2.new(
				startPos.X.Scale,
				startPos.X.Offset + d.X,
				startPos.Y.Scale,
				startPos.Y.Offset + d.Y
			)
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)
end

---------------------------------------------------------------- args parsing
local function parseArg(s)
	s = s:match("^%s*(.-)%s*$")
	if s == "nil" then
		return nil
	elseif s == "true" then
		return true
	elseif s == "false" then
		return false
	end
	local n = tonumber(s)
	if n then
		return n
	end
	local q = s:match('^"(.*)"$') or s:match("^'(.*)'$")
	return q or s
end

local function collectArgs()
	local args = { n = 0 }
	for _, box in ipairs(argBoxes) do
		if box.Text ~= "" then
			args.n += 1
			args[args.n] = parseArg(box.Text)
		end
	end
	return args
end

---------------------------------------------------------------- remote firing
local function isRemote(i)
	return i:IsA("RemoteEvent") or i:IsA("UnreliableRemoteEvent") or i:IsA("RemoteFunction")
end

local function isFunction(i)
	return i:IsA("RemoteFunction")
end

local function fireRemote(remote, args)
	task.spawn(function()
		pcall(function()
			if isFunction(remote) then
				remote:InvokeServer(table.unpack(args, 1, args.n))
			else
				remote:FireServer(table.unpack(args, 1, args.n))
			end
		end)
	end)
end

---------------------------------------------------------------- rows
local rows = {} -- [remote] = {frame=, nameLbl=, pathLbl=, parent=, name=}
local rowCount = 0
local orderCounter = 0

local function inRoots(inst)
	for _, r in ipairs(Roots) do
		if inst:IsDescendantOf(r) then
			return true
		end
	end
	return false
end

local filterText = ""
local function matchesFilter(s)
	return filterText == "" or s:find(filterText, 1, true) ~= nil
end

local removeRow -- forward declaration (used by the Delete button)

