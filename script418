-- تابع سریالایزر پیشرفته برای ساخت فرمت local args و تبدیل اینتنس‌ها به game.Workspace...
local function serialize(val, indent)
    indent = indent or 0
    local formatting = string.rep("    ", indent)
    if typeof(val) == "Instance" then
        local success, path = pcall(function() return val:GetFullName() end)
        if success then
            return "game." .. path
        else
            return "tostring(" .. tostring(val) .. ")"
        end
    elseif type(val) == "table" then
        local result = "{\n"
        for k, v in pairs(val) do
            local keyStr = type(k) == "number" and "[" .. k .. "]" or '["' .. tostring(k) .. '"]'
            result = result .. formatting .. "    " .. keyStr .. " = " .. serialize(v, indent + 1) .. ",\n"
        end
        return result .. formatting .. "}"
    elseif type(val) == "string" then
        return '"' .. val .. '"'
    else
        return tostring(val)
    end
end

