local function addLog(remoteName, remoteType, direction, rawPath, args)
    if currentTab == "Incoming" and direction ~= "IN" then return end
    if currentTab == "Outgoing" and direction ~= "OUT" then return end

    local timestamp = os.date("%H:%M:%S")
    local fullPath = "game." .. rawPath
    local key = rawPath .. "_" .. remoteType .. "_" .. direction

    if not loggedRemotes[key] then
        local logBtn = Instance.new("TextButton")
        logBtn.Parent = LogsView
        logBtn.BackgroundColor3 = direction == "OUT" and Color3.fromRGB(25, 35, 45) or Color3.fromRGB(35, 25, 45)
        logBtn.Size = UDim2.new(1, -5, 0, 40)
        logBtn.Font = Enum.Font.Gotham
        logBtn.Text = ""
        Instance.new("UICorner", logBtn).CornerRadius = UDim.new(0, 4)

        local badge = Instance.new("TextLabel")
        badge.Parent = logBtn
        badge.BackgroundColor3 = direction == "OUT" and Color3.fromRGB(0, 180, 255) or Color3.fromRGB(255, 100, 255)
        badge.Position = UDim2.new(0, 5, 0, 5)
        badge.Size = UDim2.new(0, 35, 0, 15)
        badge.Font = Enum.Font.GothamBold
        badge.Text = direction == "OUT" and "OUT" or "IN"
        badge.TextColor3 = Color3.fromRGB(15, 15, 20)
        badge.TextSize = 9
        Instance.new("UICorner", badge).CornerRadius = UDim.new(0, 3)

        local nameLbl = Instance.new("TextLabel")
        nameLbl.Parent = logBtn
        nameLbl.BackgroundTransparency = 1
        nameLbl.Position = UDim2.new(0, 45, 0, 3)
        nameLbl.Size = UDim2.new(1, -50, 0, 16)
        nameLbl.Font = Enum.Font.GothamBold
        nameLbl.Text = remoteName
        nameLbl.TextColor3 = Color3.fromRGB(230, 230, 230)
        nameLbl.TextSize = 11
        nameLbl.TextXAlignment = Enum.TextXAlignment.Left
        nameLbl.TextTruncate = Enum.TextTruncate.AtEnd

        local countLbl = Instance.new("TextLabel")
        countLbl.Parent = logBtn
        countLbl.BackgroundTransparency = 1
        countLbl.Position = UDim2.new(0, 5, 0, 20)
        countLbl.Size = UDim2.new(1, -10, 0, 16)
        countLbl.Font = Enum.Font.Gotham
        countLbl.Text = "1x (" .. timestamp .. ")"
        countLbl.TextColor3 = Color3.fromRGB(150, 150, 150)
        countLbl.TextSize = 9
        countLbl.TextXAlignment = Enum.TextXAlignment.Left

        loggedRemotes[key] = {
            button = logBtn,
            countLbl = countLbl,
            count = 1,
            history = {},
            fullPath = fullPath,
            remoteType = remoteType
        }

        logBtn.MouseButton1Click:Connect(function()
            selectedRemoteKey = key
            refreshHistory(key)

            if #loggedRemotes[key].history > 0 then
                local first = loggedRemotes[key].history[1]
                local argsCode = ""
                for i, arg in ipairs(first.args) do
                    argsCode = argsCode .. "    [" .. i .. "] = " .. serialize(arg, 1) .. ",\n"
                end
                selectedCodeText = string.format("local args = {\n%s}\n\n%s:%s(unpack(args))", argsCode, fullPath, remoteType)
                CodeTextBox.Text = selectedCodeText
            end
        end)
    else
        loggedRemotes[key].count = loggedRemotes[key].count + 1
        loggedRemotes[key].countLbl.Text = tostring(loggedRemotes[key].count) .. "x (" .. timestamp .. ")"
    end

    -- افزودن رکورد به تاریخچه
    table.insert(loggedRemotes[key].history, {time = timestamp, args = args, fullPath = fullPath, remoteType = remoteType})

    -- به‌روزرسانی زنده هیستوری اگر این ریموت انتخاب شده باشد
    if selectedRemoteKey == key then
        refreshHistory(key)
    end
end

-- مانیتورینگ ریموت‌ها
local function hookRemote(obj)
    if obj:IsA("RemoteEvent") then
        obj.OnClientEvent:Connect(function(...)
            local success, path = pcall(function() return obj:GetFullName() end)
            if success then
                addLog(obj.Name, "FireServer", "IN", path, {...})
            end
        end)
    elseif obj:IsA("RemoteFunction") then
        obj.OnClientInvoke = function(...)
            local success, path = pcall(function() return obj:GetFullName() end)
            if success then
                addLog(obj.Name, "InvokeServer", "IN", path, {...})
            end
            return
        end
    end
end

for _, obj in ipairs(game:GetDescendants()) do
    hookRemote(obj)
end

game.DescendantAdded:Connect(function(obj)
    hookRemote(obj)
end)

-- مانیتورینگ ریموت‌های ارسالی با پشتیبانی شرطی
if supportsOutgoing then
    local oldNamecall
    oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
        local method = getnamecallmethod()
        local args = {...}
        
        if (method == "FireServer" or method == "InvokeServer") and not checkcaller() then
            local successPath, path = pcall(function() return self:GetFullName() end)
            if successPath then
                addLog(self.Name, method, "OUT", path, args)
            end
        end
        
        return oldNamecall(self, ...)
    end)
end

-- قابلیت جابجایی پنل (Draggable)
local function makeDraggable(targetFrame)
    local dragging, dragInput, dragStart, startPos
    
    targetFrame.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = targetFrame.Position
            
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)
    
    targetFrame.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)
    
    UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            local delta = input.Position - dragStart
            local newPos = UDim2.new(
                startPos.X.Scale, 
                startPos.X.Offset + delta.X, 
                startPos.Y.Scale, 
                startPos.Y.Offset + delta.Y
            )
            TweenService:Create(targetFrame, TweenInfo.new(0.15), {Position = newPos}):Play()
        end
    end)
end

makeDraggable(MainFrame)
