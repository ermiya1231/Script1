-- ESP
--------------------------------------------------------------------
local function espRefresh()
    local cam = camera()
    if not cam then return end
    local camPos = cam.CFrame.Position
    local clock = os.clock()
    local pulse = 0.52 + math.sin(clock * 3) * 0.12

    local list = {}
    for part in pairs(Registry) do
        -- ✅ FIX v2.5: belt-and-suspenders — never draw inventory parts
        -- (prune loop removes them within 1s; this hides them instantly)
        if part.Parent
        and not (CFG.IGNORE_PLAYER_TOOLS and isInPlayerInventory(part)) then
            local ok, pos = pcall(function() return part.Position end)
            if ok then
                local d = (pos - camPos).Magnitude
                if d <= CFG.MAX_DIST then
                    list[#list + 1] = { part = part, d = d }
                end
            end
        end
    end
    table.sort(list, function(a, b) return a.d < b.d end)

    SortedTargets = {}
    local keep = {}
    for i = 1, math.min(#list, CFG.ESP_BUDGET) do
        SortedTargets[#SortedTargets + 1] = list[i].part
        keep[list[i].part] = true
    end

    for part, hl in pairs(Highlights) do
        if not keep[part] or part.Parent == nil then
            hl:Destroy(); Highlights[part] = nil
        else
            hl.FillTransparency = pulse
        end
    end
    for _, part in ipairs(SortedTargets) do
        if not Highlights[part] and part.Parent then
            local hl = Instance.new("Highlight")
            hl.Name = "NT_ESP"
            hl.Adornee = part
            hl.FillColor = COL.cyan
            hl.OutlineColor = COL.magenta
            hl.FillTransparency = pulse
            hl.OutlineTransparency = 0.05
            hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            hl.Parent = part
            Highlights[part] = hl
        end
    end
    updateStats()
end

local function clearEsp()
    for part, hl in pairs(Highlights) do hl:Destroy() end
    Highlights = {}
end

--------------------------------------------------------------------
-- TRACERS  (Drawing library, with a 3D neon fallback)
--------------------------------------------------------------------
local DrawLib = nil
pcall(function() DrawLib = Drawing end)
local HasDrawing = (type(DrawLib) == "table" or type(DrawLib) == "userdata")
    and DrawLib.new ~= nil

local lines, texts = {}, {}
local function getLine(i)
    local l = lines[i]
    if not l then
        l = Drawing.new("Line")
        l.Thickness = 1.4
        l.Transparency = 1
        lines[i] = l
    end
    return l
end
local function getText(i)
    local t = texts[i]
    if not t then
        t = Drawing.new("Text")
        t.Size = 12
        t.Font = 2
        t.Outline = true
        t.Center = false
        texts[i] = t
    end
    return t
end

-- 3D fallback pool
local TracerFolder = nil
local beams = {}
local function getBeam(i)
    if not TracerFolder then
        TracerFolder = new("Folder", { Name = "NT_Tracers", Parent = WS })
    end
    local b = beams[i]
    if not b then
        b = Instance.new("Part")
        b.Name = "NT_Line"
        b.Anchored = true
        b.CanCollide = false
        b.CanTouch = false
        b.CanQuery = false
        b.Material = Enum.Material.Neon
        b.Transparency = 0.35
        b.Parent = TracerFolder
        beams[i] = b
    end
    return b
end

local function clearDrawings()
    for _, l in ipairs(lines) do l.Visible = false end
    for _, t in ipairs(texts) do t.Visible = false end
    for _, b in ipairs(beams) do b.Transparency = 1 end
end

local function drawTracers()
    local cam = camera()
    if not cam then return end

    if HasDrawing then
        local vp = cam.ViewportSize
        local from = Vector2.new(vp.X * 0.5, vp.Y)
        local camPos = cam.CFrame.Position
        local used, usedText = 0, 0

        for i = 1, #SortedTargets do
            if used >= CFG.TRACER_MAX then break end
            local part = SortedTargets[i]
            if part and part.Parent then
                local pos, onScreen = cam:WorldToViewportPoint(part.Position)
                if onScreen and pos.Z > 0 then
                    used += 1
                    local l = getLine(used)
                    local d = (part.Position - camPos).Magnitude
                    local t = math.clamp(1 - (d / CFG.MAX_DIST), 0.12, 1)
                    l.Visible = true
                    l.From = from
                    l.To = Vector2.new(pos.X, pos.Y)
                    l.Color = lerpColor(COL.magenta, COL.cyan, t)
                    l.Transparency = 0.3 + 0.6 * t
                    l.Thickness = 1 + t * 1.4

                    if CFG.TRACER_LABELS and usedText < 14 then
                        usedText += 1
                        local tx = getText(usedText)
                        local nm = part.Name
                        if #nm > 14 then nm = nm:sub(1, 14) end
                        tx.Visible = true
                        tx.Position = Vector2.new(pos.X + 7, pos.Y - 9)
                        tx.Text = string.format("%s  %dm", nm, math.floor(d))
                        tx.Color = lerpColor(COL.magenta, COL.cyan, t)
                        tx.Transparency = 0.85
                    end
                end
            end
        end
        for i = used + 1, #lines do lines[i].Visible = false end
        for i = usedText + 1, #texts do texts[i].Visible = false end
    else
        local camPos = cam.CFrame.Position
        local used = 0
        for i = 1, #SortedTargets do
            if used >= CFG.TRACER_MAX then break end
            local part = SortedTargets[i]
            if part and part.Parent then
                used += 1
                local b = getBeam(used)
                local target = part.Position
                local dir = target - camPos
                local mag = dir.Magnitude
                b.Size = Vector3.new(0.12, 0.12, mag)
                b.CFrame = CFrame.lookAt(camPos, target) * CFrame.new(0, 0, -mag / 2)
                b.Color = lerpColor(COL.magenta, COL.cyan, math.clamp(1 - mag / CFG.MAX_DIST, 0.1, 1))
                b.Transparency = 0.45
            end
        end
        for i = used + 1, #beams do beams[i].Transparency = 1 end
    end
end

