--------------------------------------------------------------------
-- FLIP / WATCH
--------------------------------------------------------------------
local function watchPart(part)
    if Watch[part] then return end
    local conn
    conn = part:GetPropertyChangedSignal("CanTouch"):Connect(function()
        if not Registry[part] then
            conn:Disconnect(); Watch[part] = nil; return
        end
        if part.CanTouch == false then
            Stats.reflips += 1
            pcall(function() part.CanTouch = true end)   -- re-flip instantly
        end
    end)
    Watch[part] = conn
end

local function flip(part, tool)
    local ok = pcall(function() part.CanTouch = true end)
    if not ok then Ignored[part] = os.clock(); return end
    Registry[part] = { original = false, tool = tool, t = os.clock() }
    Stats.flips += 1
    if tool and not ToolCache[tool] then
        ToolCache[tool] = true
        Stats.tools += 1
    end
    watchPart(part)
end

local function processObject(obj)
    if obj == nil or obj.Parent == nil then return end
    if not obj:IsA("BasePart") then return end
    if Registry[obj] then return end
    local cached = Ignored[obj]
    local recheck = false
    if cached then
        if (os.clock() - cached) < CFG.IGNORE_RECHECK then return end
        Ignored[obj] = nil
        recheck = true            -- already counted once, don't inflate the stat
    end
    -- ✅ FIX v2.5: skip ANY player inventory (hand + backpack, you + others)
    -- Silently ignored: doesn't pollute scanned/ignored stats.
    if CFG.IGNORE_PLAYER_TOOLS and isInPlayerInventory(obj) then return end
    if CFG.SKIP_LOCAL_CHAR and LP.Character and obj:IsDescendantOf(LP.Character) then return end

    Stats.scanned += 1
    local valid, tool = evaluate(obj)
    if not valid then
        if obj.CanTouch == false then
            Ignored[obj] = os.clock()
            if not recheck then Stats.ignored += 1 end
        end
        return
    end
    flip(obj, tool)
end

--------------------------------------------------------------------
-- SCANNER LOOP  (0.1s tick + time budget)
--------------------------------------------------------------------
local function queue(obj)
    if PendingSet[obj] then return end
    PendingSet[obj] = true
    Pending[#Pending + 1] = obj
end

local function scanTick()
    local deadline = os.clock() + (CFG.SCAN_BUDGET_MS / 1000)

    while #Pending > 0 do                      -- new instances first
        local obj = table.remove(Pending)
        PendingSet[obj] = nil
        processObject(obj)
        if os.clock() > deadline then return end
    end

    local guard = 0
    while os.clock() < deadline and guard < 40000 do
        guard += 1
        if Sweep.cursor > #Sweep.list then
            Sweep.list = WS:GetDescendants()
            Sweep.cursor = 1
            Stats.cycles += 1
            if #Sweep.list == 0 then break end
        end
        local obj = Sweep.list[Sweep.cursor]
        Sweep.cursor += 1
        if obj then processObject(obj) end
    end
end

local scanAcc = 0
RunService.Heartbeat:Connect(function(dt)
    if not State.scanner then return end
    scanAcc += dt
    if scanAcc >= CFG.SCAN_INTERVAL then
        scanAcc = 0
        local ok, err = pcall(scanTick)
        if not ok then warn("[NEON://TOUCH] sweep error: " .. tostring(err)) end
    end
end)

WS.DescendantAdded:Connect(function(obj)
    if State.scanner then queue(obj) end
end)

-- prune dead entries (cheap, 1Hz)
task.spawn(function()
    while true do
        task.wait(1)
        for part, rec in pairs(Registry) do
            if part.Parent == nil then
                Registry[part] = nil
                local conn = Watch[part]
                if conn then conn:Disconnect(); Watch[part] = nil end
                local hl = Highlights[part]
                if hl then hl:Destroy(); Highlights[part] = nil end
            -- ✅ FIX v2.5: part entered someone's hand/backpack after
            -- being registered (e.g. you picked it up) -> restore + drop
            elseif CFG.PRUNE_EQUIPPED and isInPlayerInventory(part) then
                pcall(function() part.CanTouch = rec.original end)
                Registry[part] = nil
                local conn2 = Watch[part]
                if conn2 then conn2:Disconnect(); Watch[part] = nil end
                local hl2 = Highlights[part]
                if hl2 then hl2:Destroy(); Highlights[part] = nil end
            elseif rec.tool and rec.tool.Parent == nil then
                rec.tool = nil
            end
        end
        for tool in pairs(ToolCache) do
            if tool.Parent == nil then ToolCache[tool] = nil end
        end
    end
end)

