local setScanner, setEsp, setTracers, resetAll, equipNoTouchTools

setScanner = function(on)
    State.scanner = on
    Rows.scanner.set(on)
    if on then
        scanAcc = CFG.SCAN_INTERVAL          -- fire a tick immediately
        Sweep.list = {}
        Sweep.cursor = 1
        toast("SCANNER ONLINE · SWEEPING EVERY 0.1s", COL.cyan)
    else
        toast("SCANNER OFFLINE", COL.dim)
    end
end

setEsp = function(on)
    State.esp = on
    Rows.esp.set(on)
    if on then
        espRefresh()
        toast("ESP ONLINE · HIGHLIGHT BUDGET " .. CFG.ESP_BUDGET, COL.magenta)
    else
        clearEsp()
        SortedTargets = {}
        clearDrawings()
        if State.tracers then setTracers(false) end
        toast("ESP OFFLINE", COL.dim)
    end
end

setTracers = function(on)
    if on and not State.esp then
        setEsp(true)
        toast("TRACERS ONLINE · AUTO-ENABLED ESP", COL.amber)
    else
        toast(on and "TRACERS ONLINE" or "TRACERS OFFLINE", on and COL.amber or COL.dim)
    end
    State.tracers = on
    Rows.tracers.set(on)
    if not on then clearDrawings() end
end

equipNoTouchTools = function()
    local char = LP.Character
    local hum  = char and char:FindFirstChildOfClass("Humanoid")
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not hum or not root then
        toast("NO CHARACTER / HUMANOID", COL.danger)
        return
    end

    local function toolWasNoTouch(tool)
        if ToolCache[tool] then return true end
        for _, d in ipairs(tool:GetDescendants()) do
            if d:IsA("BasePart") then
                local rec = Registry[d]
                if rec and rec.original == false then return true end
                if d.CanTouch == false then return true end
            end
        end
        return false
    end

    local candidates, seen = {}, {}
    for tool in pairs(ToolCache) do
        -- ✅ FIX v2.5: never re-equip tools already in someone's inventory
        if tool.Parent and not seen[tool]
        and not (CFG.IGNORE_PLAYER_TOOLS and isInPlayerInventory(tool)) then
            seen[tool] = true
            candidates[#candidates + 1] = tool
        end
    end
    for _, d in ipairs(WS:GetDescendants()) do          -- catch un-scanned tools
        -- ✅ FIX v2.5: skip character-held tools (they live in Workspace!)
        if d:IsA("BackpackItem") and d.Parent and d.Parent ~= char and not seen[d] then
            if not (CFG.IGNORE_PLAYER_TOOLS and isInPlayerInventory(d)) then
                seen[d] = true
                if toolWasNoTouch(d) then candidates[#candidates + 1] = d end
            end
        end
    end

    if #candidates == 0 then
        toast("NO NO-TOUCH TOOLS FOUND", COL.dim)
        return
    end

    task.spawn(function()
        toast("EQUIPPING " .. #candidates .. " TOOL(S)...", COL.lime)
        local done = 0
        for _, tool in ipairs(candidates) do
            if tool:IsA("BackpackItem") and tool.Parent then
                local handle = tool:FindFirstChild("Handle")
                if not handle then handle = tool:FindFirstChildWhichIsA("BasePart") end
                if handle and handle:IsA("BasePart") then
                    pcall(function()
                        handle.CanCollide = false
                        handle.CFrame = root.CFrame * CFrame.new(0, 0, -2.2)
                    end)
                end
                local ok = pcall(function() hum:EquipTool(tool) end)
                if ok then done += 1 end
                task.wait(CFG.EQUIP_DELAY)
            end
        end
        toast("EQUIPPED " .. done .. " / " .. #candidates .. " TOOLS", COL.lime)
    end)
end

resetAll = function()
    -- 1) modules off first so nothing re-flips while we restore
    if State.tracers then setTracers(false) end
    if State.esp then setEsp(false) end
    if State.scanner then setScanner(false) end

    -- 2) kill watchers BEFORE restoring values
    for part, conn in pairs(Watch) do conn:Disconnect() end
    Watch = {}

    -- 3) destroy highlights / lines
    clearEsp()
    clearDrawings()
    SortedTargets = {}

    -- 4) restore original CanTouch values
    local restored = 0
    for part, rec in pairs(Registry) do
        if part.Parent then
            local ok = pcall(function() part.CanTouch = rec.original end)
            if ok then restored += 1 end
        end
    end

    -- 5) wipe memory + stats
    Registry, ToolCache, Ignored = {}, {}, setmetatable({}, { __mode = "k" })
    Sweep.list, Sweep.cursor = {}, 1
    Pending, PendingSet = {}, {}
    Stats.scanned, Stats.flips, Stats.reflips, Stats.tools, Stats.ignored, Stats.cycles = 0, 0, 0, 0, 0, 0
    StatLabels.fps.Text = "0"
    updateStats()
    toast("RESET COMPLETE · " .. restored .. " PART(S) RESTORED", COL.lime)
end

