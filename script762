local function new(class, props, children)
    local o = Instance.new(class)
    if props then for k, v in pairs(props) do o[k] = v end end
    if children then for _, c in ipairs(children) do c.Parent = o end end
    return o
end

local function guiParent()
    local ok, res = pcall(function() return gethui() end)
    if ok and res then return res end
    ok, res = pcall(function() return game:GetService("CoreGui") end)
    if ok and res then return res end
    return LP:WaitForChild("PlayerGui")
end

local function camera()
    return WS.CurrentCamera
end

local function lerpColor(a, b, t)
    return Color3.new(a.R + (b.R - a.R) * t, a.G + (b.G - a.G) * t, a.B + (b.B - a.B) * t)
end

--------------------------------------------------------------------
-- FILTER LOGIC  (the heart of the scanner)
--------------------------------------------------------------------
local function findToolAncestor(obj)
    local anc = obj.Parent
    while anc do
        if anc:IsA("BackpackItem") then return anc end
        anc = anc.Parent
    end
    return nil
end

-- ✅ FIX v2.5: true if part lives in ANY player's Character or Backpack
-- Covers: your hand, your backpack, enemies' hands, enemies' backpacks.
local function isInPlayerInventory(obj)
    if not obj or not obj.Parent then return false end

    -- 0) Fast path: YOUR character + YOUR backpack
    if LP.Character then
        local ok, res = pcall(function()
            return obj:IsDescendantOf(LP.Character)
        end)
        if ok and res then return true end
    end
    local myBackpack = LP:FindFirstChildOfClass("Backpack")
    if myBackpack then
        local ok, res = pcall(function()
            return obj:IsDescendantOf(myBackpack)
        end)
        if ok and res then return true end
    end

    -- 1) Walk ancestors: ANY Backpack / Player / Character-Model
    local cur = obj.Parent
    while cur and cur ~= game do
        local okC, cls = pcall(function() return cur.ClassName end)
        if okC and (cls == "Backpack" or cls == "Player") then
            return true
        end
        if cur:IsA("Model") then
            if cur:FindFirstChildOfClass("Humanoid") then
                return true
            end
            local ok, plr = pcall(function()
                return Players:GetPlayerFromCharacter(cur)
            end)
            if ok and plr then return true end
        end
        cur = cur.Parent
    end
    return false
end

local function hasTouchInterest(part)
    local ok, child = pcall(function() return part:FindFirstChildOfClass("TouchInterest") end)
    if ok and child then return true end
    ok, child = pcall(function() return part:FindFirstChild("TouchInterest") end)
    if ok and child then return true end
    for _, c in ipairs(part:GetChildren()) do
        if c.ClassName == "TouchInterest" then return true end
    end
    return false
end

-- returns: valid(bool), tool(Tool?)
local function evaluate(part)
    if part.CanTouch == true then return false, nil end
    -- ✅ FIX: Tools in ANY character/backpack (even yours) are NOT targets
    if CFG.IGNORE_PLAYER_TOOLS and isInPlayerInventory(part) then
        return false, nil
    end
    local tool = findToolAncestor(part)
    if tool then return true, tool end                 -- Tool exception
    if hasTouchInterest(part) then return true, nil end -- needs TouchInterest
    return false, nil                                   -- ignored
end

