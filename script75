	ScreenGui:Destroy()
end)

------------------------------------------------------------------
-- Live refresh of weapon list
------------------------------------------------------------------
local refreshToken = 0
local function liveRefresh(child)
	if child:IsA("Tool") and state.view == "tools" then
		refreshToken += 1
		local my = refreshToken
		task.delay(0.15, function()
			if my == refreshToken and state.view == "tools" then loadTools() end
		end)
	end
end

local function hookBackpack()
	local bp = LocalPlayer:WaitForChild("Backpack")
	bp.ChildAdded:Connect(liveRefresh)
	bp.ChildRemoved:Connect(liveRefresh)
end
local function hookCharacter(char)
	char.ChildAdded:Connect(liveRefresh)
	char.ChildRemoved:Connect(liveRefresh)
end

task.spawn(hookBackpack)
if LocalPlayer.Character then hookCharacter(LocalPlayer.Character) end

------------------------------------------------------------------
-- Respawn: restore saved values
------------------------------------------------------------------
LocalPlayer.CharacterAdded:Connect(function(character)
	Overlay.Visible = true
	LoadingText.Text = "Loading Backup Values..."
	LoadingText.TextColor3 = Color3.fromRGB(255, 200, 50)

	stopAllSpam()
	table.clear(spamText)
	hookCharacter(character)

	pcall(function()
		LocalPlayer:WaitForChild("Backpack")
		hookBackpack()
		task.wait(1.8)

		for key, pathsTable in pairs(savedValues) do
			local freshRoot = resolveRoot(key)
			if freshRoot then
				for relPath, textVal in pairs(pathsTable) do
					local obj = findObjByPath(freshRoot, relPath)
					if obj and obj:IsA("ValueBase") then applyValue(obj, textVal) end
				end
				local spamPaths = savedSpam[key]
				if spamPaths then
					for relPath, textVal in pairs(spamPaths) do
						local obj = findObjByPath(freshRoot, relPath)
						if obj and obj:IsA("ValueBase") then startSpam(obj, textVal) end
					end
				end
			end
		end
	end)

	LoadingText.Text = "Successfully Loaded ✔"
	LoadingText.TextColor3 = Color3.fromRGB(100, 255, 100)
	task.wait(0.8)
	Overlay.Visible = false

	-- برگشت به همان جایی که بودی
	if currentRootKey then
		local newRoot = resolveRoot(currentRootKey)
		if newRoot then
			enterRoot(newRoot)
			return
		end
	end
	showMode(state.mode)
end)

showMode("Backpack")
