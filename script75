------------------------------------------------------------------
-- Spam
------------------------------------------------------------------
local function stopSpam(obj)
	if spamThreads[obj] then
		pcall(task.cancel, spamThreads[obj])
		spamThreads[obj] = nil
	end
end

local function startSpam(obj, text)
	stopSpam(obj)
	spamText[obj] = text
	spamThreads[obj] = task.spawn(function()
		while obj.Parent do
			local inp = valueInputs[obj]
			local txt = (inp and inp.Parent) and inp.Text or spamText[obj]
			spamText[obj] = txt
			applyValue(obj, txt)
			task.wait(0.01)
		end
		spamThreads[obj] = nil
	end)
end

local function stopAllSpam()
	for obj in pairs(spamThreads) do stopSpam(obj) end
end

local function setSpamVisual(b, on)
	b.Text = on and "RUNNING" or "SPAM"
	b.BackgroundColor3 = on and Color3.fromRGB(20, 80, 20) or Color3.fromRGB(55, 55, 30)
	b.TextColor3 = on and Color3.fromRGB(150, 255, 150) or Color3.fromRGB(210, 210, 150)
end

local function selectObj(obj)
	if selectedObj and rowOf[selectedObj] then rowOf[selectedObj].BackgroundColor3 = T.row end
	selectedObj = obj
	if obj and rowOf[obj] then rowOf[obj].BackgroundColor3 = T.rowSel end
end

------------------------------------------------------------------
-- Script viewer
------------------------------------------------------------------
local currentSource = ""

local function getSource(obj)
	local lastErr
	local attempts = {
		function() return decompile(obj) end,
		function() return obj.Source end,
	}
	for _, f in ipairs(attempts) do
		local ok, res = pcall(f)
		if ok and type(res) == "string" and #res > 0 then return res end
		if not ok then lastErr = tostring(res) end
	end
	return nil, lastErr or "empty result"
end

local function openViewer(obj)
	Viewer.Visible = true
	ViewerTitle.Text = "📄 " .. obj:GetFullName()
	for _, c in ipairs(ViewerHolder:GetChildren()) do
		if c:IsA("GuiObject") then c:Destroy() end
	end
	currentSource = ""
	ViewerInfo.Text = "Decompiling..."
	ViewerInfo.TextColor3 = T.gold

	task.spawn(function()
		local src, err = getSource(obj)
		if not src then
			make("TextLabel", {Size = UDim2.new(0, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.XY, BackgroundTransparency = 1, Text = "-- Could not read this script.\n-- Reason: " .. tostring(err) .. "\n-- Your executor may not support decompile(), or this is a server Script\n-- (server scripts are never sent to the client).", TextColor3 = T.red, Font = Enum.Font.Code, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, ZIndex = 52}, ViewerHolder)
			ViewerInfo.Text = "Failed"
			ViewerInfo.TextColor3 = T.red
			return
		end
		currentSource = src
		local lines = string.split(src, "\n")
		local total = #lines
		local cap = math.min(total, 6000)
		local idx, order = 1, 1
		while idx <= cap do
			local buf = {}
			for i = idx, math.min(idx + 79, cap) do
				buf[#buf + 1] = string.format("%4d │ %s", i, (lines[i]:gsub("\t", "    "):gsub("\r", "")))
			end
			make("TextLabel", {Size = UDim2.new(0, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.XY, BackgroundTransparency = 1, Text = table.concat(buf, "\n"), TextColor3 = Color3.fromRGB(215, 225, 235), Font = Enum.Font.Code, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, RichText = false, LayoutOrder = order, ZIndex = 52}, ViewerHolder)
			idx += 80
			order += 1
			if order % 10 == 0 then task.wait() end
		end
		ViewerInfo.Text = string.format("%d lines  ·  %d chars", total, #src)
		ViewerInfo.TextColor3 = T.green
	end)
end

ViewerClose.MouseButton1Click:Connect(function() Viewer.Visible = false end)
ViewerCopy.MouseButton1Click:Connect(function()
	if currentSource == "" then return end
	local fn = setclipboard or toclipboard
	if fn and pcall(fn, currentSource) then
		ViewerInfo.Text = "✔ Copied to clipboard"
		ViewerInfo.TextColor3 = T.green
	else
		print(currentSource)
		ViewerInfo.Text = "Clipboard not supported – printed to console"
		ViewerInfo.TextColor3 = T.gold
	end
end)

