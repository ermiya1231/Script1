ExpandBtn.MouseButton1Click:Connect(function()
	if not state.root then return end
	local n = 0
	for _, d in ipairs(state.root:GetDescendants()) do
		if #d:GetChildren() > 0 and n < 600 then expanded[d] = true n += 1 end
	end
	render()
end)
CollapseBtn.MouseButton1Click:Connect(function()
	table.clear(expanded)
	if state.root then render() end
end)

SaveBtn.MouseButton1Click:Connect(function()
	local root = state.root
	if not root then return setStatus("Open a weapon first.", T.red) end
	local key = rootKey(root)
	savedValues[key] = savedValues[key] or {}
	savedSpam[key] = {}
	local n = 0
	for _, obj in ipairs(root:GetDescendants()) do
		if obj:IsA("ValueBase") and not obj:IsA("ObjectValue") then
			local isSpam = spamThreads[obj] ~= nil
			if edited[obj] or isSpam then
				local path = getRelativePath(obj, root)
				local inp = valueInputs[obj]
				local txt = (inp and inp.Parent) and inp.Text or (spamText[obj] or valueToText(obj))
				savedValues[key][path] = txt
				if isSpam then savedSpam[key][path] = txt end
				n += 1
			end
		end
	end
	SaveBtn.Text = "✔ SAVED (" .. n .. ")"
	SaveBtn.BackgroundColor3 = Color3.fromRGB(20, 150, 20)
	setStatus("Saved " .. n .. " value(s)", T.green)
	task.wait(1)
	SaveBtn.Text = "💾 SAVE VALUES"
	SaveBtn.BackgroundColor3 = Color3.fromRGB(0, 100, 60)
end)

CloseBtn.MouseButton1Click:Connect(function()
