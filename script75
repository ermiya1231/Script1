			end)
		else
			make("TextLabel", {Size = UDim2.new(0.5, -8, 1, 0), Position = UDim2.new(0.46, 0, 0, 0), BackgroundTransparency = 1, Text = obj.ClassName, TextColor3 = T.sub, Font = Enum.Font.Gotham, TextSize = 10, TextXAlignment = Enum.TextXAlignment.Left}, Row)
		end
	end

	local function walk(p, depth)
		for _, child in ipairs(p:GetChildren()) do
			if count >= MAX_ROWS then return end
			addRow(child, depth)
			if expanded[child] then walk(child, depth + 1) end
		end
	end

	if searchText ~= "" then
		local q = searchText:lower()
		for _, d in ipairs(root:GetDescendants()) do
			if count >= MAX_ROWS then break end
			if d.Name:lower():find(q, 1, true) or d.ClassName:lower():find(q, 1, true) then
				addRow(d, 0)
			end
		end
	else
		walk(root, 0)
	end
	List.CanvasPosition = savedPos
end

function loadTools()
	clearList()
	local bp = LocalPlayer:FindFirstChild("Backpack")
	local found = 0
	if bp then
		for _, tool in ipairs(bp:GetChildren()) do
			if tool:IsA("Tool") then
				found += 1
				local b = make("TextButton", {Size = UDim2.new(1, -6, 0, 40), BackgroundColor3 = Color3.fromRGB(35, 35, 40), Text = "   🔫   " .. tool.Name, TextColor3 = T.text, Font = Enum.Font.GothamBold, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left, BorderSizePixel = 0, LayoutOrder = found}, List)
				round(b, 8)
				b.MouseButton1Click:Connect(function() enterRoot(tool) end)
			end
		end
	end
	if found == 0 then
		make("TextLabel", {Size = UDim2.new(1, -6, 0, 50), BackgroundTransparency = 1, Text = "No weapons in backpack.", TextColor3 = T.sub, Font = Enum.Font.Gotham, TextSize = 13}, List)
	end
	setStatus("Pick a weapon (" .. found .. ")", T.sub)
end

function enterRoot(root)
	state.root = root
	state.view = "tree"
	currentRootKey = rootKey(root)
	selectedObj = nil
	searchText = ""
	SearchBox.Text = ""
	render()
	setStatus("Exploring: " .. root.Name, T.gold)
end

function showMode(mode)
	state.mode = mode
	selectedObj = nil
	BackpackTab.BackgroundColor3 = (mode == "Backpack") and Color3.fromRGB(45, 65, 90) or T.btn
	PlayerTab.BackgroundColor3 = (mode == "Player") and Color3.fromRGB(70, 50, 95) or T.btn
	if mode == "Backpack" then
		state.root, currentRootKey = nil, nil
		state.view = "tools"
		loadTools()
	else
		enterRoot(LocalPlayer)
	end
end

BackpackTab.MouseButton1Click:Connect(function() showMode("Backpack") end)
PlayerTab.MouseButton1Click:Connect(function() showMode("Player") end)

