local function iconFor(obj)
	if ICONS[obj.ClassName] then return ICONS[obj.ClassName] end
	if obj:IsA("ValueBase") then return "🔢" end
	if obj:IsA("BasePart") then return "🧱" end
	if obj:IsA("GuiObject") then return "▭" end
	return "🔹"
end

local function isScript(o)
	return o:IsA("LocalScript") or o:IsA("ModuleScript") or o:IsA("Script")
end

local function parseNums(t)
	local n = {}
	for s in string.gmatch(t, "[%-%d%.]+") do
		local v = tonumber(s)
		if v then table.insert(n, v) end
	end
	return n
end

local function valueToText(obj)
	local v = obj.Value
	if obj:IsA("Color3Value") then
		return string.format("%d, %d, %d", math.floor(v.R * 255 + 0.5), math.floor(v.G * 255 + 0.5), math.floor(v.B * 255 + 0.5))
	elseif obj:IsA("Vector3Value") then
		return string.format("%g, %g, %g", v.X, v.Y, v.Z)
	elseif obj:IsA("ObjectValue") then
		return v and v:GetFullName() or "nil"
	end
	return tostring(v)
end

local function applyValue(obj, text)
	pcall(function()
		if obj:IsA("BoolValue") then
			obj.Value = (text:lower() == "true" or text == "1")
		elseif obj:IsA("StringValue") then
			obj.Value = text
		elseif obj:IsA("IntValue") or obj:IsA("NumberValue") then
			local n = tonumber(text)
			if n then obj.Value = n end
		elseif obj:IsA("Color3Value") then
			local n = parseNums(text)
			if #n >= 3 then obj.Value = Color3.fromRGB(n[1], n[2], n[3]) end
		elseif obj:IsA("Vector3Value") then
			local n = parseNums(text)
			if #n >= 3 then obj.Value = Vector3.new(n[1], n[2], n[3]) end
		elseif obj:IsA("ObjectValue") or obj:IsA("CFrameValue") then
			-- فقط خواندنی
		else
			if tonumber(text) then obj.Value = tonumber(text) else obj.Value = text end
		end
	end)
end

local function getRelativePath(obj, root)
	local path = {}
	local cur = obj
	while cur and cur ~= root do
		table.insert(path, 1, cur.Name)
		cur = cur.Parent
	end
	return table.concat(path, "/")
end

local function findObjByPath(root, pathStr)
	local cur = root
	for _, part in ipairs(string.split(pathStr, "/")) do
		if not cur then return nil end
		cur = cur:FindFirstChild(part)
	end
	return cur
end

local function rootKey(root)
	if root:IsA("Tool") then return "T:" .. root.Name end
	return "P:" -- LocalPlayer
end

local function resolveRoot(key)
	if key == "P:" then return LocalPlayer end
	local name = key:sub(3)
	local bp = LocalPlayer:FindFirstChild("Backpack")
	return (bp and bp:WaitForChild(name, 4)) or (LocalPlayer.Character and LocalPlayer.Character:FindFirstChild(name))
end

