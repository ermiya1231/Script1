-- =========================================================
-- [ توابع کمکی Mesh ] --
-- =========================================================
local function cleanId(s)
    if not s or s == "" then return nil end
    return s:match("%d+") or s
end

local function fmtVec(v)
    return string.format("%.3f, %.3f, %.3f", v.X, v.Y, v.Z)
end

-- رنگ دقیق به صورت 0 تا 1 با ۵ رقم اعشار (برای ثبت دقیق رنگ افکت‌ها)
local function fmtColor(c)
    return string.format("%.5f, %.5f, %.5f", c.R, c.G, c.B)
end

local function fmtBool(b)
    return b and "True" or "False"
end

-- هر نوع Mesh (SpecialMesh / BlockMesh / CylinderMesh / FileMesh) را به خطوط متنی تبدیل می‌کند
local function exportDataModelMesh(mesh, partData)
    local meshType = "FileMesh"

    if mesh:IsA("SpecialMesh") then
        meshType = mesh.MeshType.Name          -- Head, Torso, Wedge, Sphere, Cylinder, Brick, FileMesh, Prism, Pyramid, ParallelRamp, RightAngleRamp, CornerWedge
    elseif mesh:IsA("BlockMesh") then
        meshType = "Brick"
    elseif mesh:IsA("CylinderMesh") then
        meshType = "Cylinder"
    else
        meshType = "FileMesh"                  -- FileMesh ساده
    end

    table.insert(partData, "MeshType: " .. meshType)

    -- MeshId / TextureId فقط اگر وجود داشته باشند (برای FileMesh ها و هر نوع دیگری که Texture دارد)
    local okId, meshIdVal = pcall(function() return mesh.MeshId end)
    if okId then
        local id = cleanId(meshIdVal)
        if id then table.insert(partData, "MeshId: " .. id) end
    end

    local okTex, texVal = pcall(function() return mesh.TextureId end)
    if okTex then
        local tid = cleanId(texVal)
        if tid then table.insert(partData, "MeshTextureId: " .. tid) end
    end

    table.insert(partData, "MeshScale: " .. fmtVec(mesh.Scale))
    table.insert(partData, "MeshOffset: " .. fmtVec(mesh.Offset))
end

-- =========================================================
-- [ توابع ثبت دقیق PointLight / Fire / Sparkles / Smoke ] --
-- فرمت خطوط قدیمی (Light: True / LightRange / LightBrightness / Fire: True / ...) حفظ شده
-- و خطوط جدید برای مشخصات کامل اضافه شده‌اند.
-- =========================================================
local function exportPointLight(light, partData)
    table.insert(partData, "Light: True")
    table.insert(partData, string.format("LightRange: %.3f", light.Range))
    table.insert(partData, string.format("LightBrightness: %.4f", light.Brightness))
    table.insert(partData, "LightColor: " .. fmtColor(light.Color))
    table.insert(partData, "LightShadows: " .. fmtBool(light.Shadows))
    table.insert(partData, "LightEnabled: " .. fmtBool(light.Enabled))
end

local function exportFire(fire, partData)
    table.insert(partData, "Fire: True")
    table.insert(partData, "FireColor: " .. fmtColor(fire.Color))
    table.insert(partData, "FireSecondaryColor: " .. fmtColor(fire.SecondaryColor))
    table.insert(partData, string.format("FireHeat: %.3f", fire.Heat))
    table.insert(partData, string.format("FireSize: %.3f", fire.Size))
    table.insert(partData, "FireEnabled: " .. fmtBool(fire.Enabled))
end

local function exportSparkles(sparkles, partData)
    table.insert(partData, "Sparkles: True")
    table.insert(partData, "SparklesColor: " .. fmtColor(sparkles.SparkleColor))
    table.insert(partData, "SparklesEnabled: " .. fmtBool(sparkles.Enabled))
end

local function exportSmoke(smoke, partData)
    table.insert(partData, "Smoke: True")
    table.insert(partData, "SmokeColor: " .. fmtColor(smoke.Color))
    table.insert(partData, string.format("SmokeSize: %.3f", smoke.Size))
    table.insert(partData, string.format("SmokeOpacity: %.3f", smoke.Opacity))
    table.insert(partData, string.format("SmokeRiseVelocity: %.3f", smoke.RiseVelocity))
    table.insert(partData, "SmokeEnabled: " .. fmtBool(smoke.Enabled))
end

-- [ کدهای اصلی استخراج مپ ] --
local function runExport()
    exportBtn.Text = "Exporting... Please Wait!"
    exportBtn.BackgroundColor3 = Color3.fromRGB(200, 150, 40)
    task.wait(0.1)

    exportedPages = {}
    currentPage = 1

    local currentBuffer = {}
    local partIndex = 1
    local partsInCurrentPage = 0
    local faces = {"Top", "Bottom", "Left", "Right", "Front", "Back"}

    local ignoredModels = {}
    for _, player in ipairs(Players:GetPlayers()) do
        if player.Character then ignoredModels[player.Character] = true end
    end

    local function shouldIgnore(instance)
        local current = instance
        while current and current ~= workspace do
            if ignoredModels[current] then
                return true
            end
            current = current.Parent
        end
        return false
    end

    local descendants = workspace:GetDescendants()
    safeNotify("Export Started...", "Processing Map...")

    for i, v in ipairs(descendants) do
        if i % 100 == 0 then task.wait() end

        if (v:IsA("BasePart") or v:IsA("UnionOperation")) and v.Name ~= "Terrain" then
            if not shouldIgnore(v) then

                local success, partInfo = pcall(function()
                    local partData = {}
                    table.insert(partData, string.format("Part %d:", partIndex))

                    local pos = v.Position
                    table.insert(partData, string.format("Position: (%.3f, %.3f, %.3f)", pos.X, pos.Y, pos.Z))

                    local orient = v.Orientation
                    table.insert(partData, string.format("Rotation: (%.3f, %.3f, %.3f)", orient.X, orient.Y, orient.Z))

                    local size = v.Size
                    table.insert(partData, string.format("Size: (%.3f, %.3f, %.3f)", size.X, size.Y, size.Z))

                    local shapeName = "Normal"
                    if v:IsA("WedgePart") then shapeName = "Wedge"
                    elseif v:IsA("CornerWedgePart") then shapeName = "Corner"
                    elseif v:IsA("TrussPart") then shapeName = "Truss"
                    elseif v:IsA("VehicleSeat") then shapeName = "VehicleSeat"
                    elseif v:IsA("Seat") then shapeName = "Seat"
                    elseif v:IsA("SpawnLocation") then shapeName = "Spawn"
                    elseif v:IsA("Part") then
                        if v.Shape == Enum.PartType.Ball then shapeName = "Ball"
                        elseif v.Shape == Enum.PartType.Cylinder then shapeName = "Cylinder"
                        end
                    end
                    table.insert(partData, string.format("Shape: %s", shapeName))

                    local exportClassName = v.ClassName
                    local isConvertedMesh = false

                    if v:IsA("MeshPart") or v:IsA("UnionOperation") then
                        exportClassName = "Part"
                        isConvertedMesh = true
                    end
                    table.insert(partData, string.format("ClassName: %s", exportClassName))

                    if v:IsA("SpawnLocation") then table.insert(partData, "SpawnPoint: True") end
                    if v:IsA("VehicleSeat") then table.insert(partData, "VehicleSeat: True")
                    elseif v:IsA("Seat") then table.insert(partData, "Seat: True") end

                    local col = v.Color
                    table.insert(partData, string.format("Color: %.3f, %.3f, %.3f", col.R, col.G, col.B))

                    local matName = tostring(v.Material):gsub("Enum.Material.", "")
                    table.insert(partData, string.format("Material: %s", matName))
                    table.insert(partData, string.format("Transparency: %.3f", v.Transparency))

                    -- === [ تشخیص NPC و وجود هر نوع Mesh ] ===
                    local isNPC = false
                    local checkParent = v.Parent
                    while checkParent and checkParent ~= workspace do
                        if checkParent:FindFirstChildOfClass("Humanoid") then
                            isNPC = true
                            break
                        end
                        checkParent = checkParent.Parent
                    end

                    -- هر DataModelMesh (SpecialMesh, BlockMesh, CylinderMesh, FileMesh)
                    local hasAnyMesh = false
                    for _, c in ipairs(v:GetChildren()) do
                        if c:IsA("DataModelMesh") then hasAnyMesh = true break end
                    end

                    if v:IsA("MeshPart") then
                        -- MeshPart تبدیل‌شده: بسته به چک‌باکس Collide MeshParts
                        if not collideMeshParts then table.insert(partData, "CanCollide: False") end
                    elseif isConvertedMesh or not v.CanCollide then
                        -- UnionOperation یا پارت‌هایی که اصلاً Collision نداشتند
                        table.insert(partData, "CanCollide: False")
                    end

                    if not v.Anchored and not v:IsA("Seat") and not isNPC and not hasAnyMesh then
                        table.insert(partData, "Unanchored: True")
                    end
                    -- ========================================

                    local meshExported = false

                    -- MeshPart
                    if v:IsA("MeshPart") then
                        table.insert(partData, "MeshType: FileMesh")
                        local mid = cleanId(v.MeshId)
                        if mid then table.insert(partData, "MeshId: " .. mid) end
                        local tid = cleanId(v.TextureID)
                        if tid then table.insert(partData, "MeshTextureId: " .. tid) end

                        local mSize = v.MeshSize
                        local sX = mSize.X > 0.001 and (v.Size.X / mSize.X) or 1
                        local sY = mSize.Y > 0.001 and (v.Size.Y / mSize.Y) or 1
                        local sZ = mSize.Z > 0.001 and (v.Size.Z / mSize.Z) or 1
                        table.insert(partData, string.format("MeshScale: %.3f, %.3f, %.3f", sX, sY, sZ))
                        meshExported = true
                    end

                    -- F3X از هر نوع افکت فقط یکی روی هر پارت می‌پذیرد، پس فقط اولین مورد ثبت می‌شود
                    local lightExported, fireExported, sparklesExported, smokeExported = false, false, false, false

                    local usedDecals, usedTextures = {}, {}
                    for _, child in ipairs(v:GetChildren()) do
                        if child:IsA("Decal") then
                            local faceStr = tostring(child.Face):gsub("Enum.NormalId.", "")

                            local idNum
                            if child.Texture == "rbxasset://textures/SpawnLocation.png" then
                                idNum = "6045248793"
                            else
                                if child.Texture and child.Texture ~= "" then
                                    idNum = child.Texture:match("%d+")
                                    if not idNum then idNum = child.Texture end
                                end
                            end

                            if idNum and not usedDecals[faceStr] then
                                table.insert(partData, string.format("Decal.%s = %s", faceStr, idNum))
                                usedDecals[faceStr] = true
                            end

                        elseif child:IsA("Texture") then
                            local faceStr = tostring(child.Face):gsub("Enum.NormalId.", "")
                            local idNum
                            if child.Texture and child.Texture ~= "" then
                                idNum = child.Texture:match("%d+")
                                if not idNum then idNum = child.Texture end
                            end
                            if idNum and not usedTextures[faceStr] then
                                table.insert(partData, string.format("Texture.%s = %s", faceStr, idNum))
                                usedTextures[faceStr] = true
                            end

                        elseif child:IsA("DataModelMesh") then
                            -- فقط اولین Mesh هر پارت ذخیره می‌شود (F3X فقط یک Mesh می‌پذیرد)
                            if not meshExported then
                                exportDataModelMesh(child, partData)
                                meshExported = true
                            end

                        elseif child:IsA("PointLight") then
                            if not lightExported then
                                exportPointLight(child, partData)
                                lightExported = true
                            end

                        elseif child:IsA("Fire") then
                            if not fireExported then
                                exportFire(child, partData)
                                fireExported = true
                            end

                        elseif child:IsA("Sparkles") then
                            if not sparklesExported then
                                exportSparkles(child, partData)
                                sparklesExported = true
                            end

                        elseif child:IsA("Smoke") then
                            if not smokeExported then
                                exportSmoke(child, partData)
                                smokeExported = true
                            end
                        end
                    end

                    if v:IsA("Part") or v:IsA("WedgePart") or v:IsA("CornerWedgePart") or v:IsA("SpawnLocation") then
                        for _, face in ipairs(faces) do
                            if v[face .. "Surface"] == Enum.SurfaceType.Studs then
                                table.insert(partData, string.format("Stud.%s: True", face))
                            end
                        end
                    end

                    return table.concat(partData, "\n") .. "\n"
                end)

                if success and partInfo then
                    table.insert(currentBuffer, partInfo)
                    partIndex = partIndex + 1
                    partsInCurrentPage = partsInCurrentPage + 1

                    if partsInCurrentPage >= PARTS_PER_PAGE then
                        table.insert(exportedPages, table.concat(currentBuffer, "\n"))
                        currentBuffer = {}
                        partsInCurrentPage = 0
                    end
                end
            end
        end
    end

    if #currentBuffer > 0 then
        table.insert(exportedPages, table.concat(currentBuffer, "\n"))
    end

    if #exportedPages > 0 then
        updatePageDisplay()
        exportBtn.Text = "Exported! ✅"
        exportBtn.BackgroundColor3 = Color3.fromRGB(40, 200, 80)
        safeNotify("Export Complete! ✅", "Map exported successfully.")
    else
        textBox.Text = "No parts found to export!"
        pageLabel.Text = "Page: 0 / 0"
        exportBtn.Text = "Export Map"
        exportBtn.BackgroundColor3 = Color3.fromRGB(40, 200, 80)
    end
end

exportBtn.MouseButton1Click:Connect(runExport)
