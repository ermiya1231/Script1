    Purple = Color3.fromRGB(150, 0, 255),
    Pink = Color3.fromRGB(255, 105, 180),
    Cyan = Color3.fromRGB(0, 255, 255),
}

local LIGHT_COLORS = {}
for name in string.gmatch(tostring(POINTLIGHT_ALL_MAP_COLOR), "[^_]+") do
    if COLOR_MAP[name] then table.insert(LIGHT_COLORS, COLOR_MAP[name]) end
end
if #LIGHT_COLORS == 0 then LIGHT_COLORS = {Color3.new(1, 1, 1)} end

local function SetFreeze(state)
    local char = Player.Character
    if char and char:FindFirstChild("HumanoidRootPart") then
        char.HumanoidRootPart.Anchored = state
    end
end

