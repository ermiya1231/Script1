UIListLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
    ScrollFrame.CanvasSize = UDim2.new(0, 0, 0, UIListLayout.AbsoluteContentSize.Y + 10)
end)

-- دکمه سبز حذف
local RemoveBtn = Instance.new("TextButton")
RemoveBtn.Size = UDim2.new(1, -20, 0, 42)
RemoveBtn.Position = UDim2.new(0, 10, 1, -52)
RemoveBtn.BackgroundColor3 = Color3.fromRGB(46, 204, 113)
RemoveBtn.Text = "Remove Selected"
RemoveBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
RemoveBtn.TextSize = 15
RemoveBtn.Font = Enum.Font.GothamBold
RemoveBtn.Parent = MainFrame

local BtnCorner = Instance.new("UICorner")
BtnCorner.CornerRadius = UDim.new(0, 8)
BtnCorner.Parent = RemoveBtn

-- ۲. منطق صحیح Collapse / Expand پنل
local isCollapsed = false
CollapseBtn.MouseButton1Click:Connect(function()
    isCollapsed = not isCollapsed
    CollapseBtn.Text = isCollapsed and "+" or "-"
    
    ScrollFrame.Visible = not isCollapsed
    RemoveBtn.Visible = not isCollapsed
    
    local targetHeight = isCollapsed and 45 or 420
    -- تغییر موقت حداقل سایز محدودکننده برای اجازه جمع شدن کامل پنل
    SizeConstraint.MinSize = Vector2.new(280, isCollapsed and 45 or 350)
    
    TweenService:Create(MainFrame, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        Size = UDim2.new(MainFrame.Size.X.Scale, MainFrame.Size.X.Offset, 0, targetHeight)
    }):Play()
end)

-- ۳. مدیریت وضعیت آیتم‌ها
local SelectedTools = {}

local function RefreshInventory()
    for _, child in ipairs(ScrollFrame:GetChildren()) do
        if child:IsA("TextButton") then
            child:Destroy()
        end
    end

    local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
    local char = LocalPlayer.Character
    local tools = {}

    if backpack then
        for _, tool in ipairs(backpack:GetChildren()) do
            if tool:IsA("Tool") then table.insert(tools, tool) end
        end
    end
    if char then
        for _, tool in ipairs(char:GetChildren()) do
            if tool:IsA("Tool") then table.insert(tools, tool) end
        end
    end

    for _, tool in ipairs(tools) do
        local ItemBtn = Instance.new("TextButton")
        ItemBtn.Size = UDim2.new(1, 0, 0, 40)
        ItemBtn.BackgroundColor3 = SelectedTools[tool] and Color3.fromRGB(40, 110, 65) or Color3.fromRGB(35, 35, 42)
        ItemBtn.Text = ""
        ItemBtn.Parent = ScrollFrame

        local ItemCorner = Instance.new("UICorner")
        ItemCorner.CornerRadius = UDim.new(0, 6)
        ItemCorner.Parent = ItemBtn

        -- آیکون آیتم
        local Icon = Instance.new("ImageLabel")
        Icon.Size = UDim2.new(0, 28, 0, 28)
        Icon.Position = UDim2.new(0, 6, 0.5, -14)
        Icon.BackgroundTransparency = 1
        Icon.Image = (tool.TextureId ~= "") and tool.TextureId or "rbxassetid://0"
        Icon.Parent = ItemBtn

        -- نام آیتم
        local NameLbl = Instance.new("TextLabel")
        NameLbl.Size = UDim2.new(1, -45, 1, 0)
        NameLbl.Position = UDim2.new(0, 42, 0, 0)
        NameLbl.BackgroundTransparency = 1
        NameLbl.Text = tool.Name
        NameLbl.TextColor3 = Color3.fromRGB(230, 230, 230)
        NameLbl.TextXAlignment = Enum.TextXAlignment.Left
        NameLbl.Font = Enum.Font.GothamMedium
        NameLbl.TextSize = 13
        NameLbl.Parent = ItemBtn

        ItemBtn.MouseButton1Click:Connect(function()
            if SelectedTools[tool] then
                SelectedTools[tool] = nil
                ItemBtn.BackgroundColor3 = Color3.fromRGB(35, 35, 42)
            else
                SelectedTools[tool] = true
                ItemBtn.BackgroundColor3 = Color3.fromRGB(40, 110, 65)
            end
        end)
    end
end

-- ۴. حذف تمیز و مستقیم ابزارها با متد Destroy
local function RemoveSelected()
    for tool, isSelected in pairs(SelectedTools) do
        if isSelected and tool and tool.Parent then
            tool:Destroy()
        end
    end

    SelectedTools = {}
    RefreshInventory()
end

RemoveBtn.MouseButton1Click:Connect(RemoveSelected)

-- اتصال هوشمند برای رصد دقیق تغییرات بعد از ریسپان (Respawn Handling)
local function SetupCharacter(char)
    char.ChildAdded:Connect(function(child)
        if child:IsA("Tool") then RefreshInventory() end
    end)
    char.ChildRemoved:Connect(function(child)
        if child:IsA("Tool") then RefreshInventory() end
    end)

    -- صبر برای ساخته شدن بک‌پک جدید بعد از ریسپان
    task.spawn(function()
        local backpack = LocalPlayer:WaitForChild("Backpack", 3)
        if backpack then
            backpack.ChildAdded:Connect(RefreshInventory)
            backpack.ChildRemoved:Connect(RefreshInventory)
        end
        RefreshInventory()
    end)
end

if LocalPlayer.Character then
    SetupCharacter(LocalPlayer.Character)
end
LocalPlayer.CharacterAdded:Connect(SetupCharacter)

RefreshInventory()
