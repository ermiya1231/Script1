local function updateCharacter(newChar)
    character = newChar
    if newChar then
        humanoid = newChar:WaitForChild("Humanoid", 5)
        root = newChar:WaitForChild("HumanoidRootPart", 5)
    end
end

if LocalPlayer.Character then updateCharacter(LocalPlayer.Character) end
