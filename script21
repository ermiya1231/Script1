local function makeToggle(label, onColor, init, cb)
    local b = new("TextButton", {Text = "", TextColor3 = C.text, Font = Enum.Font.GothamBold,
        TextSize = 12, BackgroundColor3 = C.off}, TogGrid)
    corner(b, 6)
    local state = init
    local function refresh()
        b.Text = label .. (state and ": ON" or ": OFF")
        b.BackgroundColor3 = state and onColor or C.off
    end
    b.Activated:Connect(function()
        state = not state
        refresh()
        cb(state)
    end)
    refresh()
    return {set = function(v) state = v; refresh() end}
end

