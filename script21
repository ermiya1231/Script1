---------------- Animations (R6 + R15) ----------------
local RigIDs = {
    R15 = {Idle = 507766388, Walk = 507777826, Run = 507767714, Jump = 507765000, Fall = 507767968, Climb = 507765644},
    R6  = {Idle = 180435571, Walk = 180426354, Run = 180426354, Jump = 125750702, Fall = 180436148, Climb = 180436334},
}

local function loadTracks(hum)
    Tracks, CurAnim = {}, nil
    local ids = RigIDs[hum.RigType == Enum.HumanoidRigType.R6 and "R6" or "R15"]
    local animator = hum:FindFirstChildOfClass("Animator") or Instance.new("Animator", hum)
    for name, id in pairs(ids) do
        local a = Instance.new("Animation")
        a.AnimationId = "rbxassetid://" .. id
        local ok, t = pcall(function() return animator:LoadAnimation(a) end)
        if ok and t then
            t.Priority = (name == "Idle") and Enum.AnimationPriority.Idle or Enum.AnimationPriority.Movement
            t.Looped = (name ~= "Jump")
            Tracks[name] = t
        end
    end
end

local function playAnim(name, speed)
    local t = Tracks[name]
    if not t then return end
    if CurAnim ~= name then
        local prev = CurAnim and Tracks[CurAnim]
        if prev then prev:Stop(0.15) end
        CurAnim = name
        t:Play(0.15)
    elseif not t.IsPlaying then
        t:Play(0.15)
    end
    if speed then t:AdjustSpeed(speed) end
end

---------------- Core ----------------
local function getMove()
    if Controls then
        local ok, v = pcall(function() return Controls:GetMoveVector() end)
        if ok and v then return v end
    end
    local v = Vector3.zero
    if not UIS:GetFocusedTextBox() then
        if UIS:IsKeyDown(Enum.KeyCode.W) then v += Vector3.new(0, 0, -1) end
        if UIS:IsKeyDown(Enum.KeyCode.S) then v += Vector3.new(0, 0, 1) end
        if UIS:IsKeyDown(Enum.KeyCode.A) then v += Vector3.new(-1, 0, 0) end
        if UIS:IsKeyDown(Enum.KeyCode.D) then v += Vector3.new(1, 0, 0) end
    end
    return v
end

local function flat(v)
    return Vector3.new(v.X, 0, v.Z)
end

local function disconnectRun()
    for _, c in ipairs(RunConns) do pcall(function() c:Disconnect() end) end
    RunConns = {}
end

local stopMode

local function step(dt)
    if not (S.on and FakeChar and FakeChar.Parent and fakeHum and fakeRoot) then return end
    if fakeHum.Health <= 0 then stopMode() return end

    local walk = math.clamp(tonumber(SpeedBox.Text) or 16, 0, 500)
    local flySpeed = math.clamp(tonumber(FlyBox.Text) or 50, 0, 1000)
    local jump = math.clamp(tonumber(JumpBox.Text) or 50, 0, 1000)
    local input = getMove()
    local cf = Camera.CFrame
    local camLook, camRight = flat(cf.LookVector), flat(cf.RightVector)
    if camLook.Magnitude > 0.01 then camLook = camLook.Unit end
    if camRight.Magnitude > 0.01 then camRight = camRight.Unit end
    local pos = fakeRoot.Position

    if S.fly then
        fakeHum.PlatformStand = true
        fakeHum.AutoRotate = false

        local bv = fakeRoot:FindFirstChild("FlyVelocity")
        if not bv then
            bv = new("BodyVelocity", {Name = "FlyVelocity", MaxForce = Vector3.new(1e5, 1e5, 1e5), Velocity = Vector3.zero}, fakeRoot)
        end
        local bg = fakeRoot:FindFirstChild("FlyGyro")
        if not bg then
            bg = new("BodyGyro", {Name = "FlyGyro", MaxTorque = Vector3.new(1e5, 1e5, 1e5), P = 20000, D = 500, CFrame = fakeRoot.CFrame}, fakeRoot)
        end

        -- جهت حرکت سه‌بعدی (هرجا نگاه کنی همون‌جا میره)
        local dir = (cf.RightVector * input.X) + (cf.LookVector * -input.Z)
        local vert = 0
        if S.up then vert += 1 end
        if S.down then vert -= 1 end
        if not UIS:GetFocusedTextBox() then
            if UIS:IsKeyDown(Enum.KeyCode.Space) then vert += 1 end
            if UIS:IsKeyDown(Enum.KeyCode.LeftControl) then vert -= 1 end
        end
        dir += Vector3.new(0, vert, 0)

        local target = Vector3.zero
        if dir.Magnitude > 0.05 then
            target = dir.Unit * flySpeed
            playAnim("Fall", 1)
        else
            playAnim("Idle", 1)
        end
        bv.Velocity = bv.Velocity:Lerp(target, math.clamp(dt * 10, 0, 1))

        -- چرخش (upright)
        local face
        if S.lock and camLook.Magnitude > 0.01 then
            face = camLook
        elseif flat(dir).Magnitude > 0.1 then
            face = flat(dir).Unit
        end
        if face then lastFace = face end
        bg.CFrame = CFrame.lookAt(pos, pos + lastFace)
    else
        -- حالت راه رفتن
        if fakeHum.PlatformStand then fakeHum.PlatformStand = false end
        local bv = fakeRoot:FindFirstChild("FlyVelocity")
        if bv then bv:Destroy() end
        local bg = fakeRoot:FindFirstChild("FlyGyro")
        if bg then bg:Destroy() end

        fakeHum.WalkSpeed = walk
        fakeHum.UseJumpPower = true
        fakeHum.JumpPower = jump
        fakeHum.AutoRotate = not S.lock

        if S.lock and camLook.Magnitude > 0.01 then
            fakeRoot.CFrame = CFrame.lookAt(pos, pos + camLook)
        end

        local dir = (camRight * input.X) + (camLook * -input.Z)
        local moving = dir.Magnitude > 0.01
        fakeHum:Move(moving and dir.Unit or Vector3.zero, false)

        -- انتخاب انیمیشن
        local state = fakeHum:GetState()
        local vy = fakeRoot.AssemblyLinearVelocity.Y
        if state == Enum.HumanoidStateType.Climbing then
            playAnim("Climb", math.clamp(math.abs(vy) / 5, 0, 2))
        elseif fakeHum.FloorMaterial == Enum.Material.Air then
            playAnim(vy > 2 and "Jump" or "Fall", 1)
        elseif moving then
            playAnim(walk <= 10 and "Walk" or "Run", math.clamp(walk / 16, 0.5, 2.5))
        else
            playAnim("Idle", 1)
        end
    end
end

local function startMode()
    if S.on then return end
    local char = Player.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not (root and hum) then return end

    RealChar = char
    originalCF = root.CFrame
    char.Archivable = true
    local clone = char:Clone()
    if not clone then return end

    clone.Name = "God_Clone"
    FakeChar = clone
    fakeHum = clone:FindFirstChildOfClass("Humanoid")
    fakeRoot = clone:FindFirstChild("HumanoidRootPart")
    if not (fakeHum and fakeRoot) then clone:Destroy() return end

    FakeParts = {}
    for _, v in ipairs(clone:GetDescendants()) do
        if v:IsA("LocalScript") or v:IsA("Script") then
            v:Destroy()
        elseif v:IsA("BasePart") then
            v.Anchored = false
            v.CanCollide = (v == fakeRoot)
            if v == fakeRoot then v.Transparency = 1 end
            table.insert(FakeParts, v)
        end
    end

    S.on = true
    MainBtn.Text = "Desync: ON"
    MainBtn.BackgroundColor3 = C.cyan

    if S.hide then
        root.CFrame = originalCF + Vector3.new(0, 5000, 0)
    end
    root.Anchored = true

    clone.Parent = workspace
    loadTracks(fakeHum)       -- بعد از parent شدن، با تشخیص R6/R15
    Camera.CameraSubject = fakeHum
    playAnim("Idle", 1)
    lastFace = flat(fakeRoot.CFrame.LookVector)
    if lastFace.Magnitude < 0.01 then lastFace = Vector3.new(0, 0, -1) else lastFace = lastFace.Unit end

    table.insert(RunConns, RunService.RenderStepped:Connect(step))
    table.insert(RunConns, RunService.Stepped:Connect(function()
        if not S.on then return end
        for _, p in ipairs(FakeParts) do
            if p.Parent then p.CanCollide = (p == fakeRoot) and not S.wall end
        end
    end))
    table.insert(RunConns, UIS.JumpRequest:Connect(function()
        if S.on and fakeHum and not S.fly then fakeHum.Jump = true end
    end))
end

stopMode = function()
    if not S.on then return end
    S.on = false
    MainBtn.Text = "Desync: OFF"
    MainBtn.BackgroundColor3 = C.blue
    disconnectRun()

    for _, t in pairs(Tracks) do pcall(function() t:Stop(0) end) end
    Tracks, CurAnim = {}, nil

    local lastCF
    if fakeRoot and fakeRoot.Parent then
        local _, yaw = fakeRoot.CFrame:ToOrientation()
        lastCF = CFrame.new(fakeRoot.Position) * CFrame.Angles(0, yaw, 0)
    end
    if FakeChar then FakeChar:Destroy() end
    FakeChar, fakeHum, fakeRoot, FakeParts = nil, nil, nil, {}

    if RealChar and RealChar.Parent then
        local root = RealChar:FindFirstChild("HumanoidRootPart")
        local hum = RealChar:FindFirstChildOfClass("Humanoid")
        if root then
            root.Anchored = false
            root.CFrame = (S.tp and lastCF) or originalCF
        end
        if hum then Camera.CameraSubject = hum end
    end
end

---------------- Auto ----------------
local autoToken = 0
local autoT
local function setAuto(v)
    S.auto = v
    autoToken += 1
    local my = autoToken
    if v then
        task.spawn(function()
            while S.auto and autoToken == my do
                local onTime = tonumber(TimeBox.Text) or 5
                if not S.on then startMode() end
                local t = 0
                while t < onTime and S.auto and autoToken == my do
                    t = t + task.wait(0.1)
                end
                if not (S.auto and autoToken == my) then break end
                if S.on then stopMode() end
                task.wait(0.5)
            end
        end)
    end
end

