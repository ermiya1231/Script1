-- متغیرهای اصلی سیستم
local PO = Vector3.new(0, 0, -1.48)
local RO = CFrame.Angles(0, math.pi, 0)
local con = nil
local savedpos = nil
local db = false
local isOn = false

local animTrack1, animTrack2 = nil, nil

-- آماده‌سازی انیمیشن‌های بغل کردن
local anim1 = Instance.new("Animation")
anim1.AnimationId = "rbxassetid://283545583"
local anim2 = Instance.new("Animation")
anim2.AnimationId = "rbxassetid://225975820"

local function GetTarget()
    local targetName = TextBox.Text:lower():gsub("%s+", "")
    if targetName == "" then return nil end

    for _, p in ipairs(Players:GetPlayers()) do
        if p == player then continue end
        local name = p.Name:lower()
        local display = (p.DisplayName or ""):lower()
        if name:find(targetName) or display:find(targetName) then
            return p
        end
    end
    return nil
end

local function PlayAnimations()
    local character = player.Character
    if not character then return end
    local humanoid = character:FindFirstChild("Humanoid")
    if not humanoid then return end

    animTrack1 = humanoid:LoadAnimation(anim1)
    animTrack2 = humanoid:LoadAnimation(anim2)
    
    animTrack1.Priority = Enum.AnimationPriority.Action4
    animTrack2.Priority = Enum.AnimationPriority.Action4

    animTrack1:Play()
    animTrack2:Play()
end

local function StopAnimations()
    if animTrack1 then animTrack1:Stop(); animTrack1 = nil end
    if animTrack2 then animTrack2:Stop(); animTrack2 = nil end
end

local function Start()
    if db then return end
    if con then con:Disconnect() end
    con = nil

    local TP = GetTarget()
    if not TP then 
        HugButton.Text = "Target not found!"
        task.delay(1.5, function()
            if isOn then HugButton.Text = "Hug: ON" else HugButton.Text = "Hug: OFF" end
        end)
        isOn = false
        return 
    end

    TextBox.Text = TP.Name
    local character = player.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    local humanoid = character and character:FindFirstChild("Humanoid")
    if not root or not humanoid then return end

    humanoid.WalkSpeed = 0
    humanoid.JumpPower = 0

    savedpos = root.CFrame
    local tChar = TP.Character
    local tRoot = tChar and tChar:FindFirstChild("HumanoidRootPart")

    -- استفاده از Stepped به جای Heartbeat برای اجرا دقیقاً قبل از محاسبات فیزیک
    con = RunService.Stepped:Connect(function()
        if not root or not root.Parent or humanoid.Health <= 0 then
            pcall(function() sethiddenproperty(root, "PhysicsRepRootPart", nil) end)
            if con then con:Disconnect() end
            return
        end

        if not tRoot or not tRoot:IsDescendantOf(workspace) then
            tChar = TP.Character
            tRoot = tChar and tChar:FindFirstChild("HumanoidRootPart")
            if not tRoot then return end
        end

        -- غیرفعال کردن کامل کلیه برخوردها و تعاملات فیزیکی
        for _, part in ipairs(character:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = false
                part.CanTouch = false
                part.CanQuery = false
                part.Massless = true
            end
        end

        local targetCFrame = tRoot.CFrame * CFrame.new(PO) * RO
        
        pcall(function() sethiddenproperty(root, "PhysicsRepRootPart", tRoot) end)

        root.CFrame = targetCFrame
        
        -- کلید اصلی نپریدن تارگت: سرعت ما دقیقاً برابر با سرعت حرکت تارگت می‌شه
        local targetVelocity = tRoot.AssemblyLinearVelocity
        local targetAngularVelocity = tRoot.AssemblyAngularVelocity

        root.AssemblyLinearVelocity = targetVelocity
        root.AssemblyAngularVelocity = targetAngularVelocity
    end)

    PlayAnimations()
end

local function Stop()
    if con then 
        con:Disconnect()
        con = nil
    end

    StopAnimations()
    local character = player.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    local humanoid = character and character:FindFirstChild("Humanoid")

    if root then
        pcall(function() sethiddenproperty(root, "PhysicsRepRootPart", nil) end)
        
        for _, part in ipairs(character:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = true
                part.CanTouch = true
                part.CanQuery = true
                part.Massless = false
            end
        end
        
        if savedpos then
            root.CFrame = savedpos
            root.AssemblyLinearVelocity = Vector3.zero
            root.AssemblyAngularVelocity = Vector3.zero
        end
    end
    
    if humanoid then
        humanoid.WalkSpeed = 16
        humanoid.JumpPower = 50
    end
    
    savedpos = nil
end

HugButton.MouseButton1Click:Connect(function()
    if db then return end
    isOn = not isOn

    if isOn then
        HugButton.Text = "Hug: ON"
        HugButton.BackgroundColor3 = Color3.fromRGB(85, 255, 127)
        Start()
    else
        HugButton.Text = "Hug: OFF"
        HugButton.BackgroundColor3 = Color3.fromRGB(85, 170, 255)
        Stop()
    end
end)

player.CharacterAdded:Connect(function(newChar)
    if isOn then
        db = true
        task.wait(0.5)
        db = false
        if isOn then Start() end
    end
end) 

player.CharacterRemoving:Connect(function()
    local character = player.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if root then pcall(function() sethiddenproperty(root, "PhysicsRepRootPart", nil) end) end
    if con then con:Disconnect() end
    StopAnimations()
end)
