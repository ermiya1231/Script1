-- تابع درگ روان با TweenService
local function makeDraggable(targetFrame)
    local dragging, dragInput, dragStart, startPos

    targetFrame.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = targetFrame.Position

            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)

    targetFrame.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            local delta = input.Position - dragStart
            local newPos = UDim2.new(
                startPos.X.Scale, 
                startPos.X.Offset + delta.X, 
                startPos.Y.Scale, 
                startPos.Y.Offset + delta.Y
            )
            TweenService:Create(targetFrame, TweenInfo.new(0.15), {Position = newPos}):Play()
        end
    end)
end

-- تابع اسکن و یافتن پارت‌های معلق
local function getUnanchoredIsolatedParts()
    local isolatedParts = {}
    
    for _, desc in ipairs(Workspace:GetDescendants()) do
        if desc:IsA("BasePart") and not desc.Anchored then
            local model = desc:FindFirstAncestorOfClass("Model")
            local isCharacterOrNPC = false
            
            if model then
                if Players:GetPlayerFromCharacter(model) then
                    isCharacterOrNPC = true
                elseif model:FindFirstChildOfClass("Humanoid") then
                    isCharacterOrNPC = true
                end
            end
            
            if not isCharacterOrNPC then
                local hasAnchoredConnection = false
                local connectedParts = desc:GetConnectedParts(true)
                
                for _, connPart in ipairs(connectedParts) do
                    if connPart.Anchored then
                        hasAnchoredConnection = true
                        break
                    end
                end
                
                if not hasAnchoredConnection and model then
                    for _, otherDesc in ipairs(model:GetDescendants()) do
                        if otherDesc:IsA("BasePart") and otherDesc.Anchored then
                            hasAnchoredConnection = true
                            break
                        end
                    end
                end
                
                if not hasAnchoredConnection then
                    table.insert(isolatedParts, desc)
                end
            end
        end
    end
    
    return isolatedParts
end

-- اجرا و دریافت لیست پارت‌ها
local foundParts = getUnanchoredIsolatedParts()

-- اگر چیزی یافت نشد
