-- استخراج ID عددی از رشته‌ی عکس
local function extractId(img)
	local id = string.match(img, "[?&]id=(%d+)")
		or string.match(img, "rbxassetid://(%d+)")
		or string.match(img, "(%d%d%d+)")
	return id or img
end

