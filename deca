local entries = {}
local searching = false

-- بندانگشتی‌ها فقط برای ردیف‌هایی که توی دید (یا نزدیک دید) هستن لود می‌شن
local ROW_H = 105 -- ارتفاع ردیف (100) + فاصله (5)
local visibleList = {}
local loaded = {}

local function refreshThumbs()
	local y = ScrollingFrame.CanvasPosition.Y
	local h = ScrollingFrame.AbsoluteSize.Y
	local first = math.max(1, math.floor(y / ROW_H) - 1)
	local last = math.min(#visibleList, math.ceil((y + h) / ROW_H) + 2)

	local want = {}
	for i = first, last do
		local e = visibleList[i]
		want[e] = true
		if not loaded[e] then
			e.thumb.Image = e.img
			loaded[e] = true
		end
	end
	for e in pairs(loaded) do
		if not want[e] then
			e.thumb.Image = ""
			loaded[e] = nil
		end
	end
end

ScrollingFrame:GetPropertyChangedSignal("CanvasPosition"):Connect(refreshThumbs)
ScrollingFrame:GetPropertyChangedSignal("AbsoluteSize"):Connect(refreshThumbs)

local function applyFilter()
	local q = string.lower(FilterBox.Text)
	table.clear(visibleList)
	for _, e in ipairs(entries) do
		local match = q == "" or string.find(e.key, q, 1, true) ~= nil
		e.frame.Visible = match
		if match then
			table.insert(visibleList, e)
		end
	end
	refreshThumbs()
	return #visibleList
end

FilterBox:GetPropertyChangedSignal("Text"):Connect(function()
	if #entries > 0 then
		local shown = applyFilter()
		StatusLabel.Text = ("Showing %d of %d"):format(shown, #entries)
	end
end)

