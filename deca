	make("TextLabel", {
		Size = UDim2.new(1, -186, 0, 20),
		Position = UDim2.new(0, 94, 0, 16),
		BackgroundTransparency = 1,
		Text = img,
		TextColor3 = C.text,
		Font = Enum.Font.Gotham,
		TextSize = 12,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
	}, frame)

	make("TextLabel", {
		Size = UDim2.new(1, -186, 0, 16),
		Position = UDim2.new(0, 94, 0, 40),
		BackgroundTransparency = 1,
		Text = instance.ClassName,
		TextColor3 = C.ok,
		Font = Enum.Font.GothamBold,
		TextSize = 11,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextTruncate = Enum.TextTruncate.AtEnd,
	}, frame)

	make("TextLabel", {
		Size = UDim2.new(1, -186, 0, 28),
		Position = UDim2.new(0, 94, 0, 58),
		BackgroundTransparency = 1,
		Text = path,
		TextColor3 = C.sub,
		Font = Enum.Font.Gotham,
		TextSize = 10,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		TextTruncate = Enum.TextTruncate.AtEnd,
	}, frame)

	local copyPath = makeSmallButton("Copy ID", 36, frame)

	copyPath.MouseButton1Click:Connect(function()
		if copyText(extractId(img)) then
			flash(copyPath, "Copied!", "Copy ID")
		else
			flash(copyPath, "No clip", "Copy ID")
		end
	end)

	local entry = {
		frame = frame,
		thumb = thumb,
		img = img,
		key = string.lower(img .. " " .. instance.ClassName .. " " .. path),
	}
	table.insert(entries, entry)

	local q = string.lower(FilterBox.Text)
	local match = q == "" or string.find(entry.key, q, 1, true) ~= nil
	frame.Visible = match
	if match then
		table.insert(visibleList, entry)
	end
end

local function clearEntries()
	table.clear(visibleList)
	table.clear(loaded)
	local n = 0
	for _, e in ipairs(entries) do
		e.thumb.Image = ""
		e.frame:Destroy()
		n += 1
		if n % 100 == 0 then
			task.wait()
		end
	end
	table.clear(entries)
end

-- ==================== جستجو ====================
-- مسیرهایی که شامل این کلمات باشند نادیده گرفته می‌شوند
local BLOCKED_WORDS = { "hdadmin", "kohl", "topbar", "emotes", "chat" }

local function hasBlockedWord(str)
	local l = string.lower(str)
	for _, w in ipairs(BLOCKED_WORDS) do
		if string.find(l, w, 1, true) then
			return true
		end
	end
	return false
end

-- آیا عکس واقعاً دیده می‌شود؟ (خودش + همه‌ی والدها)
local function isActuallyVisible(inst)
	local ok, result = pcall(function()
		if inst:IsA("Decal") or inst:IsA("Texture") then
			if inst.Transparency >= 1 then
				return false
			end
		elseif inst:IsA("ImageLabel") then
			if inst.ImageTransparency >= 1 then
				return false
			end
		end
		local cur = inst
		while cur do
			if cur:IsA("GuiObject") and not cur.Visible then
				return false
			end
			if cur:IsA("LayerCollector") and not cur.Enabled then
				return false
			end
			cur = cur.Parent
		end
		return true
	end)
	return ok and result
end

local function getImageOf(inst, includeGuiImages, filterVisible)
	local img, kind
	if inst:IsA("Decal") or inst:IsA("Texture") then
		local ok, tex = pcall(function()
			return inst.Texture
		end)
		if ok then
			img, kind = tex, "tex"
		end
	elseif inst:IsA("SurfaceAppearance") then
		local ok, tex = pcall(function()
			return inst.ColorMap
		end)
		if ok then
			img, kind = tex, "tex"
		end
	elseif includeGuiImages and inst:IsA("ImageLabel") then
		local ok, v = pcall(function()
			return inst.Image
		end)
		if ok then
			img, kind = v, "gui"
		end
	end

	if not img or img == "" then
		return nil
	end
	-- عکس‌های داخلی روبلاکس (rbxasset://)
	if string.sub(string.lower(img), 1, 11) == "rbxasset://" then
		return nil
	end
	-- اگر Filter Not Showing Images روشن باشد فقط عکس‌های قابل مشاهده
	if filterVisible and not isActuallyVisible(inst) then
		return nil
	end
	-- hdadmin / kohl در مسیر
	local path = getFullName(inst)
	if hasBlockedWord(path) then
		return nil
	end
	return img, kind, path
end

local function search()
	if searching then
		return
	end

	local doGuis = cbGuis.value
	local doWorkspace = cbWorkspace.value

	if not (doGuis or doWorkspace) then
		StatusLabel.Text = "Select at least one search option!"
		return
	end

	searching = true
	clearEntries()
	StatusLabel.Text = "Searching..."
	StartButton.Text = "Scanning..."
	StartButton.BackgroundColor3 = C.accentBusy

	-- ریشه‌های اسکن
	local stack = {}
	local function pushRoot(root)
		if root then
			table.insert(stack, root)
		end
	end

	do
		if doWorkspace then
			pushRoot(workspace)
		end
		if doGuis then
			pushRoot(PlayerGui)
			local okCore, core = pcall(function()
				return game:GetService("CoreGui")
			end)
			if okCore then
				pushRoot(core)
			end
		end
	end

	local seenTex = {}   -- جلوگیری از تکرار ID (Decal / Texture)
	local seenInst = {}  -- جلوگیری از اسکن دوباره‌ی یک Instance
	local found, skipped, visited = 0, 0, 0
	local sinceYield = 0

	while #stack > 0 do
		local inst = table.remove(stack)

		if not seenInst[inst] and inst ~= ScreenGui then
			seenInst[inst] = true
			visited += 1

			if visited % 1500 == 0 then
				StatusLabel.Text = ("Searching... %d found"):format(found)
				task.wait()
			end

			local skip = hasBlockedWord(inst.Name)
			if not skip then
				local ok, s = pcall(shouldSkipCharacters, inst)
				skip = ok and s
			end

			if skip then
				skipped += 1
			else
				local img, kind, path = getImageOf(inst, doGuis, cbFilter.value)
				if img then
					if kind == "tex" then
						-- Decal/Texture: ID تکراری فقط یک بار نشان داده می‌شود
						if not seenTex[img] then
							seenTex[img] = true
							found += 1
							addEntry(inst, img, found, path)
							sinceYield += 1
						end
					else
						-- ImageLabel/ImageButton: هر Instance جدا
						found += 1
						addEntry(inst, img, found, path)
						sinceYield += 1
					end
					-- ساخت ردیف‌ها تدریجی انجام می‌شود تا فریم نپرد
					if sinceYield >= 15 then
						sinceYield = 0
						StatusLabel.Text = ("Searching... %d found"):format(found)
						task.wait()
						refreshThumbs()
					end
				end

				local ok3, children = pcall(inst.GetChildren, inst)
				if ok3 then
					for _, child in ipairs(children) do
						table.insert(stack, child)
					end
				end
			end
		end
	end

	applyFilter()
	StatusLabel.Text = ("Done! %d results"):format(found)
	StartButton.Text = "Scan Again"
	StartButton.BackgroundColor3 = C.accent
	searching = false
end

StartButton.MouseButton1Click:Connect(search)

