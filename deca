-- ==================== کمکی‌ها ====================
local function copyText(text)
	local fn = setclipboard or toclipboard or (syn and syn.write_clipboard)
	if fn then
		fn(text)
		return true
	end
	return false
end

local function flash(button, text, normal)
	button.Text = text
	task.delay(1.2, function()
		if button.Parent then
			button.Text = normal
		end
	end)
end

local function getFullName(inst)
	local ok, name = pcall(function()
		return inst:GetFullName()
	end)
	return ok and name or inst.Name
end

-- ==================== فیلتر کاراکترها ====================
local function isCharacterModel(inst)
	if not inst:IsA("Model") then
		return false
	end
	if inst:FindFirstChildOfClass("Humanoid") then
		return true
	end
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr.Character == inst then
			return true
		end
	end
	return false
end

local function shouldSkipCharacters(inst)
	if isCharacterModel(inst) then
		return true
	end
	if inst:IsA("Player") and inst ~= LocalPlayer then
		return true
	end
	return false
end

