-- جستجو
local function search()
	if searching then
		return
	end
	searching = true

	clearEntries()
	StatusLabel.Text = "Searching decals..."
	SearchButton.Text = "Searching..."
	SearchButton.BackgroundColor3 = C.accentBusy

	local seen = {}
	local found, skipped, visited = 0, 0, 0
	local stack = {}

	-- فقط Workspace اسکن می‌شود
	table.insert(stack, workspace)

	while #stack > 0 do
		local inst = table.remove(stack)
		visited += 1

		if visited % 1500 == 0 then
			StatusLabel.Text = ("Searching... %d found"):format(found)
			task.wait()
		end

		local ok, skip = pcall(shouldSkipSubtree, inst)
		if ok and skip then
			skipped += 1
		else
			if inst:IsA("Decal") or inst:IsA("Texture") then
				local ok2, tex = pcall(function()
					return inst.Texture
				end)
				if ok2 and tex and tex ~= "" and not seen[tex] then
					seen[tex] = true
					found += 1
					addEntry(inst, tex, found)
				end
			end

			local ok3, children = pcall(inst.GetChildren, inst)
			if ok3 then
				for _, child in ipairs(children) do
					table.insert(stack, child)
				end
			end
		end
	end

	applyFilter()
	StatusLabel.Text = ("Done! %d unique decals (skipped %d characters)"):format(found, skipped)
	SearchButton.Text = "Search Again"
	SearchButton.BackgroundColor3 = C.accent
	searching = false
end

