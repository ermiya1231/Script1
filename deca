-- کمکی‌ها
local function copyText(text)
	local fn = setclipboard or toclipboard or (syn and syn.write_clipboard)
	if fn then
		fn(text)
		return true
	end
	return false
end

local function flash(button, text, normal)
	button.Text = text
	task.delay(1.2, function()
		if button.Parent then
			button.Text = normal
		end
	end)
end

-- فیلتر: Decalهای مربوط به کاراکترها (اجزای بدن، اکسسوری، ابزار) نادیده گرفته می‌شوند
local function isCharacterModel(inst)
	if not inst:IsA("Model") then
		return false
	end
	if inst:FindFirstChildOfClass("Humanoid") then
		return true
	end
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr.Character == inst then
			return true
		end
	end
	return false
end

local function shouldSkipSubtree(inst)
	-- کاراکتر (بازیکنان و NPCها)
	if isCharacterModel(inst) then
		return true
	end
	-- اطلاعات بازیکن‌های دیگر (Backpack و ...)
	if inst:IsA("Player") and inst ~= LocalPlayer then
		return true
	end
	-- GUI خودمان
	if inst == ScreenGui then
		return true
	end
	return false
end

