-- تابع ساخت دکمه‌های استایل مدرن
local function StyleButton(btn, text, posY, primaryColor)
    btn.Size = UDim2.new(1, -24, 0, 38)
    btn.Position = UDim2.new(0, 12, 0, posY)
    btn.Text = text
    btn.BackgroundColor3 = Color3.fromRGB(28, 28, 38)
    btn.TextColor3 = Color3.fromRGB(220, 220, 230)
    btn.Font = Enum.Font.GothamSemibold
    btn.TextSize = 11
    btn.Parent = AppBase
    
    local c = Instance.new("UICorner", btn)
    c.CornerRadius = UDim.new(0, 8)
    
    local s = Instance.new("UIStroke", btn)
    s.Color = primaryColor or Color3.fromRGB(50, 50, 70)
    s.Thickness = 1
    s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border

    btn.MouseEnter:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(38, 38, 52)}):Play()
    end)
    btn.MouseLeave:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(28, 28, 38)}):Play()
    end)
end

