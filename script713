    acc = acc + dt
    if acc < 0.1 then return end -- 10 بار در ثانیه
    acc = 0
    for _, p in ipairs(Players:GetPlayers()) do processPlayer(p) end
end))

local function hookPlayerCharacter(player)
    local function onChar(char)
        local hum = char:WaitForChild("Humanoid", 4)
        if hum then
            trackConn(hum.Died:Connect(function()
                local hrp = getHitboxPart(char)
                if hrp and modified[hrp] then restorePart(hrp) end
            end))
        end
    end
    if player.Character then task.spawn(onChar, player.Character) end
    trackConn(player.CharacterAdded:Connect(onChar))
end
for _, p in ipairs(Players:GetPlayers()) do
    if p ~= LocalPlayer then hookPlayerCharacter(p) end
end
trackConn(Players.PlayerAdded:Connect(hookPlayerCharacter))
trackConn(Players.PlayerRemoving:Connect(function(player)
    if player.Character then
        local hrp = getHitboxPart(player.Character)
        if hrp and modified[hrp] then restorePart(hrp) end
    end
end))

