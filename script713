        or char:FindFirstChild("Torso")
        or char:FindFirstChild("UpperTorso")
end

-- ============================================================
--  HITBOX ENGINE v3.2 (Clean HumanoidRootPart Dedicated)
--  - فقط روی HumanoidRootPart اعمال می‌شود تا از باگ‌های مفاصل و لیمب‌ها جلوگیری شود
--  - جلوگیری از فریز شدن پلیرها با setIfDiff و عدم دستکاری Massless
--  - اجرای نرم با Heartbeat و تراتل 10Hz
-- ============================================================
local original = setmetatable({}, { __mode = "k" }) -- part -> props
local modified = setmetatable({}, { __mode = "k" }) -- part -> true

local function setIfDiff(part, prop, val)
    if part[prop] ~= val then part[prop] = val end
end

local function restorePart(part)
    local o = original[part]
    if o and part and part.Parent then
        pcall(function()
            setIfDiff(part, "Size", o.Size)
            setIfDiff(part, "Transparency", o.Transparency)
            setIfDiff(part, "Color", o.Color)
            setIfDiff(part, "CanCollide", o.CanCollide)
            setIfDiff(part, "Material", o.Material)
        end)
    end
    original[part] = nil
    modified[part] = nil
end

local function expandPart(part)
    if not original[part] then
        original[part] = {
            Size         = part.Size,
            Transparency = part.Transparency,
            Color        = part.Color,
            CanCollide   = part.CanCollide,
            Material     = part.Material,
        }
    end
    pcall(function()
        setIfDiff(part, "Size", Config.Size)
        setIfDiff(part, "Transparency", Config.Transparency)
        setIfDiff(part, "Color", Config.Color)
        setIfDiff(part, "CanCollide", Config.CanCollide)
        setIfDiff(part, "Material", Enum.Material.Neon)
    end)
    modified[part] = true
end

local function processPlayer(p)
    if p == LocalPlayer then return end
    local char = p.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    local alive = hum and hum.Health > 0
    local myTeam = LocalPlayer.Team
    local isTeammate = Config.TeamCheck and myTeam ~= nil and p.Team == myTeam

    local hrp = getHitboxPart(char)
    if hrp and hrp:IsA("BasePart") then
        if getgenv().HBE and alive and not isTeammate then
            expandPart(hrp)
        elseif modified[hrp] then
            restorePart(hrp)
        end
    end
end

local function restoreAll()
    for part in pairs(modified) do restorePart(part) end
end

local function forceUpdateHitboxes()
    if not getgenv().HBE then restoreAll() return end
    for _, p in ipairs(Players:GetPlayers()) do processPlayer(p) end
end

