        bar.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                ds = true; update(input)
            end
        end)
        trackConn(UIS.InputChanged:Connect(function(input)
            if ds and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then update(input) end
        end))
        trackConn(UIS.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then ds = false end
        end))
    end

    local function addColorPicker(frame, title, defaultColor, callback)
        local currentColor = defaultColor or Color3.fromRGB(255, 0, 0)
        local h, s, v = Color3.toHSV(currentColor)

        local card = Instance.new("Frame", frame)
        card.LayoutOrder = nextOrder()
        card.Size = UDim2.new(1, 0, 0, 38)
        card.BackgroundColor3 = Color3.fromRGB(26, 26, 40)
        card.ClipsDescendants = true
        Instance.new("UICorner", card).CornerRadius = UDim.new(0, 6)

        local lbl = Instance.new("TextLabel", card)
        lbl.Size = UDim2.new(1, -80, 0, 38)
        lbl.Position = UDim2.new(0, 10, 0, 0)
        lbl.BackgroundTransparency = 1
        lbl.Text = title
        lbl.TextColor3 = Color3.fromRGB(220, 220, 235)
        lbl.Font = Enum.Font.Gotham
        lbl.TextSize = 13
        lbl.TextXAlignment = Enum.TextXAlignment.Left

        local preview = Instance.new("TextButton", card)
        preview.Size = UDim2.new(0, 38, 0, 22)
        preview.Position = UDim2.new(1, -48, 0, 8)
        preview.BackgroundColor3 = currentColor
        preview.Text = ""
        Instance.new("UICorner", preview).CornerRadius = UDim.new(0, 5)
        local ps = Instance.new("UIStroke", preview)
        ps.Color = Color3.fromRGB(80, 80, 100)

        local tray = Instance.new("Frame", card)
        tray.Size = UDim2.new(1, -20, 0, 100)
        tray.Position = UDim2.new(0, 10, 0, 42)
        tray.BackgroundTransparency = 1

        local isOpen = false
        local fills = {}
        local function applyColor()
            currentColor = Color3.fromHSV(h, s, v)
            preview.BackgroundColor3 = currentColor
            if fills.h then fills.h.Size = UDim2.new(h, 0, 1, 0) end
            if fills.s then fills.s.Size = UDim2.new(s, 0, 1, 0) end
            if fills.v then fills.v.Size = UDim2.new(v, 0, 1, 0) end
            if callback then callback(currentColor) end
        end

        local function mini(pY, key, labelName, getVal, onSlide)
            local sBar = Instance.new("Frame", tray)
            sBar.Size = UDim2.new(1, 0, 0, 16)
            sBar.Position = UDim2.new(0, 0, 0, pY)
            sBar.BackgroundColor3 = Color3.fromRGB(35, 35, 50)
            Instance.new("UICorner", sBar).CornerRadius = UDim.new(0, 4)
            local sFill = Instance.new("Frame", sBar)
            sFill.Size = UDim2.new(getVal(), 0, 1, 0)
            sFill.BackgroundColor3 = Color3.fromRGB(80, 140, 255)
            Instance.new("UICorner", sFill).CornerRadius = UDim.new(0, 4)
            fills[key] = sFill
            local sText = Instance.new("TextLabel", sBar)
            sText.Size = UDim2.new(1, 0, 1, 0)
            sText.BackgroundTransparency = 1
            sText.Text = labelName
            sText.TextColor3 = Color3.fromRGB(240, 240, 240)
            sText.Font = Enum.Font.GothamBold
            sText.TextSize = 10

            local dragging2 = false
            local function slide(input)
                onSlide(math.clamp((input.Position.X - sBar.AbsolutePosition.X) / sBar.AbsoluteSize.X, 0, 1))
                applyColor()
            end
            sBar.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    dragging2 = true; slide(input)
                end
            end)
            trackConn(UIS.InputChanged:Connect(function(input)
                if dragging2 and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then slide(input) end
            end))
            trackConn(UIS.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging2 = false end
            end))
        end
        mini(0,  "h", "HUE",        function() return h end, function(x) h = x end)
        mini(22, "s", "SATURATION", function() return s end, function(x) s = x end)
        mini(44, "v", "BRIGHTNESS", function() return v end, function(x) v = x end)

        local presets = {
            Color3.fromRGB(255, 40, 40), Color3.fromRGB(0, 255, 120), Color3.fromRGB(0, 160, 255),
            Color3.fromRGB(255, 230, 0), Color3.fromRGB(255, 0, 220), Color3.fromRGB(255, 255, 255),
        }
        local ph = Instance.new("Frame", tray)
        ph.Size = UDim2.new(1, 0, 0, 20)
        ph.Position = UDim2.new(0, 0, 0, 70)
        ph.BackgroundTransparency = 1
        local pLayout = Instance.new("UIListLayout", ph)
        pLayout.FillDirection = Enum.FillDirection.Horizontal
        pLayout.Padding = UDim.new(0, 6)
        for _, col in ipairs(presets) do
            local pBtn = Instance.new("TextButton", ph)
            pBtn.Size = UDim2.new(0, 24, 0, 20)
            pBtn.BackgroundColor3 = col
            pBtn.Text = ""
            Instance.new("UICorner", pBtn).CornerRadius = UDim.new(0, 4)
            pBtn.MouseButton1Click:Connect(function() h, s, v = Color3.toHSV(col); applyColor() end)
        end

        preview.MouseButton1Click:Connect(function()
            sClick()
            isOpen = not isOpen
            TS:Create(card, TweenInfo.new(0.2), {Size = isOpen and UDim2.new(1, 0, 0, 148) or UDim2.new(1, 0, 0, 38)}):Play()
        end)
    end

    -- [ TAB: Hitbox ]
    local hbPage = createTab("Hitbox", "🎯")
    local hbToggle = addToggle(hbPage, "Enable Hitbox Expander", getgenv().HBE, function(v)
        getgenv().HBE = v
        forceUpdateHitboxes()
    end)
    addSlider(hbPage, "Hitbox Size", 2, 60, 15, function(v)
        Config.Size = Vector3.new(v, v, v)
        forceUpdateHitboxes()
    end)
    addSlider(hbPage, "Transparency", 0, 100, 75, function(v)
        Config.Transparency = v / 100
        forceUpdateHitboxes()
    end)
    addColorPicker(hbPage, "Hitbox Color", Config.Color, function(c)
        Config.Color = c
        forceUpdateHitboxes()
    end)
    addToggle(hbPage, "Team Check", false, function(v)
        Config.TeamCheck = v
        forceUpdateHitboxes()
    end)
    addToggle(hbPage, "CanCollide", false, function(v)
        Config.CanCollide = v
        forceUpdateHitboxes()
    end)

    -- [ TAB: ESP ]
    local espPage = createTab("ESP", "👁")
    addToggle(espPage, "Enable ESP Master", Config.ESP, function(v) Config.ESP = v end)
    addToggle(espPage, "2D Boxes", Config.ESPBoxes, function(v) Config.ESPBoxes = v end)
    addToggle(espPage, "Names", Config.ESPName, function(v) Config.ESPName = v end)
    addToggle(espPage, "Health Bar", Config.ESPHealth, function(v) Config.ESPHealth = v end)
    addToggle(espPage, "Distance", Config.ESPDist, function(v) Config.ESPDist = v end)
    addToggle(espPage, "Tracers", Config.ESPTracers, function(v) Config.ESPTracers = v end)
    addSlider(espPage, "Max Distance", 50, 3000, 600, function(v) Config.ESPRange = v end)
    addColorPicker(espPage, "ESP Main Color", Config.ESPColor, function(c) Config.ESPColor = c end)
    addColorPicker(espPage, "Tracers Color", Config.ESPTracerColor, function(c) Config.ESPTracerColor = c end)

    -- [ TAB: Movement ]
    local movePage = createTab("Movement", "⚡")
    addToggle(movePage, "Speed Modifier", false, function(v) Config.SpeedEnabled = v; applySpeed() end)
    addSlider(movePage, "WalkSpeed Value", 16, 250, 16, function(v)
        Config.WalkSpeed = v
        if Config.SpeedEnabled then applySpeed() end
    end)
    addToggle(movePage, "Infinite Jump", false, function(v) Config.InfJump = v end)
    addToggle(movePage, "Noclip", false, function(v) Config.Noclip = v end)
    addToggle(movePage, "Fly Mode", false, function(v) Config.Fly = v end)
    addSlider(movePage, "Fly Speed", 10, 200, 50, function(v) Config.FlySpeed = v end)

    -- [ TAB: Settings ]
    local infoPage = createTab("Settings", "⚙")
    local infoCard = Instance.new("Frame", infoPage)
    infoCard.LayoutOrder = nextOrder()
    infoCard.Size = UDim2.new(1, 0, 0, 140)
    infoCard.BackgroundColor3 = Color3.fromRGB(24, 24, 38)
    Instance.new("UICorner", infoCard).CornerRadius = UDim.new(0, 6)
    local infoTxt = Instance.new("TextLabel", infoCard)
    infoTxt.Size = UDim2.new(1, -16, 1, -16)
    infoTxt.Position = UDim2.new(0, 8, 0, 8)
    infoTxt.BackgroundTransparency = 1
    infoTxt.TextColor3 = Color3.fromRGB(180, 180, 210)
    infoTxt.Font = Enum.Font.Gotham
    infoTxt.TextSize = 12
    infoTxt.TextWrapped = true
    infoTxt.TextXAlignment = Enum.TextXAlignment.Left
    infoTxt.TextYAlignment = Enum.TextYAlignment.Top
    infoTxt.Text = "• [—] Collapse / جمع‌کردن منو\n• [RightShift] : مخفی/آشکار سازی پنجره\n• [F] : خاموش و روشن سریع هیت‌باکس\n• Target: فقط HumanoidRootPart (بهترین عملکرد و پایداری فیزیک)\n• کلیدهای پرواز: WASD + Space/LeftShift\n• v3.2: حذف پارت‌های اضافی + رفع کامل فریز کاراکترها\nUniversal Hitbox v3.2 by C00LHACK."

    tabs["Hitbox"].page.Visible = true
    tabs["Hitbox"].btn.BackgroundColor3 = Color3.fromRGB(50, 90, 180)
    tabs["Hitbox"].btn.TextColor3 = Color3.fromRGB(255, 255, 255)

    return gui, hbToggle
end

local MainUI, HBToggle = buildGUI()

