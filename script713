local espData = {}

local function removeESP(player)
    local data = espData[player]
    if not data then return end
    if data.conn then data.conn:Disconnect() end
    for _, obj in pairs(data.drawings or {}) do pcall(function() obj:Remove() end) end
    espData[player] = nil
end

local function createESP(player)
    if player == LocalPlayer or not HasDrawing then return end
    if espData[player] then removeESP(player) end

    local drawings = {
        box = Drawing.new("Square"), nameTag = Drawing.new("Text"),
        healthBg = Drawing.new("Square"), healthBar = Drawing.new("Square"),
        distTag = Drawing.new("Text"), tracer = Drawing.new("Line"),
    }
    drawings.box.Thickness = 1.5; drawings.box.Filled = false
    drawings.nameTag.Size = 13; drawings.nameTag.Center = true; drawings.nameTag.Outline = true
    drawings.healthBg.Filled = true; drawings.healthBg.Color = Color3.fromRGB(20, 20, 20)
    drawings.healthBar.Filled = true
    drawings.distTag.Size = 11; drawings.distTag.Center = true; drawings.distTag.Outline = true
    drawings.tracer.Thickness = 1

    local function hideAll() for _, d in pairs(drawings) do d.Visible = false end end

    local conn = RunService.RenderStepped:Connect(function()
        if not Config.ESP then hideAll() return end
        local char = player.Character
        if not char then hideAll() return end
        local hrp  = getHitboxPart(char)
        local hum  = char:FindFirstChildOfClass("Humanoid")
        local head = char:FindFirstChild("Head")
        if not hrp or not hum or not head or hum.Health <= 0 then hideAll() return end
        local myHrp = LocalPlayer.Character and getHitboxPart(LocalPlayer.Character)
        if not myHrp then hideAll() return end
        local dist = (myHrp.Position - hrp.Position).Magnitude
        if dist > Config.ESPRange then hideAll() return end
        local hrp2D, onScreen = Camera:WorldToViewportPoint(hrp.Position)
        if not onScreen then hideAll() return end

        local head2D = Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 0.5, 0))
        local feet2D = Camera:WorldToViewportPoint(hrp.Position - Vector3.new(0, 3, 0))
        local height = math.abs(head2D.Y - feet2D.Y)
        local width = height * 0.6
        local x = hrp2D.X - width / 2
        local y = head2D.Y

        drawings.box.Visible = Config.ESPBoxes
        if Config.ESPBoxes then
            drawings.box.Size = Vector2.new(width, height)
            drawings.box.Position = Vector2.new(x, y)
            drawings.box.Color = Config.ESPColor
        end
        drawings.nameTag.Visible = Config.ESPName
        if Config.ESPName then
            drawings.nameTag.Text = player.DisplayName
            drawings.nameTag.Position = Vector2.new(hrp2D.X, y - 16)
            drawings.nameTag.Color = Config.ESPColor
        end
        drawings.healthBg.Visible = Config.ESPHealth
        drawings.healthBar.Visible = Config.ESPHealth
        if Config.ESPHealth then
            local r = math.clamp(hum.Health / math.max(hum.MaxHealth, 1), 0, 1)
            drawings.healthBg.Size = Vector2.new(3, height)
            drawings.healthBg.Position = Vector2.new(x - 6, y)
            drawings.healthBar.Size = Vector2.new(3, height * r)
            drawings.healthBar.Position = Vector2.new(x - 6, y + height * (1 - r))
            drawings.healthBar.Color = Color3.fromRGB(math.floor(255 * (1 - r)), math.floor(255 * r), 0)
        end
        drawings.distTag.Visible = Config.ESPDist
        if Config.ESPDist then
            drawings.distTag.Text = tostring(math.floor(dist)) .. "m"
            drawings.distTag.Position = Vector2.new(hrp2D.X, y + height + 2)
            drawings.distTag.Color = Color3.fromRGB(255, 255, 255)
        end
        drawings.tracer.Visible = Config.ESPTracers
        if Config.ESPTracers then
            drawings.tracer.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
            drawings.tracer.To = Vector2.new(hrp2D.X, hrp2D.Y)
            drawings.tracer.Color = Config.ESPTracerColor
        end
    end)
    espData[player] = {conn = conn, drawings = drawings}
end

if HasDrawing then
    for _, p in ipairs(Players:GetPlayers()) do createESP(p) end
    trackConn(Players.PlayerAdded:Connect(createESP))
    trackConn(Players.PlayerRemoving:Connect(removeESP))
