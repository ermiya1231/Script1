getgenv()._UniversalHitboxCleanup = function()
    for _, conn in ipairs(Connections) do pcall(function() conn:Disconnect() end) end
    table.clear(Connections)
    if HasDrawing then
        for player in pairs(espData) do pcall(removeESP, player) end
        table.clear(espData)
    end
    pcall(restoreAll)
    pcall(function()
        if MainUI then MainUI:Destroy() end
        local existing = CoreGui:FindFirstChild("UniversalHitboxGUI")
        if existing then existing:Destroy() end
    end)
    getgenv().HBE = false
    print("🧹 [UniversalHitbox] Cleaned up previous instance successfully!")
end

