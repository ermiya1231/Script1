    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if hum then hum.WalkSpeed = Config.SpeedEnabled and Config.WalkSpeed or 16 end
end
trackConn(LocalPlayer.CharacterAdded:Connect(function()
    task.wait(0.5)
    if Config.SpeedEnabled then applySpeed() end
end))
trackConn(RunService.Stepped:Connect(function()
    if Config.Noclip and LocalPlayer.Character then
        for _, v in ipairs(LocalPlayer.Character:GetDescendants()) do
            if v:IsA("BasePart") then v.CanCollide = false end
        end
    end
end))
trackConn(UIS.JumpRequest:Connect(function()
    if Config.InfJump and LocalPlayer.Character then
        local hum = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
        if hum then hum:ChangeState(Enum.HumanoidStateType.Jumping) end
    end
end))
trackConn(RunService.RenderStepped:Connect(function(dt)
    if not Config.Fly or not LocalPlayer.Character then return end
    local hrp = getHitboxPart(LocalPlayer.Character)
    if not hrp then return end
    local cam = Camera.CFrame
    local dir = Vector3.zero
    if Config.FlyKeys.W then dir = dir + cam.LookVector end
    if Config.FlyKeys.S then dir = dir - cam.LookVector end
    if Config.FlyKeys.A then dir = dir - cam.RightVector end
    if Config.FlyKeys.D then dir = dir + cam.RightVector end
    if Config.FlyKeys.Space then dir = dir + Vector3.new(0, 1, 0) end
    if Config.FlyKeys.LeftShift then dir = dir - Vector3.new(0, 1, 0) end
    hrp.AssemblyLinearVelocity = Vector3.zero
    if dir.Magnitude > 0 then
        hrp.CFrame = hrp.CFrame + (dir.Unit * Config.FlySpeed * dt)
    end
end))

