--  KEYBINDS
-- ============================================================
local flyMap = {
    [Enum.KeyCode.W] = "W", [Enum.KeyCode.A] = "A", [Enum.KeyCode.S] = "S",
    [Enum.KeyCode.D] = "D", [Enum.KeyCode.Space] = "Space", [Enum.KeyCode.LeftShift] = "LeftShift",
}
trackConn(UIS.InputBegan:Connect(function(input, gpe)
    if gpe then return end
    if input.KeyCode == Enum.KeyCode.RightShift then
        if MainUI then MainUI.Enabled = not MainUI.Enabled; sToggle() end
    elseif input.KeyCode == Enum.KeyCode.F then
        getgenv().HBE = not getgenv().HBE
        if HBToggle then HBToggle.Set(getgenv().HBE, true) end
        forceUpdateHitboxes()
        sToggle()
    end
    local k = flyMap[input.KeyCode]
    if k and Config.Fly then Config.FlyKeys[k] = true end
end))
trackConn(UIS.InputEnded:Connect(function(input)
    local k = flyMap[input.KeyCode]
    if k then Config.FlyKeys[k] = false end
end))

