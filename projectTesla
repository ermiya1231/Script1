-- لودینگ بمبی با قرارگیری جلوی پلیر
local function BuildAndVerifyMap(data)
    print("شروع ساخت پارت‌ها در جلوی پلیر...")
    local partsToBuild = {}
    
    local cleanData = data:gsub("Part %d+:", "|||")
    for partBlock in cleanData:gmatch("([^|]+)") do
        local x, y, z = partBlock:match("Position:%s*%(([^,]+),%s*([^,]+),%s*([^)]+)%)")
        if x and y and z then
            local rx, ry, rz = partBlock:match("Rotation:%s*%(([^,]+),%s*([^,]+),%s*([^)]+)%)")
            local sx, sy, sz = partBlock:match("Size:%s*%(([^,]+),%s*([^,]+),%s*([^)]+)%)")
            local shape = partBlock:match("Shape:%s*([%a%d]+)")
            local r, g, b = partBlock:match("Color:%s*([^,]+),%s*([^,]+),%s*([^%s\r\n]+)")
            local mat = partBlock:match("Material:%s*([%a%d]+)")
            local trans = partBlock:match("Transparency:%s*([%d%.]+)")
            
            local decalFace, decalId = partBlock:match("Decal%.(%a+)%s*=%s*(%d+)")
            local texFace, texId = partBlock:match("Texture%.(%a+)%s*=%s*(%d+)")
            
            local meshType = partBlock:match("MeshType:%s*(%a+)")
            local meshId = partBlock:match("MeshId:%s*(%S+)") or partBlock:match("Mesh:%s*(%S+)")
            local meshTextureId = partBlock:match("MeshTextureId:%s*(%S+)") or partBlock:match("MeshTexture:%s*(%S+)")
            
            local msStr = partBlock:match("MeshScale:%s*([^\n\r]+)")
            local msX, msY, msZ = 1, 1, 1
            if msStr then
                local ex, ey, ez = msStr:match("([%d%.]+)%s*,%s*([%d%.]+)%s*,%s*([%d%.]+)")
                if ex and ey and ez then msX, msY, msZ = ex, ey, ez end
            end
            
            local hasLight = partBlock:match("Light:%s*[Tt]rue") and true or false
            local hasFire = partBlock:match("Fire:%s*[Tt]rue") and true or false
            local isUnanchored = partBlock:match("Unanchored:%s*[Tt]rue") and true or false
            
            local f3xShape = "Normal"
            if partBlock:match("SpawnPoint:%s*[Tt]rue") then f3xShape = "Spawn"
            elseif shape == "Cylinder" then f3xShape = "Cylinder"
            elseif shape == "Ball" or shape == "Sphere" then f3xShape = "Ball"
            elseif shape == "Wedge" then f3xShape = "Wedge" end
            
            local pColor = Color3.new(1, 1, 1)
            if r and g and b then
                local rn, gn, bn = safeNum(r), safeNum(g), safeNum(b)
                if rn > 1 or gn > 1 or bn > 1 then pColor = Color3.fromRGB(rn, gn, bn)
                else pColor = Color3.new(rn, gn, bn) end
            end
            
            table.insert(partsToBuild, {
                pos = Vector3.new(safeNum(x), safeNum(y), safeNum(z)),
                rot = Vector3.new(safeNum(rx), safeNum(ry), safeNum(rz)),
                shape = f3xShape, size = Vector3.new(safeNum(sx,1), safeNum(sy,1), safeNum(sz,1)),
                color = pColor, material = mat or "Plastic", transparency = safeNum(trans),
                decalFace = decalFace, decalId = decalId,
                texFace = texFace, texId = texId, 
                meshType = meshType, meshId = meshId, meshTextureId = meshTextureId, 
                meshScale = Vector3.new(safeNum(msX, 1), safeNum(msY, 1), safeNum(msZ, 1)),
                hasLight = hasLight, hasFire = hasFire, 
                collision = not (partBlock:match("CanCollide:%s*[Ff]alse")),
                isUnanchored = isUnanchored
            })
        end
    end
    
    local totalParts = #partsToBuild
    if totalParts == 0 then warn("خطا: پارتی یافت نشد!") return end

    -- پیدا کردن مرکز و پایین‌ترین نقطه کل مدل برای اسپاون جلوی پلیر
    local minPos, maxPos
    for _, p in ipairs(partsToBuild) do
        if not minPos then
            minPos = p.pos
            maxPos = p.pos
        else
            minPos = Vector3.new(math.min(minPos.X, p.pos.X), math.min(minPos.Y, p.pos.Y), math.min(minPos.Z, p.pos.Z))
            maxPos = Vector3.new(math.max(maxPos.X, p.pos.X), math.max(maxPos.Y, p.pos.Y), math.max(maxPos.Z, p.pos.Z))
        end
    end

    -- Pivot اصلیِ مدل خام
    local modelCenter = Vector3.new((minPos.X + maxPos.X) / 2, minPos.Y, (minPos.Z + maxPos.Z) / 2)
    local modelPivot = CFrame.new(modelCenter)

    -- Pivot مقصد (جلوی پلیر با استفاده از متغیر فاصله)
    local targetPivot = CFrame.new(0, 0, 0)
    local hrp = Player.Character and Player.Character:FindFirstChild("HumanoidRootPart")
    if hrp then
        local flatLook = Vector3.new(hrp.CFrame.LookVector.X, 0, hrp.CFrame.LookVector.Z)
        if flatLook.Magnitude < 0.01 then flatLook = Vector3.new(0, 0, -1) else flatLook = flatLook.Unit end
        
        -- استفاده از متغیرهای تنظیم فاصله و ارتفاع که در بالای اسکریپت تعریف شدند
        local targetPos = hrp.Position + (flatLook * SPAWN_DISTANCE) - Vector3.new(0, SPAWN_HEIGHT_OFFSET, 0)
        targetPivot = CFrame.lookAt(targetPos, targetPos + flatLook)
    end

    local batches = {
        resize = {}, color = {}, material = {}, anchor = {}, collision = {},
        meshCreate = {}, meshSync = {}, decalCreate = {}, decalSync = {},
        lightCreate = {}, lightSync = {}, decorationCreate = {}
    }
    
    local completed = 0

    for _, pData in ipairs(partsToBuild) do
        task.spawn(function()
            local success, p = pcall(function()
                -- محاسبه موقعیت جدید و نسبی برای ظاهر شدن جلوی پلیر
                local originalCFrame = CFrame.new(pData.pos) * CFrame.fromOrientation(math.rad(pData.rot.X), math.rad(pData.rot.Y), math.rad(pData.rot.Z))
                local relativeCFrame = modelPivot:ToObjectSpace(originalCFrame)
                local baseCFrame = targetPivot * relativeCFrame
                
                -- ====== فیکس مربوط به 90 درجه کج بودن MeshType: Cylinder ======
                if pData.meshType == "Cylinder" then
                    baseCFrame = baseCFrame * CFrame.Angles(0, 0, math.rad(90))
                    pData.size = Vector3.new(pData.size.Y, pData.size.X, pData.size.Z)
                    pData.meshScale = Vector3.new(pData.meshScale.Y, pData.meshScale.X, pData.meshScale.Z)
                end
                -- =============================================================
                
                return remote:InvokeServer("CreatePart", pData.shape, baseCFrame, workspace)
            end)
            
            if success and p and typeof(p) == "Instance" then
                table.insert(batches.resize, {Part = p, CFrame = p.CFrame, Size = pData.size})
                table.insert(batches.color, {Part = p, Color = pData.color})
                table.insert(batches.anchor, {Part = p, Anchored = not pData.isUnanchored})
                table.insert(batches.collision, {Part = p, CanCollide = pData.collision})
                
                local matSuccess, matEnum = pcall(function() return Enum.Material[pData.material:gsub("%s+", "")] end)
                table.insert(batches.material, {Part = p, Material = matSuccess and matEnum or Enum.Material.Plastic, Transparency = pData.transparency})
                
                if pData.hasLight or LIGHT_ALL_PARTS then
                    local targetRange = pData.hasLight and 60 or tonumber(GLOBAL_LIGHT_RANGE) or 15
                    local targetBright = pData.hasLight and 3 or tonumber(GLOBAL_LIGHT_BRIGHTNESS) or 3
                    
                    table.insert(batches.lightCreate, {Part = p, LightType = "PointLight"})
                    table.insert(batches.lightSync, {
                        Part = p, 
                        LightType = "PointLight", 
                        Range = targetRange, 
                        Brightness = targetBright,
                        Color = Color3.new(1, 1, 1),
                        Shadows = false
                    })
                end
                
                if pData.hasFire then
                    table.insert(batches.decorationCreate, {Part = p, DecorationType = "Fire"})
                end
                
                if pData.meshId or pData.meshType then
                    table.insert(batches.meshCreate, {Part = p})
                    local mTypeEnum = Enum.MeshType.FileMesh
                    if pData.meshType then
                        local meshTypeMap = {
                            File = "FileMesh", FileMesh = "FileMesh", Block = "Brick", Brick = "Brick",
                            Head = "Head", Sphere = "Sphere", Wedge = "Wedge", Cylinder = "Cylinder"
                        }
                        local mappedType = meshTypeMap[pData.meshType] or pData.meshType
                        local typeSuccess, typeEnum = pcall(function() return Enum.MeshType[mappedType] end)
                        if typeSuccess and typeEnum then mTypeEnum = typeEnum end
                    end
                    
                    local mId, tId = "", ""
                    if pData.meshId then local x = pData.meshId:match("%d+") if x then mId = "rbxassetid://"..x end end
                    if pData.meshTextureId then local x = pData.meshTextureId:match("%d+") if x then tId = "rbxassetid://"..x end end
                    
                    table.insert(batches.meshSync, {
                        Part = p, MeshType = mTypeEnum, MeshId = mId, 
                        TextureId = tId, Scale = pData.meshScale, Offset = Vector3.new(0, 0, 0)
                    })
                end
                
                -- پردازش Decal
                if pData.decalFace and pData.decalId and pData.decalId:match("%d+") then
                    local formattedFace = pData.decalFace:sub(1,1):upper() .. pData.decalFace:sub(2):lower()
                    local faceSuccess, faceEnum = pcall(function() return Enum.NormalId[formattedFace] end)
                    if faceSuccess and faceEnum then
                        table.insert(batches.decalCreate, {Part = p, Face = faceEnum, TextureType = "Decal"})
                        table.insert(batches.decalSync, {Part = p, Face = faceEnum, TextureType = "Decal", Texture = "rbxassetid://"..pData.decalId:match("%d+")})
                    end
                end

                -- پردازش Surface Texture
                if pData.texFace and pData.texId and pData.texId:match("%d+") then
                    local formattedFace = pData.texFace:sub(1,1):upper() .. pData.texFace:sub(2):lower()
                    local faceSuccess, faceEnum = pcall(function() return Enum.NormalId[formattedFace] end)
                    if faceSuccess and faceEnum then
                        table.insert(batches.decalCreate, {Part = p, Face = faceEnum, TextureType = "Texture"})
                        table.insert(batches.decalSync, {Part = p, Face = faceEnum, TextureType = "Texture", Texture = "rbxassetid://"..pData.texId:match("%d+")})
                    end
                end
            end
            completed = completed + 1
        end)
    end
    
    while completed < totalParts do RunService.Heartbeat:Wait() end
    print("پایه‌ها ایجاد شدند! تزریق یکجای تمامی استایل‌ها...")
    
    FireMassiveSync("SyncResize", batches.resize)
    FireMassiveSync("SyncColor", batches.color)
    FireMassiveSync("SyncMaterial", batches.material)
    FireMassiveSync("SyncAnchor", batches.anchor)
    FireMassiveSync("SyncCollision", batches.collision)
    
    if #batches.lightCreate > 0 then 
        ActiveSyncs = ActiveSyncs + 1
        task.spawn(function()
            pcall(function() remote:InvokeServer("CreateLights", batches.lightCreate) end)
            pcall(function() remote:InvokeServer("SyncLighting", batches.lightSync) end)
            ActiveSyncs = ActiveSyncs - 1
        end)
    end
    
    if #batches.decorationCreate > 0 then
        FireMassiveSync("CreateDecorations", batches.decorationCreate)
    end
    
    if #batches.meshCreate > 0 then 
        ActiveSyncs = ActiveSyncs + 1
        task.spawn(function()
            pcall(function() remote:InvokeServer("CreateMeshes", batches.meshCreate) end)
            pcall(function() remote:InvokeServer("SyncMesh", batches.meshSync) end)
            ActiveSyncs = ActiveSyncs - 1
        end)
    end

    if #batches.decalCreate > 0 then 
        ActiveSyncs = ActiveSyncs + 1
        task.spawn(function()
            pcall(function() remote:InvokeServer("CreateTextures", batches.decalCreate) end)
            pcall(function() remote:InvokeServer("SyncTexture", batches.decalSync) end)
            ActiveSyncs = ActiveSyncs - 1
        end)
    end

    print("در حال هماهنگی با سرور...")
    while ActiveSyncs > 0 do RunService.Heartbeat:Wait() end
    print("مدل با موفقیت در مقابل شما اسپاون شد!")
end

