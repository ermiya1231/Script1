                    sethiddenproperty(speaker, "MaxSimulationRadius", math.huge)
                end
            end)
            task.wait(0.2)
        end
    end)
    
    -- 🚀 منطق اصلی (دقیقاً همون کد خودت بدون هیچ تغییری)
    task.spawn(function()
        for i,v in pairs(players) do
            local Forces = {}
