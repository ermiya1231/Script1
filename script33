    list.HorizontalAlignment = Enum.HorizontalAlignment.Center
    list.SortOrder = Enum.SortOrder.LayoutOrder
    list.Padding = UDim.new(0, 8)
    list.Parent = page

    tabButtons[order] = tabBtn
    tabPages[order] = page

    tabBtn.MouseButton1Click:Connect(function()
        selectTab(order)
    end)

    return page
end

