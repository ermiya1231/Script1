	local function getGlyph(char)
		return FONT[char] or FONT[char:upper()] or nil
	end
	
	local function getMat(name)
		local t = {
			SmoothPlastic = Enum.Material.SmoothPlastic,
			Neon          = Enum.Material.Neon,
			Metal         = Enum.Material.Metal,
			Wood          = Enum.Material.Wood,
			Brick         = Enum.Material.Brick,
			Glass         = Enum.Material.Glass,
			Granite       = Enum.Material.Granite,
			Marble        = Enum.Material.Marble,
		}
		return t[name] or Enum.Material.Glass
	end
	
	local function getF3X()
		local bp = player.Backpack
		local ch = player.Character
		for _, v in ipairs(bp:GetChildren()) do
			if v:FindFirstChild("SyncAPI") then return v end
		end
		if ch then
			for _, v in ipairs(ch:GetChildren()) do
				if v:FindFirstChild("SyncAPI") then return v end
			end
		end
		return nil
	end
	
	local function updateColor()
		local r = math.clamp(tonumber(rInput.Text) or 255, 0, 255) / 255
		local g = math.clamp(tonumber(gInput.Text) or 255, 0, 255) / 255
		local b = math.clamp(tonumber(bInput.Text) or 255, 0, 255) / 255
		colorPreview.BackgroundColor3 = Color3.new(r, g, b)
	end
	
	rInput:GetPropertyChangedSignal("Text"):Connect(updateColor)
	gInput:GetPropertyChangedSignal("Text"):Connect(updateColor)
	bInput:GetPropertyChangedSignal("Text"):Connect(updateColor)
	updateColor()
	
	local builtParts = {}
	
	local function clearAll(endpoint)
		if #builtParts == 0 then return end
		local batch = {}
		for _, p in ipairs(builtParts) do
			if p and p.Parent then
				batch[#batch + 1] = p
			end
		end
		if #batch > 0 then
			pcall(function()
				endpoint:InvokeServer("Remove", batch)
			end)
		end
		builtParts = {}
	end
	
	local function build()
		local f3x = getF3X()
		if not f3x then return end
	
		local endpoint  = f3x.SyncAPI.ServerEndpoint
		local character = player.Character
		if not character then return end
	
		local root = character:FindFirstChild("HumanoidRootPart")
		if not root then return end
	
		local text = textInput.Text
		if text == "" then return end
	
		local letterSize = 2
		local thickness  = 0.2
		local spacing    = 0.5
		local r = math.clamp(tonumber(rInput.Text) or 255, 0, 255) / 255
		local g = math.clamp(tonumber(gInput.Text) or 255, 0, 255) / 255
		local b = math.clamp(tonumber(bInput.Text) or 255, 0, 255) / 255
		local color    = Color3.new(r, g, b)
		local material = Enum.Material.SmoothPlastic
	
		local px     = letterSize / 5
		local gap    = px * 0.1
		local cw     = 5 * (px + gap)
		local cs     = cw + spacing * px
		local sw     = cs
	
		local fwd   = root.CFrame.LookVector
		local rgt   = root.CFrame.RightVector
		local up    = root.CFrame.UpVector
	
		local chars = {}
		for _, c in utf8.codes(text) do
			chars[#chars + 1] = utf8.char(c)
		end
	
		local totalW = 0
		for _, ch in ipairs(chars) do
			totalW = totalW + (ch == " " and sw or cs)
		end
		totalW = totalW - (cs - cw)
	
		local origin = root.Position + fwd * 6 + up * (5 * (px + gap) * 0.5)
	
		clearAll(endpoint)
	
		local curX   = -totalW / 2
		local count  = 0
	
		for _, ch in ipairs(chars) do
			if ch == " " then
				curX = curX + sw
			else
				local glyph = getGlyph(ch)
				if glyph then
					for row = 1, #glyph do
						for col = 1, 5 do
							if glyph[row] and glyph[row][col] == 1 then
								local offX = curX + (col - 1) * (px + gap) + px * 0.5
								local offY = -(row - 1) * (px + gap)
								local pos  = origin + rgt * offX + up * offY
								local cf   = CFrame.new(pos) * CFrame.fromMatrix(Vector3.zero, rgt, up, -fwd)
								local sz   = Vector3.new(px, px, thickness)
	
								task.spawn(function()
									local ok, part = pcall(function()
										return endpoint:InvokeServer("CreatePart", "Normal", cf, workspace)
									end)
									if ok and part then
										builtParts[#builtParts + 1] = part
										pcall(function() endpoint:InvokeServer("SyncAnchor",   {{Part = part, Anchored = true}}) end)
										pcall(function() endpoint:InvokeServer("SyncResize",   {{Part = part, CFrame = part.CFrame, Size = sz}}) end)
										pcall(function() endpoint:InvokeServer("SyncColor",    {{Part = part, Color = color, UnionColoring = false}}) end)
										pcall(function() endpoint:InvokeServer("SyncMaterial", {{Part = part, Material = material}}) end)
									end
								end)
	
								count = count + 1
								if count % 12 == 0 then
									task.wait(0.04)
								end
							end
						end
					end
				end
				curX = curX + cs
			end
			task.wait(0.006)
		end
	end
	
	buildBtn.MouseButton1Click:Connect(function()
		pcall(build)
	end)
	
	clearBtn.MouseButton1Click:Connect(function()
		local f3x = getF3X()
		if not f3x then return end
		pcall(clearAll, f3x.SyncAPI.ServerEndpoint)
	end)
end;
