-- محاسبه ضریب سایز برای موبایل و کامپیوتر
---------------------------------------------------------
local function getScaleFactor()
	if not Camera then return 1 end
	-- بر اساس ارتفاع صفحه، ضریب را حساب می‌کند (روی گوشی‌ها کوچکتر می‌شود)
	return math.clamp(Camera.ViewportSize.Y / 720, 0.5, 1.4)
end

