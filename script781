-- 3. منطق سیستم Overhead و هماهنگ‌سازی سایزها
---------------------------------------------------------
local isSystemActive = false 
local guiContainer = Instance.new("Folder")
guiContainer.Name = "OverheadInventories"
guiContainer.Parent = LocalPlayer:WaitForChild("PlayerGui")
local playerConnections = {}

local function updateInventoryDisplay(player, scrollFrame)
	if not scrollFrame or not scrollFrame.Parent then return end
	
	for _, child in pairs(scrollFrame:GetChildren()) do
		if child:IsA("GuiObject") then child:Destroy() end
	end

	local tools = {}
	local backpack = player:FindFirstChild("Backpack")
	if backpack then
		for _, item in pairs(backpack:GetChildren()) do
			if item:IsA("Tool") then table.insert(tools, item) end
		end
	end
	
	if player.Character then
		for _, item in pairs(player.Character:GetChildren()) do
			if item:IsA("Tool") then table.insert(tools, item) end
		end
	end

	for _, tool in ipairs(tools) do
		if tool.TextureId and tool.TextureId ~= "" then
			local icon = Instance.new("ImageLabel")
			icon.Image = tool.TextureId
			icon.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
			icon.BorderSizePixel = 0
			icon.Parent = scrollFrame
			
			local stroke = Instance.new("UIStroke")
			stroke.Color = Color3.fromRGB(0, 255, 150)
			stroke.Thickness = 2
			stroke.Parent = icon
		else
			local txt = Instance.new("TextLabel")
			txt.Text = tool.Name
			txt.TextScaled = true
			txt.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
			txt.TextColor3 = Color3.fromRGB(10, 10, 10)
			txt.BorderSizePixel = 0
			txt.Parent = scrollFrame
			
			local stroke = Instance.new("UIStroke")
			stroke.Color = Color3.fromRGB(255, 50, 50)
			stroke.Thickness = 2
			stroke.Parent = txt
		end
	end
end

local function setupPlayer(player)
	if not isSystemActive then return end
	if player == LocalPlayer then return end
	if guiContainer:FindFirstChild(player.Name .. "_InventoryGui") then return end

	local sf = getScaleFactor() -- گرفتن ضریب سایز مخصوص دستگاه شما

	local billboard = Instance.new("BillboardGui")
	billboard.Name = player.Name .. "_InventoryGui"
	-- اعمال ضریب روی سایز ثابت تا در موبایل کوچکتر و در PC استاندارد بماند
	billboard.Size = UDim2.new(0, 180 * sf, 0, 120 * sf)
	billboard.StudsOffset = Vector3.new(0, 4, 0)
	billboard.AlwaysOnTop = true
	billboard.Active = true
	billboard.MaxDistance = 65
	billboard.Parent = guiContainer

	local scroll = Instance.new("ScrollingFrame")
	scroll.Size = UDim2.new(1, 0, 1, 0)
	scroll.BackgroundTransparency = 0.2
	scroll.BackgroundColor3 = Color3.fromRGB(10, 10, 15)
	scroll.BorderSizePixel = 0
	scroll.ScrollBarThickness = 4
	scroll.ScrollBarImageColor3 = Color3.fromRGB(0, 255, 150)
	scroll.AutomaticCanvasSize = Enum.AutomaticSize.Y
	scroll.CanvasSize = UDim2.new(0, 0, 0, 0)
	scroll.Parent = billboard

	local grid = Instance.new("UIGridLayout")
	-- اعمال ضریب روی آیکون‌ها
	grid.CellSize = UDim2.new(0, 50 * sf, 0, 50 * sf)
	grid.CellPadding = UDim2.new(0, 6 * sf, 0, 6 * sf)
	grid.SortOrder = Enum.SortOrder.LayoutOrder
	grid.HorizontalAlignment = Enum.HorizontalAlignment.Center
	grid.Parent = scroll
	
	local padding = Instance.new("UIPadding")
	padding.PaddingTop = UDim.new(0, 5 * sf)
	padding.PaddingBottom = UDim.new(0, 5 * sf)
	padding.Parent = scroll

	playerConnections[player] = {}

	local function onCharacter(char)
		local head = char:WaitForChild("Head", 5)
		local backpack = player:WaitForChild("Backpack", 5)
		
		if not isSystemActive or not playerConnections[player] then return end
		
		if head then billboard.Adornee = head end
		
		if backpack then
			table.insert(playerConnections[player], backpack.ChildAdded:Connect(function() updateInventoryDisplay(player, scroll) end))
			table.insert(playerConnections[player], backpack.ChildRemoved:Connect(function() updateInventoryDisplay(player, scroll) end))
		end
		
		table.insert(playerConnections[player], char.ChildAdded:Connect(function() updateInventoryDisplay(player, scroll) end))
		table.insert(playerConnections[player], char.ChildRemoved:Connect(function() updateInventoryDisplay(player, scroll) end))
		
		updateInventoryDisplay(player, scroll)
	end

	if player.Character then task.spawn(onCharacter, player.Character) end

	local charConn = player.CharacterAdded:Connect(function(char)
		if playerConnections[player] then
			for _, c in ipairs(playerConnections[player]) do
				if typeof(c) == "RBXScriptConnection" then c:Disconnect() end
			end
			playerConnections[player] = {playerConnections[player][1]} 
		else
			playerConnections[player] = {}
		end
		onCharacter(char)
	end)
	table.insert(playerConnections[player], 1, charConn) 
end

local function enableSystem()
	if isSystemActive then return end
	isSystemActive = true
	for _, p in pairs(Players:GetPlayers()) do setupPlayer(p) end
end

local function disableSystem()
	isSystemActive = false
	for player, conns in pairs(playerConnections) do
		for _, c in ipairs(conns) do
			if typeof(c) == "RBXScriptConnection" then c:Disconnect() end
		end
	end
	playerConnections = {}
	guiContainer:ClearAllChildren()
end

Players.PlayerAdded:Connect(function(player) if isSystemActive then setupPlayer(player) end end)

Players.PlayerRemoving:Connect(function(player)
	if playerConnections[player] then
		for _, c in ipairs(playerConnections[player]) do
			if typeof(c) == "RBXScriptConnection" then c:Disconnect() end
		end
		playerConnections[player] = nil
	end
	local b = guiContainer:FindFirstChild(player.Name .. "_InventoryGui")
	if b then b:Destroy() end
end)

---------------------------------------------------------
-- آپدیت زنده سایزها اگر پنجره بازی کوچک یا بزرگ شد (یا چرخش گوشی)
---------------------------------------------------------
Camera:GetPropertyChangedSignal("ViewportSize"):Connect(function()
	local sf = getScaleFactor()
	for _, child in pairs(guiContainer:GetChildren()) do
		if child:IsA("BillboardGui") then
			child.Size = UDim2.new(0, 180 * sf, 0, 120 * sf)
			local scroll = child:FindFirstChildOfClass("ScrollingFrame")
			if scroll then
				local grid = scroll:FindFirstChildOfClass("UIGridLayout")
				if grid then
					grid.CellSize = UDim2.new(0, 50 * sf, 0, 50 * sf)
					grid.CellPadding = UDim2.new(0, 6 * sf, 0, 6 * sf)
				end
			end
		end
	end
end)

