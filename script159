----------------------------------------------------------------
-- سیستم صف (پردازش تدریجی، بدون لگ)
----------------------------------------------------------------
local queue, qHead, qTail = {}, 1, 0
local mode = "apply" -- "apply" | "restore"
local addedConn

local function resetQueue(newQueue, newMode)
	queue = newQueue or {}
	qHead, qTail = 1, #queue
	mode = newMode
end

local function push(inst)
	qTail += 1
	queue[qTail] = inst
end

local function makeProps(density)
	return PhysicalProperties.new(math.max(density, 0.01), 0.3, 0.5, 1, 1)
end

-- پارت‌های پلیرها نادیده گرفته میشن
local function isPlayerPart(part)
	local model = part:FindFirstAncestorOfClass("Model")
	while model do
		if Players:GetPlayerFromCharacter(model) then
			return true
		end
		model = model:FindFirstAncestorOfClass("Model")
	end
	return false
end

local function lighten(part)
	if not part:IsA("BasePart") then return end
	local o = originals[part]
	if o then
		if o.Density == appliedDensity then return end -- قبلاً اعمال شده، لازم نیست دوباره
	elseif isPlayerPart(part) then
		return
	else
		o = { Massless = part.Massless, Props = part.CustomPhysicalProperties }
		originals[part] = o
		modifiedCount += 1
	end
	o.Density = appliedDensity
	pcall(function()
		part.Massless = true
		part.CustomPhysicalProperties = makeProps(appliedDensity)
	end)
end

local function restore(part)
	local o = originals[part]
	if not o then return end
	if part.Parent then
		pcall(function()
			part.Massless = o.Massless
			part.CustomPhysicalProperties = o.Props
		end)
	end
	originals[part] = nil
	modifiedCount = math.max(modifiedCount - 1, 0)
end

RunService.Heartbeat:Connect(function()
	if qHead > qTail then
		if qTail > 0 then queue, qHead, qTail = {}, 1, 0 end
		return
	end
	local t = os.clock()
	local fn = (mode == "apply") and lighten or restore
	while qHead <= qTail and os.clock() - t < FRAME_BUDGET do
		local item = queue[qHead]
		queue[qHead] = nil
		qHead += 1
		if item then fn(item) end
	end
end)

local function startApply()
	if addedConn then addedConn:Disconnect() end
	resetQueue(workspace:GetDescendants(), "apply") -- صف همون لیسته، بدون کپی اضافه
	addedConn = workspace.DescendantAdded:Connect(function(d)
		if d:IsA("BasePart") then push(d) end
	end)
end

local function startRestore()
	if addedConn then addedConn:Disconnect() addedConn = nil end
	local list = {}
	for part in pairs(originals) do
		list[#list + 1] = part
	end
	resetQueue(list, "restore")
end

