local function updateSlider(density)
	sliderDensity = density
	local a = (density - DENSITY_MIN) / (DENSITY_MAX - DENSITY_MIN)
	fill.Size = UDim2.fromScale(a, 1)
	knob.Position = UDim2.fromScale(a, 0.5)
	label.Text = ("Density: %.2f"):format(density)
	local changed = math.abs(density - appliedDensity) > 1e-4
	if changed and not apply.Visible then
		apply.Visible = true
		apply.Size = UDim2.fromOffset(0, 32)
		TweenService:Create(apply, TweenInfo.new(0.2, Enum.EasingStyle.Back), { Size = UDim2.fromOffset(78, 32) }):Play()
	elseif not changed then
		apply.Visible = false
	end
end

do
	local sliding = false
	local function fromInput(x)
		local a = math.clamp((x - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
		updateSlider(math.floor((DENSITY_MIN + a * (DENSITY_MAX - DENSITY_MIN)) * 100 + 0.5) / 100)
	end
	local function begin(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			sliding = true
			fromInput(input.Position.X)
		end
	end
	track.InputBegan:Connect(begin)
	knob.InputBegan:Connect(begin)
	UserInputService.InputChanged:Connect(function(input)
		if sliding and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
			fromInput(input.Position.X)
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			sliding = false
		end
	end)
end

