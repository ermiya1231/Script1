-- روش 1: چت جدید (TextChatService)
local function sendNew(msg)
	return pcall(function()
		local channels = TextChatService:WaitForChild("TextChannels", 5)
		local general = channels:FindFirstChild("RBXGeneral")
		assert(general, "RBXGeneral not found")
		general:SendAsync(msg)
	end)
end

-- روش 2: چت قدیمی (Legacy Chat)
local function sendLegacy(msg)
	return pcall(function()
		local events = ReplicatedStorage:WaitForChild("DefaultChatSystemChatEvents", 5)
		assert(events, "DefaultChatSystemChatEvents not found")
		events:WaitForChild("SayMessageRequest", 5):FireServer(msg, "All")
	end)
end

-- روش 3: ریموت‌های چت سفارشی بازی
local function sendCustom(msg)
	return pcall(function()
		local found = false
		for _, obj in ipairs(ReplicatedStorage:GetDescendants()) do
			if obj:IsA("RemoteEvent") then
				local n = obj.Name:lower()
				if n:find("chat") and (n:find("say") or n:find("send") or n:find("message")) then
					obj:FireServer(msg, "All")
					found = true
				end
			end
		end
		assert(found, "no custom chat remote found")
	end)
end

-- روشی که برای اولین پیام جواب داد را برای بقیه هم استفاده می‌کند
local methods = {
	{ name = "new_chat", fn = sendNew },
	{ name = "legacy_chat", fn = sendLegacy },
	{ name = "custom_chat", fn = sendCustom },
}
local working = nil

for i, msg in ipairs(MESSAGES) do
	local ok = false

	if working then
		ok = working.fn(msg)
	else
		for _, m in ipairs(methods) do
			if m.fn(msg) then
				working = m
				ok = true
				break
			end
		end
	end

	if i < #MESSAGES then
		task.wait(DELAY)
	end
end
end)
