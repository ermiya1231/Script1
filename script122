function breakWelds(part)

    local welds = {}

    for _, weld in ipairs(part:GetDescendants()) do

        if weld:IsA("WeldConstraint") or weld:IsA("Weld") or weld:IsA("Motor6D") then

            table.insert(welds, weld)

        end

    end

    if #welds == 0 then

        return false

    end

    local args = {

        "RemoveWelds",

        welds

    }

    _(args)

    return true

end

