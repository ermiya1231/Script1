-- FUNCTIONS

local function ClonePart(part)
	send({
		"Clone",
		{part},
		workspace
	})
end

local function MovePart(part,cf)
	send({
		"SyncMove",
		{{
			Part = part,
			CFrame = cf
		}}
	})
end

local function Anchor(part,bool)
	send({
		"SyncAnchor",
		{{
			Part = part,
			Anchored = bool
		}}
	})
end

local function Collision(part,bool)
	send({
		"SyncCollision",
		{{
			Part = part,
			CanCollide = bool
		}}
	})
end

local function Color(part,color)
	send({
		"SyncColor",
		{{
			Part = part,
			Color = color,
			UnionColoring = false
		}}
	})
end

local function Material(part,mat)
	send({
		"SyncMaterial",
		{{
			Part = part,
			Material = mat
		}}
	})
end

local function Resize(part,size)
	send({
		"SyncResize",
		{{
			Part = part,
			Size = size,
			CFrame = part.CFrame
		}}
	})
end

