ClearDataBtn.MouseButton1Click:Connect(function() SpyData[CurrentTab] = {}; SwitchTab(CurrentTab) end)

ExpandButton.MouseButton1Click:Connect(function()
    IsExpanded = not IsExpanded
    TweenService:Create(MainFrame, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Size = IsExpanded and UDim2.new(0, 960, 0, 460) or UDim2.new(0, 680, 0, 460)}):Play()
    ExpandButton.Text = IsExpanded and "<" or ">"
end)

CopyButton.MouseButton1Click:Connect(function() if _G.RawCode then _setclipboard(_G.RawCode) end end)

CloseButton.MouseButton1Click:Connect(function() IsSpamming = false; IsExecSpamming = false; ScreenGui:Destroy() end)
