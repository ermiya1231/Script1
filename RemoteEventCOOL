end)

ClientTabBtn.MouseButton1Click:Connect(function()
    ClientTabBtn.BackgroundColor3 = Color3.fromRGB(114, 137, 218)
    ServerTabBtn.BackgroundColor3 = Color3.fromRGB(40, 42, 50)
