local function LogEvent(side, remote, args, method)
    local db = SpyData[side]
    if not db[remote] then
        RemoteIDCounter = RemoteIDCounter + 1
        local success, rName = pcall(function() return remote.Name end)
        db[remote] = { ID = "Remote_" .. tostring(RemoteIDCounter), Name = success and rName or "UnknownRemote", Count = 0, Logs = {} }
    end
    
    local entry = db[remote]
    entry.Count = entry.Count + 1
    if #entry.Logs > 50 then table.remove(entry.Logs, 1) end
    
    table.insert(entry.Logs, {
        Time = os.date("%H:%M:%S"),
        Code = GenerateCodeString(side, remote, args, method),
        Args = args, Method = method
    })
    table.insert(UIUpdateQueue, {side = side, remote = remote, entry = entry})
end

if hookmetamethod then
    local oldNamecall
    pcall(function()
        oldNamecall = hookmetamethod(game, "__namecall", _newcclosure(function(self, ...)
            local method = tostring(_getnamecallmethod())
            
            if method == "PromptProductPurchase" or method == "PromptGamePassPurchase" or method == "PromptPurchase" then
                local func = self[method]
                return func(self, ...)
            end
            
            if method ~= "FireServer" and method ~= "InvokeServer" then
                return oldNamecall(self, ...)
            end
            
            if not _checkcaller() then
                if typeof(self) == "Instance" then
                    local className = self.ClassName
                    
                    if method == "FireServer" and className == "RemoteEvent" then
                        local args = {...}
                        task.spawn(function() pcall(function() LogEvent("Server", self, args, method) end) end)
                        
                    elseif method == "InvokeServer" and className == "RemoteFunction" then
                        local args = {...}
                        task.spawn(function() pcall(function() LogEvent("Server", self, args, method) end) end)
                    end
                end
            end
            
            return oldNamecall(self, ...)
        end))
    end)
else
    warn("Your executor does not support hookmetamethod. Server Side executing cannot be logged.")
end

local function wrapRemotes(folder)
    for _, obj in ipairs(folder:GetDescendants()) do
        if obj:IsA("RemoteEvent") then
            obj.OnClientEvent:Connect(function(...)
                local args = {...}
                pcall(function() LogEvent("Client", obj, args, "OnClientEvent") end)
            end)
        end
    end
end
for _, f in ipairs({game.ReplicatedStorage, game.StarterGui, game.StarterPack, game.StarterPlayer}) do
    pcall(function() wrapRemotes(f) end)
end

local function ExecuteSelectedRemote()
    if SelectedRemote and SelectedArgs then
        if CurrentTab == "Server" then
            if SelectedMethod == "FireServer" then 
                pcall(function() SelectedRemote:FireServer(unpack(SelectedArgs)) end)
            elseif SelectedMethod == "InvokeServer" then 
                task.spawn(function() pcall(function() SelectedRemote:InvokeServer(unpack(SelectedArgs)) end) end) 
            end
        elseif CurrentTab == "Client" then
            pcall(function() _firesignal(SelectedRemote.OnClientEvent, unpack(SelectedArgs)) end)
        end
    end
end

ExecuteButton.MouseButton1Click:Connect(ExecuteSelectedRemote)

SpamButton.MouseButton1Click:Connect(function()
    IsSpamming = not IsSpamming
    SpamButton.Text = IsSpamming and "Spam = ON" or "Spam = OFF"
    SpamButton.BackgroundColor3 = IsSpamming and Color3.fromRGB(200, 130, 40) or Color3.fromRGB(120, 120, 120)
    
    if IsSpamming then 
        task.spawn(function() 
            while IsSpamming do 
                ExecuteSelectedRemote()
                task.wait(0.03)
            end 
        end) 
    end
end)

CustomExecBtn.MouseButton1Click:Connect(function()
    local codeToRun = ExecTextBox.Text
    if codeToRun ~= "" then pcall(function() local func = loadstring(codeToRun); if func then task.spawn(func) end end) end
end)

ServerTabBtn.MouseButton1Click:Connect(function()
    ServerTabBtn.BackgroundColor3 = Color3.fromRGB(114, 137, 218)
    ClientTabBtn.BackgroundColor3 = Color3.fromRGB(40, 42, 50)
    CodeDisplay.Text = "<font color=\"#7A828B\">-- Server Side Tab Active</font>"
