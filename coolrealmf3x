-- ۱. اولویت اول: فریز کردن شما و حذف فیزیکی بقیه بازیکنان
local function RemoveAllPlayers()
    print("مرحله ۱: فریز کردن شما و حذف فیزیکی بقیه بازیکنان...")
    if Player.Character and Player.Character:FindFirstChild("HumanoidRootPart") then
        Player.Character.HumanoidRootPart.Anchored = true
    end
    
    local playerParts = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= Player then 
            if p.Character then
                for _, child in ipairs(p.Character:GetDescendants()) do
                    if child:IsA("BasePart") then
                        table.insert(playerParts, child)
                    end
                end
            end
        end
    end
    
    if #playerParts > 0 then
        SendF3X({"SetLocked", playerParts, false})
        SendF3X({"Remove", playerParts})
        task.wait(0.5)
    end
end

-- ۲. اولویت دوم: پاکسازی کامل مپ قبلی
local function ClearRemainingMap()
    print("مرحله ۲: پاکسازی کامل محیط ورک‌پیس...")
    local mapParts = {}
    
    for _, v in ipairs(workspace:GetDescendants()) do
        if (v:IsA("BasePart") or v:IsA("UnionOperation")) and v.Name ~= "Terrain" then
            if not v:IsDescendantOf(Player.Character) then
                table.insert(mapParts, v)
            end
        end
    end
    
    if #mapParts > 0 then
        SendF3X({"SetLocked", mapParts, false})
        SendF3X({"Remove", mapParts})
        
        local timeout = 0
        while mapParts[1] and mapParts[1].Parent ~= nil and timeout < 40 do
            task.wait(0.1)
            timeout = timeout + 1
        end
    end
    task.wait(0.3)
end

-- ۳. اولویت سوم: لود مپ جدید (با سیستم بسته‌بندی برای لود فوق‌سریع و بدون باگ)
local function BuildAndVerifyMap(data)
    print("مرحله ۳: آنالیز مپ جدید و آماده‌سازی بسته‌های اطلاعاتی...")
    local partsToBuild = {}
    
    local cleanData = data:gsub("Part %d+:", "|||")
    for partBlock in cleanData:gmatch("([^|]+)") do
        local x, y, z = partBlock:match("Position:%s*%(([^,]+),%s*([^,]+),%s*([^)]+)%)")
        local rx, ry, rz = partBlock:match("Rotation:%s*%(([^,]+),%s*([^,]+),%s*([^)]+)%)")
        local shape = partBlock:match("Shape:%s*([%a%d]+)")
        local sx, sy, sz = partBlock:match("Size:%s*%(([^,]+),%s*([^,]+),%s*([^)]+)%)")
        local r, g, b = partBlock:match("Color:%s*([^,]+),%s*([^,]+),%s*([^%s\r\n]+)")
        local mat = partBlock:match("Material:%s*([%a%d]+)")
        local trans = partBlock:match("Transparency:%s*([%d%.]+)")
        local decalFace, decalId = partBlock:match("Decal%.(%a+)%s*=%s*(%d+)")
        local meshId = partBlock:match("MeshId:%s*(%S+)")
        local textureId = partBlock:match("TextureId:%s*(%S+)")
        
        local f3xShape = "Normal"
        if shape == "Cylinder" then f3xShape = "Cylinder"
        elseif shape == "Ball" or shape == "Sphere" then f3xShape = "Ball"
        elseif shape == "Wedge" then f3xShape = "Wedge" end
        
        if x and sx then
            table.insert(partsToBuild, {
                pos = Vector3.new(tonumber(x), tonumber(y), tonumber(z)),
                rot = rx and Vector3.new(tonumber(rx), tonumber(ry), tonumber(rz)) or Vector3.new(0, 0, 0),
                shape = f3xShape,
                size = Vector3.new(tonumber(sx), tonumber(sy), tonumber(sz)),
                color = r and Color3.new(tonumber(r), tonumber(g), tonumber(b)) or Color3.new(1, 1, 1),
                material = mat or "Plastic",
                transparency = trans and tonumber(trans) or 0,
                decalFace = decalFace,
                decalId = decalId,
                meshId = meshId,
                textureId = textureId
            })
        end
    end
    
    local totalParts = #partsToBuild
    if totalParts == 0 then warn("خطا: هیچ پارتی شناسایی نشد!") return end
    
    -- جداول بسته‌بندی برای ارسال یکجای اطلاعات به سرور (جلوگیری از دراپ شدن پارت‌ها)
    local batches = {
        resize = {}, color = {}, material = {}, trans = {}, anchor = {},
        meshCreate = {}, meshSync = {}, decalCreate = {}, decalSync = {}
    }
    
    local activeThreads = 0
    print("تعداد پارت‌ها: " .. totalParts .. " | در حال ساخت اسکلت پارت‌ها...")
    
    for i, pData in ipairs(partsToBuild) do
        activeThreads = activeThreads + 1
        task.spawn(function()
            local baseCFrame = CFrame.new(pData.pos) * CFrame.fromOrientation(math.rad(pData.rot.X), math.rad(pData.rot.Y), math.rad(pData.rot.Z))
            local p = SendF3X({"CreatePart", pData.shape, baseCFrame, workspace})
            
            if p then
                -- افزودن به لیست بسته‌ها به جای ارسال درجا
                table.insert(batches.resize, {Part = p, CFrame = baseCFrame, Size = pData.size})
                table.insert(batches.color, {Part = p, Color = pData.color, UnionColoring = false})
                table.insert(batches.trans, {Part = p, Transparency = pData.transparency})
                table.insert(batches.anchor, {Part = p, Anchored = true})
                
                local matSuccess, matEnum = pcall(function() return Enum.Material[pData.material] end)
                if matSuccess and matEnum then
                    table.insert(batches.material, {Part = p, Material = matEnum})
                end
                
                if pData.meshId then
                    local numMeshId = pData.meshId:match("%d+")
                    local numTexId = pData.textureId and pData.textureId:match("%d+")
                    local cleanMeshId = numMeshId and ("rbxassetid://" .. numMeshId) or pData.meshId
                    local cleanTextureId = numTexId and ("rbxassetid://" .. numTexId) or ""
                    table.insert(batches.meshCreate, {Part = p, MeshType = Enum.MeshType.FileMesh})
                    table.insert(batches.meshSync, {Part = p, MeshId = cleanMeshId, TextureId = cleanTextureId, Scale = Vector3.new(1, 1, 1), Offset = Vector3.new(0, 0, 0)})
                end
                
                if pData.decalFace and pData.decalId then
                    local formattedFace = pData.decalFace:sub(1,1):upper() .. pData.decalFace:sub(2):lower()
                    local success, faceEnum = pcall(function() return Enum.NormalId[formattedFace] end)
                    if success and faceEnum then
                        table.insert(batches.decalCreate, {Part = p, Face = faceEnum, TextureType = "Decal"})
                        table.insert(batches.decalSync, {Part = p, Face = faceEnum, TextureType = "Decal", Texture = "rbxassetid://" .. pData.decalId})
                    end
                end
            end
            activeThreads = activeThreads - 1
        end)
        
        -- جلوگیری از لگ سرور هنگام ساخت اسکلت اولیه
        if i % 10 == 0 then task.wait() end
    end
    
    while activeThreads > 0 do task.wait(0.05) end
    
    print("در حال اعمال تغییرات به صورت یکجا (بدون لگ)...")
    -- ارسال گروهی تمامی مشخصات برای تمام پارت‌ها به صورت آنی
    if #batches.resize > 0 then SendF3X({"SyncResize", batches.resize}) end
    if #batches.color > 0 then SendF3X({"SyncColor", batches.color}) end
    if #batches.material > 0 then SendF3X({"SyncMaterial", batches.material}) end
    if #batches.trans > 0 then SendF3X({"SyncTransparency", batches.trans}) end
    if #batches.anchor > 0 then SendF3X({"SyncAnchor", batches.anchor}) end
    if #batches.meshCreate > 0 then SendF3X({"CreateMeshes", batches.meshCreate}) SendF3X({"SyncMesh", batches.meshSync}) end
    if #batches.decalCreate > 0 then SendF3X({"CreateTextures", batches.decalCreate}) SendF3X({"SyncTexture", batches.decalSync}) end
    
    print("مپ کاملا لود شد! شروع تایمر معکوس ۳ ثانیه‌ای...")
    task.wait(3)
end

