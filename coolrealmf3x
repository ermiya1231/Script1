-- ۴. اولویت آخر: آنفریز کردن شما، اجرای لیست دستورات و ری‌اسپاون
local function FinalRespawn(commandsList)
    print("مرحله نهایی: آنفریز کردن شما و ارسال دستورات...")
    if Player.Character and Player.Character:FindFirstChild("HumanoidRootPart") then
        Player.Character.HumanoidRootPart.Anchored = false
    end
    
    local hd = ReplicatedStorage:FindFirstChild("HDAdminHDClient")
    local legacyChat = ReplicatedStorage:FindFirstChild("DefaultChatSystemChatEvents")
    local textChatService = game:GetService("TextChatService")
    
    -- اجرای تک تک دستورات به ترتیب
    if commandsList and #commandsList > 0 then
        for _, cmd in ipairs(commandsList) do
            if cmd and cmd ~= "" then
                if hd and hd:FindFirstChild("Signals") then
                    local fireCmd = hd.Signals:FindFirstChild("RequestCommandSilent") or hd.Signals:FindFirstChild("RequestCommand")
                    if fireCmd then fireCmd:InvokeServer(cmd) end
                end
                
                pcall(function()
                    if legacyChat and legacyChat:FindFirstChild("SayMessageRequest") then
                        legacyChat.SayMessageRequest:FireServer(cmd, "All")
                    else
                        textChatService.TextChannels.RBXGeneral:SendAsync(cmd)
                    end
                end)
                task.wait(0.2)
            end
        end
    end
    
    -- ری‌اسپاون همگانی
    if hd and hd:FindFirstChild("Signals") then
        local fireCmd = hd.Signals:FindFirstChild("RequestCommandSilent") or hd.Signals:FindFirstChild("RequestCommand")
        if fireCmd then fireCmd:InvokeServer("") end
    end
    
    pcall(function()
        if legacyChat and legacyChat:FindFirstChild("SayMessageRequest") then
            legacyChat.SayMessageRequest:FireServer("", "All")
        else
            textChatService.TextChannels.RBXGeneral:SendAsync(";kill all")
        end
    end)
    
    tool.Parent = Player:FindFirstChild("Backpack") or ReplicatedStorage
    print("تمامی عملیات با سرعت نور و با موفقیت انجام شد!")
end

