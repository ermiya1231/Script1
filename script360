-- حالت ظاهری دکمه‌ها وقتی مشغول هستیم
local function setButtonsBusy(state)
    for _, btn in ipairs(promptButtons) do
        if btn and btn.Parent then
            btn.TextTransparency = state and 0.6 or 0
        end
    end
end

local function filterPrompts()
    local query = searchBox.Text:lower()
    local terms = {}
    for word in query:gmatch("%S+") do
        table.insert(terms, word)
    end

    for _, btn in ipairs(promptButtons) do
        if btn:IsA("TextButton") then
            local text = btn.Text:lower()
            local match = true
            for _, term in ipairs(terms) do
                if not text:find(term, 1, true) then
                    match = false
                    break
                end
            end
            btn.Visible = (#terms == 0) or match
        end
    end
end

-- اجرای امن: تلپورت، تعامل، و برگشت تضمینی به جای اصلی
local function runPrompt(obj, part)
    -- قفل‌ها
    if isBusy then return end
    local now = os.clock()
    if lastUsed[obj] and (now - lastUsed[obj]) < BUTTON_COOLDOWN then return end

    -- بررسی سالم بودن هدف
    if not obj or not obj.Parent or not part or not part.Parent then return end

    local character = player.Character
    local hrp = character and character:FindFirstChild("HumanoidRootPart")
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    if not hrp or not humanoid or humanoid.Health <= 0 then return end

    isBusy = true
    lastUsed[obj] = now
    setButtonsBusy(true)

    local camera = Workspace.CurrentCamera
    local originalCFrame = hrp.CFrame
    local ghost

    local function zeroVelocity()
        if hrp and hrp.Parent then
            hrp.AssemblyLinearVelocity = Vector3.zero
            hrp.AssemblyAngularVelocity = Vector3.zero
        end
    end

    -- تمام مراحل داخل pcall تا هر خطایی بود، cleanup اجرا بشه
    local ok, err = pcall(function()
        -- ساخت گهوست
        local wasArchivable = character.Archivable
        character.Archivable = true
        ghost = character:Clone()
        character.Archivable = wasArchivable

        if ghost then
            for _, desc in ipairs(ghost:GetDescendants()) do
                if desc:IsA("BasePart") then
                    desc.CanCollide = false
                    desc.Transparency = 0.6
                    desc.Material = Enum.Material.ForceField
                elseif desc:IsA("Script") or desc:IsA("LocalScript") then
                    desc:Destroy()
                end
            end
            local ghostRoot = ghost:FindFirstChild("HumanoidRootPart")
            if ghostRoot then
                ghostRoot.CFrame = originalCFrame
                ghostRoot.Anchored = true
            end
            ghost.Parent = Workspace

            local ghostHumanoid = ghost:FindFirstChildOfClass("Humanoid")
            if ghostHumanoid and camera then
                camera.CameraSubject = ghostHumanoid
            end
        end

        zeroVelocity()

        -- اگر پارت وسط کار حذف شده بود، تلپورت نکن
        if not part.Parent then return end
        hrp.CFrame = part.CFrame + Vector3.new(0, 3, 0)
        task.wait(0.2)

        if obj.Parent then
            if type(fireproximityprompt) == "function" then
                fireproximityprompt(obj)
            else
                obj:InputHoldBegin()
                task.wait(obj.HoldDuration + 0.05)
                obj:InputHoldEnd()
            end
        end

        task.wait(0.2)
    end)

    -- ===== Cleanup تضمینی (حتی اگر ارور بخوره یا کاراکتر بمیره) =====
    local currentChar = player.Character
    local currentHrp = currentChar and currentChar:FindFirstChild("HumanoidRootPart")
    local currentHum = currentChar and currentChar:FindFirstChildOfClass("Humanoid")

    -- فقط اگر هنوز همون کاراکتر زنده‌ست برگرد سر جای اصلی
    if currentChar == character and currentHrp and currentHum and currentHum.Health > 0 then
        currentHrp.CFrame = originalCFrame
        currentHrp.AssemblyLinearVelocity = Vector3.zero
        currentHrp.AssemblyAngularVelocity = Vector3.zero
        currentHum:ChangeState(Enum.HumanoidStateType.Running)
    end

    if camera and currentHum then
        camera.CameraSubject = currentHum
    end

    if ghost then
        ghost:Destroy()
    end

    if not ok then
        warn("[PromptTeleporter] error: " .. tostring(err))
    end

    -- کول‌دان کلی قبل از آزاد شدن قفل
    task.wait(GLOBAL_COOLDOWN)
    isBusy = false
    setButtonsBusy(false)
end

local function loadPrompts()
    for _, btn in ipairs(promptButtons) do
        btn:Destroy()
    end
    promptButtons = {}

    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("ProximityPrompt") and obj.Parent and obj.Parent:IsA("BasePart") then
            local part = obj.Parent
            local objectText = obj.ObjectText ~= "" and obj.ObjectText or obj.Name

            local btn = Instance.new("TextButton")
            btn.Size = UDim2.new(1, -6, 0, 42)
            btn.BackgroundColor3 = Color3.fromRGB(18, 18, 18)
            btn.BorderSizePixel = 1
            btn.BorderColor3 = Color3.fromRGB(50, 50, 50)
            btn.TextColor3 = Color3.fromRGB(220, 220, 220)
            btn.TextSize = 10
            btn.TextXAlignment = Enum.TextXAlignment.Left
            btn.AutoButtonColor = false
            btn.Text = "  " .. obj.Name .. " (" .. objectText .. ")"

            btn.MouseEnter:Connect(function()
                btn.BackgroundColor3 = Color3.fromRGB(240, 240, 240)
                btn.TextColor3 = Color3.fromRGB(12, 12, 12)
                btn.BorderColor3 = Color3.fromRGB(255, 255, 255)
            end)
            btn.MouseLeave:Connect(function()
                btn.BackgroundColor3 = Color3.fromRGB(18, 18, 18)
                btn.TextColor3 = Color3.fromRGB(220, 220, 220)
                btn.BorderColor3 = Color3.fromRGB(50, 50, 50)
            end)

            btn.MouseButton1Click:Connect(function()
                runPrompt(obj, part)
            end)

            btn.Parent = scrollingFrame
            table.insert(promptButtons, btn)
        end
    end
    filterPrompts()
end

loadPrompts()

