-- تابع اعمال فیلتر
local function filterPrompts()
    local query = searchBox.Text:lower()
    local terms = {}
    for word in query:gmatch("%S+") do
        table.insert(terms, word)
    end

    for _, btn in ipairs(promptButtons) do
        if btn:IsA("TextButton") then
            local text = btn.Text:lower()
            local match = true
            for _, term in ipairs(terms) do
                if not text:find(term, 1, true) then
                    match = false
                    break
                end
            end
            btn.Visible = (#terms == 0) or match
        end
    end
end

-- تابع بارگذاری دکمه‌ها
local function loadPrompts()
    for _, btn in ipairs(promptButtons) do
        btn:Destroy()
    end
    promptButtons = {}

    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("ProximityPrompt") and obj.Parent and obj.Parent:IsA("BasePart") then
            local part = obj.Parent
            local objectText = obj.ObjectText ~= "" and obj.ObjectText or obj.Name

            local btn = Instance.new("TextButton")
            btn.Size = UDim2.new(1, -6, 0, 42)
            btn.BackgroundColor3 = Color3.fromRGB(18, 18, 18)
            btn.BorderSizePixel = 1
            btn.BorderColor3 = Color3.fromRGB(50, 50, 50)
            btn.TextColor3 = Color3.fromRGB(220, 220, 220)
            btn.TextSize = 10
            btn.TextXAlignment = Enum.TextXAlignment.Left
            btn.AutoButtonColor = false
            
            -- استفاده از نام ProximityPrompt (obj.Name) به جای نام پارت
            btn.Text = "  " .. obj.Name .. " (" .. objectText .. ")"

            -- افکت هاور سیاه و سفید معکوس
            btn.MouseEnter:Connect(function()
                btn.BackgroundColor3 = Color3.fromRGB(240, 240, 240)
                btn.TextColor3 = Color3.fromRGB(12, 12, 12)
                btn.BorderColor3 = Color3.fromRGB(255, 255, 255)
            end)
            btn.MouseLeave:Connect(function()
                btn.BackgroundColor3 = Color3.fromRGB(18, 18, 18)
                btn.TextColor3 = Color3.fromRGB(220, 220, 220)
                btn.BorderColor3 = Color3.fromRGB(50, 50, 50)
            end)

            -- رویداد کلیک همراه با گهوست کلون و تلپورت
            btn.MouseButton1Click:Connect(function()
                local character = player.Character
                if not character or not character:FindFirstChild("HumanoidRootPart") then return end
                local hrp = character.HumanoidRootPart
                local humanoid = character:FindFirstChildOfClass("Humanoid")
                local camera = Workspace.CurrentCamera

                local originalCFrame = hrp.CFrame

                character.Archivable = true
                local ghost = character:Clone()
                character.Archivable = false

                for _, desc in ipairs(ghost:GetDescendants()) do
                    if desc:IsA("BasePart") then
                        desc.CanCollide = false
                        desc.Transparency = 0.6
                        desc.Material = Enum.Material.ForceField
                    elseif desc:IsA("Script") or desc:IsA("LocalScript") then
                        desc:Destroy()
                    end
                end

                if ghost:FindFirstChild("HumanoidRootPart") then
                    ghost.HumanoidRootPart.CFrame = originalCFrame
                end
                ghost.Parent = Workspace

                local ghostHumanoid = ghost:FindFirstChildOfClass("Humanoid")
                if ghostHumanoid and camera then
                    camera.CameraSubject = ghostHumanoid
                end

                hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                hrp.AssemblyAngularVelocity = Vector3.new(0, 0, 0)

                hrp.CFrame = part.CFrame + Vector3.new(0, 3, 0)
                task.wait(0.2)

                pcall(function()
                    if type(fireproximityprompt) == "function" then
                        fireproximityprompt(obj)
                    else
                        obj:InputHoldBegin()
                        task.wait(obj.HoldDuration + 0)
                        obj:InputHoldEnd()
                    end
                end)

                task.wait(0.2)
                
                hrp.CFrame = originalCFrame
                hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                hrp.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
                
                if humanoid and camera then
                    camera.CameraSubject = humanoid
                end

                if ghost then
                    ghost:Destroy()
                end
                
                if humanoid then
                    humanoid:ChangeState(Enum.HumanoidStateType.Running)
                end
            end)

            btn.Parent = scrollingFrame
            table.insert(promptButtons, btn)
        end
    end
    filterPrompts()
end

