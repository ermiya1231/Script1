local toggleData = {}
local animationTracks = {}

-- تابع کمکی برای پیدا کردن Humanoid
local function getHumanoidSafe()
    local char = player.Character or player.CharacterAdded:Wait()
    return char:WaitForChild("Humanoid"), char
end

-- تابع خاموش کردن تمام رقص‌های دیگر
local function resetAllToggles(exceptName)
    for name, data in pairs(toggleData) do
        if name ~= exceptName and data.isActive then
            data.isActive = false
            data.button.Text = name.." | خاموش"
            data.button.BackgroundColor3 = Color3.fromRGB(170, 0, 0)
            if animationTracks[name] then
                for _, track in ipairs(animationTracks[name]) do
                    track:Stop()
                end
            end
        end
    end
end

-- تابع ساخت دکمه‌های Toggle
local function createToggleButton(name, animationData, speed)
    toggleData[name] = {isActive = false}
    animationTracks[name] = {}

    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, -6, 0, buttonHeight)
    btn.BackgroundColor3 = Color3.fromRGB(170, 0, 0)
    btn.BackgroundTransparency = 0.1
    btn.Text = name.." | خاموش"
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.Font = Enum.Font.GothamBold
    btn.TextSize = 13
    btn.BorderSizePixel = 0
    btn.Parent = scroll
    
    toggleData[name].button = btn

    local crn = Instance.new("UICorner")
    crn.CornerRadius = UDim.new(0, 6)
    crn.Parent = btn

    btn.MouseButton1Click:Connect(function()
        local data = toggleData[name]
        data.isActive = not data.isActive

        local humanoid, char = getHumanoidSafe()

        if data.isActive then
            resetAllToggles(name)

            btn.Text = name.." | روشن"
            btn.BackgroundColor3 = Color3.fromRGB(255, 60, 60)

            local ids = type(animationData) == "table" and animationData or {animationData}
            animationTracks[name] = {}

            for _, id in ipairs(ids) do
                local anim = Instance.new("Animation")
                anim.AnimationId = id
                local track = humanoid:LoadAnimation(anim)
                track.Priority = Enum.AnimationPriority.Action4
                track.Looped = true
                table.insert(animationTracks[name], track)
                track:Play()
                track:AdjustSpeed(speed)
            end
        else
            btn.Text = name.." | خاموش"
            btn.BackgroundColor3 = Color3.fromRGB(170, 0, 0)

            for _, track in ipairs(animationTracks[name]) do
                track:Stop()
            end
        end
    end)
end

-- =======================================
-- ساخت دکمه اختصاصی Michael Jackson Dance
-- =======================================
local function createMJButton()
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, -6, 0, buttonHeight + 4)
    btn.BackgroundColor3 = Color3.fromRGB(255, 170, 0)
    btn.Text = "★ Michael Jakson Dance ★"
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.Font = Enum.Font.GothamBlack
    btn.TextSize = 13
    btn.BorderSizePixel = 0
    btn.Parent = scroll

    local crn = Instance.new("UICorner")
    crn.CornerRadius = UDim.new(0, 6)
    crn.Parent = btn

    local isPlayingMJ = false

    btn.MouseButton1Click:Connect(function()
        if isPlayingMJ then return end
        isPlayingMJ = true

        resetAllToggles()

        local humanoid, char = getHumanoidSafe()
        local hrp = char:WaitForChild("HumanoidRootPart")

        btn.Text = "در حال اجرا..."
        btn.BackgroundColor3 = Color3.fromRGB(120, 120, 120)

        task.spawn(function()
            -- ذخیره نورپردازی قبلی بازی
            local oldClockTime = Lighting.ClockTime
            local oldFogColor = Lighting.FogColor
            local oldFogEnd = Lighting.FogEnd
            local oldAmbient = Lighting.Ambient
            local oldOutdoorAmbient = Lighting.OutdoorAmbient

            -- تغییر ساعت به نصف شب برای بهتر دیده شدن دیسکو
            TweenService:Create(Lighting, TweenInfo.new(1.5), {
                ClockTime = 0,
                FogColor = Color3.fromRGB(10, 10, 10),
                FogEnd = 150
            }):Play()

            -- سیستم نورپردازی دیسکو
            local discoActive = true
            task.spawn(function()
                while discoActive do
                    local randomColor = Color3.fromRGB(math.random(50, 255), math.random(50, 255), math.random(50, 255))
                    TweenService:Create(Lighting, TweenInfo.new(0.35, Enum.EasingStyle.Sine), {
                        Ambient = randomColor,
                        OutdoorAmbient = randomColor
                    }):Play()
                    task.wait(0.35)
                end
            end)

            -- 1. ساخت پارتیکل‌های بنفش درخشان
            local particles = Instance.new("ParticleEmitter")
            particles.Color = ColorSequence.new(Color3.fromRGB(170, 0, 255))
            particles.LightEmission = 1
            particles.Size = NumberSequence.new({NumberSequenceKeypoint.new(0, 0.5), NumberSequenceKeypoint.new(1, 0)})
            particles.Rate = 120
            particles.Speed = NumberRange.new(5, 10)
            particles.Lifetime = NumberRange.new(1, 1.5)
            particles.SpreadAngle = Vector2.new(360, 360)
            particles.Parent = hrp

            -- 2. شروع لرزش دوربین خیلی نرم و Smooth با math.noise
            local shakeName = "MJSmoothShake" .. tostring(math.random(100,999))
            RunService:BindToRenderStep(shakeName, Enum.RenderPriority.Camera.Value + 1, function()
                if humanoid then
                    local t = tick() * 2 -- سرعت لرزش نرم
                    local intensity = 0.4 -- شدت لرزش (هرچه کمتر، ملایم‌تر)
                    humanoid.CameraOffset = Vector3.new(
                        math.noise(t, 1, 1) * intensity,
                        math.noise(1, t, 1) * intensity,
                        math.noise(1, 1, t) * intensity
                    )
                end
            end)

            -- 3. پخش آهنگ (ولوم 10)
            local sound = Instance.new("Sound")
            sound.SoundId = "rbxassetid://30231584"
            sound.Volume = 10
            sound.Parent = hrp
            sound:Play()

            -- 4. انیمیشن اول (دقیقا 0.2 ثانیه)
            local anim1 = Instance.new("Animation")
            anim1.AnimationId = "rbxassetid://182393478"
            local track1 = humanoid:LoadAnimation(anim1)
            track1.Priority = Enum.AnimationPriority.Action4
            track1:Play()
            task.wait(0.2)
            track1:Stop()

            -- 5. انیمیشن دوم (سرعت 0.5، بدون لوپ)
            local anim2 = Instance.new("Animation")
            anim2.AnimationId = "rbxassetid://186934910"
            local track2 = humanoid:LoadAnimation(anim2)
            track2.Priority = Enum.AnimationPriority.Action4
            track2.Looped = false
            track2:Play()
            track2:AdjustSpeed(0.5)
            track2.Stopped:Wait()

            -- 6. انیمیشن سوم 
            local anim3 = Instance.new("Animation")
            anim3.AnimationId = "rbxassetid://79094862"
            local track3 = humanoid:LoadAnimation(anim3)
            track3.Priority = Enum.AnimationPriority.Action4
            track3.Looped = true
            track3:Play()

            -- ذخیره تنظیمات اصلی راه رفتن
            local oldSpeed = humanoid.WalkSpeed
            local oldAutoRotate = humanoid.AutoRotate
            
            humanoid.WalkSpeed = 6
            humanoid.AutoRotate = false 

            local backDir = -hrp.CFrame.LookVector
            backDir = Vector3.new(backDir.X, 0, backDir.Z).Unit

            local renderName = "MJMoonwalk_"..tostring(math.random(1000,9999))
            RunService:BindToRenderStep(renderName, Enum.RenderPriority.Character.Value + 1, function()
                humanoid:Move(backDir, false)
            end)

            task.wait(3) -- ۳ ثانیه حرکت عقبی

            -- متوقف کردن همه چیز و بازگرداندن به حالت عادی
            RunService:UnbindFromRenderStep(renderName)
            RunService:UnbindFromRenderStep(shakeName) -- توقف لرزش دوربین
            humanoid.CameraOffset = Vector3.new(0, 0, 0) -- ریست کردن دوربین
            
            humanoid:Move(Vector3.new(0, 0, 0), false)
            humanoid.WalkSpeed = oldSpeed
            humanoid.AutoRotate = oldAutoRotate

            track3:Stop()
            sound:Destroy()
            
            -- قطع کردن تولید پارتیکل و حذف آن بعد از چند ثانیه
            particles.Enabled = false
            game.Debris:AddItem(particles, 2)

            -- پایان دادن به حالت دیسکو و برگرداندن نور به حالت اول
            discoActive = false
            TweenService:Create(Lighting, TweenInfo.new(2), {
                ClockTime = oldClockTime,
                FogColor = oldFogColor,
                FogEnd = oldFogEnd,
                Ambient = oldAmbient,
                OutdoorAmbient = oldOutdoorAmbient
            }):Play()

            -- فورا دکمه رو به حالت قبل برمیگردونیم
            btn.Text = "★ Michael Jakson Dance ★"
            btn.BackgroundColor3 = Color3.fromRGB(255, 170, 0)
            isPlayingMJ = false
        end)
    end)
end

