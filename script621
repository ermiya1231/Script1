local LocalPlayer = Players.LocalPlayer
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")

-- Tracking tables
local equippedTools = {}
local trackedTools = {}

-- Send Notification
pcall(function()
    StarterGui:SetCore("SendNotification", {
        Title = "Skidded By C00LHACK",
        Text = "Enjoy!",
        Icon = "rbxassetid://122714132204276",
        Duration = 10
    })
end)

