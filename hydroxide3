local function webImport(url, fileName)
    local success, result = pcall(function()
        return loadstring(game:HttpGet(url), fileName .. ".lua")()
    end)
    
    if not success then
        warn("خطا در لود فایل " .. fileName .. ": " .. tostring(result))
    end
    return result
end

