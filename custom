-- ===================== Tool detection =====================
local function inspectTool(tool)
	if not tool:IsA("Tool") then return nil end

	local api = tool:FindFirstChild("SyncAPI")
	if not api then return nil end

	local endpoint
	if api:IsA("RemoteFunction") or api:IsA("RemoteEvent") then
		endpoint = api
	else
		endpoint = api:FindFirstChild("ServerEndpoint") or api:FindFirstChildWhichIsA("RemoteFunction")
	end
	if not endpoint then return nil end

	local libraries = tool:FindFirstChild("Libraries")
	local fastSpawn = libraries and libraries:FindFirstChild("fastSpawn")
	local isFork = fastSpawn ~= nil and fastSpawn:IsA("ModuleScript")

	return { Tool = tool, Endpoint = endpoint, IsFork = isFork }
end

local function scan()
	local found = { F3X = nil, Fork = nil }
	local containers = { player:FindFirstChildOfClass("Backpack"), player.Character }

	for _, container in ipairs(containers) do
		if container then
			for _, child in ipairs(container:GetChildren()) do
				local info = inspectTool(child)
				if info then
					if info.IsFork then
						found.Fork = found.Fork or info
					else
						found.F3X = found.F3X or info
					end
				end
			end
		end
	end

	return found
end

local found = scan()
if not found.F3X and not found.Fork then
	error("[Customized F3X GUI] No F3X / ForkF3X tool (with SyncAPI) found in Backpack or Character.", 0)
end

-- ===================== F3X remote helpers =====================
local function invoke(entry, ...)
	local endpoint = entry.Endpoint
	if endpoint:IsA("RemoteFunction") then
		return pcall(endpoint.InvokeServer, endpoint, ...)
	else
		return pcall(endpoint.FireServer, endpoint, ...)
	end
end

local skyboxes = { F3X = nil, Fork = nil } -- created parts per kind

local function normalizeTextureId(text)
	text = (text or ""):gsub("%s+", "")
	if text == "" then return "" end
	if text:match("^%d+$") then
		return "rbxassetid://" .. text
	end
	return text
end

local function deleteSkybox(kind, entry)
	local part = skyboxes[kind]
	if not part then return false, "No skybox to delete." end
	skyboxes[kind] = nil

	if part.Parent then
		local ok = invoke(entry, "Remove", { part })
		if not ok then
			pcall(function() part:Destroy() end)
		end
	end
	return true, "Skybox deleted."
end

local function createSkybox(kind, entry, textureText)
	if normalizeTextureId(textureText):lower():find("^rbxthumb://") and kind ~= "Fork" then
		return false, "rbxthumb:// only works with ForkF3X."
	end

	local char = player.Character
	local head = char and (char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart"))
	if not head then return false, "Character not found." end

	if skyboxes[kind] then
		deleteSkybox(kind, entry)
	end

	local cf = CFrame.new(head.Position + Vector3.new(0, HEIGHT_OFFSET, 0))

	local ok, part = invoke(entry, "CreatePart", "Normal", cf, workspace)
	if not ok or typeof(part) ~= "Instance" then
		return false, "CreatePart failed."
	end
	skyboxes[kind] = part

	invoke(entry, "SetName", { part }, SKYBOX_NAME)
	invoke(entry, "SyncResize", { { Part = part, CFrame = cf, Size = SKYBOX_PART_SIZE } })
	invoke(entry, "SyncAnchor", { { Part = part, Anchored = true } })
	invoke(entry, "SyncCollision", { { Part = part, CanCollide = false } })

	invoke(entry, "CreateMeshes", { { Part = part } })
	local okMesh = invoke(entry, "SyncMesh", { {
		Part = part,
		MeshType = Enum.MeshType.FileMesh,
		MeshId = SKYBOX_MESH_ID,
		TextureId = normalizeTextureId(textureText),
		Scale = SKYBOX_SCALE,
	} })

	if not okMesh then
		return false, "Part created, but SyncMesh failed."
	end
	return true, "Skybox created."
end

-- ===================== Decal Spam =====================
local DECAL_BATCH   = 40 -- parts per remote call (each part appears ONCE per call)
local DECAL_WORKERS = 6  -- batches in flight (each one fires all 6 faces in parallel)
local SCAN_CHUNK    = 1500 -- parts examined per frame while collecting (avoids the startup freeze)

local ALL_FACES = {
	Enum.NormalId.Front,
	Enum.NormalId.Back,
	Enum.NormalId.Top,
	Enum.NormalId.Bottom,
	Enum.NormalId.Left,
	Enum.NormalId.Right
}

-- which faces of a part already carry this decal (single GetChildren pass)
local function facesWithDecal(part, id)
	local have = {}
	for _, c in ipairs(part:GetChildren()) do
		if c:IsA("Decal") and c.Texture == id then have[c.Face] = true end
	end
	return have
end

local function RunDecalSpam(kind, entry, textureText, onProgress)
	local id = normalizeTextureId(textureText)
	if id == "" then return false, "Enter a decal id first." end
	if id:lower():find("^rbxthumb://") and kind ~= "Fork" then
		return false, "rbxthumb:// only works with ForkF3X."
	end

	local function SendF3X(args)
		return invoke(entry, table.unpack(args))
	end

	-- collect parts in chunks so the game never freezes (skip Terrain and the skybox)
	local descendants = workspace:GetDescendants()
	local targets = {}
	for i = 1, #descendants do
		local v = descendants[i]
		if v:IsA("BasePart") and not v:IsA("Terrain")
			and v.Name ~= "CustomSkybox" and v.Name ~= "Skybox"
			and v ~= skyboxes.F3X and v ~= skyboxes.Fork then
			targets[#targets + 1] = v
		end
		if i % SCAN_CHUNK == 0 then task.wait() end
	end
	descendants = nil

	local total = #targets
	if total == 0 then return false, "No parts found in Workspace." end

	local nextStart, processed, alive = 1, 0, DECAL_WORKERS

	for _ = 1, DECAL_WORKERS do
		task.spawn(function()
			while true do
				-- take the next slice of parts (batches are built lazily)
				local first = nextStart
				if first > total then break end
				nextStart = first + DECAL_BATCH
				local batch = table.move(targets, first, math.min(first + DECAL_BATCH - 1, total), 1, {})

				-- unlock every locked part of the batch in ONE call
				local locked = {}
				for _, v in ipairs(batch) do
					if v.Locked then locked[#locked + 1] = v end
				end
				if #locked > 0 then
					SendF3X({ "SetLocked", locked, false })
				end

				-- all 6 faces in parallel; inside each call a part is listed only once
				local left = #ALL_FACES
				for f = 1, #ALL_FACES do
					task.spawn(function()
						local face = ALL_FACES[f]
						local create, sync = {}, {}
						for k, v in ipairs(batch) do
							create[k] = { Part = v, Face = face, TextureType = "Decal" }
							sync[k] = { Part = v, Face = face, TextureType = "Decal", Texture = id }
						end
						SendF3X({ "CreateTextures", create })
						SendF3X({ "SyncTexture", sync })
						left -= 1
					end)
				end
				while left > 0 do task.wait() end

				-- fix anything the server skipped (single face, single part)
				task.wait(0.1)
				for _, v in ipairs(batch) do
					if v.Parent then
						local have = facesWithDecal(v, id)
						for f = 1, #ALL_FACES do
							local face = ALL_FACES[f]
							if not have[face] then
								SendF3X({ "CreateTextures", { { Part = v, Face = face, TextureType = "Decal" } } })
								SendF3X({ "SyncTexture", { { Part = v, Face = face, TextureType = "Decal", Texture = id } } })
							end
						end
					end
				end

				processed += #batch
				if onProgress then onProgress(processed, total) end
			end
			alive -= 1
		end)
	end

	while alive > 0 do task.wait(0.1) end

	return true, string.format("Decal Spam done: %d parts.", total)
end

-- ===================== Particle (ForkF3X only) =====================
local function RunParticle(kind, entry, textureText)
	if kind ~= "Fork" then return false, "Particle only works with ForkF3X." end

	local id = normalizeTextureId(textureText)
	if id == "" then return false, "Enter a particle id first." end

	local heads = {}
	for _, plr in ipairs(Players:GetPlayers()) do
		local head = plr.Character and plr.Character:FindFirstChild("Head")
		if head and head:IsA("BasePart") then
			heads[#heads + 1] = head
		end
	end
	if #heads == 0 then return false, "No player heads found." end

	local function createAndSync(list)
		local create, sync = {}, {}
		for i, head in ipairs(list) do
			create[i] = { Part = head, DecorationType = "ParticleEmitter" }
			sync[i] = { Part = head, DecorationType = "ParticleEmitter", Texture = id }
		end
		invoke(entry, "CreateDecorations", create)  -- Decorate tool: make the emitter
		invoke(entry, "SyncDecorate", sync)         -- Decorate tool: set its Texture
	end

	createAndSync(heads)
	task.wait(0.2)

	-- verify; retry whatever the server skipped
	local applied = 0
	for _, head in ipairs(heads) do
		if head.Parent then
			local emitter = head:FindFirstChildOfClass("ParticleEmitter")
			if not emitter then
				createAndSync({ head })
				task.wait(0.1)
			elseif emitter.Texture ~= id then
				invoke(entry, "SyncDecorate", { { Part = head, DecorationType = "ParticleEmitter", Texture = id } })
				task.wait(0.1)
			end
			local e = head:FindFirstChildOfClass("ParticleEmitter")
			if e and e.Texture == id then applied += 1 end
		end
	end

	return applied > 0, string.format("Particle applied to %d/%d heads.", applied, #heads)
end

