			Position = UDim2.new(0, 8, 0, 312),
			BackgroundTransparency = 1,
			TextColor3 = COLORS.text,
			Font = Enum.Font.GothamBold,
			TextSize = 15,
			TextXAlignment = Enum.TextXAlignment.Left,
		}, frame)
		particleBox = makeBigBox("Decal ID", 336)
		particleBtn = makeButton("Particle", COLORS.accent, frame, UDim2.new(1, -16, 0, 30), UDim2.new(0, 8, 0, 400))
	end

	-- Lock overlay (Active = true sinks clicks)
	local lock = make("TextButton", {
		Name = "Lock",
		Text = "",
		AutoButtonColor = false,
		Active = true,
		Size = UDim2.new(1, 0, 1, 0),
		BackgroundColor3 = Color3.fromRGB(10, 10, 12),
		BackgroundTransparency = 0.25,
		ZIndex = 10,
		Visible = false,
	}, frame)
	corner(lock, 8)
