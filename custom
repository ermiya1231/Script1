-- ===================== Startup logic =====================
local function applyStartup()
	main.Visible = false
	chooser.Visible = false
	switchBtn.Visible = false

	if found.F3X and found.Fork then
		switchBtn.Visible = true
		chooser.Visible = true
	elseif found.Fork then
		setActive("Fork")
	elseif found.F3X then
		setActive("F3X")
	else
		-- nothing found (only possible after a respawn): lock everything
		for _, section in pairs(sections) do
			section.Entry = nil
			section.Lock.Visible = true
			section.LockLabel.Text = "🔒 Not found"
		end
		main.Visible = true
		setStatus("No F3X / ForkF3X tool found.", false)
	end
end

applyStartup()

-- ===================== Refresh after death / respawn =====================
local refreshToken = 0

local function refresh()
	refreshToken += 1
	local token = refreshToken

	-- hide the panel while we look again from scratch
	main.Visible = false
	chooser.Visible = false

	-- tools are given back a moment after the respawn: poll for up to 10s
	local deadline = os.clock() + 10
	local result = scan()
	while not (result.F3X or result.Fork) and os.clock() < deadline do
		task.wait(0.5)
		if token ~= refreshToken then return end
		result = scan()
	end

	-- let a second tool (F3X + ForkF3X) finish loading before deciding
	if result.F3X or result.Fork then
		task.wait(1)
		if token ~= refreshToken then return end
		result = scan()
	end

	if token ~= refreshToken then return end

	found.F3X, found.Fork = result.F3X, result.Fork
	applyStartup()
end

local respawnConn = player.CharacterAdded:Connect(function()
	task.spawn(refresh)
end)

screen.Destroying:Connect(function()
	respawnConn:Disconnect()
	refreshToken += 1
end)
