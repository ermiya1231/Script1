-- ## توابع و منطق اسکریپت ##

local function getPlayerFromPartialName(partialName)
    if partialName == "" then return nil end
    local lowerName = string.lower(partialName)
    for _, player in pairs(Players:GetPlayers()) do
        if string.sub(string.lower(player.Name), 1, #lowerName) == lowerName or 
           string.sub(string.lower(player.DisplayName), 1, #lowerName) == lowerName then
            return player
        end
    end
    return nil
end

local function sendChatMessage(msg)
    local legacyChat = ReplicatedStorage:FindFirstChild("DefaultChatSystemChatEvents")
    if legacyChat then
        legacyChat.SayMessageRequest:FireServer(msg, "All")
    else
        local textChannel = game:GetService("TextChatService").TextChannels:FindFirstChild("RBXGeneral")
        if textChannel then textChannel:SendAsync(msg) end
    end
    totalCopied = totalCopied + 1
end

-- آپدیت زنده آمار و فاصله تارگت
RunService.RenderStepped:Connect(function()
    local elapsed = os.time() - startTime
    local distText = "0m"
    
    if targetPlayer and targetPlayer.Character and targetPlayer.Character:FindFirstChild("HumanoidRootPart") and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
        local dist = (targetPlayer.Character.HumanoidRootPart.Position - LocalPlayer.Character.HumanoidRootPart.Position).Magnitude
        distText = string.format("%.1fm", dist)
    end
    
    if targetPlayer then
        InfoText.Text = string.format("👤 Target: %s\n🏷️ Display: %s\n📏 Distance: %s", targetPlayer.Name, targetPlayer.DisplayName, distText)
    else
        InfoText.Text = "👤 Target: None\n🏷️ Display: None\n📏 Distance: N/A"
    end
    
    StatsLabel.Text = string.format("📊 Copied: %d | ⏱️ %ds | %s", totalCopied, elapsed, isMimicking and "ACTIVE" or "IDLE")
end)

-- دکمه Main Toggle
MainToggleBtn.MouseButton1Click:Connect(function()
    isMimicking = not isMimicking
    
    if isMimicking then
        targetPlayer = getPlayerFromPartialName(TargetInput.Text)
        
        if targetPlayer and targetPlayer ~= LocalPlayer then
            MainToggleBtn.Text = "SYSTEM: ACTIVE"
            TweenService:Create(MainToggleBtn, TweenInfo.new(0.3), {BackgroundColor3 = Color3.fromRGB(0, 200, 120)}):Play()
            
            chatConnection = targetPlayer.Chatted:Connect(function(msg)
                sendChatMessage(msg)
            end)
        else
            isMimicking = false
            MainToggleBtn.Text = "TARGET NOT FOUND!"
            task.wait(1.5)
            MainToggleBtn.Text = "SYSTEM: OFF"
        end
    else
        MainToggleBtn.Text = "SYSTEM: OFF"
        TweenService:Create(MainToggleBtn, TweenInfo.new(0.3), {BackgroundColor3 = Color3.fromRGB(220, 50, 70)}):Play()
        if chatConnection then 
            chatConnection:Disconnect() 
            chatConnection = nil 
        end
    end
end)
