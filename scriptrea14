local function rollingTilt(i, total, t, speed, phaseShift)
    phaseShift = phaseShift or 0
    local norm = (i - 1) / math.max(1, total - 1) * 2 - 1
    local dir = norm >= 0 and 1 or -1
    local osc = math.sin(t * speed * 0.5 + i * 0.4 + phaseShift)
    return dir * math.rad(25) * math.abs(osc)
end

local function computeTargetCF(index, t, hrp)
    local preset = activePreset
    local total  = math.max(1, countTracked())
    local i      = index or 1

    local baseVal          = math.max(1, preset.radius or 5)
    local radiusMultiplier = 1 + (currentRadiusBoost / baseVal)
    local radius           = currentSize * radiusMultiplier

    local jX = math.sin(i * 1.37) * 0.07
    local jZ = math.cos(i * 0.97) * 0.05

    if preset.circleH then
        local angle = t * currentSpeed + ((2 * math.pi / total) * (i - 1))
        local worldPos = hrp.CFrame:PointToWorldSpace(
            Vector3.new(math.cos(angle)*radius, 0, math.sin(angle)*radius)
            + Vector3.new(0, currentHeight, 0)
        )
        local tiltRoll = rollingTilt(i, total, t, currentSpeed)
        local rot = CFrame.new(worldPos, hrp.Position) * CFrame.Angles(0, 0, tiltRoll)
        return worldPos, rot
    end

    if preset.wavy then
        local angle = (math.pi*2/total)*(i-1) + (t*currentSpeed)
        local wave = math.sin(angle*2) * (currentSize*0.3)
        local worldPos = hrp.CFrame:PointToWorldSpace(Vector3.new(math.cos(angle)*radius, currentHeight+wave, math.sin(angle)*radius))
        local rot = CFrame.new(worldPos, hrp.Position)
        return worldPos, rot
    end

    if preset.backInfinity then
        local angle = (math.pi*2/total)*(i-1) + (t*currentSpeed)
        local lx = radius * math.sin(angle)
        local ly = radius * 0.6 * math.sin(angle) * math.cos(angle)
        local lz = 3 - (math.abs(lx)*0.3)
        local worldPos = hrp.CFrame:PointToWorldSpace(Vector3.new(lx, currentHeight+ly, lz))
        local rot = CFrame.new(worldPos, hrp.Position)
        return worldPos, rot
    end

    if preset.knot then
        local r = currentSize * radiusMultiplier * 0.4
        local angle = (math.pi*2/total)*(i-1) + (t*currentSpeed)
        local lx = math.sin(angle) + 2*math.sin(2*angle)
        local ly = math.cos(angle) - 2*math.cos(2*angle)
        local lz = -math.sin(3*angle)
        local worldPos = hrp.CFrame:PointToWorldSpace(Vector3.new(lx*r, currentHeight+ly*r, lz*r))
        local rot = CFrame.new(worldPos, hrp.Position) * CFrame.Angles(i*0.5, i*0.3, i*0.7)
        return worldPos, rot
    end

    if preset.line then
        local lineAngle   = t * currentSpeed * 0.25
        local lineRot     = CFrame.Angles(0, lineAngle, 0)
        local spacing     = (radius * 0.5) + (currentRadiusBoost * 0.15)
        local centerOff   = (i - (total / 2) - 0.5) * spacing
        local bobPhase    = t * currentSpeed * 2 + i * 0.55
        local bobY        = math.sin(bobPhase) * (.3 + radius * 0.12)
        local localPos    = Vector3.new(centerOff, currentHeight + bobY, 0)
        local worldPos    = hrp.CFrame:PointToWorldSpace(lineRot * localPos)
        local lineDir     = (hrp.CFrame * lineRot * CFrame.new(1,0,0)).Position
                          - (hrp.CFrame * lineRot * CFrame.new(0,0,0)).Position
        local tiltRoll    = rollingTilt(i, total, t, currentSpeed)
        local rot = CFrame.lookAt(worldPos, worldPos + lineDir)
                  * CFrame.Angles(jX, 0, tiltRoll)
        return worldPos, rot
    end

    if preset.wings then
        local sizeScale = math.max(0.5, currentSize / 5)
        local spacing   = BOOM_LONG * sizeScale

        if i == 1 then
            local worldPos = hrp.CFrame:PointToWorldSpace(Vector3.new(0, currentHeight + 0.25, 1.0))
            local osc = math.sin(t * currentSpeed * 0.6) * math.rad(8)
            local rot = hrp.CFrame * CFrame.Angles(0, math.pi, 0) * CFrame.Angles(0, 0, osc)
            return worldPos, rot
        end

        local wingIdx  = i - 1
        local half     = math.ceil((total - 1) / 2)
        local isRight  = wingIdx > half
        local side     = isRight and 1 or -1
