local function hexEncode(s)
    return (s:gsub("([^&=])", function(c)
        return string.format("%%%02X", c:byte())
    end))
end

local function interleaveSpaces(s, minS, maxS)
    local out = {}
    for i = 1, #s do
        out[#out + 1] = s:sub(i, i)
        if i < #s then
            out[#out + 1] = string.rep(" ", rng:NextInteger(minS, maxS))
        end
    end
    return table.concat(out)
end

local function randAmps(min, max)
