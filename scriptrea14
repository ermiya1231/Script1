local function getPlaylistNames()
    local names = {}
    for _, audio in ipairs(playlist) do
        table.insert(names, audio.Name)
    end
    return names
end

local function getAudioName(idStr)
    local idNum = tonumber(idStr)
    if idNum then
        local success, info = pcall(function()
            return MarketplaceService:GetProductInfo(idNum, Enum.InfoType.Asset)
        end)
        if success and info and info.Name then
            return info.Name
        end
    end
    return "Audio " .. idStr
end

local function encodePretty(tbl)
    local lines = {"["}
    for i, audio in ipairs(tbl) do
        local comma = i < #tbl and "," or ""
        table.insert(lines, string.format('  { "Name": %q, "ID": %q }%s', audio.Name, audio.ID, comma))
    end
    table.insert(lines, "]")
    return table.concat(lines, "\n")
end

local function savePlaylist()
    if not writefile then return end
    writefile(PlaylistFile, encodePretty(playlist))
end

local function loadPlaylist()
    if not isfile(PlaylistFile) then return end
    
    local success, data = pcall(function()
        return HttpService:JSONDecode(readfile(PlaylistFile))
    end)

    if success and type(data) == "table" then
        table.clear(playlist)
        for _, audio in ipairs(data) do
            if type(audio) == "table" and audio.Name and audio.ID then
                table.insert(playlist, {
                    Name = tostring(audio.Name),
                    ID = tostring(audio.ID)
                })
            end
        end
    end
    
    if #playlist == 0 then
        table.insert(playlist, defaultPlaylistAudio)
        savePlaylist()
    end
end

