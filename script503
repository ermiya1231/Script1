-- Execution Logic
local isExecuting = false

local function resolvePrimary(player)
    return resolveArg(player, selectedPrimary)
end

local function getSelectedSecondary()
    if selectedSecondary == nil then return nil end
    return selectedSecondary
end

local function executeOnPlayer(player)
    if not player or not player.Parent then return end
    local primary = resolvePrimary(player)
    local secKey = getSelectedSecondary()

    for remote, sel in pairs(selectedRemotes) do
        if sel and remote and remote.Parent then
            pcall(function()
                if remote:IsA("RemoteEvent") then
                    if secKey == nil then
                        remote:FireServer(primary)
                    else
                        local secVal = resolveArg(player, secKey)
                        remote:FireServer(primary, secVal)
                    end
                elseif remote:IsA("RemoteFunction") then
                    task.spawn(function()
                        pcall(function()
                            if secKey == nil then
                                remote:InvokeServer(primary)
                            else
                                local secVal = resolveArg(player, secKey)
                                remote:InvokeServer(primary, secVal)
                            end
                        end)
                    end)
                end
            end)
        end
    end
end

local function setButtonText(button, text, delay)
    local oldText = button.Text
    button.Text = text
    task.wait(delay or 1.5)
    if button.Text == text then
        button.Text = oldText
    end
end

