local function isRemote(obj)
    return obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction")
end

local function refreshRemotes()
    for r, e in pairs(remoteEntries) do
        if e.frame and e.frame.Parent then e.frame:Destroy() end
    end
    remoteEntries = {}
    selectedRemotes = {}
    local locations = {workspace, ReplicatedStorage, LocalPlayer, Lighting}
    for _, loc in ipairs(locations) do
        local ok, desc = pcall(function() return loc:GetDescendants() end)
        if ok then
            for _, obj in ipairs(desc) do
                if isRemote(obj) then
                    makeRemoteEntry(obj)
                end
            end
        end
    end
    applyRemoteFilter()
end

