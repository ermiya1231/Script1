-- Execute On Others
ExecOthersButton.MouseButton1Click:Connect(function()
	if isExecuting then
		return
	end

	isExecuting = true
	ExecOthersButton.Text = "Firing Remotes..."

	task.spawn(function()
		local remotes = getRemotes()

		for _, player in ipairs(Players:GetPlayers()) do
			if player ~= LocalPlayer then
				for _, remote in ipairs(remotes) do
					pcall(function()
						if remote:IsA("RemoteEvent") then
							remote:FireServer(player)
							remote:FireServer(player.Name)
							if player.Character then
								remote:FireServer(player.Character)
							end
						elseif remote:IsA("RemoteFunction") then
							task.spawn(function()
								pcall(function()
									remote:InvokeServer(player)
									remote:InvokeServer(player.Name)
								end)
							end)
						end
					end)
				end
			end
		end
	end)

	task.wait(1)
	ExecOthersButton.Text = "Done!"
	task.wait(1.5)
	ExecOthersButton.Text = "Execute On Others"
	isExecuting = false
end)
