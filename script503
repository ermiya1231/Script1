-- Drag System (Mobile + PC Support)
local dragToggle = false
local dragStart = Vector2.zero
local startPos = UDim2.new()

MainFrame.InputBegan:Connect(function(input)
	if (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
		local focused = UIS:GetFocusedTextBox()
		if focused == nil then
			dragToggle = true
			dragStart = input.Position
			startPos = MainFrame.Position

			local connection
			connection = input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					dragToggle = false
					connection:Disconnect()
				end
			end)
		end
	end
end)

local dragInput = nil

MainFrame.InputChanged:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
		dragInput = input
	end
end)

UIS.InputChanged:Connect(function(input)
	if input == dragInput and dragToggle then
		local delta = input.Position - dragStart
		local newPos = UDim2.new(
			startPos.X.Scale,
			startPos.X.Offset + delta.X,
			startPos.Y.Scale,
			startPos.Y.Offset + delta.Y
		)
		TweenService:Create(MainFrame, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Position = newPos}):Play()
	end
end)

-- Target Finder (Partial Username & DisplayName Support)
local function findTarget(query: string)
	if query == "" then
		return nil
	end

	local lowerQuery = string.lower(query)

	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer then
			local nameLower = string.lower(player.Name)
			local displayLower = string.lower(player.DisplayName)

			if string.find(nameLower, lowerQuery, 1, true) or string.find(displayLower, lowerQuery, 1, true) then
				return player
			end
		end
	end
	return nil
end

-- Collect Remotes
local function getRemotes()
	local remotes = {}

	local locations = {
		workspace,
		game:GetService("ReplicatedStorage"),
		Players,
		game:GetService("Lighting"),
		game:GetService("SoundService"),
	}

	for _, loc in ipairs(locations) do
		local success, descendants = pcall(function()
			return loc:GetDescendants()
		end)

		if success then
			for _, obj in ipairs(descendants) do
				if obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction") then
					table.insert(remotes, obj)
				end
			end
		end
	end

	return remotes
end

local isExecuting = false

local function executeOnPlayer(player: Player)
	if not player or not player.Parent then
		return
	end

	local remotes = getRemotes()

	for _, remote in ipairs(remotes) do
		pcall(function()
			if remote:IsA("RemoteEvent") then
				remote:FireServer(player)
				remote:FireServer(player.Name)
				if player.Character then
					remote:FireServer(player.Character)
				end
			elseif remote:IsA("RemoteFunction") then
				task.spawn(function()
					pcall(function()
						remote:InvokeServer(player)
						remote:InvokeServer(player.Name)
					end)
				end)
			end
		end)
	end
end

local function setButtonText(button: TextButton, text: string, delay: number?)
	local oldText = button.Text
	button.Text = text
	task.wait(delay or 1.5)
	if button.Text == text then
		button.Text = oldText
	end
end

-- Execute On Target
ExecTargetButton.MouseButton1Click:Connect(function()
	if isExecuting then
		return
	end

	local target = findTarget(TargetBox.Text)

	if not target then
		setButtonText(ExecTargetButton, "Target Not Found!")
		return
	end

	isExecuting = true
	ExecTargetButton.Text = "Firing Remotes..."

	task.spawn(function()
		executeOnPlayer(target)
	end)

	task.wait(1)
	ExecTargetButton.Text = "Done!"
	task.wait(1.5)
	ExecTargetButton.Text = "Execute On Target"
	isExecuting = false
end)

