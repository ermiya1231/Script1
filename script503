local function applyRemoteFilter()
    local q = string.lower(SearchBox.Text)
    for remote, entry in pairs(remoteEntries) do
        local visible = true
        if q ~= "" then
            if not (string.find(string.lower(entry.name), q, 1, true) or string.find(string.lower(entry.path), q, 1, true)) then
                visible = false
            end
        end
        if entry.frame and entry.frame.Parent then
            entry.frame.Visible = visible
        end
    end
end

SearchBox:GetPropertyChangedSignal("Text"):Connect(applyRemoteFilter)

