local function rebuildPrimaryList()
    for _, b in pairs(primaryButtons) do
        if b and b.Parent then b:Destroy() end
    end
    primaryButtons = {}
    for _, key in ipairs(argList) do
        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(1, -6, 0, 26)
        btn.Text = argLabels[key] or key
        btn.BackgroundColor3 = (key == selectedPrimary) and Color3.fromRGB(60,120,200) or Color3.fromRGB(50,50,55)
        btn.TextColor3 = Color3.fromRGB(255,255,255)
        btn.Font = Enum.Font.SourceSans
        btn.TextSize = 12
        btn.AutoButtonColor = true
        btn.Parent = PrimaryList
        primaryButtons[key] = btn
        btn.MouseButton1Click:Connect(function()
            if selectedPrimary == key then
                selectedPrimary = nil
            else
                selectedPrimary = key
            end
            rebuildPrimaryList()
        end)
    end
end

local function rebuildSecondaryList()
    for _, b in pairs(secondaryButtons) do
        if b and b.Parent then b:Destroy() end
    end
    secondaryButtons = {}
    for _, val in ipairs(argList) do
