local isDodging = false
local autoEnabled = false
local PROXIMITY_DISTANCE = 2

-- فانکشن پارت شبح
local function createGhostPart(originalCF)
    local ghostPart = Instance.new("Part")
    ghostPart.Name = "AntiBangGhost"
    ghostPart.Size = Vector3.new(2, 2, 1)
    ghostPart.CFrame = originalCF
    ghostPart.Anchored = true
    ghostPart.CanCollide = false
    ghostPart.Transparency = 0.6
    ghostPart.Color = Color3.fromRGB(163, 162, 165)
    ghostPart.Material = Enum.Material.Plastic
    ghostPart.TopSurface = Enum.SurfaceType.Studs
    ghostPart.BottomSurface = Enum.SurfaceType.Inlet
    ghostPart.Parent = workspace
    return ghostPart
end

-- تابع عادی
local function performAntiBang()
    if isDodging then return end
    if player.Character and player.Character:FindFirstChild("HumanoidRootPart") and player.Character:FindFirstChild("Humanoid") then
        isDodging = true
        local root = player.Character.HumanoidRootPart
        local humanoid = player.Character.Humanoid
        local originalCF = root.CFrame
        
        local ghostPart = createGhostPart(originalCF)
        local cam = workspace.CurrentCamera
        cam.CameraSubject = ghostPart
        
        root.CFrame = originalCF * CFrame.new(0, -551, 0)
        task.wait(0.4)
        
        if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
            player.Character.HumanoidRootPart.CFrame = originalCF
        end
        
        cam.CameraSubject = humanoid
        ghostPart:Destroy()
        
        task.wait(1.5)
        isDodging = false
    end
end

-- تابع Strong Anti Bang (15 ثانیه خروج مستقیم با سرعت 100 هزار استود!)
local function performStrongAntiBang()
    if isDodging then return end
    isDodging = true
    
    -- اجرای کد بای‌پس NetworkPause با نوتیفیکیشن
    local function notify(title, text)
        pcall(function()
            game:GetService("StarterGui"):SetCore("SendNotification", {
                Title = title,
                Text = text,
                Duration = 5
            })
        end)
    end

    local CoreGui = game:GetService("CoreGui")
    if getgenv().networkPaused then
        pcall(function() getgenv().networkPaused:Disconnect() end)
    end
    getgenv().networkPaused = CoreGui.RobloxGui.ChildAdded:Connect(function(obj)
        if obj.Name == "CoreScripts/NetworkPause" then
            pcall(function() obj:Destroy() end)
        end
    end)
    pcall(function()
        local existingPause = CoreGui.RobloxGui:FindFirstChild("CoreScripts/NetworkPause")
        if existingPause then existingPause:Destroy() end
    end)
    
    notify("AntiGamePlayPaused", "Network Pause Bypassed - Entering Null Zone!")
    -- =========================================

    if player.Character and player.Character:FindFirstChild("HumanoidRootPart") and player.Character:FindFirstChild("Humanoid") then
        local root = player.Character.HumanoidRootPart
        local humanoid = player.Character.Humanoid
        local originalCF = root.CFrame
        
        local ghostPart = createGhostPart(originalCF)
        local cam = workspace.CurrentCamera
        cam.CameraSubject = ghostPart
        
        -- تلپورت به بالا تا به هیچ چیز برخورد نکنیم
        root.CFrame = originalCF * CFrame.new(0, 1000, 0)
        
        -- سرعت ماورایی و دیوانه‌وار برای رسیدن به ته دنیای بازی
        local moveSpeed = 1000000000 -- صد هزار استود در ثانیه!
        local moveConnection
        
        moveConnection = RunService.Heartbeat:Connect(function(deltaTime)
            if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                -- شلیک شدن در خط مستقیم رو به جلو با سرعت فضایی
                player.Character.HumanoidRootPart.CFrame = player.Character.HumanoidRootPart.CFrame * CFrame.new(0, 0, -moveSpeed * deltaTime)
            end
        end)
        
        -- حالا 15 ثانیه توی این حالت میمونه تا قشنگ گلیچ بخوره
        task.wait(10)
        
        -- قطع کردن نیروی حرکت
        if moveConnection then moveConnection:Disconnect() end
        
        -- برگرداندن پلیر به جای اصلی
        if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
            root.Velocity = Vector3.new(0,0,0)
            root.RotVelocity = Vector3.new(0,0,0)
            root.CFrame = originalCF
        end
        
        cam.CameraSubject = humanoid
        ghostPart:Destroy()
    end
    
    isDodging = false
end

