-- متغیرهای کنترل
local isDodging = false
local autoEnabled = false
local PROXIMITY_DISTANCE = 2 -- فاصله‌ای که در آن بازیکنان دیگر تشخیص داده می‌شوند (استود)

-- تابع اصلی Anti Bang با قابلیت شبح (Ghost Part)
local function performAntiBang()
    if isDodging then return end
    if player.Character and player.Character:FindFirstChild("HumanoidRootPart") and player.Character:FindFirstChild("Humanoid") then
        isDodging = true
        local root = player.Character.HumanoidRootPart
        local humanoid = player.Character.Humanoid
        local originalCF = root.CFrame
        
        -- ساخت Part شبح برای موقعیت اصلی
        local ghostPart = Instance.new("Part")
        ghostPart.Name = "AntiBangGhost"
        ghostPart.Size = Vector3.new(2, 2, 1) -- سایز تقریبی بدن
        ghostPart.CFrame = originalCF
        ghostPart.Anchored = true
        ghostPart.CanCollide = false
        ghostPart.Transparency = 0.6
        
        -- تغییرات برای حس کلاسیک
        ghostPart.Color = Color3.fromRGB(163, 162, 165) -- رنگ خاکستری کلاسیک (Medium stone grey)
        ghostPart.Material = Enum.Material.Plastic -- متریال پلاستیک کلاسیک
        ghostPart.TopSurface = Enum.SurfaceType.Studs -- اضافه کردن Stud به سطح بالایی
        ghostPart.BottomSurface = Enum.SurfaceType.Inlet -- اضافه کردن فرورفتگی به سطح پایینی
        
        ghostPart.Parent = workspace
        
        -- قفل کردن دوربین روی پارت شبح
        local cam = workspace.CurrentCamera
        cam.CameraSubject = ghostPart
        
        -- رفتن به وید
        root.CFrame = originalCF * CFrame.new(0, -551, 0)
        
        task.wait(0.4)
        
        -- برگشت به جای قبلی
        if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
            player.Character.HumanoidRootPart.CFrame = originalCF
        end
        
        -- برگرداندن دوربین روی پلیر و پاک کردن پارت شبح
        cam.CameraSubject = humanoid
        ghostPart:Destroy()
        
        -- جلوگیری از تکرار بیش از حد سریع در حالت اتوماتیک
        task.wait(1.5)
        isDodging = false
    end
end

AntiBangBtn.MouseButton1Click:Connect(function()
    task.spawn(performAntiBang)
end)

