    end
end)

-- حلقه پردازش فریم به فریم برای تشخیص بازیکنان نزدیک
RunService.RenderStepped:Connect(function()
    UIGradient_Main.Rotation = UIGradient_Main.Rotation + 3
    
    if autoEnabled and not isDodging then
        if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
            local myRoot = player.Character.HumanoidRootPart
            
            for _, otherPlayer in ipairs(Players:GetPlayers()) do
                if otherPlayer ~= player and otherPlayer.Character and otherPlayer.Character:FindFirstChild("HumanoidRootPart") then
                    local otherRoot = otherPlayer.Character.HumanoidRootPart
                    local distance = (myRoot.Position - otherRoot.Position).Magnitude
                    
                    -- اگر پلیر دیگری نزدیک‌تر از مقدار تعیین شده بود
                    if distance <= PROXIMITY_DISTANCE then
                        task.spawn(performAntiBang)
                        break -- برای جلوگیری از اجرای همزمان چند دستور
                    end
                end
            end
        end
    end
end)

