---------------------------------------------------------
-- منطق آنتی وید و انیمیشن
---------------------------------------------------------
local normalHeight = Workspace.FallenPartsDestroyHeight
local isAntiVoidOn = false
local tweenInfo = TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)

ToggleButton.MouseButton1Click:Connect(function()
    isAntiVoidOn = not isAntiVoidOn
    
    local goalColor
    if isAntiVoidOn then
        Workspace.FallenPartsDestroyHeight = 0
        ToggleButton.Text = "ON"
        goalColor = Color3.fromRGB(75, 255, 115)
    else
        Workspace.FallenPartsDestroyHeight = normalHeight
        ToggleButton.Text = "OFF"
        goalColor = Color3.fromRGB(255, 75, 75)
    end
    
    local colorTween = TweenService:Create(ToggleButton, tweenInfo, {BackgroundColor3 = goalColor})
    colorTween:Play()
end)

---------------------------------------------------------
-- سیستم جابجایی پنل با موس (کد درخواستی شما)
---------------------------------------------------------
local function dragify(Frame)
    local dragToggle = nil
    local dragSpeed = 0.15
    local dragInput = nil
    local dragStart = nil
    local startPos = nil
    
    local function updateInput(input)
        local Delta = input.Position - dragStart
        local Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + Delta.X, startPos.Y.Scale, startPos.Y.Offset + Delta.Y)
        TweenService:Create(Frame, TweenInfo.new(dragSpeed), {Position = Position}):Play()
    end
    
    Frame.InputBegan:Connect(function(input)
        if (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) and UserInputService:GetFocusedTextBox() == nil then
            dragToggle = true
            dragStart = input.Position
            startPos = Frame.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragToggle = false
                end
            end)
        end
    end)
    
    Frame.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)
    
    UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragToggle then
            updateInput(input)
        end
    end)
end

-- اعمال قابلیت درگ روی پنل اصلی
dragify(MainFrame)
