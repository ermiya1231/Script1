-- پیدا کردن پارت های هدف (اگر وجود نداشته باشند نادیده گرفته میشوند)
---------------------------------------------------------
local function getTargets()
    local list = {}
    local ok, island = pcall(function() return Workspace:FindFirstChild("HarborGardenIsland") end)
    if not ok or not island then return list end

    local function add(folderName, partName)
        local folder = island:FindFirstChild(folderName)
        local part = folder and folder:FindFirstChild(partName)
        if part and part:IsA("BasePart") then
            table.insert(list, part)
        end
    end

    add("GrappleObby", "swap part26")
    add("IranTowerObby", "swap part2")
    add("IranTowerObby", "swap part")
    return list
end

-- فعال/غیرفعال کردن CanTouch روی پارت هایی که وجود دارند
local function setTargetsCanTouch(state)
    for _, part in ipairs(getTargets()) do
        pcall(function()
            part.CanTouch = state
        end)
    end
end

---------------------------------------------------------
-- منطق آنتی وید و انیمیشن
---------------------------------------------------------
local normalHeight = Workspace.FallenPartsDestroyHeight
local isAntiVoidOn = false
local tweenInfo = TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.Out)

ToggleButton.MouseButton1Click:Connect(function()
    isAntiVoidOn = not isAntiVoidOn

    local goalColor
    if isAntiVoidOn then
        Workspace.FallenPartsDestroyHeight = 0/0
        setTargetsCanTouch(false) -- روشن: CanTouch غیرفعال
        ToggleButton.Text = "ON"
        goalColor = Color3.fromRGB(75, 255, 115)
    else
        Workspace.FallenPartsDestroyHeight = normalHeight
        setTargetsCanTouch(true) -- خاموش: CanTouch فعال
        ToggleButton.Text = "OFF"
        goalColor = Color3.fromRGB(255, 75, 75)
    end

    local colorTween = TweenService:Create(ToggleButton, tweenInfo, {BackgroundColor3 = goalColor})
    colorTween:Play()
end)

---------------------------------------------------------
-- سیستم جابجایی پنل با موس
---------------------------------------------------------
local function dragify(Frame)
    local dragToggle = nil
    local dragSpeed = 0.15
    local dragInput = nil
    local dragStart = nil
    local startPos = nil

    local function updateInput(input)
        local Delta = input.Position - dragStart
        local Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + Delta.X, startPos.Y.Scale, startPos.Y.Offset + Delta.Y)
        TweenService:Create(Frame, TweenInfo.new(dragSpeed), {Position = Position}):Play()
    end

    Frame.InputBegan:Connect(function(input)
        if (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) and UserInputService:GetFocusedTextBox() == nil then
            dragToggle = true
            dragStart = input.Position
            startPos = Frame.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragToggle = false
                end
            end)
        end
    end)

    Frame.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)

    UserInputService.InputChanged:Connect(function(input)
        if input == dragInput and dragToggle then
            updateInput(input)
        end
    end)
end

dragify(MainFrame)
