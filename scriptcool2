-- GOD Anti-Void + Smooth Camera Stabilizer
-- Platform: PC & Mobile Compatible
-- Features: Anti-LoopTP, Camera Motion-Sickness Guard, FallenParts Height Override

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local LocalPlayer = Players.LocalPlayer
local Character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
local Humanoid = Character:WaitForChild("Humanoid")
local RootPart = Character:WaitForChild("HumanoidRootPart")
local Camera = Workspace.CurrentCamera

local AntiVoidEnabled = false
local LastSafeCFrame = RootPart.CFrame
local SafetyPlatform = nil
local IsRescuing = false

-- Dynamic Camera Tracker
Workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
    Camera = Workspace.CurrentCamera
end)

local OriginalDestroyHeight = Workspace.FallenPartsDestroyHeight
local SafeVoidLevel = -100

-- Re-bind on Respawn
LocalPlayer.CharacterAdded:Connect(function(newChar)
    Character = newChar
    Humanoid = Character:WaitForChild("Humanoid")
    RootPart = Character:WaitForChild("HumanoidRootPart")
    IsRescuing = false
    task.wait(0.5)
    if RootPart then
        LastSafeCFrame = RootPart.CFrame
        SetupCFrameHook()
    end
end)

----------------------------------------------------
-- Platform & Barrier System
----------------------------------------------------
local function CreatePlatform()
    if SafetyPlatform and SafetyPlatform.Parent then return end
    SafetyPlatform = Instance.new("Part")
    SafetyPlatform.Name = "GodVoidShieldPlatform"
    SafetyPlatform.Size = Vector3.new(3000, 10, 3000)
    SafetyPlatform.Anchored = true
    SafetyPlatform.CanCollide = true
    SafetyPlatform.Transparency = 0.5
    SafetyPlatform.Material = Enum.Material.ForceField
    SafetyPlatform.Color = Color3.fromRGB(255, 0, 50)
    SafetyPlatform.Parent = Workspace
end

local function DestroyPlatform()
    if SafetyPlatform then
        SafetyPlatform:Destroy()
        SafetyPlatform = nil
    end
end

----------------------------------------------------
-- Smooth Camera Guard (ثبت ارتفاع دوربین)
----------------------------------------------------
RunService:BindToRenderStep("GodAntiVoidCameraGuard", Enum.RenderPriority.Camera.Value + 1, function()
    if not AntiVoidEnabled or not RootPart or not Camera then return end
    
    local minCamY = SafeVoidLevel + 25
    local currentCamCF = Camera.CFrame
    
    -- اگر تلپورت ناگهانی رخ داد و دوربین خواست وارد وید بشه، ارتفاعش رو بالا نگه‌می‌داره
    if currentCamCF.Position.Y < minCamY or IsRescuing then
        local lookVector = currentCamCF.LookVector
        local clampedCamPos = Vector3.new(currentCamCF.Position.X, math.max(currentCamCF.Position.Y, minCamY), currentCamCF.Position.Z)
        Camera.CFrame = CFrame.new(clampedCamPos, clampedCamPos + lookVector)
    end
end)

----------------------------------------------------
-- Anti-LoopTP & Instant Rescue System
----------------------------------------------------
local function RescuePlayer()
    if IsRescuing then return end
    IsRescuing = true
    
    -- صفر کردن اینرسی حرکت
    RootPart.AssemblyLinearVelocity = Vector3.zero
    RootPart.AssemblyAngularVelocity = Vector3.zero
    
    -- شکستن اتصالات و Sit
    if Humanoid.Sit then
        Humanoid.Sit = false
        Humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
    end
    for _, obj in pairs(Character:GetDescendants()) do
        if obj:IsA("Weld") or obj:IsA("WeldConstraint") then
            obj:Destroy()
        end
    end
    
    -- بازگرداندن نرم به موقعیت امن
    if LastSafeCFrame then
        RootPart.CFrame = LastSafeCFrame + Vector3.new(0, 10, 0)
    else
        RootPart.CFrame = CFrame.new(RootPart.Position.X, OriginalDestroyHeight + 100, RootPart.Position.Z)
    end
    
    task.wait(0.15)
    IsRescuing = false
end

local function SetupCFrameHook()
    RootPart:GetPropertyChangedSignal("CFrame"):Connect(function()
        if not AntiVoidEnabled or IsRescuing then return end
        if RootPart.Position.Y <= SafeVoidLevel then
            RescuePlayer()
        end
    end)
end
SetupCFrameHook()

RunService.Stepped:Connect(function()
    if not AntiVoidEnabled or not RootPart or not Humanoid then return end
    
    -- تنظیم پلتفرم در زیر پای پلیر
    if SafetyPlatform and SafetyPlatform.Parent then
        SafetyPlatform.Position = Vector3.new(RootPart.Position.X, SafeVoidLevel - 5, RootPart.Position.Z)
    end
    
    -- ذخیره آخرین موقعیت امن روی زمین
    if Humanoid.FloorMaterial ~= Enum.Material.Air and RootPart.Position.Y > SafeVoidLevel + 20 and not Humanoid.Sit then
        LastSafeCFrame = RootPart.CFrame
    end
    
    -- چک کردن سقوط
    if RootPart.Position.Y <= SafeVoidLevel + 10 then
        RescuePlayer()
    end
end)

----------------------------------------------------
-- GUI Creation (PC & Mobile Support)
----------------------------------------------------
