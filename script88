-- ۴. اولویت آخر: آنفریز کردن شما، اجرای لیست دستورات و ری‌اسپاون
local function FinalRespawn(commandsList)
    print("مرحله نهایی: آنفریز کردن شما و ارسال دستورات...")
    if Player.Character and Player.Character:FindFirstChild("HumanoidRootPart") then
        Player.Character.HumanoidRootPart.Anchored = false
    end
    
    local hd = ReplicatedStorage:FindFirstChild("HDAdminHDClient")
    local legacyChat = ReplicatedStorage:FindFirstChild("DefaultChatSystemChatEvents")
    local textChatService = game:GetService("TextChatService")
    
    if commandsList and #commandsList > 0 then
        for _, item in ipairs(commandsList) do
            -- اگر آیتم یک عدد بود، به همون اندازه صبر کن
            if type(item) == "number" then
                task.wait(item)
            
            -- اگر آیتم متن بود، اون رو به عنوان کامند بفرست
            elseif type(item) == "string" and item ~= "" then
                if hd and hd:FindFirstChild("Signals") then
                    local fireCmd = hd.Signals:FindFirstChild("RequestCommandSilent") or hd.Signals:FindFirstChild("RequestCommand")
                    if fireCmd then fireCmd:InvokeServer(item) end
                end
                
                pcall(function()
                    if legacyChat and legacyChat:FindFirstChild("SayMessageRequest") then
                        legacyChat.SayMessageRequest:FireServer(item, "All")
                    else
                        textChatService.TextChannels.RBXGeneral:SendAsync(item)
                    end
                end)
                task.wait(0.2) -- یک مکث خیلی کوتاه پیش‌فرض برای اینکه چت قاطی نکنه
            end
        end
    end
    
    -- ری‌اسپاون همگانی بعد از اتمام همه کامندها
    if hd and hd:FindFirstChild("Signals") then
        local fireCmd = hd.Signals:FindFirstChild("RequestCommandSilent") or hd.Signals:FindFirstChild("RequestCommand")
        if fireCmd then fireCmd:InvokeServer("") end
    end
    
    pcall(function()
        if legacyChat and legacyChat:FindFirstChild("SayMessageRequest") then
            legacyChat.SayMessageRequest:FireServer("", "All")
        else
            textChatService.TextChannels.RBXGeneral:SendAsync("")
        end
    end)
    
    tool.Parent = Player:FindFirstChild("Backpack") or ReplicatedStorage
    print("تمام! مپ لود شد و کامندها با زمان‌بندی دقیق اجرا شدند.")
end

