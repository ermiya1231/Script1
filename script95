----------------------------------------------------------------
-- Remote tracking
----------------------------------------------------------------
local SelectedRemote = nil
local remoteList = {}
local remoteSet = {}
local buttons = {}
local dirty = true

local hidden = {}
local hiddenCount = 0

local function addRemote(v)
    if remoteSet[v] or hidden[v] then return end
    if not (v:IsA("RemoteEvent") and v.Name == REMOTE) then return end

    if isBlacklistedRemote(v) then
        hidden[v] = true
        hiddenCount += 1
        print("[MusicPlayer] hidden:", v:GetFullName())
        dirty = true
        return
    end

    remoteSet[v] = true
    table.insert(remoteList, v)
    print("[MusicPlayer] found:", v:GetFullName())
    dirty = true
end

local function removeRemote(v)
    if hidden[v] then
        hidden[v] = nil
        hiddenCount -= 1
        dirty = true
    end
    if not remoteSet[v] then return end
    remoteSet[v] = nil
    local i = table.find(remoteList, v)
    if i then table.remove(remoteList, i) end
    if SelectedRemote == v then SelectedRemote = nil end
    dirty = true
end

-- DescendantRemoving قبل از جابه‌جایی صدا زده میشه؛ پس بعدش دوباره چک می‌کنیم
-- (مثلاً وقتی Tool از Backpack به Character میره، ریموت نباید از لیست پاک بشه)
local function onRemoving(v)
    if not (remoteSet[v] or hidden[v]) then return end
    task.defer(function()
        if v:IsDescendantOf(g) then
            if not remoteSet[v] and not hidden[v] then
                addRemote(v)
            end
        else
            removeRemote(v)
        end
    end)
end

local function paintButtons()
    for remote, btn in pairs(buttons) do
        local selected = (remote == SelectedRemote)
        btn.BackgroundColor3 = selected and THEME.good or THEME.item
        btn.TextColor3 = selected and Color3.new(0, 0, 0) or THEME.text
    end
    local sel = SelectedRemote
        and (SelectedRemote.Parent and SelectedRemote.Parent.Name or "?")
        or "none"
    statusLabel.Text = ("Selected: %s  |  Found: %d  Hidden: %d"):format(sel, #remoteList, hiddenCount)
end

local function rebuildList()
    for _, btn in pairs(buttons) do btn:Destroy() end
    table.clear(buttons)

    emptyLabel.Visible = (#remoteList == 0)

    for i, remote in ipairs(remoteList) do
        local btnName = remote.Parent and remote.Parent.Name or "Unknown"
        local rBtn = create("TextButton", {
            Size = UDim2.new(1, 0, 0, 30),
            BackgroundColor3 = THEME.item,
            TextColor3 = THEME.text,
            Text = btnName .. " (" .. i .. ")",
            FontFace = FONT,
            TextSize = 14,
            TextTruncate = Enum.TextTruncate.AtEnd,
            BorderSizePixel = 0,
            LayoutOrder = i,
            corner(7),
        }, remoteListFrame)

        rBtn.Activated:Connect(function()
            playClick()
            SelectedRemote = remote
            paintButtons()
            notify("Selected", btnName, 2)
        end)

        buttons[remote] = rBtn
    end
    paintButtons()
end

-- اسکن کامل کل بازی (تکه‌تکه تا فریز نشه)
local scanning = false
local function fullScan()
    if scanning then return end
    scanning = true
    local ok, err = pcall(function()
        local n = 0
        for _, v in ipairs(g:GetDescendants()) do
            addRemote(v)
            n += 1
            if n % 2000 == 0 then task.wait() end
        end
    end)
    scanning = false
    if not ok then
        warn("[MusicPlayer] scan error:", err)
    end
end

-- رویدادها روی کل game
g.DescendantAdded:Connect(addRemote)
g.DescendantRemoving:Connect(onRemoving)
task.spawn(fullScan)

local rescanning = false
rescanButton.Activated:Connect(function()
    playClick()
    if rescanning then return end
    rescanning = true
    rescanButton.Text = "..."

    task.spawn(function()
        local waited = 0
        while scanning and waited < 5 do
            waited += task.wait()
        end

        local keep = SelectedRemote
        table.clear(remoteList)
        table.clear(remoteSet)
        table.clear(hidden)
        hiddenCount = 0
        SelectedRemote = nil

        scanning = false
        fullScan()

        if keep and remoteSet[keep] then
            SelectedRemote = keep
        end
        dirty = true

        rescanButton.Text = "Refresh"
        rescanning = false
        notify("Info", "Rescanned: " .. #remoteList .. " remotes", 2)
    end)
end)

-- حلقه‌ی اصلی: اسکن دوره‌ای + حذف ریموت‌های مرده + بازسازی لیست
task.spawn(function()
    local t = 0
    while gui.Parent do
        t += 1
        if t % 10 == 0 and main.Visible and not rescanning then
            task.spawn(fullScan)
        end
        if t % 4 == 0 then
            for i = #remoteList, 1, -1 do
                local r = remoteList[i]
                if not r:IsDescendantOf(g) then
                    removeRemote(r)
                else
                    local b = buttons[r]
                    local expected = (r.Parent and r.Parent.Name or "Unknown") .. " (" .. i .. ")"
                    if not b or b.Text ~= expected then
                        dirty = true
                    end
                end
            end
        end

        if dirty then
            dirty = false
            local ok, err = pcall(rebuildList)
            if not ok then
                warn("[MusicPlayer] rebuildList error:", err)
            end
        end
        task.wait(0.5)
    end
end)

