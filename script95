----------------------------------------------------------------
-- Play logic (با توقف صدای قبلی)
----------------------------------------------------------------
-- دستورهای احتمالی توقف (حدسی؛ اگه بازی اسم دیگه‌ای داره اینجا اضافه کن)
local STOP_COMMANDS = { "stopSound", "removeSound", "destroySound", "deleteSound" }
local lastSound = {} -- [remote] = اسم آخرین صدا

local function stopPrevious(remote)
    local prev = lastSound[remote]
    if not prev then return end
    for _, cmd in ipairs(STOP_COMMANDS) do
        pcall(function()
            remote:FireServer(cmd, prev)
        end)
    end
end

local function firesound(remote, assetId, pitch, volume, looped)
    stopPrevious(remote)
    local name = RandomName()
    lastSound[remote] = name
    remote:FireServer("newSound", name, INJECT, assetId, pitch, volume, looped)
    remote:FireServer("playSound", name)
end

playButton.Activated:Connect(function()
    if not SelectedRemote or not SelectedRemote:IsDescendantOf(g) then
        OhNo:Play()
        return notify("Error", "Select remote first!", 4)
    end

    local success = pcall(
        firesound,
        SelectedRemote,
        formatAssetId(textBox.Text),
        toNumber(pitchBox.Text, 1),
        toNumber(volumeBox.Text, 1),
        loopState
    )

    if not success then
        OhNo:Play()
        return notify("Error", "Failed!", 4)
    end

    playClick()
    notify("Info", "Executed!", 3)
end)
