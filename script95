-- ریموت‌هایی که باید نادیده گرفته بشن
local BLACKLIST = { "AC6_Stock_Sound" }

local function isBlacklisted(name)
    local low = name:lower()
    for _, bad in ipairs(BLACKLIST) do
        if low:find(bad:lower(), 1, true) then
            return true
        end
    end
    return false
end

local function isBlacklistedRemote(remote)
    if isBlacklisted(remote.Name) then
        return true
    end
    local parent = remote.Parent
    return parent ~= nil and isBlacklisted(parent.Name)
end

