local function RefreshRemotesList()
    for _, btn in ipairs(listButtons) do
        btn:Destroy()
    end
    listButtons = {}
    
    local allRemotes = getAllRemotes()
    
    if #allRemotes == 0 then
        notify("Warning", "No AC6 Remotes found!", 5)
        return
    end

    for i, remote in ipairs(allRemotes) do
        local btnName = remote.Parent and remote.Parent.Name or "Unknown"
        local rBtn = create("TextButton", {
            Size = Udim2(0.9, 0, 0, 30),
            BackgroundColor3 = Color(0.2, 0.2, 0.2),
            TextColor3 = Color(1, 1, 1),
            Text = btnName .. " (" .. i .. ")",
            FontFace = font,
            TextSize = 14,
            TextScaled = true,
            create("UICorner", ref)
        }, remoteListFrame)

        rBtn.Activated:Connect(function()
            Click:Play()
            SelectedRemote = remote
            
            for _, b in ipairs(listButtons) do
                b.BackgroundColor3 = Color(0.2, 0.2, 0.2)
            end
            rBtn.BackgroundColor3 = Color(0, 0.8, 0)
            
            notify("Selected", btnName, 2)
        end)
        
        table.insert(listButtons, rBtn)
    end
    
    remoteListFrame.CanvasSize = UDim2.new(0, 0, 0, #allRemotes * 35)
end

