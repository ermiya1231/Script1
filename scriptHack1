local function interactWithTarget(targetObj)
    local char = player.Character
    if not char then return false end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local actionTaken = false

    local clickDetector = targetObj:IsA("ClickDetector") and targetObj or targetObj:FindFirstChildWhichIsA("ClickDetector")
    local touchTransmitter = targetObj:IsA("TouchTransmitter") and targetObj or targetObj:FindFirstChildWhichIsA("TouchTransmitter")
    local proximityPrompt = targetObj:IsA("ProximityPrompt") and targetObj or targetObj:FindFirstChildWhichIsA("ProximityPrompt")

    if clickDetector and fireclickdetector then
        fireclickdetector(clickDetector)
        actionTaken = true
    elseif proximityPrompt and fireproximityprompt then
        fireproximityprompt(proximityPrompt)
        actionTaken = true
    elseif touchTransmitter and hrp then
        local parentPart = touchTransmitter.Parent or targetObj
        if parentPart:IsA("BasePart") then
            if firetouchinterest then
                firetouchinterest(hrp, parentPart, 0)
                task.wait(0.025) -- سرعت تاچ ۲ برابر شد (۰.۰۵ به ۰.۰۲۵)
                firetouchinterest(hrp, parentPart, 1)
                actionTaken = true
            else
                parentPart.CFrame = hrp.CFrame
                actionTaken = true
            end
        end
    end
    
    return actionTaken
end

-- ================== هوش مصنوعی حل ریاضی ==================
local function solveMathExpression(exprText)
    local cleaned = exprText:gsub("%?", ""):gsub(" ", ""):gsub("=", "")
    local leftNum, op, rightNum = cleaned:match("(%d+)([+%-%*/])(%d+)")
    
    if leftNum and op and rightNum then
        local n1 = tonumber(leftNum)
        local n2 = tonumber(rightNum)
        if op == "+" then return n1 + n2 end
        if op == "-" then return n1 - n2 end
        if op == "*" then return n1 * n2 end
        if op == "/" then return n2 ~= 0 and n1 / n2 or 0 end
    end
    
    local func, err = loadstring("return " .. cleaned)
    if func then
        local success, res = pcall(func)
        if success and type(res) == "number" then
            return math.floor(res)
        end
    end
    return nil
end

