-- متغیرها
local isEnabled = false
local activeHighlights = {}

-- پاکسازی ESPها
local function clearESP()
    for _, hl in pairs(activeHighlights) do
        if hl and hl.Parent then
            hl:Destroy()
        end
    end
    table.clear(activeHighlights)
    StatusLabel.Text = "تعداد: 0"
end

-- به‌روزرسانی و اعمال ESP
local function updateESP()
    if not isEnabled then return end
    
    local currentParts = {}
    local count = 0
    
    -- گرفتن لیست کاراکتر تمام پلیرهای داخل بازی برای فیلتر کردن
    local playerCharacters = {}
    for _, player in ipairs(Players:GetPlayers()) do
        if player.Character then
            playerCharacters[player.Character] = true
        end
    end

    for _, item in ipairs(Workspace:GetDescendants()) do
        if item:IsA("BasePart") and not item.Anchored and not (item.AssemblyRootPart and item.AssemblyRootPart.Anchored) then
            
            -- بررسی سریع اینکه آیا این پارت مال هیچ پلیری هست یا نه
            local isPlayerPart = false
            local ancestor = item.Parent
            while ancestor and ancestor ~= Workspace do
                if playerCharacters[ancestor] then
                    isPlayerPart = true
                    break
                end
                ancestor = ancestor.Parent
            end

            -- اگر پارت مال پلیرها نبود، ESP را اعمال کن
            if not isPlayerPart then
                currentParts[item] = true
                count = count + 1
                
                if not activeHighlights[item] then
                    local hl = Instance.new("Highlight")
                    hl.Name = "MaxBright_Unanchored_ESP"
                    hl.Adornee = item
                    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                    
                    hl.FillColor = Color3.fromRGB(255, 255, 0)
                    hl.FillTransparency = 0.15
                    hl.OutlineColor = Color3.fromRGB(255, 255, 255)
                    hl.OutlineTransparency = 0
                    
                    hl.Parent = item 
                    activeHighlights[item] = hl
                end
            end
        end
    end

    -- حذف از قطعات پاک شده، انکور شده یا مال پلیرها
    for part, hl in pairs(activeHighlights) do
        if not currentParts[part] or not part.Parent then
            if hl then hl:Destroy() end
            activeHighlights[part] = nil
        end
    end

    StatusLabel.Text = "تعداد: " .. tostring(count)
end

-- عملکرد کلیک
ToggleButton.MouseButton1Click:Connect(function()
    isEnabled = not isEnabled
    
    if isEnabled then
        ToggleButton.BackgroundColor3 = Color3.fromRGB(45, 180, 85)
        ToggleButton.Text = "ESP: ON"
        updateESP()
    else
        ToggleButton.BackgroundColor3 = Color3.fromRGB(180, 45, 45)
        ToggleButton.Text = "ESP: OFF"
        clearESP()
    end
end)

task.spawn(function()
    while true do
        task.wait(1)
        if isEnabled then
            updateESP()
        end
    end
end)
