-- سیستم Drag نرم
local dragging, dragInput, dragStart, startPos
Title.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = MainFrame.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then dragging = false end
        end)
    end
end)
Title.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then dragInput = input end
end)
UserInputService.InputChanged:Connect(function(input)
    if input == dragInput and dragging then
        local delta = input.Position - dragStart
        TweenService:Create(MainFrame, TweenInfo.new(0.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)}):Play()
    end
end)

-------------------------------------------------------------------------
-- 2. توابع اسکنر و سیستم مانیتورینگ Anchored
-------------------------------------------------------------------------
local espFolder = Instance.new("Folder")
espFolder.Name = "LiveNetworkESP"
espFolder.Parent = ScreenGui

local function isPlayerCharacter(instance)
    for _, player in ipairs(Players:GetPlayers()) do
        if player.Character and instance:IsDescendantOf(player.Character) then return true end
    end
    return false
end

local function isEffectivelyAnchored(part)
    if part.Anchored then return true end
    local root = part.AssemblyRootPart
    if root and root.Anchored then return true end
    return false
end

local function checkOwnership(part)
    if type(isnetworkowner) == "function" then return isnetworkowner(part) end
    return part.ReceiveAge == 0
end

local function addESP(part)
    if not espEnabled then return end
    if not part:IsA("BasePart") then return end
    if isEffectivelyAnchored(part) then return end
    if isPlayerCharacter(part) then return end
    if trackedParts[part] then return end

    local highlight = Instance.new("Highlight")
    highlight.Adornee = part
    highlight.FillTransparency = 0.5
    highlight.OutlineTransparency = 0.1
    highlight.Parent = espFolder
    
    local tracer = nil
    if Drawing then
        tracer = Drawing.new("Line")
        tracer.Visible = false
        tracer.Thickness = 1.5
        tracer.Transparency = 0.7
    end
    
    trackedParts[part] = { Highlight = highlight, Tracer = tracer }
    trackerCount += 1
    StatusLabel.Text = "Tracking: " .. tostring(trackerCount) .. " Parts"
end

-- سیستم هوشمند مانیتورینگ تغییر وضعیت پارت‌ها
local function monitorPart(part)
    if not part:IsA("BasePart") then return end
    
    -- جلوگیری از لگ با اطمینان از اینکه به هر پارت فقط یکبار ایونت وصل می‌شود
    if part:GetAttribute("ESP_Hooked") then
        if espEnabled then addESP(part) end
        return 
    end
    part:SetAttribute("ESP_Hooked", true)
    
    -- این بخش کلیدی است: گوش دادن به لحظه‌ای که پارت Unanchored می‌شود
    part:GetPropertyChangedSignal("Anchored"):Connect(function()
        if espEnabled and not isEffectivelyAnchored(part) then
            addESP(part)
        end
    end)
    
    -- چک کردن اولیه برای زمانی که اسکن اجرا می‌شود
    if espEnabled then addESP(part) end
end

local function clearESP()
    for part, data in pairs(trackedParts) do
        data.Highlight:Destroy()
        if data.Tracer then data.Tracer:Remove() end
    end
    table.clear(trackedParts)
    trackerCount = 0
    StatusLabel.Text = "Tracking: 0 Parts"
end

local function initialScan()
    local count = 0
    -- وقتی دکمه رو میزنید تمام مپ رو فقط اسکن نمیکنه، بلکه مانیتور هم میکنه
    for _, obj in ipairs(workspace:GetDescendants()) do
        if not espEnabled then break end
        monitorPart(obj)
        count += 1
        if count % 300 == 0 then task.wait() end 
    end
end

