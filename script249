-- وقتی پارت جدیدی ساخته می‌شود (حتی اگر ESP خاموش باشد) به آن شنونده وصل می‌کند تا آماده باشد
workspace.DescendantAdded:Connect(function(obj)
    task.defer(function() monitorPart(obj) end)
end)

-- اسکن اولیه تمام پارت‌هایی که از قبل در مپ بوده‌اند برای مانیتورینگ آماده‌باش
task.spawn(function()
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") then
            monitorPart(obj)
        end
    end
end)

RunService.Heartbeat:Connect(function()
    if not espEnabled then return end
    
    local screenSize = Camera.ViewportSize
    local originPos = Vector2.new(screenSize.X / 2, screenSize.Y)
    
    for part, data in pairs(trackedParts) do
        local highlight = data.Highlight
        local tracer = data.Tracer
        
        -- اگر پارت در حین بازی Anchored شد، ESP آن خاموش می‌شود
        if not part or not part.Parent or isEffectivelyAnchored(part) then
            highlight:Destroy()
            if tracer then tracer:Remove() end
            trackedParts[part] = nil
            trackerCount -= 1
            StatusLabel.Text = "Tracking: " .. tostring(trackerCount) .. " Parts"
            continue
        end
        
        local isOwned = checkOwnership(part)
        local targetColor
        if isOwned then
            targetColor = Color3.fromRGB(0, 255, 128)
            highlight.FillColor = targetColor
            highlight.OutlineColor = Color3.fromRGB(0, 255, 255)
        else
            targetColor = Color3.fromRGB(255, 20, 20)
            highlight.FillColor = targetColor
            highlight.OutlineColor = Color3.fromRGB(255, 80, 0)
        end
        
        if tracer then
            if tracersEnabled then
                local vector, onScreen = Camera:WorldToViewportPoint(part.Position)
                if onScreen then
                    tracer.From = originPos
                    tracer.To = Vector2.new(vector.X, vector.Y)
                    tracer.Color = targetColor
                    tracer.Visible = true
                else
                    tracer.Visible = false
                end
            else
                tracer.Visible = false
            end
        end
    end
end)
