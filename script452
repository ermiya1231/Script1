-- تنظیمات انیمیشن
local isOn = false
local anim = Instance.new("Animation")
anim.AnimationId = "rbxassetid://215384594"
local loadedAnim = nil

-- عملکرد دکمه
ToggleBtn.MouseButton1Click:Connect(function()
	isOn = not isOn

	local char = player.Character
	if not char then return end

	local hum = char:FindFirstChildOfClass("Humanoid")
	if not hum then return end

	if isOn then
		-- حالت روشن
		ToggleBtn.Text = "ON"
		ToggleBtn.BackgroundColor3 = Color3.fromRGB(50, 220, 50) -- سبز

		local animator = hum:FindFirstChildOfClass("Animator") or hum
		loadedAnim = animator:LoadAnimation(anim)

		loadedAnim:Play()
		loadedAnim:AdjustSpeed(0)
		loadedAnim.TimePosition = 0.50
	else
		-- حالت خاموش
		ToggleBtn.Text = "OFF"
		ToggleBtn.BackgroundColor3 = Color3.fromRGB(220, 50, 50) -- قرمز

		if loadedAnim then
			loadedAnim:Stop()
			loadedAnim = nil
		end
	end
end)
