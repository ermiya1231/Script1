local function GetF3X()

local char = LocalPlayer.Character

local backpack = LocalPlayer:FindFirstChild("Backpack")

local tool = (char and char:FindFirstChild("Building Tools")) or (backpack and backpack:FindFirstChild("Building Tools"))

if tool and tool:FindFirstChild("SyncAPI") and tool.SyncAPI:FindFirstChild("ServerEndpoint") then

return tool.SyncAPI.ServerEndpoint

end

return nil

end



local function MapPartType(part)

if part:IsA("WedgePart") then return "Wedge" end

if part:IsA("CornerWedgePart") then return "Corner" end

if part:IsA("TrussPart") then return "Truss" end

if part:IsA("Part") then

if part.Shape == Enum.PartType.Ball then return "Sphere" end

if part.Shape == Enum.PartType.Cylinder then return "Cylinder" end

end

return "Normal"

end



local function BuildModelAdvanced(assetId, spawnHitPosition)

local endpoint = GetF3X()

if not endpoint then

StatusLabel.Text = "⚠️ F3X Tool not found in your inventory!"

StatusLabel.TextColor3 = Color3.fromRGB(255, 80, 80)

return

end



StatusLabel.Text = "Downloading Asset..."

StatusLabel.TextColor3 = Color3.fromRGB(255, 200, 80)



local rootObject = SafeGetObjects(assetId)


if not rootObject then

StatusLabel.Text = "⚠️ Failed to load asset! (Stuck/Invalid ID)"

StatusLabel.TextColor3 = Color3.fromRGB(255, 80, 80)

return

end



local boundingCFrame, boundingSize = GetContainerBoundingBox(rootObject)

local spawnCFrame = CFrame.new(spawnHitPosition) * CFrame.new(0, boundingSize.Y / 2, 0)



local partsToImport = {}

if rootObject:IsA("BasePart") then table.insert(partsToImport, rootObject) end

for _, child in ipairs(rootObject:GetDescendants()) do

if child:IsA("BasePart") then table.insert(partsToImport, child) end

end



if #partsToImport == 0 then

StatusLabel.Text = "This Model contains no BaseParts."

StatusLabel.TextColor3 = Color3.fromRGB(255, 80, 80)

rootObject:Destroy()

return

end



local baseCFrame = boundingCFrame



StatusLabel.Text = string.format("⚡ Fast Importing %d Parts...", #partsToImport)

StatusLabel.TextColor3 = Color3.fromRGB(100, 255, 130)


local myToken = tick()

currentBuildToken = myToken



task.spawn(function()

local createdPartsMapping = {}

local finalAnchorStates = {}


local MAX_CONCURRENT = 50

local activeThreads = 0

local threadFinished = Instance.new("BindableEvent")


local resizeBatch, colorBatch, matBatch, anchorBatch = {}, {}, {}, {}

local createMeshesBatch, syncMeshBatch = {}, {}



for idx, part in ipairs(partsToImport) do

if currentBuildToken ~= myToken then 

StatusLabel.Text = "Build Cancelled."

StatusLabel.TextColor3 = Color3.fromRGB(255, 100, 100)

rootObject:Destroy()

return 

end


while activeThreads >= MAX_CONCURRENT do

threadFinished.Event:Wait()

end


activeThreads += 1

task.spawn(function()

local targetCFrame = spawnCFrame * baseCFrame:ToObjectSpace(part.CFrame)

local partType = MapPartType(part)


local ok, createdPart = pcall(function()

return endpoint:InvokeServer("CreatePart", partType, targetCFrame, workspace)

end)


if ok and createdPart then

createdPartsMapping[part] = createdPart


table.insert(resizeBatch, { Part = createdPart, CFrame = targetCFrame, Size = part.Size })

table.insert(colorBatch, { Part = createdPart, Color = part.Color })

table.insert(matBatch, { Part = createdPart, Material = part.Material, Transparency = part.Transparency })

table.insert(anchorBatch, { Part = createdPart, Anchored = true })

table.insert(finalAnchorStates, { Part = createdPart, Anchored = part.Anchored })


local cMesh, sMesh = ProcessMeshProperties(part, createdPart)

if cMesh and sMesh then

table.insert(createMeshesBatch, cMesh)

table.insert(syncMeshBatch, sMesh)

end


for _, descendant in ipairs(part:GetChildren()) do

if descendant:IsA("Texture") or descendant:IsA("Decal") or descendant:IsA("SurfaceAppearance") then

pcall(function() descendant:Clone().Parent = createdPart end)

end

end

end


activeThreads -= 1

threadFinished:Fire()

end)


if idx % 15 == 0 then

StatusLabel.Text = string.format("Spawning: %d / %d", idx, #partsToImport)

task.wait()

end

end



while activeThreads > 0 do

threadFinished.Event:Wait()

end

threadFinished:Destroy()



if currentBuildToken ~= myToken then return end



StatusLabel.Text = "Applying Mesh Properties & Transforms..."

pcall(function()

if #resizeBatch > 0 then endpoint:InvokeServer("SyncResize", resizeBatch) end

if #colorBatch > 0 then endpoint:InvokeServer("SyncColor", colorBatch) end

if #matBatch > 0 then endpoint:InvokeServer("SyncMaterial", matBatch) end

if #anchorBatch > 0 then endpoint:InvokeServer("SyncAnchor", anchorBatch) end


if #createMeshesBatch > 0 then endpoint:InvokeServer("CreateMeshes", createMeshesBatch) end

if #syncMeshBatch > 0 then endpoint:InvokeServer("SyncMesh", syncMeshBatch) end

end)



StatusLabel.Text = "Rebuilding Joints & Welds..."

local weldsToCreate = {}

for _, descendant in ipairs(rootObject:GetDescendants()) do

if descendant:IsA("Weld") or descendant:IsA("WeldConstraint") or descendant:IsA("Motor6D") then

local newPart0 = createdPartsMapping[descendant.Part0]

local newPart1 = createdPartsMapping[descendant.Part1]

if newPart0 and newPart1 then

table.insert(weldsToCreate, {

Type = descendant.ClassName,

Part0 = newPart0,

Part1 = newPart1,

C0 = descendant.C0,

C1 = descendant.C1

})

end

end

end



