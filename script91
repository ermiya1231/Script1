end)

-- دکمه‌های - و + (نگه داشتن = تکرار سریع)
local function bindStep(btn, delta)
    local token = 0
    btn.MouseButton1Down:Connect(function()
        token = token + 1
        local myToken = token
        setReach(reachValue + delta)
        task.spawn(function()
            task.wait(0.35)
            while token == myToken do
                setReach(reachValue + delta)
                task.wait(0.06)
            end
        end)
    end)
    local function stop() token = token + 1 end
    btn.MouseButton1Up:Connect(stop)
    btn.MouseLeave:Connect(stop)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            stop()
        end
    end)
end

