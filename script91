openBtn.BackgroundColor3 = Color3.fromRGB(0, 170, 255)
Instance.new("UICorner", openBtn).CornerRadius = UDim.new(0, 8)

local dragging = false
local dragStart, startPos
local pressTime = 0
local CLICK_MAX_TIME = 0.15
local DRAG_THRESHOLD = 6

local function clampPosition(pos)
    local x = math.clamp(pos.X, 0, gui.AbsoluteSize.X - openBtn.AbsoluteSize.X)
    local y = math.clamp(pos.Y, 0, gui.AbsoluteSize.Y - openBtn.AbsoluteSize.Y)
    return UDim2.fromOffset(x, y)
end

local function onDrag(input)
    local delta = input.Position - dragStart
    if not dragging then
        if math.abs(delta.X) > DRAG_THRESHOLD or math.abs(delta.Y) > DRAG_THRESHOLD then
            dragging = true
        else
            return
        end
    end
    local newPos = UDim2.fromOffset(startPos.X.Offset + delta.X, startPos.Y.Offset + delta.Y)
    openBtn.Position = clampPosition(newPos)
end

openBtn.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
        pressTime = tick()
        dragging = false
        dragStart = input.Position
        startPos = openBtn.Position
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch) then
        onDrag(input)
    end
end)

openBtn.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
        if not dragging and (tick() - pressTime) <= CLICK_MAX_TIME then
            toggleMenu()
        end
        dragging = false
    end
end)

