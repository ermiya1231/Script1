        or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - panelDragStart

        -- جلوگیری از خارج شدن پنل از صفحه
        local minX = gui.AbsolutePosition.X
        local minY = gui.AbsolutePosition.Y
        local maxX = minX + gui.AbsoluteSize.X - main.AbsoluteSize.X
        local maxY = minY + gui.AbsoluteSize.Y - main.AbsoluteSize.Y

        local newX = math.clamp(panelStartAbs.X + delta.X, minX, maxX)
        local newY = math.clamp(panelStartAbs.Y + delta.Y, minY, maxY)

        main.Position = UDim2.new(
            panelStartPos.X.Scale, panelStartPos.X.Offset + (newX - panelStartAbs.X),
            panelStartPos.Y.Scale, panelStartPos.Y.Offset + (newY - panelStartAbs.Y)
        )
    end
end)

UserInputService.InputEnded:Connect(function(input)
