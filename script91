local sliding = false
local targetRatio = reachValue / MAX_REACH
local shownRatio = targetRatio

local function applyVisual(ratio)
    sliderFill.Size = UDim2.new(ratio, 0, 1, 0)
    knob.Position = UDim2.new(ratio, 0, 0.5, 0)
    bubble.Position = UDim2.new(ratio, 0, 0, -4)
end

local function setReach(value, instant)
    value = math.clamp(math.round(value), 0, MAX_REACH)
    reachValue = value
    targetRatio = value / MAX_REACH
    bubble.Text = tostring(value)
    statusLabel.Text = "Reach: " .. reachValue .. " | " .. (reachEnabled and "ON" or "OFF")
    if instant then
        shownRatio = targetRatio
        applyVisual(shownRatio)
    end
end

-- حرکت نرم دستگیره به سمت مقدار هدف
RunService.RenderStepped:Connect(function(dt)
    if shownRatio ~= targetRatio then
        if math.abs(shownRatio - targetRatio) < 0.001 then
            shownRatio = targetRatio
        else
            shownRatio = shownRatio + (targetRatio - shownRatio) * math.min(1, dt * 18)
        end
        applyVisual(shownRatio)
    end
end)

local function updateFromX(mouseX)
    local ratio = math.clamp((mouseX - sliderTrack.AbsolutePosition.X) / sliderTrack.AbsoluteSize.X, 0, 1)
    setReach(ratio * MAX_REACH)
end

