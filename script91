-- موقعیت فعلی پنل (بعد از درگ ذخیره می‌شود تا دفعه بعد همان‌جا باز شود)
local panelPosition = UDim2.new(0.5, -190, 0.5, -130)

local function offscreenPosition()
    return UDim2.new(panelPosition.X.Scale, panelPosition.X.Offset, -1, -130)
end

local function showMenu()
    main.Position = offscreenPosition()
    main.Visible = true
    TweenService:Create(main, TweenInfo.new(0.5, Enum.EasingStyle.Quart, Enum.EasingDirection.Out),
        {Position = panelPosition}):Play()
end

local function hideMenu()
    TweenService:Create(main, TweenInfo.new(0.4, Enum.EasingStyle.Quart, Enum.EasingDirection.In),
        {Position = offscreenPosition()}):Play()
    task.delay(0.4, function()
        main.Visible = false
    end)
end

local function toggleMenu()
    if main.Visible then hideMenu() else showMenu() end
end

