-- پیدا کردن پای ترجیحی (R6: Right/Left Leg ، R15: Right/Left LowerLeg)
local function getFoot(character, humanoid, preferredFoot)
    if humanoid.RigType == Enum.HumanoidRigType.R6 then
        return (preferredFoot == 1 and character:FindFirstChild("Right Leg"))
            or character:FindFirstChild("Left Leg")
    else
        return (preferredFoot == 1 and character:FindFirstChild("RightLowerLeg"))
            or character:FindFirstChild("LeftLowerLeg")
    end
end

RunService.RenderStepped:Connect(function()
    if not reachEnabled then return end

    local character = player.Character
    if not character then return end

    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local root = character:FindFirstChild("HumanoidRootPart")
    if not humanoid or not root then return end

    -- توپ بازی: workspace.TPSSystem.TPS
    local tpsSystem = workspace:FindFirstChild("TPSSystem")
    local ball = tpsSystem and tpsSystem:FindFirstChild("TPS")
    if not ball then return end

    -- پای ترجیحی از ReplicatedStorage.Data[PlayerName].PreferredFoot
    -- (در صورت نبودن: ReplicatedStorage.PlayerSave.PreferredFoot ، و در نهایت پای راست)
    local dataFolder = ReplicatedStorage:FindFirstChild("Data")
    local playerData = dataFolder and dataFolder:FindFirstChild(player.Name)
    local preferredFoot = playerData and playerData:FindFirstChild("PreferredFoot")
    if not preferredFoot then
        local save = ReplicatedStorage:FindFirstChild("PlayerSave")
        preferredFoot = save and save:FindFirstChild("PreferredFoot")
    end
    local footValue = preferredFoot and preferredFoot.Value or 1

    local foot = getFoot(character, humanoid, footValue)
    if not foot then return end

    -- کولداون بر اساس سرعت
    local speed = root.Velocity.Magnitude
    local cooldown = defaultCooldown
    if speed < 6 then
        cooldown = 0.035
    elseif speed > 16 then
        cooldown = 0.07
    end
    if (tick() - lastTouch) < cooldown then return end

    local range = reachValue
    if reactMode then range = 2 end

    -- اگر توپ در رنج بود، لمس جعلی بفرست
    if (root.Position - ball.Position).Magnitude <= range then
        lastTouch = tick()
        firetouchinterest(foot, ball, 0)
        firetouchinterest(foot, ball, 1)
    end
end)

