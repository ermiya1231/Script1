----------------------------------------------------------------
-- منطق Farm
----------------------------------------------------------------
local function billboardHasDollar(gui)
    for _, obj in ipairs(gui:GetDescendants()) do
        if (obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox"))
            and obj.Text:find("$", 1, true) then
            return true
        end
    end
    return false
end

local function getAnchorPart(gui)
    local adornee = gui.Adornee
    if adornee then
        if adornee:IsA("BasePart") then return adornee end
        if adornee:IsA("Attachment") and adornee.Parent:IsA("BasePart") then
            return adornee.Parent
        end
    end
    local p = gui.Parent
    if p then
        if p:IsA("BasePart") then return p end
        if p:IsA("Attachment") and p.Parent:IsA("BasePart") then return p.Parent end
    end
    return nil
end

local function findPromptFor(part)
    local direct = part:FindFirstChildWhichIsA("ProximityPrompt", true)
    if direct then return direct end
    local model = part:FindFirstAncestorOfClass("Model")
    if model then
        return model:FindFirstChildWhichIsA("ProximityPrompt", true)
    end
    return nil
end

local farming = false -- جلوگیری از اجرای همزمان دو Farm

local function runFarm()
    if farming then return end
    farming = true

    local ok, err = pcall(function()
        local character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
        local hrp = character:WaitForChild("HumanoidRootPart")
        local originalCFrame = hrp.CFrame
        local done = {}

        for _, gui in ipairs(Workspace:GetDescendants()) do
            if gui:IsA("BillboardGui") and billboardHasDollar(gui) then
                local part = getAnchorPart(gui)
                if part then
                    local prompt = findPromptFor(part)
                    if prompt and not done[prompt] then
                        done[prompt] = true
                        local target = prompt.Parent
                        if target:IsA("Attachment") then target = target.Parent end
                        if target and target:IsA("BasePart") then
                            hrp.CFrame = target.CFrame + Vector3.new(0, 3, 0)
                            task.wait(0.2)
                            fireproximityprompt(prompt)
                            task.wait(prompt.HoldDuration + 0.2)
                        end
                    end
                end
            end
        end
        hrp.CFrame = originalCFrame
    end)

    if not ok then warn("Farm error:", err) end
    farming = false
end

