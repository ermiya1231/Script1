local function billboardHasDollar(g)
    for _, obj in ipairs(g:GetDescendants()) do
        if (obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox"))
            and obj.Text:find("$", 1, true) then
            return true
        end
    end
    return false
end

local function getAnchorPart(g)
    local adornee = g.Adornee
    if adornee then
        if adornee:IsA("BasePart") then return adornee end
        if adornee:IsA("Attachment") and adornee.Parent:IsA("BasePart") then
            return adornee.Parent
        end
    end
    local p = g.Parent
    if p then
        if p:IsA("BasePart") then return p end
        if p:IsA("Attachment") and p.Parent:IsA("BasePart") then return p.Parent end
    end
    return nil
end

local function findPromptFor(part)
    local direct = part:FindFirstChildWhichIsA("ProximityPrompt", true)
    if direct then return direct end
    local model = part:FindFirstAncestorOfClass("Model")
    if model then
        return model:FindFirstChildWhichIsA("ProximityPrompt", true)
    end
    return nil
end

local function runFarm()
    local ok, err = pcall(function()
        local character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
        local hrp = character:WaitForChild("HumanoidRootPart")
        local done = {}
        for _, g in ipairs(Workspace:GetDescendants()) do
            if stopped then return end
            if g:IsA("BillboardGui") and billboardHasDollar(g) then
                local part = getAnchorPart(g)
                if part then
                    local prompt = findPromptFor(part)
                    if prompt and not done[prompt] then
                        done[prompt] = true
                        local target = prompt.Parent
                        if target:IsA("Attachment") then target = target.Parent end
                        if target and target:IsA("BasePart") then
                            hrp.CFrame = target.CFrame + Vector3.new(0, 3, 0)
                            task.wait(0.22)
                            fireproximityprompt(prompt)
                            task.wait(prompt.HoldDuration + 0.22)
                        end
                    end
                end
            end
        end
    end)
    if not ok then warn("Farm error:", err) end
end

---------------- Server Hop ----------------
local function getServers()
    local url = ("https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Asc&limit=100"):format(game.PlaceId)
    local ok, res = pcall(function() return game:HttpGet(url) end)
    if not ok then return {} end
    local ok2, data = pcall(function() return HttpService:JSONDecode(res) end)
    if not ok2 or not data or not data.data then return {} end
    local list = {}
    for _, s in ipairs(data.data) do
        if s.id ~= game.JobId and s.playing and s.maxPlayers and s.playing < s.maxPlayers then
            table.insert(list, s.id)
        end
    end
    return list
end

local function hop()
    while not stopped do
        status.Text = "Server hopping..."
        requeue()
        local list = getServers()
        local ok
        if #list > 0 then
            ok = pcall(function()
                TeleportService:TeleportToPlaceInstance(game.PlaceId, list[math.random(#list)], LocalPlayer)
            end)
        else
            ok = pcall(function()
                TeleportService:Teleport(game.PlaceId, LocalPlayer)
            end)
        end
        -- اگه تلپورت موفق باشه اسکریپت همینجا با بسته شدن سرور تموم میشه
        task.wait(8) -- اگه هنوز اینجاییم یعنی فیل شده، دوباره تلاش کن
    end
end

