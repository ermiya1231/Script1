    autoFarm = not autoFarm
    autoBtn.Text = "Auto Farm = " .. (autoFarm and "ON" or "OFF")
    autoBtn.BackgroundColor3 = autoFarm and Color3.fromRGB(40, 140, 70) or Color3.fromRGB(60, 60, 70)

    if autoFarm then
        task.spawn(function()
            while autoFarm do
                runFarm()
                -- صبر ۱۳۰ ثانیه (ثانیه‌به‌ثانیه چک می‌شود تا با OFF کردن فوراً متوقف شود)
                for _ = 1, LOOP_DELAY do
                    if not autoFarm then break end
                    task.wait(1)
                end
            end
        end)
    end
end)
