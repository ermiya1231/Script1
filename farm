                    local prompt = findPromptFor(part)
                    if prompt and not done[prompt] then
                        done[prompt] = true
                        local target = prompt.Parent
                        if target:IsA("Attachment") then target = target.Parent end
                        if target and target:IsA("BasePart") then
                            hrp.CFrame = target.CFrame + Vector3.new(0, 3, 0)
                            task.wait(0.22)
                            fireproximityprompt(prompt)
                            task.wait(prompt.HoldDuration + 0.22)
                        end
                    end
                end
            end
        end
        if returnBack ~= false then
            hrp.CFrame = originalCFrame
        end
    end)

    if not ok then warn("Farm error:", err) end
    farming = false
end

