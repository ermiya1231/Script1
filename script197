-- Multi-Player Logger Logic
local activeConnections = {}
local globalPlayerAdded = nil

local function disconnectAllPlayers()
    for _, conns in pairs(activeConnections) do
        if conns.anim then conns.anim:Disconnect() end
        if conns.char then conns.char:Disconnect() end
    end
    table.clear(activeConnections)
    if globalPlayerAdded then globalPlayerAdded:Disconnect(); globalPlayerAdded = nil end
end

local function hookPlayer(p)
    if activeConnections[p] then return end
    activeConnections[p] = {}

    local function onChar(char)
        local h = char:WaitForChild("Humanoid", 5)
        if h then
            local a = h:WaitForChild("Animator", 5)
            if a then 
                if activeConnections[p].anim then activeConnections[p].anim:Disconnect() end
                activeConnections[p].anim = a.AnimationPlayed:Connect(logAnim) 
            end
        end
    end
    activeConnections[p].char = p.CharacterAdded:Connect(onChar)
    if p.Character then onChar(p.Character) end
end

local function setupLogger(targetName)
    disconnectAllPlayers()
    clearLogs()

    -- ALL Players Logic
    if string.lower(targetName) == "all" then
        selectedPlayerLabel.Text = "Selected: ALL PLAYERS"
        for _, p in pairs(Players:GetPlayers()) do
            hookPlayer(p)
        end
        globalPlayerAdded = Players.PlayerAdded:Connect(function(p)
            hookPlayer(p)
        end)
        return
    end

    -- Specific Player Logic
    local targetPlr
    for _, p in pairs(Players:GetPlayers()) do
        if string.lower(p.Name) == string.lower(targetName) or string.lower(p.DisplayName) == string.lower(targetName) then targetPlr = p; break end
    end
    if not targetPlr then return end
    
    selectedPlayerLabel.Text = "Selected Player: " .. targetPlr.Name
    hookPlayer(targetPlr)
end

targetBox:GetPropertyChangedSignal("Text"):Connect(function() targetOkBtn.Visible = true end)
targetOkBtn.MouseButton1Click:Connect(function()
    local text = string.lower(targetBox.Text)
    
    if text == "all" then
        targetBox.Text = "All"
        setupLogger("All")
        targetOkBtn.Visible = false
        return
    end

    local found = nil
    for _, p in pairs(Players:GetPlayers()) do
        if string.sub(string.lower(p.Name), 1, #text) == text or string.sub(string.lower(p.DisplayName), 1, #text) == text then
            found = p
            break
        end
    end
    if found then
        targetBox.Text = found.Name
        setupLogger(found.Name)
        targetOkBtn.Visible = false
    end
end)

