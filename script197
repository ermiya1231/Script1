-- Default Animation Names to Filter
local defaultAnims = {
    ["walkanim"] = true, ["runanim"] = true, ["jumpanim"] = true, ["fallanim"] = true,
    ["climbanim"] = true, ["idleanim"] = true, ["sitanim"] = true, ["toolnoneanim"] = true,
    ["toolslashanim"] = true, ["toollungeanim"] = true, ["swimanim"] = true, ["swimidleanim"] = true,
    ["toolloopanimation"] = true, ["animation1"] = true, ["animation2"] = true,
    -- Basic keywords that catch most default actions
    ["walk"] = true, ["run"] = true, ["jump"] = true, ["fall"] = true, ["climb"] = true,
    ["idle"] = true, ["sit"] = true
}

local function logAnim(track)
    if not track.Animation then return end
    
    local name = track.Name
    if name == "" or name == "Animation" then
        name = track.Animation.Name
    end
    if name == "ToolLoopAnimation" then
        name = "ToolAnim"
    end

    -- Filter Mode Logic
    if isFilterMode then
        local lowerName = string.lower(name)
        -- Check exact names or keyword matches
        if defaultAnims[lowerName] or string.find(lowerName, "walk") or string.find(lowerName, "idle") or string.find(lowerName, "run") or string.find(lowerName, "jump") or string.find(lowerName, "fall") or string.find(lowerName, "tool") then
            return 
        end
    end

    local id = string.match(track.Animation.AnimationId, "%d+")
    if not id or loggedAnims[id] then return end
    loggedAnims[id] = true
    
    local initialName = (name ~= "" and name ~= "Animation") and name or ("Animation " .. id)
    local textInfo = string.format("%s (%s)", initialName, id)
    
    local btn = make("TextButton", {Parent = logScroll, Size = UDim2.new(1, 0, 0, 30), BackgroundColor3 = Color3.fromRGB(40, 40, 40), Text = textInfo, TextWrapped = true, TextColor3 = Color3.new(1,1,1), TextSize = 11, Font = Enum.Font.Gotham})
    btn.MouseButton1Click:Connect(function()
        if setclipboard then 
            setclipboard(id) 
            local currentText = btn.Text
            btn.Text = "Copied!"
            task.delay(1.2, function()
                if btn and btn.Parent then
                    btn.Text = currentText
                end
            end)
        end
    end)

    if name == "" or name == "Animation" then
        task.spawn(function()
            local success, info = pcall(function()
                return MarketplaceService:GetProductInfo(tonumber(id))
            end)
            if success and info and info.Name then
                btn.Text = string.format("%s (%s)", info.Name, id)
            end
        end)
    end
end

