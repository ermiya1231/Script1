-- Glitch and Media controls
local function StartGlitchLoop(track)
    currentGlitchId = currentGlitchId + 1
    local myId = currentGlitchId
    task.spawn(function()
        while CurrentTrack == track and track.IsPlaying and Settings["Glitch Mode"] and currentGlitchId == myId do
            local nextPos = track.TimePosition + 0.08
            if track.Length > 0 and nextPos >= track.Length then
                if Settings["Looped"] then 
                    track.TimePosition = math.clamp(Settings["Start Position"], 0, 1) * track.Length 
                else 
                    track:Stop(); break 
                end
            else track.TimePosition = nextPos end
            task.wait(0.08)
        end
    end)
end

local function createSlider(name, min, max)
    local frame = make("Frame", {Parent = optScroll, Size = UDim2.new(1, 0, 0, 35), BackgroundTransparency = 1})
    local label = make("TextLabel", {Parent = frame, Size = UDim2.new(1, 0, 0, 15), BackgroundTransparency = 1, Text = string.format("%s: %.2f", name, Settings[name]), TextColor3 = Color3.new(1,1,1), TextXAlignment = 0, TextSize = 11})
    local bg = make("Frame", {Parent = frame, Size = UDim2.new(1, 0, 0, 5), Position = UDim2.new(0, 0, 0, 20), BackgroundColor3 = Color3.fromRGB(60, 60, 60)})
    local fill = make("Frame", {Parent = bg, Size = UDim2.new((Settings[name]-min)/(max-min), 0, 1, 0), BackgroundColor3 = Color3.fromRGB(0, 120, 255)})
    local thumb = make("Frame", {Parent = bg, Size = UDim2.new(0, 10, 0, 10), Position = UDim2.new((Settings[name]-min)/(max-min), 0, 0.5, 0), AnchorPoint = Vector2.new(0.5, 0.5)})
    
    local isDraggingSlider = false
    local function updateSlider(input)
        local p = math.clamp((input.Position.X - bg.AbsolutePosition.X) / bg.AbsoluteSize.X, 0, 1)
        local val = min + (max - min) * p
        Settings[name] = val; label.Text = string.format("%s: %.2f", name, val)
        fill.Size = UDim2.new(p, 0, 1, 0); thumb.Position = UDim2.new(p, 0, 0.5, 0)
        if CurrentTrack and CurrentTrack.IsPlaying then
            if name == "Speed" and not Settings["Glitch Mode"] then CurrentTrack:AdjustSpeed(val)
            elseif name == "Time Position" and CurrentTrack.Length > 0 then CurrentTrack.TimePosition = p * CurrentTrack.Length end
        end
    end
    local function startDrag(i) if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then isDraggingSlider = true; updateSlider(i) end end
    bg.InputBegan:Connect(startDrag); thumb.InputBegan:Connect(startDrag)
    UserInputService.InputChanged:Connect(function(i) if isDraggingSlider and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then updateSlider(i) end end)
    UserInputService.InputEnded:Connect(function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then isDraggingSlider = false end end)
    
    if name == "Time Position" then
        RunService.RenderStepped:Connect(function()
            if not isDraggingSlider and CurrentTrack and CurrentTrack.IsPlaying and CurrentTrack.Length > 0 then
                local p = CurrentTrack.TimePosition / CurrentTrack.Length
                Settings[name] = p; label.Text = string.format("%s: %.2f", name, p)
                fill.Size = UDim2.new(p, 0, 1, 0); thumb.Position = UDim2.new(p, 0, 0.5, 0)
            end
        end)
    end
end

local function createToggle(name)
    local frame = make("Frame", {Parent = optScroll, Size = UDim2.new(1, 0, 0, 25), BackgroundTransparency = 1})
    make("TextLabel", {Parent = frame, Size = UDim2.new(0.7, 0, 1, 0), BackgroundTransparency = 1, Text = name, TextColor3 = Color3.new(1,1,1), TextXAlignment = 0, TextSize = 12})
    local btn = make("TextButton", {Parent = frame, Size = UDim2.new(0, 30, 0, 15), Position = UDim2.new(1, -30, 0.5, -7), BackgroundColor3 = Settings[name] and Color3.fromRGB(0,200,100) or Color3.fromRGB(200,50,50), Text = ""})
    btn.MouseButton1Click:Connect(function()
        Settings[name] = not Settings[name]
        btn.BackgroundColor3 = Settings[name] and Color3.fromRGB(0,200,100) or Color3.fromRGB(200,50,50)
        if name == "Looped" and CurrentTrack then CurrentTrack.Looped = Settings[name] end
        if name == "Glitch Mode" and CurrentTrack and CurrentTrack.IsPlaying then
            if Settings[name] then CurrentTrack:AdjustSpeed(0); StartGlitchLoop(CurrentTrack) else currentGlitchId = currentGlitchId + 1; CurrentTrack:AdjustSpeed(Settings["Speed"]) end
        end
    end)
end

