local function StopTrack()
    if CurrentTrack then isManualStop = true; CurrentTrack:Stop(0.1); CurrentTrack = nil; currentGlitchId = currentGlitchId + 1 end
end

local function LoadTrack(id)
    if CurrentTrack then isManualStop = true; CurrentTrack:Stop(0) end
    isManualStop = false
    local anim = Instance.new("Animation"); anim.AnimationId = "rbxassetid://"..tostring(id)
    local track = getAnimator():LoadAnimation(anim)
    track.Priority = Enum.AnimationPriority.Action4
    track.Looped = Settings["Looped"]
    track:Play(0.1, 1, Settings["Speed"])
    CurrentTrack = track
    
    if Settings["Glitch Mode"] then track:AdjustSpeed(0); StartGlitchLoop(track) end
    
    track.DidLoop:Connect(function()
        if Settings["Start Position"] > 0 and CurrentTrack == track then
            track.TimePosition = math.clamp(Settings["Start Position"], 0, 1) * track.Length
        end
    end)

    track.Stopped:Connect(function()
        if Settings["Looped"] and not isManualStop and CurrentTrack == track and not Settings["Glitch Mode"] and not track.Looped then
            task.spawn(function()
                task.wait()
                if Settings["Looped"] and not isManualStop and CurrentTrack == track and not Settings["Glitch Mode"] then
                    track:Play(0.1, 1, Settings["Speed"])
                    track.TimePosition = math.clamp(Settings["Start Position"], 0, 1) * track.Length
                end
            end)
        end
    end)
    
    task.spawn(function()
        repeat task.wait() until track.Length > 0 or CurrentTrack ~= track
        if CurrentTrack == track then 
            track.TimePosition = math.clamp(Settings["Start Position"], 0, 1) * track.Length 
        end
    end)
end

