local function createButton(name, text, yPos)
	local btn = Instance.new("TextButton")
	btn.Name = name
	btn.Size = UDim2.new(0.85, 0, 0, 35)
	btn.Position = UDim2.new(0.075, 0, 0, yPos)
	btn.BackgroundColor3 = Color3.fromRGB(70, 70, 70)
	btn.BorderSizePixel = 1
	btn.BorderColor3 = Color3.fromRGB(0, 0, 0)
	btn.Text = text
	btn.Font = Enum.Font.SourceSansBold
	btn.TextSize = 16
	btn.TextColor3 = Color3.fromRGB(255, 255, 255)
	btn.AutoButtonColor = true
	btn.Parent = MainFrame
	return btn
end

local CheckToolsBtn = createButton("CheckToolsBtn", "Check Tools", 45)
local DupeToolsBtn = createButton("DupeToolsBtn", "Dupe Tools", 90)

local function notify(title, text)
	game.StarterGui:SetCore("SendNotification", {
		Title = title;
		Text = text;
		Duration = 4;
	})
end

CheckToolsBtn.MouseButton1Click:Connect(function()
	local toolsToCheck = {}
	local backpack = LocalPlayer:FindFirstChild("Backpack")
	if backpack then
		for _, item in pairs(backpack:GetChildren()) do
			if item:IsA("Tool") then table.insert(toolsToCheck, item) end
		end
	end
	if LocalPlayer.Character then
		for _, item in pairs(LocalPlayer.Character:GetChildren()) do
			if item:IsA("Tool") then table.insert(toolsToCheck, item) end
		end
	end
	
	if #toolsToCheck == 0 then
		notify("Check", "هیچ ابزاری پیدا نشد!")
		return
	end
	
	for _, tool in ipairs(toolsToCheck) do
		if not tool.CanBeDropped then
			notify("❌ " .. tool.Name, "صد در صد قابل کلون شدن نیستند")
		elseif tool.CanBeDropped and not StarterPack:FindFirstChild(tool.Name) then
			notify("⚠️ " .. tool.Name, "به احتمال 40 درصد کلون میشود")
		else
			notify("✅ " .. tool.Name, "ابزار عادی است و در StarterPack وجود دارد")
		end
	end
end)

-- عملکرد Dupe Tools
local grabtoolsFunc = nil
local isDupeOnCooldown = false

DupeToolsBtn.MouseButton1Click:Connect(function()
	if isDupeOnCooldown then return end
	
	local char = LocalPlayer.Character
	if not char then return end
	
	local hrp = char:FindFirstChild("HumanoidRootPart")
	local humanoid = char:FindFirstChild("Humanoid")
	if not hrp or not humanoid then return end
	
	isDupeOnCooldown = true
	DupeToolsBtn.Text = "Please Wait..."
	DupeToolsBtn.BackgroundColor3 = Color3.fromRGB(120, 50, 50)
	
	local savedCFrame = hrp.CFrame
	local cam = workspace.CurrentCamera
	
	-- 1. فیکس دوربین همین پایین (بدون قفل شدن)
	local camDummy = Instance.new("Part")
	camDummy.Transparency = 1
	camDummy.Anchored = true
	camDummy.CanCollide = false
	camDummy.CFrame = hrp.CFrame
	camDummy.Parent = workspace
	cam.CameraSubject = camDummy
	
	-- 2. آوردن وسایل به دست کاراکتر
	local backpack = LocalPlayer:FindFirstChild("Backpack")
	if backpack then
		for _, v in pairs(backpack:GetChildren()) do
			if v:IsA("Tool") then v.Parent = char end
		end
	end
	
	-- 3. ساخت یک کف نامرئی در آسمان برای جلوگیری از سقوط تا زمانی که سرور تلپورت رو ثبت کنه
	local skyPlatform = Instance.new("Part")
	skyPlatform.Anchored = true
	skyPlatform.Size = Vector3.new(100, 5, 100)
	skyPlatform.CFrame = savedCFrame + Vector3.new(0, 14995, 0) -- 5 استاد زیر پای کاراکتر
	skyPlatform.Transparency = 1
	skyPlatform.Parent = workspace
	
	-- 4. تلپورت بی‌نقص به آسمان (بدون Anchored)
	char:PivotTo(savedCFrame + Vector3.new(0, 15000, 0))
	
	-- 5. *** کلید حل مشکل FE ***
	-- 0.3 ثانیه صبر میکنیم تا سرور به خاطر پینگ، موقعیت جدیدمون رو تو آسمون آپدیت کنه
	task.wait(0.3) 
	
	-- 6. حالا که سرور مطمئنه ما تو آسمونیم، وسایل رو دراپ میکنیم
	for _, v in pairs(char:GetChildren()) do
		if v:IsA("Tool") then v.Parent = workspace end
	end
	
	-- 7. پاک کردن پلتفرم و مرگ
	skyPlatform:Destroy()
	humanoid.Health = 0
	
	-- 8. منتظر ماندن برای ریسپاون
	local newChar = LocalPlayer.CharacterAdded:Wait()
	local newHrp = newChar:WaitForChild("HumanoidRootPart", 3)
	local newHumanoid = newChar:WaitForChild("Humanoid", 3)
	
	-- 9. برگرداندن دوربین به کاراکتر
	cam.CameraSubject = newHumanoid
	camDummy:Destroy()
	
	if newHrp then
		local endTime = tick() + 0.3
		local connection
		connection = RunService.RenderStepped:Connect(function()
			if tick() < endTime and newHrp.Parent then
				newHrp.CFrame = savedCFrame
			else
				if connection then connection:Disconnect() end
			end
		end)
	end
	
	if newHumanoid then
		-- 10. تله‌کنسیس: گرفتن وسایل از آسمان
		for _, child in ipairs(workspace:GetChildren()) do
			if child:IsA("Tool") and child:FindFirstChild("Handle") then
				child.Handle.CFrame = savedCFrame 
				newHumanoid:EquipTool(child)
			end
		end

		if grabtoolsFunc then grabtoolsFunc:Disconnect() end

		grabtoolsFunc = workspace.ChildAdded:Connect(function(child)
			if newChar and child:IsA("Tool") and child:FindFirstChild("Handle") then
				child.Handle.CFrame = savedCFrame
				newHumanoid:EquipTool(child)
			end
		end)
		
		task.delay(0.5, function()
			if grabtoolsFunc then grabtoolsFunc:Disconnect() end
			isDupeOnCooldown = false
			DupeToolsBtn.Text = "Dupe Tools"
			DupeToolsBtn.BackgroundColor3 = Color3.fromRGB(70, 70, 70)
		end)
	else
		if camDummy then camDummy:Destroy() end
		cam.CameraSubject = newHumanoid or char
		isDupeOnCooldown = false
		DupeToolsBtn.Text = "Dupe Tools"
		DupeToolsBtn.BackgroundColor3 = Color3.fromRGB(70, 70, 70)
	end
end)
