    end
end)

local function getPlayer(name)
    name = name:lower()
    for _, p in pairs(Players:GetPlayers()) do
        if p.Name:lower():sub(1, #name) == name or p.DisplayName:lower():sub(1, #name) == name then 
            return p 
        end
    end
    return nil
end

local function KickTarget(targetPlayer)
    if selectedRemote and targetPlayer then
        pcall(function()
            selectedRemote:FireServer(targetPlayer)
            if targetPlayer.Character then 
                selectedRemote:FireServer(targetPlayer.Character) 
            end
        end)
    end
end

local function KillTarget(targetPlayer)
    if selectedRemote and targetPlayer and targetPlayer.Character then
        local char = targetPlayer.Character
        local partToDestroy = char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart") or char:FindFirstChildOfClass("BasePart")
        if partToDestroy then
            pcall(function()
                selectedRemote:FireServer(partToDestroy)
            end)
        end
    end
end

