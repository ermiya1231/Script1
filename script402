local function isValidMapPart(obj)
    if not obj:IsA("BasePart") or obj:IsA("Terrain") or obj.Name:lower() == "baseplate" or obj.Transparency >= 1 or obj.Size.Magnitude > 30 then return false end
    local ancestorModel = obj:FindFirstAncestorOfClass("Model")
    return not (ancestorModel and ancestorModel:FindFirstChildOfClass("Humanoid"))
end

local function GetTestableMapParts()
    local candidates = {}
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if isValidMapPart(obj) then table.insert(candidates, obj) end
    end
    return candidates
end

local function AutoScan()
    local allRemotes = {}
    local function gather(parent)
        if not parent then return end
        for _, v in ipairs(parent:GetDescendants()) do
            if v:IsA("RemoteEvent") then table.insert(allRemotes, v) end
        end
    end

    pcall(function() gather(Workspace) end)
    pcall(function() gather(ReplicatedStorage) end)
    pcall(function() gather(player) end)

    local priority = {}
    local normal = {}
    for _, r in ipairs(allRemotes) do
        local ln = r.Name:lower()
        if ln:find("delete") or ln:find("destroy") then
            table.insert(priority, r)
        else
            table.insert(normal, r)
        end
    end
    local remotes = {}
    for _, r in ipairs(priority) do table.insert(remotes, r) end
    for _, r in ipairs(normal) do table.insert(remotes, r) end

    local mapParts = GetTestableMapParts()
    if #mapParts == 0 then return nil end

    for index, remote in ipairs(remotes) do
        local targetPart = table.remove(mapParts, 1)
        if not targetPart or not targetPart.Parent then continue end

        ScanLabel.Text = string.format("Scanning [%d/%d]\n%s", index, #remotes, remote.Name)
        pcall(function() remote:FireServer(targetPart) end)

        local startTime = os.clock()
        local success = false
        while (os.clock() - startTime) < 1.5 do
            if not targetPart:IsDescendantOf(Workspace) then
                success = true
                break
            end
            task.wait(0.05)
        end

        if success then return remote end
        task.wait(1)
    end
    return nil
end

