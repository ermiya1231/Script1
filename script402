local function isValidMapPart(obj)
    if not obj:IsA("BasePart") or obj:IsA("Terrain") or obj.Name:lower() == "baseplate" or obj.Transparency >= 1 or obj.Size.Magnitude > 30 then return false end
    local ancestorModel = obj:FindFirstAncestorOfClass("Model")
    return not (ancestorModel and ancestorModel:FindFirstChildOfClass("Humanoid"))
end

local function GetTestableMapPart()
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if isValidMapPart(obj) then return obj end
    end
    return nil
end

-- توابع اسکن هوشمند با اولویت‌بندی، حذف تکراری‌ها و Progress Bar
local function SmartScan()
    local servicesToScan = {
        Workspace, ReplicatedStorage, StarterGui, StarterPack, 
        game:GetService("Lighting"), game:GetService("JointsService")
    }

    local allRemotes = {}
    local seenNames = {}

    -- جمع‌آوری و فیلتر ریموت‌های تکراری بر اساس نام
    for _, service in ipairs(servicesToScan) do
        for _, v in ipairs(service:GetDescendants()) do
            if v:IsA("RemoteEvent") and not seenNames[v.Name] then
                seenNames[v.Name] = true
                table.insert(allRemotes, v)
            end
        end
    end

    -- مرتب‌سازی: اولویت با ریموت‌هایی که حاوی Remove, Destroy یا Delete هستند
    table.sort(allRemotes, function(a, b)
        local aLower = a.Name:lower()
        local bLower = b.Name:lower()
        local aHasPriority = aLower:find("remove") or aLower:find("destroy") or aLower:find("delete")
        local bHasPriority = bLower:find("remove") or bLower:find("destroy") or bLower:find("delete")
        
        if aHasPriority and not bHasPriority then
            return true
        elseif not aHasPriority and bHasPriority then
            return false
        end
        return false
    end)

    local foundRemote = nil
    local rType = "None"
    local total = #allRemotes

    for index, v in ipairs(allRemotes) do
        if total > 0 then
            local progress = index / total
            ProgressBarFill.Size = UDim2.new(progress, 0, 1, 0)
        end
        
        ScanLabel.Text = "Scanning (" .. index .. "/" .. total .. "):\n" .. v.Name

        local testPart = GetTestableMapPart()
        local canDeletePart = false

        if testPart then
            pcall(function() v:FireServer(testPart) end)
            task.wait(0.67) -- کندتر کردن سرعت تست برای بالا رفتن دقت
            if not testPart or not testPart.Parent then
                canDeletePart = true
            end
        end

        if canDeletePart then
            foundRemote = v
            rType = "Limited"

            local nonPartTarget = game:GetService("StarterPlayer").StarterPlayerScripts:FindFirstChild("RbxCharacterSounds")
            if nonPartTarget then
                pcall(function() v:FireServer(nonPartTarget) end)
                task.wait(0.4)
                if not nonPartTarget or not nonPartTarget.Parent then
                    rType = "FullAccess"
                    break 
                end
            end

            if rType == "FullAccess" then break end
        end
    end

    return foundRemote, rType
end

