local isOrbiting = false
local alignCon = nil
local velocityCon = nil
local activeHats = {}
local mov = {}
local mov2 = {}
local par = {}
local partsFolder = nil

local function cleanupOrbit()
    if alignCon then alignCon:Disconnect() alignCon = nil end
    if velocityCon then velocityCon:Disconnect() velocityCon = nil end
    if partsFolder then partsFolder:Destroy() partsFolder = nil end
    for _, hat in ipairs(activeHats) do
        if hat and hat.Parent then
            local a = hat:FindFirstChildOfClass("AlignPosition")
            local b = hat:FindFirstChildOfClass("BodyAngularVelocity")
            if a then a:Destroy() end
            if b then b:Destroy() end
        end
    end
    activeHats = {}
    mov = {}
    mov2 = {}
    par = {}
end

HatOrbitBtn.MouseButton1Click:Connect(function()
    if not selectedRemote or not player.Character then return end
    local char = player.Character
    local hum = char:FindFirstChild("Humanoid")
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hum or not hrp then return end

    isOrbiting = not isOrbiting

    if isOrbiting then
        HatOrbitBtn.Text = "Stop Orbit"
        HatOrbitBtn.BackgroundColor3 = Color3.fromRGB(0, 180, 80)
        cleanupOrbit()

        partsFolder = Instance.new("Folder", char)
        partsFolder.Name = "wacky parts folder"

        for _, v in pairs(hum:GetAccessories()) do
            local handle = v:FindFirstChild("Handle")
            if handle then
                handle.CustomPhysicalProperties = PhysicalProperties.new(0, 0, 0, 0, 0)
                handle.CanCollide = false

                for _, joint in pairs(handle:GetDescendants()) do
                    if joint:IsA("JointInstance") then
                        pcall(function() selectedRemote:FireServer(joint) end)
                        joint:Destroy()
                    end
                end

                table.insert(activeHats, handle)
            end
        end

        for _, handle in pairs(activeHats) do
            local still = Instance.new("BodyAngularVelocity", handle)
            still.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
            still.AngularVelocity = Vector3.new(0, 0, 0)

            local align = Instance.new("AlignPosition", handle)
            align.MaxForce = 1000000
            align.MaxVelocity = math.huge
            align.RigidityEnabled = false
            align.ApplyAtCenterOfMass = true
            align.Responsiveness = 200

            local a0 = Instance.new("Attachment", handle)
            local a1 = Instance.new("Attachment", char.Head)
            align.Attachment0 = a0
            align.Attachment1 = a1

            table.insert(mov, a1)
            table.insert(mov2, still)

            local part = Instance.new("Part", partsFolder)
            part.Anchored = true
            part.Size = Vector3.new(1, 1, 1)
            part.Transparency = 1
            part.CanCollide = false
            table.insert(par, part)
        end

        velocityCon = RunService.Heartbeat:Connect(function()
            for _, handle in pairs(activeHats) do
                if handle and handle.Parent then
                    handle.Velocity = Vector3.new(0, 30, 0)
                end
            end
        end)

        local l = 1

        alignCon = RunService.RenderStepped:Connect(function()
            if not char or not hrp or not hrp.Parent then
                isOrbiting = false
                HatOrbitBtn.Text = "HatOrbit"
                HatOrbitBtn.BackgroundColor3 = Color3.fromRGB(120, 40, 160)
                cleanupOrbit()
                return
            end

            local speed = getSpeed()
            local offset = getOffset()
            local angular = Vector3.new(0, 0, 0)

            l = (l >= 360 and 1 or l + speed)

            for i, v in pairs(par) do
                if v and hrp then
                    v.CFrame = CFrame.new(hrp.Position) * CFrame.fromEulerAnglesXYZ(0, math.rad(l + (360 / #par) * i + speed), 0) * CFrame.new(offset, 0, 0)
                end
            end

            for i, v in pairs(mov) do
                if par[i] then 
                    v.Position = Vector3.new(hrp.CFrame:ToObjectSpace(CFrame.new(par[i].Position)).X, hrp.CFrame:ToObjectSpace(CFrame.new(par[i].Position)).Y, hrp.CFrame:ToObjectSpace(CFrame.new(par[i].Position)).Z) 
                end
            end

            for _, v in pairs(mov2) do v.AngularVelocity = angular end
        end)
    else
        HatOrbitBtn.Text = "HatOrbit"
        HatOrbitBtn.BackgroundColor3 = Color3.fromRGB(120, 40, 160)
        cleanupOrbit()
    end
end)
