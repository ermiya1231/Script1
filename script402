local Workspace = game:GetService("Workspace")
local Stats = game:GetService("Stats")

local LocalPlayer = Players.LocalPlayer

-- تابع محاسبه پینگ لحظه‌ای برای جلوگیری از باگ اینترنت
local function getNetworkDelay()
    local ping = 0.15
    pcall(function()
        ping = Stats.Network.ServerStatsItem["Data Ping"]:GetValue() / 1000
    end)
    -- حداقل 0.5 ثانیه و حداکثر 2 ثانیه مهلت بر اساس پینگ
    return math.clamp(ping * 2.5, 0.5, 2.0)
end

local function AutoScan()
    local remotes = {}
    
    local function gather(parent)
        if not parent then return end
        for _, v in ipairs(parent:GetDescendants()) do
            if v:IsA("RemoteEvent") then 
                table.insert(remotes, v) 
            end
        end
    end

    pcall(function() gather(ReplicatedStorage) end)
    pcall(function() gather(Workspace) end)
    pcall(function() gather(LocalPlayer) end)

    -- ۱. جداسازی و اولویت‌بندی ایمن ریموت‌های Dance و Emote
    local priorityRemotes = {}
    local otherRemotes = {}

    for _, remote in ipairs(remotes) do
        local nameLower = string.lower(remote.Name)
        if string.find(nameLower, "delete") or string.find(nameLower, "destroy") then
            table.insert(priorityRemotes, remote)
        else
            table.insert(otherRemotes, remote)
        end
    end

    -- ادغام دو لیست (ابتدا اولویت‌دارها، سپس مابقی)
    remotes = {}
    for _, r in ipairs(priorityRemotes) do table.insert(remotes, r) end
    for _, r in ipairs(otherRemotes) do table.insert(remotes, r) end

    local mapParts = GetTestableMapParts()
    if not mapParts or #mapParts == 0 then
        ScanLabel.Text = "No valid map parts found!"
        task.wait(2)
        return nil
    end

    local totalRemotes = #remotes
    local foundRemote = nil

    for index, remote in ipairs(remotes) do
        if #mapParts == 0 then break end
        
        local targetPart = table.remove(mapParts, 1)
        if not targetPart or not targetPart.Parent then continue end

        ScanLabel.Text = string.format("Scanning [%d/%d]\n%s", index, totalRemotes, remote.Name)

        pcall(function() remote:FireServer(targetPart) end)

        -- ۲. تنظیم زمان انتظار بازتر (بین ۱.۰ تا ۳.۵ ثانیه) جهت پاسخ‌دهی سرورهای کند
        local maxWait = math.clamp(getNetworkDelay() * 1.8, 1.0, 3.5)
        local startTime = os.clock()

        while (os.clock() - startTime) < maxWait do
            if not targetPart:IsDescendantOf(Workspace) or targetPart.Parent == nil then
                -- تاییدیه مجدد با مکث کوتاه برای جلوگیری از پاسخ کاذب ناشی از لگ
                task.wait(0.1)
                if not targetPart:IsDescendantOf(Workspace) then
                    foundRemote = remote
                    break
                end
            end
            task.wait(0.05)
        end

        if foundRemote then break end
        task.wait(0.03)
    end
    
    return foundRemote
end

