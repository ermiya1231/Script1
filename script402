    DeleteMapBtn.Text = "Deleting..."
    
    task.spawn(function()
        -- گرفتن تمام آبجکت‌های داخل مپ بازی
        local allObjects = workspace:GetDescendants()
        
        for i, obj in ipairs(allObjects) do
            -- چک می‌کنیم که حتما پارت یا مدل باشه (چیزای اصلی مپ)
            if (obj:IsA("BasePart") or obj:IsA("Model")) and obj.Parent then
                pcall(function() 
                    selectedRemote:FireServer(obj) 
                end)
            end
            
            -- بهینه‌سازی بسیار مهم: هر 100 پارت یه مکث خیلی کوتاه می‌کنه
            -- تا کلاینتت فریز نشه و سرور هم تو رو به خاطر اسپم ریموت کیک نکنه
            if i % 500 == 0 then
                task.wait()
            end
        end
        
        DeleteMapBtn.Text = "Map Deleted!"
        task.wait(1.5)
        DeleteMapBtn.Text = "Delete Map"
    end)
end)

