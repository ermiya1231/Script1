    local legParts = {"Right Leg", "RightFoot", "RightLowerLeg", "RightUpperLeg"}
    for _, partName in ipairs(legParts) do
        local part = targetCharacter:FindFirstChild(partName)
        if part then pcall(function() selectedRemote:FireServer(part) end) end
