local function CreateSlider(parent, posY, labelText, minVal, maxVal, defaultVal, isInt)
    local frame = createUI("Frame", {Size = UDim2.new(1, -20, 0, 22), Position = UDim2.new(0, 10, 0, posY), BackgroundColor3 = Color3.fromRGB(30, 30, 30), BorderSizePixel = 1, Parent = parent})
    local label = createUI("TextLabel", {Size = UDim2.new(0.55, 0, 1, 0), Position = UDim2.new(0, 5, 0, 0), BackgroundTransparency = 1, Text = labelText .. ": " .. tostring(defaultVal), TextColor3 = Color3.fromRGB(200, 200, 200), Font = Enum.Font.SourceSansBold, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Left, Parent = frame})
    local barBg = createUI("Frame", {Size = UDim2.new(0.4, 0, 0, 6), Position = UDim2.new(0.57, 0, 0.5, -3), BackgroundColor3 = Color3.fromRGB(10, 10, 10), BorderSizePixel = 0, Parent = frame})
    local fill = createUI("Frame", {Size = UDim2.new((defaultVal - minVal) / (maxVal - minVal), 0, 1, 0), BackgroundColor3 = Color3.fromRGB(140, 40, 180), BorderSizePixel = 0, Parent = barBg})
    local btn = createUI("TextButton", {Size = UDim2.new(1, 0, 1, 0), BackgroundTransparency = 1, Text = "", Parent = barBg})

    local val = defaultVal
    local dragging = false
    btn.MouseButton1Down:Connect(function() dragging = true end)
    UserInputService.InputEnded:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            local percent = math.clamp((input.Position.X - barBg.AbsolutePosition.X) / barBg.AbsoluteSize.X, 0, 1)
            fill.Size = UDim2.new(percent, 0, 1, 0)
            if isInt then
                val = math.floor(minVal + ((maxVal - minVal) * percent) + 0.5)
            else
                val = math.floor((minVal + (maxVal - minVal) * percent) * 10) / 10
            end
            label.Text = labelText .. ": " .. tostring(val)
        end
    end)
    return function() return val end
end

