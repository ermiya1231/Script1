local function LogEvent(side, remote, args, method)
    local db = SpyData[side]
    if not db[remote] then
        RemoteIDCounter = RemoteIDCounter + 1
        local success, rName = pcall(function() return remote.Name end)
        db[remote] = { ID = "Remote_" .. tostring(RemoteIDCounter), Name = success and rName or "UnknownRemote", Count = 0, Logs = {} }
    end
    local entry = db[remote]
    entry.Count = entry.Count + 1
    if #entry.Logs > 50 then table.remove(entry.Logs, 1) end
    table.insert(entry.Logs, {Time = os.date("%H:%M:%S"), Code = GenerateCodeString(side, remote, args, method), Args = args, Method = method})
    table.insert(UIUpdateQueue, {side = side, remote = remote, entry = entry})
end

if hookmetamethod then
    local oldNamecall
    pcall(function()
        oldNamecall = hookmetamethod(game, "__namecall", _newcclosure(function(self, ...)
            local method = tostring(_getnamecallmethod())
            if method == "PromptProductPurchase" or method == "PromptGamePassPurchase" or method == "PromptPurchase" then return self[method](self, ...) end
            if method ~= "FireServer" and method ~= "InvokeServer" then return oldNamecall(self, ...) end
            if not _checkcaller() and typeof(self) == "Instance" then
                if method == "FireServer" and self.ClassName == "RemoteEvent" then
                    local args = {...} task.spawn(function() pcall(function() LogEvent("Server", self, args, method) end) end)
                elseif method == "InvokeServer" and self.ClassName == "RemoteFunction" then
                    local args = {...} task.spawn(function() pcall(function() LogEvent("Server", self, args, method) end) end)
                end
            end
            return oldNamecall(self, ...)
        end))
    end)
end

local function wrapRemotes(folder)
    for _, obj in ipairs(folder:GetDescendants()) do
        if obj:IsA("RemoteEvent") then obj.OnClientEvent:Connect(function(...) local args = {...} pcall(function() LogEvent("Client", obj, args, "OnClientEvent") end) end) end
    end
end
