ConvertBtn.MouseButton1Click:Connect(function()
    local rawText = ConvInputBox.Text
    if rawText == "" then return end
    local result = "local myArgs = {\n"
    for line in rawText:gmatch("[^\r\n]+") do
        local key, value = line:match("(.-):%s*(.+)")
        if key and value then
            if tonumber(value) then result = result .. string.format('    ["%s"] = %s,\n', key, value)
            else result = result .. string.format('    ["%s"] = "%s",\n', key, value) end
        end
    end
    result = result .. "}"
    ConvOutputBox.Text = result
end)

