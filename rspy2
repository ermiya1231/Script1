local function ApplySyntaxHighlighting(codeString)
    local highlighted = codeString:gsub("<", "&lt;"):gsub(">", "&gt;")
    local cKeyword, cString, cNumber, cMethod = "#FF79C6", "#F1FA8C", "#BD93F9", "#50FA7B"
    highlighted = highlighted:gsub('("[^"]*")', '<font color="'..cString..'">%1</font>')
    highlighted = highlighted:gsub("([%s%[,=])(%d+%.?%d*)([%s%],;])", "%1<font color=\""..cNumber.."\">%2</font>%3")
    highlighted = highlighted:gsub("^(%d+%.?%d*)([%s%],;])", "<font color=\""..cNumber.."\">%1</font>%2")
    highlighted = highlighted:gsub("(FireServer)", '<font color="'..cMethod..'">%1</font>')
    highlighted = highlighted:gsub("(InvokeServer)", '<font color="'..cMethod..'">%1</font>')
    local keywords = {"local", "function", "return", "if", "then", "else", "end", "for", "while", "do", "in", "and", "or", "not", "true", "false", "nil", "unpack"}
    for _, kw in pairs(keywords) do highlighted = highlighted:gsub("([^%a_])("..kw..")([^%a_])", "%1<font color=\""..cKeyword.."\">%2</font>%3") end
    return highlighted
end

local function getPathToInstance(instance)
    local path, current = {}, instance
    while current and current ~= game do
        local name = current.Name
        if name:match("%s") or name:match("^%d") then name = '["' .. name .. '"]'
        elseif name:sub(1, 4) == "Game" then name = "game" .. name:sub(5) end
        table.insert(path, 1, name)
        current = current.Parent
    end
    return table.concat(path, ".")
end

local function formatValue(value, indent)
    indent = indent or 1
    local formatting = string.rep("    ", indent)
    if typeof(value) == "string" then return string.format("%q", value)
    elseif typeof(value) == "number" then return tostring(value)
    elseif typeof(value) == "boolean" then return value and "true" or "false"
    elseif typeof(value) == "Instance" then return getPathToInstance(value)
    elseif typeof(value) == "Vector3" then return string.format("Vector3.new(%f, %f, %f)", value.X, value.Y, value.Z)
    elseif typeof(value) == "table" then
        if next(value) == nil then return "{}" end
        local result = "{\n"
        for k, v in pairs(value) do
            local keyStr = type(k) == "string" and '["'..k..'"]' or "["..tostring(k).."]"
            result = result .. formatting .. keyStr .. " = " .. formatValue(v, indent + 1) .. ",\n"
        end
        return result .. string.rep("    ", indent - 1) .. "}"
    else return string.format("%q", tostring(value)) end
end

local function GenerateCodeString(side, remote, args, method)
    local formattedArgs = {}
    for i, arg in ipairs(args) do formattedArgs[i] = string.format("[%d] = %s", i, formatValue(arg)) end
    local argsString = table.concat(formattedArgs, ",\n    ")
    local fullPath = getPathToInstance(remote)
    if side == "Server" then return string.format("local args = {\n    %s\n}\n\n%s:%s(unpack(args))", argsString, fullPath, method)
    else return string.format("local args = {\n    %s\n}\n\nfiresignal(%s.OnClientEvent, unpack(args))", argsString, fullPath) end
end

