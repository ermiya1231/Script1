        if CurrentTab == "Server" then
            if SelectedMethod == "FireServer" then pcall(function() SelectedRemote:FireServer(unpack(SelectedArgs)) end)
            elseif SelectedMethod == "InvokeServer" then task.spawn(function() pcall(function() SelectedRemote:InvokeServer(unpack(SelectedArgs)) end) end) end
        elseif CurrentTab == "Client" then pcall(function() _firesignal(SelectedRemote.OnClientEvent, unpack(SelectedArgs)) end) end
    end
end

