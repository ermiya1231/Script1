-- توابع فریز
local anim1 = Instance.new("Animation")
anim1.AnimationId = anim1Id
local anim2 = Instance.new("Animation")
anim2.AnimationId = anim2Id

local function freezeProjectile(part)
    if frozenParts[part] then return end
    frozenParts[part] = {
        lockedCFrame = part.CFrame,
        expireTime = tick() + 2
    }
end

local function isCharacterPart(part)
    local model = part:FindFirstAncestorOfClass("Model")
    if model and model:FindFirstChildOfClass("Humanoid") then
        return true
    end
    return false
end

-- قفل فیزیک سرورساید
local preSimConnection = RunService.PreSimulation or RunService.Stepped
preSimConnection:Connect(function()
    if not isActive then return end
    stealNetworkOwnership()
    for part, data in pairs(frozenParts) do
        if part and part.Parent then
            if tick() < data.expireTime then
                part.AssemblyLinearVelocity = Vector3.zero
                part.AssemblyAngularVelocity = Vector3.zero
                part.CFrame = data.lockedCFrame
            else
                frozenParts[part] = nil
            end
        else
            frozenParts[part] = nil
        end
    end
end)

-- [[ حلقه اصلی Heartbeat برای ماتریکس و Ultra Instinct ]] --
RunService.Heartbeat:Connect(function()
    local char = player.Character
    if not char then return end

    local hum = char:FindFirstChildOfClass("Humanoid")
    local hrp = char:FindFirstChild("HumanoidRootPart")

    if not hum or not hrp or hum.Health <= 0 then 
        if uiRingPart then uiRingPart.CFrame = CFrame.new(0,-1000,0) end
        return 
    end

    -- آپدیت مکان دایره نعونی
    if isUIActive and uiRingPart then
        -- چرخش 90 درجه برای اینکه Cylinder روی زمین بخوابه
        uiRingPart.CFrame = hrp.CFrame * CFrame.new(0, -2.5, 0) * CFrame.Angles(0, 0, math.pi/2)
    end

    local overlapParams = OverlapParams.new()
    overlapParams.FilterType = Enum.RaycastFilterType.Exclude
    overlapParams.FilterDescendantsInstances = {char}

    -- ==============================================
    -- 1. لاجیک Ultra Instinct (اولویت بالاتر برای فرار)
    -- ==============================================
    if isUIActive and (tick() - lastDodgeTime > dodgeCooldown) then
        local uiPartsInRadius = Workspace:GetPartBoundsInRadius(hrp.Position, uiRange, overlapParams)
        local shouldDodge = false
        
        for _, part in ipairs(uiPartsInRadius) do
            if part:IsA("BasePart") and not part.Anchored and not isCharacterPart(part) then
                local velocity = part.AssemblyLinearVelocity
                local speed = velocity.Magnitude
                
                -- اگه سرعت داشت (Unanchored ثابت رو ایگنور میکنه)
                if speed > 5 then
                    local toPlayer = (hrp.Position - part.Position)
                    local isHeadingTowards = velocity:Dot(toPlayer) > 0
                    
                    if isHeadingTowards or toPlayer.Magnitude <= (uiRange * 0.8) then
                        shouldDodge = true
                        break
                    end
                end
            end
        end

        if shouldDodge then
            -- جاخالی دادن به صورت رندوم به راست یا چپ به اندازه 15 استاد
            local direction = (math.random() > 0.5) and 1 or -1
            hrp.CFrame = hrp.CFrame * CFrame.new(direction * 15, 0, 0)
            lastDodgeTime = tick()
            
            -- افکت انیمیشنی کوتاه (اختیاری)
            local dodgeAnim = Instance.new("Animation")
            dodgeAnim.AnimationId = anim2Id
            local track = hum:LoadAnimation(dodgeAnim)
            track.Priority = Enum.AnimationPriority.Action4
            track:Play(0.1, 1, 2)
            task.delay(0.2, function() track:Stop() end)
        end
    end

    -- ==============================================
    -- 2. لاجیک Matrix Deflect (فریز کردن)
    -- ==============================================
    if isActive then
        local animator = hum:FindFirstChildOfClass("Animator") or hum
        if not loadedAnim1 and animator then 
            loadedAnim1 = animator:LoadAnimation(anim1) 
            loadedAnim1.Priority = Enum.AnimationPriority.Action4
            loadedAnim1.Looped = false
        end
        if not loadedAnim2 and animator then 
            loadedAnim2 = animator:LoadAnimation(anim2) 
            loadedAnim2.Priority = Enum.AnimationPriority.Action4
            loadedAnim2.Looped = false
        end

        local activeThreats = 0
        local partsInRadius = Workspace:GetPartBoundsInRadius(hrp.Position, protectionRadius, overlapParams)

        for _, part in ipairs(partsInRadius) do
            if part:IsA("BasePart") and not part.Anchored and not isCharacterPart(part) then
                local velocity = part.AssemblyLinearVelocity
                local speed = velocity.Magnitude
                local toPlayer = (hrp.Position - part.Position)
                local isHeadingTowards = velocity:Dot(toPlayer) > 0

                if (speed > 1 and isHeadingTowards) or toPlayer.Magnitude <= 12 or frozenParts[part] then
                    activeThreats = activeThreats + 1
                    if not frozenParts[part] then freezeProjectile(part) end
                end
            end
        end

        -- کنترل انیمیشن ماتریکس
        if activeThreats > 0 then
            if not isDefending then
                isDefending = true
                if loadedAnim1 then loadedAnim1:AdjustSpeed(1); loadedAnim1:Play() end
                task.delay(0.2, function()
                    if isDefending and loadedAnim2 then
                        if loadedAnim1 then loadedAnim1:Stop() end 
                        loadedAnim2:AdjustSpeed(1); loadedAnim2:Play()
                        task.delay(0.25, function()
                            if isDefending and loadedAnim2 then loadedAnim2:AdjustSpeed(0) end
                        end)
                    end
                end)
            end
        else
            if isDefending then
                local stillFrozen = false
                for part, _ in pairs(frozenParts) do
                    if part and part.Parent then stillFrozen = true; break end
                end
                if not stillFrozen then
                    isDefending = false
                    if loadedAnim1 then loadedAnim1:Stop(); loadedAnim1:AdjustSpeed(1) end
                    if loadedAnim2 then loadedAnim2:Stop(); loadedAnim2:AdjustSpeed(1) end
                end
            end
        end
    end
end)
