-- [[ تنظیم Posture ]] --
local function setPostureUpright(character, makeStraight)
    local torso = character:FindFirstChild("Torso") or character:FindFirstChild("UpperTorso")
    if torso then
        local rootJoint = torso:FindFirstChild("RootJoint") or (character:FindFirstChild("LowerTorso") and character.LowerTorso:FindFirstChild("Root"))
        if rootJoint then
            if makeStraight then
                if not originalPosture then originalPosture = rootJoint.C0 end
                rootJoint.C0 = CFrame.new(rootJoint.C0.Position) * CFrame.Angles(-math.pi/2, 0, math.pi) 
            else
                if originalPosture then 
                    rootJoint.C0 = originalPosture 
                    originalPosture = nil
                end
            end
        end
    end
end

