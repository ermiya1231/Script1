        pcall(function()
            sethiddenproperty(player, "MaximumSimulationRadius", 10000)
            sethiddenproperty(player, "SimulationRadius", 10000)
        end)
    elseif set_simulation_radius then
        pcall(function() set_simulation_radius(10000) end)
    end
end

