-- ========== Logic ==========
local eventCount = 0
local suppress = 0
local stoppers = {}

local senders = {
    Product  = function(id) Market:SignalPromptProductPurchaseFinished(player.UserId, id, true) end,
    Gamepass = function(id) Market:SignalPromptGamePassPurchaseFinished(player, id, true) end,
    Bulk     = function(id) Market:SignalPromptBulkPurchaseFinished(player.UserId, id, true) end,
    Purchase = function(id) Market:SignalPromptPurchaseFinished(player.UserId, id, true) end,
}

local function fire(kind, id)
    suppress += 1
    pcall(senders[kind], id)
    task.defer(function() suppress -= 1 end)
end

local function setEmpty(show)
    local e = logArea:FindFirstChild("EmptyState")
    if show and not e then
        local l = label(logArea, "Waiting for events...", UDim2.new(1, 0, 0, 100),
            UDim2.new(), TS + 1, GRAY, CENTER)
        l.Name = "EmptyState"
        l.LayoutOrder = 99999
    elseif not show and e then
        e:Destroy()
    end
end

local function stopAll()
    for fn in pairs(table.clone(stoppers)) do fn() end
end
stopAllBtn.MouseButton1Click:Connect(stopAll)

local function addLog(kind, id)
    setEmpty(false)
    local EH = isMobile and 42 or 38
    local entry = new("Frame", {
        Name = "Entry", Size = UDim2.new(1, -2, 0, EH),
        BackgroundColor3 = BLACK, BorderSizePixel = 0, LayoutOrder = -eventCount,
    }, logArea)
    stroke(entry, GRAY)
    eventCount += 1

    label(entry, tostring(id), UDim2.new(1, -160, 0.55, 0), UDim2.new(0, 8, 0, 0), TS + 2)
    label(entry, string.upper(kind) .. "  " .. os.date("%H:%M:%S"),
        UDim2.new(1, -160, 0.4, 0), UDim2.new(0, 8, 0.58, 0), TS - 2, GRAY)

    local holder = new("Frame", {
        Size = UDim2.new(0, 144, 1, 0), Position = UDim2.new(1, -150, 0, 0),
        BackgroundTransparency = 1,
    }, entry)
    local bw, by = UDim2.new(0, 46, 0, BH), 0.5
    local autoBtn = button(holder, "Auto", bw, UDim2.new(0, 0, by, -BH / 2))
    local copyBtn = button(holder, "Copy", bw, UDim2.new(0, 49, by, -BH / 2))
    local runBtn = button(holder, "Run", bw, UDim2.new(0, 98, by, -BH / 2))
    for _, b in ipairs({ autoBtn, copyBtn, runBtn }) do b.TextSize = TS - 1 end

    -- Copy
    copyBtn.MouseButton1Click:Connect(function()
        pcall(setclipboard, tostring(id))
        copyBtn.Text = "Copied"
        task.delay(1, function() copyBtn.Text = "Copy" end)
    end)

    -- Auto
    local auto, autoThread = false, nil
    local function stopAuto()
        auto = false
        if autoThread then task.cancel(autoThread) autoThread = nil end
        stoppers[stopAuto] = nil
        setOn(autoBtn, false, "Auto")
    end
    local function startAuto()
        auto = true
        setOn(autoBtn, true, "Stop")
        autoThread = task.spawn(function()
            while auto do
                fire(kind, id)
                task.wait(1 / autoSpeed)
            end
        end)
        stoppers[stopAuto] = true
    end
    autoBtn.MouseButton1Click:Connect(function()
        if auto then stopAuto() else startAuto() end
    end)

    -- Run (click = once, hold 3s = spam)
    local spam, spamThread, holdStart, holdId = false, nil, nil, 0
    local function stopSpam()
        spam = false
        if spamThread then task.cancel(spamThread) spamThread = nil end
        stoppers[stopSpam] = nil
        setOn(runBtn, false, "Run")
    end
    local function startSpam()
        spam = true
        setOn(runBtn, true, "Spam")
        spamThread = task.spawn(function()
            while spam do
                fire(kind, id)
                task.wait(0.1)
            end
        end)
        stoppers[stopSpam] = true
    end

    runBtn.InputBegan:Connect(function(i)
        if not isPress(i) or spam then return end
        holdId += 1
        local my = holdId
        holdStart = tick()
        task.delay(3, function()
            if holdStart and holdId == my and not spam then startSpam() end
        end)
    end)
    runBtn.InputEnded:Connect(function(i)
        if not isPress(i) then return end
        local held = holdStart and (tick() - holdStart) or 0
        holdStart = nil
        if spam then
            stopSpam()
        elseif held > 0 and held < 3 then
            fire(kind, id)
            runBtn.Text = "Sent"
            task.delay(1, function() if not spam then runBtn.Text = "Run" end end)
        end
    end)

    entry.Destroying:Connect(function()
        stopAuto()
        stopSpam()
    end)
end

clearBtn.MouseButton1Click:Connect(function()
    stopAll()
    for _, c in ipairs(logArea:GetChildren()) do
        if c.Name == "Entry" then c:Destroy() end
    end
    eventCount = 0
    setEmpty(true)
end)

