Market.PromptProductPurchaseFinished:Connect(function(_, id)
    if suppress == 0 then addLog("Product", id) end
end)
Market.PromptGamePassPurchaseFinished:Connect(function(_, id)
    if suppress == 0 then addLog("Gamepass", id) end
end)
Market.PromptBulkPurchaseFinished:Connect(function(_, id)
    if suppress == 0 then addLog("Bulk", id) end
end)
Market.PromptPurchaseFinished:Connect(function(_, id)
    if suppress == 0 then addLog("Purchase", id) end
end)

setEmpty(true)
