-- Resize handle (PC)
if not isMobile then
    local rh = new("Frame", {
        Size = UDim2.new(0, 12, 0, 12), Position = UDim2.new(1, -12, 1, -12),
        BackgroundColor3 = WHITE, BorderSizePixel = 0, ZIndex = 5,
    }, panel)
    local resizing, startPos, startSize
    rh.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 then
            resizing = true
            startPos = i.Position
            startSize = panel.AbsoluteSize
            i.Changed:Connect(function()
                if i.UserInputState == Enum.UserInputState.End then resizing = false end
            end)
        end
    end)
    UIS.InputChanged:Connect(function(i)
        if resizing and i.UserInputType == Enum.UserInputType.MouseMovement then
            local d = i.Position - startPos
            panel.Size = UDim2.fromOffset(
                math.clamp(startSize.X + d.X, 360, 900),
                math.clamp(startSize.Y + d.Y, 220, 700))
        end
    end)
end

