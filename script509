-- ========== Settings ==========
local settingsWindow
local function closeSettings()
    if settingsWindow then settingsWindow:Destroy() settingsWindow = nil end
end

local function toggleSettings()
    if settingsWindow then return closeSettings() end

    local w = new("Frame", {
        Name = "Settings", Size = UDim2.new(0, 240, 0, 140),
        Position = UDim2.new(0.5, -120, 0.5, -70),
        BackgroundColor3 = BLACK, BorderSizePixel = 0, ZIndex = 50,
    }, gui)
    settingsWindow = w
    stroke(w)

    local bar = new("Frame", {
        Size = UDim2.new(1, 0, 0, TH), BackgroundColor3 = BLACK, BorderSizePixel = 0,
    }, w)
    line(bar, UDim2.new(0, 0, 1, -1))
    label(bar, "SETTINGS", UDim2.new(1, -40, 1, 0), UDim2.new(0, 10, 0, 0))
    local x = button(bar, "X", UDim2.new(0, bs, 0, bs), UDim2.new(1, -bs - 6, 0.5, -bs / 2))
    x.MouseButton1Click:Connect(closeSettings)
    makeDraggable(bar, w)

    label(w, "Signals / sec", UDim2.new(0, 110, 0, 24), UDim2.new(0, 10, 0, TH + 10))
    local box = new("TextBox", {
        Size = UDim2.new(0, 90, 0, 24), Position = UDim2.new(1, -100, 0, TH + 10),
        BackgroundColor3 = BLACK, Text = tostring(autoSpeed), TextColor3 = WHITE,
        TextSize = TS, Font = FONT, BorderSizePixel = 0, ClearTextOnFocus = false,
    }, w)
    stroke(box)
    label(w, "Range: 1 - 10000", UDim2.new(1, -20, 0, 14), UDim2.new(0, 10, 0, TH + 40), TS - 2, GRAY)

    local save = button(w, "Save", UDim2.new(0, 80, 0, BH), UDim2.new(0.5, -40, 1, -BH - 8))
    save.MouseButton1Click:Connect(function()
        local n = tonumber(box.Text)
        if n and n >= 1 and n <= 10000 then
            autoSpeed = math.floor(n)
            save.Text = "Saved!"
        else
            save.Text = "Invalid"
        end
        box.Text = tostring(autoSpeed)
        task.wait(1)
        if save.Parent then save.Text = "Save" end
    end)
end
setBtn.MouseButton1Click:Connect(toggleSettings)

