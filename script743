-- 3. اسکنر دقیق Network Ownership (بهینه‌شده و بدون لگ)
-- ==========================================
local cachedNPCs = {}
local checkOwnership = typeof(isnetworkowner) == "function"
local allModels = {}

-- تابع اضافه کردن مدل‌های جدید به لیست پنهان
local function checkAndAddModel(obj)
    if obj:IsA("Model") and obj:FindFirstChildOfClass("Humanoid") then
        table.insert(allModels, obj)
    end
end

-- یک‌بار مپ را اسکن می‌کنیم
for _, obj in ipairs(workspace:GetDescendants()) do
    checkAndAddModel(obj)
end

-- برای مدل‌های جدیدی که اسپاون می‌شوند
workspace.DescendantAdded:Connect(function(obj)
    if obj:IsA("Model") then
        task.delay(0.5, function() -- کمی صبر تا لود کامل شود
            checkAndAddModel(obj)
        end)
    elseif obj:IsA("Humanoid") and obj.Parent and obj.Parent:IsA("Model") then
        table.insert(allModels, obj.Parent)
    end
end)

task.spawn(function()
    while true do
        if isOrbitActive then
            local newNpcs = {}
            local char = player.Character
            local myRoot = char and char:FindFirstChild("HumanoidRootPart")
            
            if myRoot then
                -- به جای کل مپ، فقط لیست مدل‌ها را بررسی می‌کنیم
                for i = #allModels, 1, -1 do
                    local obj = allModels[i]
                    
                    if not obj or not obj.Parent then
                        table.remove(allModels, i)
                        continue
                    end
                    
                    if not Players:GetPlayerFromCharacter(obj) then
                        local humanoid = obj:FindFirstChildOfClass("Humanoid")
                        local rootPart = obj:FindFirstChild("HumanoidRootPart") or obj.PrimaryPart
                        
                        if humanoid and rootPart and not rootPart.Anchored and humanoid.Health > 0 then
                            local hasOwnerShip = true
                            if checkOwnership then
                                pcall(function()
                                    hasOwnerShip = isnetworkowner(rootPart)
                                end)
                            end
                            
                            if hasOwnerShip then
                                local dist = (rootPart.Position - myRoot.Position).Magnitude
                                if dist <= maxSearchDistance then
                                    table.insert(newNpcs, rootPart)
                                end
                            end
                        end
                    end
                end
            end
            cachedNPCs = newNpcs
        else
            cachedNPCs = {}
        end
        task.wait(0.5)
    end
end)

-- ==========================================
-- 4. حلقه چرخش بدون لگ
-- ==========================================
local currentAngle = 0
local connection

-- تغییر به Heartbeat برای پردازش نرم‌تر CFrame
connection = RunService.Heartbeat:Connect(function(dt)
    if not isOrbitActive then return end
    
    local char = player.Character
    if not char or not char.PrimaryPart then return end
    
    local myRoot = char.PrimaryPart
    local npcs = cachedNPCs
    
    if #npcs == 0 then return end
    
    currentAngle = currentAngle + math.rad(orbitSpeed * dt)
    local angleStep = (math.pi * 2) / #npcs
    
    for i, npcRoot in ipairs(npcs) do
        if npcRoot and npcRoot.Parent then
            local angle = currentAngle + (angleStep * i)
            local targetCFrame
            
            if orbitMode == 1 then
                local offset = Vector3.new(math.cos(angle) * orbitRadius, 0, math.sin(angle) * orbitRadius)
                targetCFrame = myRoot.CFrame * CFrame.new(offset)
            elseif orbitMode == 2 then
                local yOffset = math.sin(currentAngle * 2 + i) * (orbitRadius / 2)
                local offset = Vector3.new(math.cos(angle) * orbitRadius, yOffset, math.sin(angle) * orbitRadius)
                targetCFrame = myRoot.CFrame * CFrame.new(offset)
            elseif orbitMode == 3 then
                local offset = Vector3.new(math.cos(angle) * orbitRadius, math.cos(angle * 1.5) * orbitRadius, math.sin(angle) * orbitRadius)
                targetCFrame = myRoot.CFrame * CFrame.new(offset)
            end
            
            npcRoot.Velocity = Vector3.zero
            npcRoot.RotVelocity = Vector3.zero
            npcRoot.CFrame = targetCFrame * CFrame.Angles(0, -angle + math.pi/2, 0)
        end
    end
end)

