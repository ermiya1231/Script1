                                track:Stop()
                            end
                        end
                    end
                end
                -- ==============================================
                
                -- آپدیت وضعیت به بازیکن
                btn.Text = "BOMB PLANTED! NOW RESET"
                btn.TextColor3 = Color3.fromRGB(255, 180, 50)
