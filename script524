                remote:FireServer("PlaySong", 0)
                
                -- === اضافه شده: متوقف کردن انیمیشن Tool Hold ===
                local hum = char:FindFirstChild("Humanoid")
                if hum then
                    -- در روبلاکس انیمیشن‌ها روی Animator پلی میشن
