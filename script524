-- 1. سیستم پیدا کردن هوشمند ابزارها
-- ==========================================
local function findTool(keyword)
    local keywordLower = string.lower(keyword)
    local bp = plr:FindFirstChild("Backpack")
    local char = plr.Character
    
    if bp then
        for _, tool in pairs(bp:GetChildren()) do
            if tool:IsA("Tool") and string.find(string.lower(tool.Name), keywordLower) then return tool end
        end
    end
    if char then
        for _, tool in pairs(char:GetChildren()) do
            if tool:IsA("Tool") and string.find(string.lower(tool.Name), keywordLower) then return tool end
        end
    end
    return nil
end

