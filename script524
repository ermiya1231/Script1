    local fusebomb = findTool("bomb")

    if not boombox or not fusebomb then
        btn.Text = "MISSING TOOLS!"
        btn.TextColor3 = Color3.fromRGB(255, 50, 50)
        task.wait(1.5)
        btn.Text = isSetup and "READY (CLICK SCREEN)" or "SETUP BOMB"
        btn.TextColor3 = isSetup and Color3.fromRGB(50, 255, 50) or Color3.fromRGB(200, 200, 200)
