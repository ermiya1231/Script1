local function setupFEOperation(boombox, char, hrp)
    boomboxHandle = boombox:FindFirstChild("Handle")
    if not boomboxHandle then return end

    if workspace:FindFirstChild("OrbitReference_SilentBomb") then workspace.OrbitReference_SilentBomb:Destroy() end

    local targetPart = Instance.new("Part", workspace)
    targetPart.Name = "OrbitReference_SilentBomb"
    targetPart.Anchored = true
    targetPart.CanCollide = false
    targetPart.Transparency = 1
    targetPart.Size = Vector3.new(0.2, 0.2, 0.2)
    targetPart.CFrame = hrp.CFrame * CFrame.new(0, -5, -3)

    local ap = Instance.new("AlignPosition", boomboxHandle)
    ap.MaxForce, ap.MaxVelocity, ap.Responsiveness = math.huge, math.huge, 200
    
    local att0 = Instance.new("Attachment", boomboxHandle)
    att0.Name = "SilentBombAtt"
    local att1 = Instance.new("Attachment", targetPart)
    ap.Attachment0, ap.Attachment1 = att0, att1

    if renderConnection then renderConnection:Disconnect() end
    if feConnection then feConnection:Disconnect() end

    lastHRPPos = hrp.Position

    renderConnection = RunService.RenderStepped:Connect(function()
        if targetPart and hrp and char.Parent then
            targetPart.CFrame = hrp.CFrame * CFrame.new(0, -5, -3)
        end
    end)

    feConnection = RunService.PostSimulation:Connect(function(dt)
        if boomboxHandle and boomboxHandle.Parent and hrp and char.Parent then
            local currentTime = os.clock()
            local currentPos = hrp.Position
            local hrpVel = (dt > 0) and ((currentPos - lastHRPPos) / dt) or Vector3.zero
            lastHRPPos = currentPos

            local predictedTargetPos = targetPart.Position + (hrpVel * 0.1)
            local antiSleep = Vector3.new(0, math.sin(currentTime * 15) * 0.0015, 0)
            local gravityAxis = SETTINGS.VelocityY + math.sin(currentTime)

            local dir = predictedTargetPos - boomboxHandle.Position
            local xz = Vector3.new(dir.X, 0, dir.Z)
            local velXZ = (xz.Magnitude > 0) and (xz.Unit * xz.Magnitude * 2) or Vector3.zero

            boomboxHandle.AssemblyLinearVelocity = Vector3.new(velXZ.X, gravityAxis, velXZ.Z)
            boomboxHandle.AssemblyAngularVelocity = Vector3.new(0, math.huge, math.huge)
            boomboxHandle.CFrame = boomboxHandle.CFrame + antiSleep
        else
            if feConnection then feConnection:Disconnect() end
            if renderConnection then renderConnection:Disconnect() end
        end
    end)
end

task.spawn(function()
    while task.wait(0.1) do
        local currentChar = plr.Character
        local hum = currentChar and currentChar:FindFirstChild("Humanoid")
        
        if isSetup and boomboxHandle and boomboxHandle.Parent and currentChar and hum and hum.Health > 0 then
            local ref = workspace:FindFirstChild("OrbitReference_SilentBomb")
            if ref then
                local separation = (boomboxHandle.Position - ref.Position).Magnitude
                if separation > 8 then
                    local tool = boomboxHandle.Parent
                    if tool:IsA("Tool") and tool.Parent == currentChar then
                        local bp = plr:FindFirstChild("Backpack")
                        if bp then
                            tool.Parent = bp
                            task.wait()
                            tool.Parent = currentChar
                        end
                    end
                end
            end
        end
    end
end)
