-- ==========================================
local function resetSystem()
    isSetup = false
    needsReset = false -- قفل باز میشه چون مُردی
    isPlaying = false
    
    if feConnection then feConnection:Disconnect() feConnection = nil end
    if renderConnection then renderConnection:Disconnect() renderConnection = nil end
    if workspace:FindFirstChild("OrbitReference_SilentBomb") then
        workspace.OrbitReference_SilentBomb:Destroy()
    end
    
    if boomboxHandle then clearPhysics(boomboxHandle) end
    boomboxHandle = nil

    local bp = plr:FindFirstChild("Backpack")
    local boombox = findTool("boom")
    local fusebomb = findTool("bomb")
    
    if bp then
        if boombox then boombox.Parent = bp end
        if fusebomb then fusebomb.Parent = bp end
    end
    
    btn.Text = "SETUP BOMB"
    btn.TextColor3 = Color3.fromRGB(200, 200, 200)
    TweenService:Create(btnStroke, TweenInfo.new(0.5), {Color = Color3.fromRGB(80, 80, 80)}):Play()
end

