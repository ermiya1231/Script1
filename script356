local LIGHT_ALL_PARTS = false
local GLOBAL_LIGHT_RANGE = 20
local GLOBAL_LIGHT_BRIGHTNESS = 0.011

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Player = Players.LocalPlayer
local TextChatService = game:GetService("TextChatService")
local generalChannel = TextChatService:WaitForChild("TextChannels"):WaitForChild("RBXGeneral")

local tool
for _, v in ipairs(Player:GetDescendants()) do if v.Name == "SyncAPI" then tool = v.Parent break end end
if not tool then for _, v in ipairs(ReplicatedStorage:GetDescendants()) do if v.Name == "SyncAPI" then tool = v.Parent break end end end
if not tool or not tool:FindFirstChild("SyncAPI") then warn("خطا: ابزار F3X پیدا نشد!") return end

local remote = tool.SyncAPI.ServerEndpoint
local ActiveSyncs = 0

local CHUNK_SIZE = 250 -- تعداد پارت‌ها در هر بسته ارسالی به سرور

local function FireMassiveSync(action, dataArray, extraArg)
    if not dataArray or #dataArray == 0 then return end
    
    -- تقسیم کردن آرایه بزرگ به بسته‌های کوچکتر
    for i = 1, #dataArray, CHUNK_SIZE do
        local chunk = {}
        for j = i, math.min(i + CHUNK_SIZE - 1, #dataArray) do
            table.insert(chunk, dataArray[j])
        end
        
        ActiveSyncs = ActiveSyncs + 1
        task.spawn(function()
            pcall(function()
                if extraArg ~= nil then 
                    remote:InvokeServer(action, chunk, extraArg)
                else 
                    remote:InvokeServer(action, chunk) 
                end
            end)
            ActiveSyncs = ActiveSyncs - 1
        end)
        
        task.wait() -- یک مکث بسیار کوتاه تا صف شبکه روبلاکس قفل نشود
    end
end

local function safeNum(val, default) return tonumber(val) or default or 0 end

local function SetFreeze(state)
    local char = Player.Character
    if char and char:FindFirstChild("HumanoidRootPart") then
        char.HumanoidRootPart.Anchored = state
    end
end

