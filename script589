local function RemoveAllPlayers()
    local playerParts = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= Player and p.Character then
            for _, child in ipairs(p.Character:GetDescendants()) do
                if child:IsA("BasePart") then table.insert(playerParts, child) end
            end
        end
    end
    FireMassiveSync("SetLocked", playerParts, false)
    FireMassiveSync("Remove", playerParts)
end

local function FastClearMap()
    local mapParts = {}
    for _, v in ipairs(workspace:GetDescendants()) do
        if (v:IsA("BasePart") or v:IsA("UnionOperation")) and v.Name ~= "Terrain" then
            if not (Player.Character and v:IsDescendantOf(Player.Character)) then
                table.insert(mapParts, v)
            end
        end
    end
    FireMassiveSync("SetLocked", mapParts, false)
    FireMassiveSync("Remove", mapParts)
end

local function BuildAndVerifyMap(data)
    local partsToBuild = {}
    
    local cleanData = data:gsub("Part %d+:", "|||")
    for partBlock in cleanData:gmatch("([^|]+)") do
        local x, y, z = partBlock:match("Position:%s*%(([^,]+),%s*([^,]+),%s*([^)]+)%)")
        if x and y and z then
            local rx, ry, rz = partBlock:match("Rotation:%s*%(([^,]+),%s*([^,]+),%s*([^)]+)%)")
            local sx, sy, sz = partBlock:match("Size:%s*%(([^,]+),%s*([^,]+),%s*([^)]+)%)")
            
            local shape = partBlock:match("Shape:%s*([%a%d]+)")
            local className = partBlock:match("Class:%s*([%a%d]+)") or partBlock:match("ClassName:%s*([%a%d]+)") or partBlock:match("Type:%s*([%a%d]+)")
            
            local r, g, b = partBlock:match("Color:%s*([^,]+),%s*([^,]+),%s*([^%s\r\n]+)")
            local mat = partBlock:match("Material:%s*([%a%d]+)")
            local trans = partBlock:match("Transparency:%s*([%d%.]+)")
            
            local decals = {}
            for face in string.gmatch("Top Bottom Left Right Front Back", "%a+") do
                local dId = partBlock:match("Decal%." .. face .. "%s*=%s*(%d+)")
                if dId then decals[face] = dId end
            end
            
            local textures = {}
            for face in string.gmatch("Top Bottom Left Right Front Back", "%a+") do
                local tId = partBlock:match("Texture%." .. face .. "%s*=%s*(%d+)")
                if tId then textures[face] = tId end
            end
            
            local surfaces = {}
            local generalStud = (partBlock:match("Stud:%s*[Tt]rue") or partBlock:match("Studs:%s*[Tt]rue")) and true or false
            for face in string.gmatch("Top Bottom Left Right Front Back", "%a+") do
                local faceStud = (partBlock:match("Stud%." .. face .. ":%s*[Tt]rue") or partBlock:match("Studs%." .. face .. ":%s*[Tt]rue")) and true or false
                if faceStud or generalStud then
                    surfaces[face] = Enum.SurfaceType.Studs
                end
            end
            
            local meshType = partBlock:match("MeshType:%s*(%a+)")
            local meshId = partBlock:match("MeshId:%s*(%S+)") or partBlock:match("Mesh:%s*(%S+)")
            local meshTextureId = partBlock:match("MeshTextureId:%s*(%S+)") or partBlock:match("MeshTexture:%s*(%S+)")
            
            local msStr = partBlock:match("MeshScale:%s*([^\n\r]+)")
            local msX, msY, msZ = 1, 1, 1
            if msStr then
                local ex, ey, ez = msStr:match("([%d%.]+)%s*,%s*([%d%.]+)%s*,%s*([%d%.]+)")
                if ex and ey and ez then msX, msY, msZ = ex, ey, ez end
            end
            
            local hasLight = partBlock:match("Light:%s*[Tt]rue") and true or false
            local hasFire = partBlock:match("Fire:%s*[Tt]rue") and true or false
            local hasSparkles = partBlock:match("Sparkles:%s*[Tt]rue") and true or false
            local hasSmoke = partBlock:match("Smoke:%s*[Tt]rue") and true or false
            local isUnanchored = partBlock:match("Unanchored:%s*[Tt]rue") and true or false
            
            local f3xShape = "Normal"
            if partBlock:match("SpawnPoint:%s*[Tt]rue") or shape == "Spawn" or className == "SpawnLocation" then 
                f3xShape = "Spawn"
            elseif partBlock:match("VehicleSeat:%s*[Tt]rue") or shape == "VehicleSeat" or className == "VehicleSeat" then 
                f3xShape = "Vehicle Seat"
            elseif partBlock:match("Seat:%s*[Tt]rue") or shape == "Seat" or className == "Seat" then 
                f3xShape = "Seat"
            elseif shape == "Cylinder" or className == "CylinderPart" then 
                f3xShape = "Cylinder"
            elseif shape == "Ball" or shape == "Sphere" then 
                f3xShape = "Ball"
            elseif shape == "Wedge" or className == "WedgePart" then 
                f3xShape = "Wedge"
            elseif shape == "Corner" or shape == "CornerWedge" or className == "CornerWedgePart" then 
                f3xShape = "Corner"
            elseif shape == "Truss" or className == "TrussPart" then 
                f3xShape = "Truss" 
            end
            
            local pColor = Color3.new(1, 1, 1)
            if r and g and b then
                local rn, gn, bn = safeNum(r), safeNum(g), safeNum(b)
                if rn > 1 or gn > 1 or bn > 1 then pColor = Color3.fromRGB(rn, gn, bn)
                else pColor = Color3.new(rn, gn, bn) end
            end
            
            table.insert(partsToBuild, {
                pos = Vector3.new(safeNum(x), safeNum(y), safeNum(z)),
                rot = Vector3.new(safeNum(rx), safeNum(ry), safeNum(rz)),
                shape = f3xShape, size = Vector3.new(safeNum(sx,1), safeNum(sy,1), safeNum(sz,1)),
                color = pColor, material = mat or "Plastic", transparency = safeNum(trans),
                decals = decals, textures = textures, surfaces = surfaces,
                meshType = meshType, meshId = meshId, meshTextureId = meshTextureId, 
                meshScale = Vector3.new(safeNum(msX, 1), safeNum(msY, 1), safeNum(msZ, 1)),
                hasLight = hasLight, hasFire = hasFire, hasSparkles = hasSparkles, hasSmoke = hasSmoke,
                collision = not (partBlock:match("CanCollide:%s*[Ff]alse")),
                isUnanchored = isUnanchored
            })
        end
    end
    
    local totalParts = #partsToBuild
    if totalParts == 0 then warn("خطا: پارتی یافت نشد!") return end

    local batches = {
        resize = {}, color = {}, material = {}, anchor = {}, unanchor = {}, collision = {},
        meshCreate = {}, meshSync = {}, 
        lightCreate = {}, lightSync = {}, decorationCreate = {}, surface = {},
        decalCreate = {Top={}, Bottom={}, Left={}, Right={}, Front={}, Back={}},
        decalSync = {Top={}, Bottom={}, Left={}, Right={}, Front={}, Back={}}
    }
    
    local completed = 0

    for i, pData in ipairs(partsToBuild) do
        if i % 50 == 0 then
            RunService.Heartbeat:Wait()
        end

        task.spawn(function()
            local success, p = pcall(function()
                local baseCFrame = CFrame.new(pData.pos) * CFrame.fromOrientation(math.rad(pData.rot.X), math.rad(pData.rot.Y), math.rad(pData.rot.Z))
                
                if pData.meshType == "Cylinder" then
                    baseCFrame = baseCFrame * CFrame.Angles(0, 0, math.rad(90))
                    pData.size = Vector3.new(pData.size.Y, pData.size.X, pData.size.Z)
                    pData.meshScale = Vector3.new(pData.meshScale.Y, pData.meshScale.X, pData.meshScale.Z)
                end
                
                return remote:InvokeServer("CreatePart", pData.shape, baseCFrame, workspace)
            end)
            
            if success and p and typeof(p) == "Instance" then
                table.insert(batches.resize, {Part = p, CFrame = p.CFrame, Size = pData.size})
                table.insert(batches.color, {Part = p, Color = pData.color})
                
                -- برای جلوگیری از سقوط، همه پارت‌ها ابتدا ثابت (Anchored) نگه داشته می‌شوند
                table.insert(batches.anchor, {Part = p, Anchored = true})
                if pData.isUnanchored then
                    table.insert(batches.unanchor, {Part = p, Anchored = false})
                end

                table.insert(batches.collision, {Part = p, CanCollide = pData.collision})
                
                local matSuccess, matEnum = pcall(function() return Enum.Material[pData.material:gsub("%s+", "")] end)
                table.insert(batches.material, {Part = p, Material = matSuccess and matEnum or Enum.Material.Plastic, Transparency = pData.transparency})
                
                if next(pData.surfaces) ~= nil then
                    local appliedSurfaces = {}
                    for faceKey, surfEnum in pairs(pData.surfaces) do
                        appliedSurfaces[faceKey] = surfEnum
                    end
                    table.insert(batches.surface, {Part = p, Surfaces = appliedSurfaces})
                end
                
                if pData.hasLight or LIGHT_ALL_PARTS then
                    local targetRange = pData.hasLight and 30 or tonumber(GLOBAL_LIGHT_RANGE) or 30
                    local targetBright = pData.hasLight and 0.2 or tonumber(GLOBAL_LIGHT_BRIGHTNESS) or 0.2
                    
                    table.insert(batches.lightCreate, {Part = p, LightType = "PointLight"})
                    table.insert(batches.lightSync, {
                        Part = p, LightType = "PointLight", Range = targetRange, 
                        Brightness = targetBright, Color = Color3.new(1, 1, 1), Shadows = false
                    })
                end
                
                if pData.hasFire then table.insert(batches.decorationCreate, {Part = p, DecorationType = "Fire"}) end
                if pData.hasSparkles then table.insert(batches.decorationCreate, {Part = p, DecorationType = "Sparkles"}) end
                if pData.hasSmoke then table.insert(batches.decorationCreate, {Part = p, DecorationType = "Smoke"}) end
                
                if pData.meshId or pData.meshType then
                    table.insert(batches.meshCreate, {Part = p})
                    local mTypeEnum = Enum.MeshType.FileMesh
                    if pData.meshType then
                        local meshTypeMap = {
                            File = "FileMesh", FileMesh = "FileMesh", Block = "Brick", Brick = "Brick",
                            Head = "Head", Sphere = "Sphere", Wedge = "Wedge", Cylinder = "Cylinder"
                        }
                        local mappedType = meshTypeMap[pData.meshType] or pData.meshType
                        local typeSuccess, typeEnum = pcall(function() return Enum.MeshType[mappedType] end)
                        if typeSuccess and typeEnum then mTypeEnum = typeEnum end
                    end
                    
                    local mId, tId = "", ""
                    if pData.meshId then local x = pData.meshId:match("%d+") if x then mId = "rbxassetid://"..x end end
                    if pData.meshTextureId then local x = pData.meshTextureId:match("%d+") if x then tId = "rbxassetid://"..x end end
                    
                    table.insert(batches.meshSync, {
                        Part = p, MeshType = mTypeEnum, MeshId = mId, 
                        TextureId = tId, Scale = pData.meshScale, Offset = Vector3.new(0, 0, 0)
                    })
                end
                
                for faceName, dId in pairs(pData.decals) do
                    local formattedFace = faceName:sub(1,1):upper() .. faceName:sub(2):lower()
                    local faceSuccess, faceEnum = pcall(function() return Enum.NormalId[formattedFace] end)
                    if faceSuccess and faceEnum and dId:match("%d+") then
                        table.insert(batches.decalCreate[formattedFace], {Part = p, Face = faceEnum, TextureType = "Decal"})
                        table.insert(batches.decalSync[formattedFace], {Part = p, Face = faceEnum, TextureType = "Decal", Texture = "rbxassetid://"..dId:match("%d+")})
                    end
                end

                for faceName, tId in pairs(pData.textures) do
                    local formattedFace = faceName:sub(1,1):upper() .. faceName:sub(2):lower()
                    local faceSuccess, faceEnum = pcall(function() return Enum.NormalId[formattedFace] end)
                    if faceSuccess and faceEnum and tId:match("%d+") then
                        table.insert(batches.decalCreate[formattedFace], {Part = p, Face = faceEnum, TextureType = "Texture"})
                        table.insert(batches.decalSync[formattedFace], {Part = p, Face = faceEnum, TextureType = "Texture", Texture = "rbxassetid://"..tId:match("%d+")})
                    end
                end
            end
            completed = completed + 1
        end)
    end
    
    while completed < totalParts do RunService.Heartbeat:Wait() end
    
    FireMassiveSync("SyncResize", batches.resize)
    FireMassiveSync("SyncColor", batches.color)
    FireMassiveSync("SyncMaterial", batches.material)
    FireMassiveSync("SyncAnchor", batches.anchor)
    FireMassiveSync("SyncCollision", batches.collision)
    
    if #batches.surface > 0 then
        FireMassiveSync("SyncSurface", batches.surface)
    end
    
    if #batches.lightCreate > 0 then 
        FireMassiveSync("CreateLights", batches.lightCreate)
        FireMassiveSync("SyncLighting", batches.lightSync)
    end
    
    if #batches.decorationCreate > 0 then
        FireMassiveSync("CreateDecorations", batches.decorationCreate)
    end
    
    if #batches.meshCreate > 0 then 
        FireMassiveSync("CreateMeshes", batches.meshCreate)
        FireMassiveSync("SyncMesh", batches.meshSync)
    end

    local hasAnyDecal = false
    for _, faceBatch in pairs(batches.decalCreate) do
        if #faceBatch > 0 then hasAnyDecal = true break end
    end

    if hasAnyDecal then 
        for faceName, faceBatch in pairs(batches.decalCreate) do
            if #faceBatch > 0 then
                FireMassiveSync("CreateTextures", faceBatch)
                FireMassiveSync("SyncTexture", batches.decalSync[faceName])
            end
        end
    end

    while ActiveSyncs > 0 do 
        RunService.Heartbeat:Wait() 
    end
    
    -- مرحله نهایی: آن‌آنکور کردن پارت‌ها دقیقاً بعد از اتمام کامل ساخت مپ
    if #batches.unanchor > 0 then
        FireMassiveSync("SyncAnchor", batches.unanchor)
        while ActiveSyncs > 0 do 
            RunService.Heartbeat:Wait() 
        end
    end
    
end

