local function addRemoteButton(remote)
    if not remote:IsA("RemoteEvent") and not remote:IsA("RemoteFunction") then return end
    if remoteButtonMap[remote] then return end

    local rBtn = createUI("TextButton", {
        Size = UDim2.new(1, 0, 0, 34),
        BackgroundColor3 = Color3.fromRGB(30, 30, 30),
        BorderColor3 = Color3.fromRGB(60, 60, 60),
        Text = " " .. remote.Name .. " (" .. remote.ClassName .. ")",
        TextColor3 = Color3.fromRGB(220, 220, 220),
        Font = Enum.Font.SourceSans,
        TextSize = 14,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = RemoteScrolling
    })

    rBtn.MouseButton1Click:Connect(function()
        selectedRemote = remote
        StatusLabel.Text = "This Script Made By C00LHACK | Selected Remote: " .. remote.Name .. " [" .. remote.ClassName .. "]"
        Notify("Remote Selected", "Target set to: " .. remote.Name, 2)
    end)

    remoteButtonMap[remote] = rBtn

    local query = SearchBox.Text:lower()
    if query == "" or rBtn.Text:lower():find(query, 1, true) then
        rBtn.Visible = true
    else
        rBtn.Visible = false
    end

    updateCanvasSize()
end

local function removeRemoteButton(remote)
    if remoteButtonMap[remote] then
        remoteButtonMap[remote]:Destroy()
        remoteButtonMap[remote] = nil
        updateCanvasSize()
    end
end

