-- ==== منطق بهینه‌شده اسکن اتوماتیک ====
local function SmartScanNew()
    blurefct(20)
    Notify("Vulnerability Checker", "Looking up for remotes, may take a while.", 3)

    local checkIn = {"Workspace", "ReplicatedStorage", "StarterGui", "CoreGui"}
    local names = {"Delete", "Deletar", "Remove", "Destroy", "Clean", "Clear", "Bullet", "Bala", "Shoot", "Shot", "Fire", "Segway", "Handless", "Sword", "Attack"}

    local candidates = {}
    for _, serviceName in pairs(checkIn) do
        local serviceObj = nil
        pcall(function() serviceObj = game:GetService(serviceName) end)
        if serviceObj then
            for _, v in pairs(serviceObj:GetDescendants()) do
                if v:IsA("RemoteEvent") then
                    for _, str in pairs(names) do
                        if string.match(v.Name:lower(), str:lower()) then
                            table.insert(candidates, {remote = v, service = serviceName})
                            break
                        end
                    end
                end
            end
        end
    end

    local foundRemote = nil
    local total = #candidates

    for i, item in ipairs(candidates) do
        local v = item.remote
        local service = item.service

        if total > 0 then
            ProgressBarFill.Size = UDim2.new(i / total, 0, 1, 0)
        end
        ProgressText.Text = "Checking (" .. i .. "/" .. total .. "):\n" .. v.Name .. " [" .. service .. "]"

        -- اطمینان از زنده بودن کاراکتر قبل از تست
        local char = player.Character
        if not char or not char:FindFirstChild("Head") or (char:FindFirstChildOfClass("Humanoid") and char:FindFirstChildOfClass("Humanoid").Health <= 0) then
            char = player.CharacterAdded:Wait()
            task.wait(1)
        end

        local head = char:FindFirstChild("Head")
        local humanoid = char:FindFirstChildOfClass("Humanoid")

        if head then
            pcall(function()
                v:FireServer(head)
            end)

            -- مهلت انتظار تا ۱.۲ ثانیه برای پاسخ سرور و پینگ شبکه
            local startTime = tick()
            local detected = false
            while tick() - startTime < 1.7 do
                if not char:FindFirstChild("Head") or (humanoid and humanoid.Health <= 0) or not char.Parent then
                    detected = true
                    break
                end
                task.wait(0.1)
            end

            if detected then
                foundRemote = v
                break
            end
        end
    end

    blurefct(0)
    return foundRemote
end

