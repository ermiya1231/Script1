function render()
	local top = math.floor(list.CanvasPosition.Y / ROW_H)
	for i = 1, POOL do
		local r = pool[i]
		local idx = top + i
		local inst = idx <= fN and fInst[idx] or nil
		if inst then
			local depth = fDepth[idx]
			local name = inst.Name
			local isSel = inst == selected
			local isExp = expanded[inst] == true
			if r.inst ~= inst or r.idx ~= idx or r.sel ~= isSel or r.exp ~= isExp or r.name ~= name or r.depth ~= depth then
				r.inst, r.idx, r.sel, r.exp, r.name, r.depth = inst, idx, isSel, isExp, name, depth

				r.frame.Visible = true
				r.frame.Position = UDim2.fromOffset(0, (idx - 1) * ROW_H)
				r.frame.BackgroundTransparency = isSel and 0 or 1

				local x = 4 + depth * 16
				local hasKids = (not searchMode) and inst:FindFirstChildWhichIsA("Instance") ~= nil
				r.tog.Position = UDim2.fromOffset(x, 2)
				r.tog.Visible = hasKids
				r.tog.Text = isExp and "-" or "+"

				r.icon.Position = UDim2.fromOffset(x + 22, 2)
				r.icon.Text = iconFor(inst)

				r.label.Position = UDim2.fromOffset(x + 44, 0)
				r.label.Size = UDim2.new(1, -(x + 44), 1, 0)
				r.label.Text = escape(name) .. '  <font color="#8a8a8a">' .. inst.ClassName .. "</font>"
			end
		elseif r.inst ~= nil or r.frame.Visible then
			r.inst = nil
			r.frame.Visible = false
		end
	end
end

local function markDirty()
	dirty = true
end

local function flatten()
	local oldN = fN
	fN = 0
	if searchMode then
		for i, inst in ipairs(searchResults) do
			fN = i
			fInst[i] = inst
			fDepth[i] = 0
		end
		for _, conns in pairs(watchers) do
			for _, c in ipairs(conns) do c:Disconnect() end
		end
		table.clear(watchers)
	else
		local seen = {}
		local function walk(inst, depth)
			fN += 1
			fInst[fN] = inst
			fDepth[fN] = depth
			if expanded[inst] then
				seen[inst] = true
				for _, c in ipairs(inst:GetChildren()) do
					walk(c, depth + 1)
				end
			end
		end
		for _, root in ipairs(ROOTS) do
			walk(root, 0)
		end

		for inst, conns in pairs(watchers) do
			if not seen[inst] then
				for _, c in ipairs(conns) do c:Disconnect() end
				watchers[inst] = nil
			end
		end
		for inst in pairs(seen) do
			if not watchers[inst] then
				watchers[inst] = {
					inst.ChildAdded:Connect(markDirty),
					inst.ChildRemoved:Connect(markDirty),
				}
			end
		end
	end
	for i = fN + 1, oldN do
		fInst[i] = nil
		fDepth[i] = nil
	end
	list.CanvasSize = UDim2.fromOffset(0, fN * ROW_H)
end

local function refresh()
	dirty = false
	flatten()
	for i = 1, POOL do pool[i].inst = nil end
	render()
end

