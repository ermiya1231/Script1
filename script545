local function revealAndScroll(inst)
	searchMode = false
	table.clear(searchResults)
	local p = inst.Parent
	while p do
		expanded[p] = true
		p = p.Parent
	end
	refresh()
	local found = false
	for i = 1, fN do
		if fInst[i] == inst then
			local y = (i - 1) * ROW_H - list.AbsoluteSize.Y / 2
			list.CanvasPosition = Vector2.new(0, math.max(0, y))
			found = true
			break
		end
	end
	if not found then
		showToast("Not inside the shown services")
	end
	render()
end

local inputConn = UIS.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed or not clickMode then return end
	if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then
		return
	end
	local target = mouse.Target
	if not target then return end

	setSelected(target) -- select only, no teleport
	revealAndScroll(target)
end)

