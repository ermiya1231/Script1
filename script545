local function shakePanel(btn)
    if selectedRemote then return false end

    task.spawn(function()
        local originalPos = MainFrame.Position
        for i = 1, 6 do
            local offsetX = math.random(-5, 5)
            local offsetY = math.random(-5, 5)
            MainFrame.Position = originalPos + UDim2.new(0, offsetX, 0, offsetY)
            task.wait(0.03)
        end
        MainFrame.Position = originalPos
    end)

    if btn and btn:IsA("TextButton") then
        task.spawn(function()
            local oldText = btn.Text
            local oldColor = btn.BackgroundColor3
            btn.Text = "Select A Remote!"
            btn.BackgroundColor3 = Color3.fromRGB(180, 40, 40)
            task.wait(1.5)
            btn.Text = oldText
            btn.BackgroundColor3 = oldColor
        end)
    end

    return true
end

local function fireRemote(...)
    if not selectedRemote then return end
    local args = {...}
    pcall(function()
        if selectedRemote:IsA("RemoteFunction") then
            selectedRemote:InvokeServer(unpack(args))
        elseif selectedRemote:IsA("RemoteEvent") then
            selectedRemote:FireServer(unpack(args))
        end
    end)
end

local function lockButton(btn)
    if not btn:GetAttribute("IsLocked") then
        btn:SetAttribute("IsLocked", true)
        btn.BackgroundColor3 = Color3.fromRGB(80, 80, 80)
        btn.Text = btn.Text .. " (Locked)"
    end
end

