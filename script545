local function fmt(v)
	local t = typeof(v)
	if t == "number" then
		return tostring(math.floor(v * 1000 + 0.5) / 1000)
	elseif t == "Vector3" then
		return string.format("%.2f, %.2f, %.2f", v.X, v.Y, v.Z)
	elseif t == "Vector2" then
		return string.format("%.2f, %.2f", v.X, v.Y)
	elseif t == "Color3" then
		return string.format("%d, %d, %d", math.floor(v.R * 255 + 0.5), math.floor(v.G * 255 + 0.5), math.floor(v.B * 255 + 0.5))
	elseif t == "UDim2" then
		return string.format("{%.2f, %d}, {%.2f, %d}", v.X.Scale, v.X.Offset, v.Y.Scale, v.Y.Offset)
	elseif t == "UDim" then
		return string.format("%.2f, %d", v.Scale, v.Offset)
	elseif t == "CFrame" then
		local p = v.Position
		return string.format("%.2f, %.2f, %.2f (CFrame)", p.X, p.Y, p.Z)
	elseif t == "EnumItem" then
		return v.Name
	elseif t == "Instance" then
		return getPath(v)
	elseif t == "nil" then
		return "nil"
	end
	return tostring(v)
end

