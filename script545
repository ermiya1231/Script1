---------------------------------------------------------------- Helpers
local function isIdent(s)
	return s:match("^[%a_][%w_]*$") ~= nil
end

local function getPath(inst)
	if inst == game then return "game" end
	local chain, cur = {}, inst
	while cur and cur ~= game do
		table.insert(chain, 1, cur)
		cur = cur.Parent
	end
	local path = "game"
	for i, o in ipairs(chain) do
		if i == 1 then
			if o == workspace then
				path = "game.Workspace"
			else
				local ok, svc = pcall(game.GetService, game, o.ClassName)
				if ok and svc == o then
					path = string.format('game:GetService("%s")', o.ClassName)
				elseif isIdent(o.Name) then
					path = "game." .. o.Name
				else
					path = path .. string.format("[%q]", o.Name)
				end
			end
		else
			if isIdent(o.Name) then
				path = path .. "." .. o.Name
			else
				path = path .. string.format("[%q]", o.Name)
			end
		end
	end
	return path
end

local function escape(s)
	return (s:gsub("&", "&amp;"):gsub("<", "&lt;"):gsub(">", "&gt;"))
end

