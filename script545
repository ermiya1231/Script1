local function checkLock(btn) return btn:GetAttribute("IsLocked") end
local function getPlayer(name)
    name = name:lower()
    for _, p in pairs(Players:GetPlayers()) do
        if p.Name:lower():sub(1, #name) == name or p.DisplayName:lower():sub(1, #name) == name then return p end
    end
    return nil
end

local function KickTarget(targetPlayer)
    if selectedRemote and targetPlayer then
        pcall(function()
            fireRemote(targetPlayer)
            if targetPlayer.Character then fireRemote(targetPlayer.Character) end
        end)
    end
end

local function KillTarget(targetPlayer)
    if selectedRemote and targetPlayer and targetPlayer.Character then
        local char = targetPlayer.Character
        local part = char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart") or char:FindFirstChildOfClass("BasePart")
        if part then pcall(function() fireRemote(part) end) end
    end
end

local function DeleteRightLeg(targetCharacter)
    if not selectedRemote or not targetCharacter then return end
    local legParts = {"Right Leg", "RightFoot", "RightLowerLeg", "RightUpperLeg"}
    for _, partName in ipairs(legParts) do
        local part = targetCharacter:FindFirstChild(partName)
        if part then pcall(function() fireRemote(part) end) end
    end
end

