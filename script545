local propEntries = {}
local propCount = 0

local function clearProps()
	propCount = 0
	table.clear(propEntries)
	for i = 1, PROP_POOL do propRows[i].frame.Visible = false end
	propList.CanvasSize = UDim2.new()
end

local function pushEntry(entry)
	if propCount >= PROP_POOL then return end
	propCount += 1
	propEntries[propCount] = entry
	local row = propRows[propCount]
	row.frame.Visible = true
	if entry.header then
		row.frame.BackgroundTransparency = 0.2
		row.name.Text = entry.header
		row.name.TextColor3 = C.blue
		row.name.Font = Enum.Font.GothamBold
		row.name.Size = UDim2.new(1, -8, 1, 0)
		row.value.Text = ""
	else
		row.frame.BackgroundTransparency = 0.6
		row.name.Text = entry.name
		row.name.TextColor3 = C.dim
		row.name.Font = Enum.Font.Gotham
		row.name.Size = UDim2.new(0.4, 0, 1, 0)
		local ok, v = pcall(entry.get)
		entry.last = ok and fmt(v) or "?"
		row.value.Text = entry.last
	end
end

function buildProps(inst)
	clearProps()
	if not inst then return end

	pushEntry({ header = "Data" })
	pushEntry({ name = "Name", get = function() return inst.Name end })
	pushEntry({ name = "ClassName", get = function() return inst.ClassName end })
	pushEntry({ name = "Parent", get = function() return inst.Parent and inst.Parent.Name or "nil" end })
	pushEntry({ name = "Path", get = function() return getPath(inst) end })

	for _, group in ipairs(PROP_GROUPS) do
		local okIs, is = pcall(inst.IsA, inst, group[1])
		if okIs and is then
			local added = false
			for _, prop in ipairs(group[2]) do
				local ok = pcall(function() return inst[prop] end)
				if ok then
					if not added then
						pushEntry({ header = group[1] })
						added = true
					end
					pushEntry({ name = prop, get = function() return inst[prop] end })
				end
			end
		end
	end

	local okA, attrs = pcall(inst.GetAttributes, inst)
	if okA and attrs and next(attrs) then
		pushEntry({ header = "Attributes" })
		for k in pairs(attrs) do
			pushEntry({ name = k, get = function() return inst:GetAttribute(k) end })
		end
	end

	local okT, tags = pcall(CollectionService.GetTags, CollectionService, inst)
	if okT and tags and #tags > 0 then
		pushEntry({ header = "Tags" })
		pushEntry({ name = "Tags", get = function() return table.concat(tags, ", ") end })
	end

	propList.CanvasSize = UDim2.fromOffset(0, propCount * PROP_ROW_H)
end

local function updateProps()
	for i = 1, propCount do
		local e = propEntries[i]
		if e and e.get then
			local ok, v = pcall(e.get)
			local s = ok and fmt(v) or "?"
			if s ~= e.last then
				e.last = s
				propRows[i].value.Text = s
			end
		end
	end
end

---------------------------------------------------------------- Heartbeat: debounced tree refresh + props refresh
local lastBuild, lastProps = 0, 0
local hb = RunService.Heartbeat:Connect(function()
	local now = os.clock()
	if dirty and now - lastBuild > 0.5 then
		lastBuild = now
		refresh()
	end
	if selected and now - lastProps > 0.5 then
		lastProps = now
		updateProps()
	end
end)

---------------------------------------------------------------- Search
local searchToken = 0

searchBox.FocusLost:Connect(function(enter)
	if not enter then return end
	local q = searchBox.Text:lower()
	searchToken += 1
	local my = searchToken

	if q == "" then
		searchMode = false
		table.clear(searchResults)
		refresh()
		return
	end

	status.Text = "Searching..."
	task.spawn(function()
		local res = {}
		local all = {}
		for _, root in ipairs(ROOTS) do
			all[#all + 1] = root
			for _, d in ipairs(root:GetDescendants()) do
				all[#all + 1] = d
			end
		end
		for i = 1, #all do
			local d = all[i]
			if d.Name:lower():find(q, 1, true) or d.ClassName:lower():find(q, 1, true) then
				res[#res + 1] = d
				if #res >= 500 then break end
			end
			if i % 4000 == 0 then
				task.wait()
				if my ~= searchToken then return end
			end
		end
		if my ~= searchToken then return end
		searchResults = res
		searchMode = true
		list.CanvasPosition = Vector2.new(0, 0)
		refresh()
		status.Text = #res .. (#res >= 500 and "+" or "") .. " results"
	end)
end)

