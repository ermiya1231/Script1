-- سیستم ثبت ترتیبی دقیق
local dumpedRawStrings = {}

local function SequentialFilter(rawStrings)
    local finalCode = "--[[ OP Deobfuscator By C00LHACK V2 ]]\n\n"
    local hasData = false

    for _, v in ipairs(rawStrings) do
        if type(v) == "string" then
            local isJunk = v:match("MoonSec") or v:match("protected with") or v:match("^_MBOX") 
                            or v:match("^%%%w+") or v:match("^:%d+:") or v:match("^__%w+") 
                            or (#v < 2 and not v:match("%a")) or v == ":%d+: a"

            if not isJunk then
                hasData = true
                local safeStr = string.gsub(v, '"', '\\"')
                safeStr = string.gsub(safeStr, '\n', '\\n')

                if safeStr:match("^[%a%d_]+$") and not safeStr:match(" ") then
                    finalCode = finalCode .. safeStr .. "\n"
                else
                    finalCode = finalCode .. '"' .. safeStr .. '"\n'
                end
            end
        end
    end

    if not hasData then
        return "-- No readable data found."
    end

    return finalCode
end

local function deep_unpack(tbl)
    for _, v in pairs(tbl) do
        if type(v) == "table" then
            deep_unpack(v)
        elseif type(v) == "string" then
            table.insert(dumpedRawStrings, v)
        end
    end
end

local old_unpack = unpack or table.unpack
function unpack(...)
    for _, v in ipairs({...}) do
        if type(v) == "table" then deep_unpack(v) end
    end
    return old_unpack(...)
end
_G.unpack = unpack

